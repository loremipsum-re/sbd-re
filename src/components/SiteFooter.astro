---
/**
 * Pied de page — obligatoire sur TOUTES les pages.
 *
 * Les deux mentions ci-dessous ne sont pas décoratives :
 *  - le crédit OpenPowerlifting est la contrepartie de l'usage de leurs données ;
 *  - la mention de non-affiliation évite toute confusion avec la FFForce
 *    (la fédération) et avec SBD Apparel (la marque d'équipement), dont le nom
 *    ressemble à celui du site.
 */
import { periode, nombreAthletes, results } from '../lib/data';
import { dateLongue } from '../lib/format';

const { debut, fin } = periode();
---

<footer class="pied">
  <div class="wrap">
    <div class="grille">
      <div>
        <p class="marque">SBD<span>.re</span></p>
        <p class="fin">
          Classements et records de force athlétique de La Réunion.
        </p>
      </div>

      <nav aria-label="Pied de page">
        <p class="titre">Le site</p>
        <ul>
          {/*
            L'en-tête ne porte que trois entrées ; ce menu recueille tout le
            reste. C'est ici, et nulle part ailleurs, que se retrouvent les
            rubriques sorties de la barre de navigation.
          */}
          <li><a href="/classement/">Classement officiel</a></li>
          <li><a href="/communaute/">Communauté</a></li>
          <li><a href="/comparer/">Comparer des athlètes</a></li>
          <li><a href="/records/">Records</a></li>
          <li><a href="/categories/">Catégories</a></li>
          <li><a href="/competitions/">Compétitions</a></li>
          <li><a href="/exterieur/">Extérieur</a></li>
          <li><a href="/a-propos/">À propos</a></li>
        </ul>
      </nav>

      <div>
        <p class="titre">Données</p>
        <p class="fin">
          {results.length.toLocaleString('fr-FR')} résultats, {nombreAthletes()} athlètes.{' '}
          {debut && <>De {dateLongue(debut)} à {dateLongue(fin)}.</>}
        </p>
      </div>
    </div>

    <div class="soutien">
      <div>
        <p class="titre">Soutenir le projet</p>
        <p class="fin">
          Le site est gratuit et sans publicité. La mesure d'audience reste
          facultative et se refuse en un clic. Un café aide à couvrir le nom de
          domaine et l'hébergement.
        </p>
      </div>
      {/*
        Bouton « fait maison » plutôt que le script officiel de Buy Me a Coffee.
        Ce script se charge depuis un serveur tiers sur chacune des pages du
        site, ce qui transmet l'adresse IP de chaque visiteur avant même le
        moindre clic. Le lien ci-dessous produit le même rendu et ne contacte
        Buy Me a Coffee qu'au moment où l'on clique.
      */}
      <a class="bmc lien-nu" href="https://www.buymeacoffee.com/nathanlannes" rel="noopener">
        <span class="tasse" aria-hidden="true">☕</span>
        <span>Soutenir ce projet</span>
      </a>
    </div>

    <div class="mentions">
      <p>
        Données issues du projet OpenPowerlifting :{' '}
        <a href="https://www.openpowerlifting.org" rel="noopener">openpowerlifting.org</a>. Jeu
        de données téléchargeable sur{' '}
        <a href="https://data.openpowerlifting.org" rel="noopener">data.openpowerlifting.org</a>.
      </p>
      <p>
        Site indépendant, non affilié à la FFForce ni à SBD Apparel.
      </p>
      <p class="legal">
        <a href="/mentions-legales/">Mentions légales</a>
        <span aria-hidden="true">·</span>
        <a href="/confidentialite/">Confidentialité</a>
      </p>
      <p class="realisation">
        Une réalisation de{' '}
        <a href="https://loremipsum.re" rel="noopener">loremipsum.re</a>.
      </p>
    </div>
  </div>
</footer>

<style>
  .pied {
    margin-top: var(--space-16);
    border-top: 1px solid var(--border);
    background: var(--surface);
    padding-block: var(--space-12) var(--space-8);
    font-size: var(--step--1);
  }

  .grille {
    display: grid;
    gap: var(--space-8);
    grid-template-columns: 1fr;
  }

  @media (min-width: 48rem) {
    .grille {
      grid-template-columns: 2fr 1fr 1.5fr;
      gap: var(--space-12);
    }
  }

  .marque {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: var(--step-1);
    letter-spacing: -0.03em;
    margin-bottom: var(--space-2);
  }
  .marque span {
    color: var(--accent);
  }

  .titre {
    font-weight: 700;
    margin-bottom: var(--space-2);
  }

  .fin {
    color: var(--muted);
    margin: 0;
  }

  ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    /*
     * Aucun écart entre les lignes, et c'est voulu. Les liens font désormais
     * 44 px de haut chacun ; un écart en plus les éloignerait sans rien
     * gagner, alors que des lignes jointives se lisent comme une liste.
     */
    gap: 0;
  }

  /*
   * Les liens de navigation du pied de page faisaient 15 px de haut, la pire
   * cible mesurée du site. C'est pourtant un plan du site complet, atteint au
   * pouce, en bas de page, souvent d'une seule main.
   *
   * Ils deviennent des lignes à la manière d'une liste : le texte garde sa
   * taille, c'est la zone cliquable qui grandit autour de lui. Le pied de page
   * s'allonge, ce qui est le prix accepté d'une navigation utilisable.
   */
  /*
   * Aucun rembourrage horizontal, et c'est délibéré. La version précédente en
   * posait 12 px et les compensait par une marge négative : la liste mesurait
   * alors 355 px dans une colonne de 343, soit un débordement de 12 px hors de
   * la zone de contenu. Sans rembourrage, le texte tombe pile sur l'axe du
   * titre et la puce de survol occupe la largeur de la colonne, ce qui est
   * aussi la forme d'une ligne de liste.
   */
  ul a {
    display: flex;
    align-items: center;
    min-height: var(--cible-min);
    border-radius: var(--radius);
    color: var(--muted);
  }
  ul a:hover {
    color: var(--accent);
    background: var(--bg);
  }

  .soutien {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    margin-top: var(--space-8);
    padding-top: var(--space-6);
    border-top: 1px solid var(--border);
  }

  .soutien .fin {
    max-width: 46ch;
  }

  /*
   * Reprend l'apparence du bouton officiel Buy Me a Coffee : violet #7628ff,
   * texte blanc, police Lato remplacée par la police du site, tasse en emoji.
   */
  .bmc {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-3) var(--space-6);
    border-radius: var(--radius);
    background: #7628ff;
    color: #ffffff;
    font-weight: 700;
    font-size: var(--step-0);
    white-space: nowrap;
    box-shadow: 0 1px 2px rgb(0 0 0 / 0.2);
  }

  .bmc:hover {
    background: #6a20e8;
    color: #ffffff;
  }

  .tasse {
    font-size: 1.15em;
  }

  .mentions {
    margin-top: var(--space-8);
    padding-top: var(--space-6);
    border-top: 1px solid var(--border);
    color: var(--muted);
  }

  .legal {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2);
    margin-top: var(--space-3);
  }

  /*
   * Mentions légales et confidentialité restent côte à côte sur une ligne,
   * séparées par le point médian : ce sont deux liens, pas une liste. Seule
   * leur zone cliquable grandit, verticalement, autour d'un texte inchangé.
   *
   * La page de confidentialité porte le droit d'opposition des athlètes à la
   * publication de leur nom. Elle doit s'atteindre du premier coup.
   */
  .legal a {
    display: inline-flex;
    align-items: center;
    min-height: var(--cible-min);
  }

  .realisation {
    margin-top: var(--space-2);
  }

  .mentions p {
    margin: 0 0 var(--space-2);
  }
</style>

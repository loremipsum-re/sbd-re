---
/**
 * Les records de l'île, en une image.
 *
 * HUIT CARTES, UNE PAR MOUVEMENT ET PAR SEXE. Chacune donne la barre, son
 * détenteur, sa catégorie, son équipement et sa date. C'est la meilleure barre
 * toutes catégories et tous équipements confondus, celle que l'article « Les
 * records de force athlétique à La Réunion » énumère.
 *
 * LES RÈGLES SONT CELLES DE lib/records.ts, reprises sans être réécrites :
 * `recordsPour` donne le record de chaque catégorie, et la carte retient le
 * plus lourd. Le total vient donc du seul full power, et le développé couché
 * compte aussi les compétitions de ce seul mouvement. À égalité, la marque la
 * plus ancienne garde le record, comme dans `progressionRecord`.
 *
 * L'ÉQUIPEMENT EST ÉCRIT SUR CHAQUE CARTE. Un record peut venir de l'équipé,
 * le développé couché des hommes en est un. La carte donne alors aussi la
 * meilleure barre raw, que l'article cite.
 *
 * LA DATE DIT L'ÂGE DU RECORD. Une saison est une année civile, comme dans
 * l'article « La saison 2026 », et la saison en cours est celle de la dernière
 * compétition des données. Ses records portent leur date sur un aplat
 * d'accent. Le bas de l'image les compte par saison.
 */
import Infographie from './Infographie.astro';
import { EQUIPMENT_GROUPS, LIFTS } from '../../lib/categories';
import { periode } from '../../lib/data';
import { annee, dateLongue, nombre, pluriel } from '../../lib/format';
import type { IdInfographie } from '../../lib/infographies';
import { TRACES_MOUVEMENTS } from '../../lib/mouvements';
import { recordsPour, type RecordEntry } from '../../lib/records';
import type { LiftKey, Sex } from '../../lib/types';

interface Props {
  lienArticle?: IdInfographie;
}

const { lienArticle } = Astro.props;

/** La plus lourde, puis la plus ancienne à égalité. */
function plusLourd(candidats: RecordEntry[]): RecordEntry | null {
  return candidats.reduce<RecordEntry | null>(
    (a, b) =>
      !a || b.valueKg > a.valueKg || (b.valueKg === a.valueKg && b.date < a.date) ? b : a,
    null,
  );
}

const debut = periode().debut;
const saison = annee(periode().fin);

const SEXES: { id: Sex; titre: string; complement: string }[] = [
  { id: 'M', titre: 'Hommes', complement: 'des hommes' },
  { id: 'F', titre: 'Femmes', complement: 'des femmes' },
];

/** « 18 juillet 2026 », le jour soudé à son mois par une espace insécable. */
const date = (iso: string) => dateLongue(iso).replace(' ', '\u00a0');

const libelleEquipement = (id: string) => EQUIPMENT_GROUPS.find((e) => e.id === id)?.label ?? id;

interface Carte {
  lift: LiftKey;
  label: string;
  sexe: (typeof SEXES)[number];
  record: RecordEntry;
  /** Meilleure barre raw, pour un record établi en équipé. */
  raw: RecordEntry | null;
  courante: boolean;
}

const groupes = SEXES.map((sexe) => ({
  sexe,
  cartes: LIFTS.flatMap((l): Carte[] => {
    const categories = recordsPour(l.id).filter((r) => r.sex === sexe.id);
    const record = plusLourd(categories);
    if (!record) return [];
    const raw =
      record.equipment === 'raw'
        ? null
        : plusLourd(categories.filter((r) => r.equipment === 'raw'));
    return [
      {
        lift: l.id,
        label: l.label,
        sexe,
        record,
        raw,
        courante: annee(record.date) === saison,
      },
    ];
  }),
})).filter((g) => g.cartes.length > 0);

const cartes = groupes.flatMap((g) => g.cartes);
const courantes = cartes.filter((c) => c.courante);

/* Les saisons qui portent au moins un record, de la plus ancienne à la plus
   récente. Une saison sans record n'a rien à montrer. */
const parSaison = new Map<string, Carte[]>();
for (const c of [...cartes].sort((a, b) => a.record.date.localeCompare(b.record.date))) {
  const an = annee(c.record.date);
  parSaison.set(an, [...(parSaison.get(an) ?? []), c]);
}
const saisons = [...parSaison.entries()].map(([an, liste]) => ({ an, liste }));

const nomCarte = (c: Carte) => `${c.label.toLowerCase()} ${c.sexe.complement}`;

/*
 * LES RECORDS DE LA SAISON VIENNENT-ILS D'UNE SEULE COMPÉTITION ? La phrase
 * donne alors son jour et sa commune, comme l'article « La saison 2026 ». Le
 * nom de la compétition n'y entre pas : le déterminant qui le précéderait
 * change d'un nom à l'autre, au Championnat, à l'Open, aux Eliminatoires.
 */
const competitionsCourantes = new Set(courantes.map((c) => `${c.record.date}|${c.record.meetName}`));
const uneSeule = competitionsCourantes.size === 1 ? courantes[0].record : null;
/** « 18 juillet » : l'année est déjà dans la phrase. */
const jourEtMois = (iso: string) => date(iso).replace(/ \d{4}$/, '');
const phraseSaison = uneSeule
  ? (courantes.length > 1
      ? `Les ${courantes.length} records de ${saison} ont été établis`
      : `Le record de ${saison} a été établi`) +
    ` le ${jourEtMois(uneSeule.date)}` +
    (uneSeule.meetTown ? `, à ${uneSeule.meetTown}.` : '.')
  : null;

/* Le plus ancien, quand il date d'une saison passée. */
const premiereDate = cartes.map((c) => c.record.date).sort()[0];
const anciens = cartes.filter((c) => c.record.date === premiereDate);
const phraseAncien =
  premiereDate && annee(premiereDate) !== saison
    ? anciens.length === 1
      ? `Le plus ancien est le ${nomCarte(anciens[0])}, du ${date(premiereDate)}.`
      : `Les plus anciens datent du ${date(premiereDate)}.`
    : null;

/* LE TITRE EST LE CONSTAT DU JOUR, recalculé à chaque mise à jour. */
const titre =
  courantes.length === 0
    ? "Les meilleures barres de l'île, toutes catégories confondues"
    : courantes.length === 1
      ? `Un des ${cartes.length} records de l'île date de ${saison}`
      : courantes.length === cartes.length
        ? `Les ${cartes.length} records de l'île datent de ${saison}`
        : `${courantes.length} des ${cartes.length} records de l'île datent de ${saison}`;
---

<Infographie
  titre={titre}
  source={`Meilleures barres en compétition à La Réunion depuis ${annee(debut)}, toutes catégories et tous équipements confondus. Le total vient uniquement du full power. Le développé couché inclut les compétitions de ce seul mouvement.`}
  lienArticle={lienArticle}
>
  <div class="sexes">
    {
      groupes.map(({ sexe, cartes }) => (
        <section class="sexe" aria-labelledby={`records-ile-${sexe.id}`}>
          <p class="intitule" id={`records-ile-${sexe.id}`}>
            {sexe.titre}
          </p>

          <ul class="records">
            {cartes.map((c) => (
              <li class="record">
                <p class="mouvement">
                  {TRACES_MOUVEMENTS[c.lift] && (
                    <svg
                      class="icone-mouvement"
                      width="18"
                      height="18"
                      viewBox="0 0 24 24"
                      aria-hidden="true"
                      focusable="false"
                    >
                      {TRACES_MOUVEMENTS[c.lift]?.map((d) => <path d={d} />)}
                    </svg>
                  )}
                  {c.label}
                </p>
                <p class="valeur num">
                  {nombre(c.record.valueKg)}&nbsp;kg
                </p>
                <p class="detenteur">
                  <a href={`/athlete/${c.record.slug}/`}>{c.record.holder}</a>
                </p>
                <p class="meta">
                  <span class="sr-only">Catégorie </span>
                  <span class="nowrap">{c.record.weightClass.label}</span>
                  <span aria-hidden="true"> · </span>
                  <span class="sr-only">, </span>
                  <span data-equipement={c.record.equipment}>
                    {libelleEquipement(c.record.equipment)}
                  </span>
                </p>
                <p class="date">
                  <span data-courante={c.courante ? '' : undefined}>
                    {date(c.record.date)}
                  </span>
                </p>
                {c.raw && (
                  <p class="raw">
                    Meilleure barre raw&nbsp;:{' '}
                    <strong class="num-tab">{nombre(c.raw.valueKg)}&nbsp;kg</strong>{' '}
                    en {annee(c.raw.date)}
                    {c.raw.holder !== c.record.holder && <>, par {c.raw.holder}</>}.
                  </p>
                )}
              </li>
            ))}
          </ul>
        </section>
      ))
    }
  </div>

  <div class="bilan">
    <p class="intitule" id="records-ile-saisons">
      Saison de chaque record
    </p>
    <ol class="saisons" aria-labelledby="records-ile-saisons">
      {
        saisons.map(({ an, liste }) => (
          <li data-courante={an === saison ? '' : undefined}>
            <span class="cases" aria-hidden="true">
              {liste.map(() => (
                <span class="case" />
              ))}
            </span>
            <span class="annee num-tab">{an}</span>
            <span class="sr-only">
              , {liste.length} {pluriel(liste.length, 'record')} :{' '}
              {liste.map(nomCarte).join(', ')}
            </span>
          </li>
        ))
      }
    </ol>

    {phraseSaison && <p class="phrase">{phraseSaison}</p>}
    {phraseAncien && <p class="phrase">{phraseAncien}</p>}
  </div>
</Infographie>

<style>
  p {
    margin: 0;
  }

  .intitule {
    margin-bottom: var(--space-2);
    font-size: var(--step--1);
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--muted);
  }

  /*
   * LES DEUX SEXES CÔTE À CÔTE dès qu'il y a la place. Sur la page des
   * records, l'image a 1 040 px utiles et chaque sexe y prend la moitié.
   * Dans un article, large de 68 caractères, ils s'empilent.
   */
  .sexes {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(26rem, 100%), 1fr));
    gap: var(--space-6) var(--space-8);
  }

  .sexe {
    min-width: 0;
  }

  /*
   * QUATRE CARTES EN DEUX RANGÉES, à toutes les largeurs. Le compte de
   * colonnes divise le compte de cartes, et les rangées se partagent par
   * `subgrid` : « Développé couché » tient sur deux lignes à côté de
   * « Squat », et les charges restent alignées. Le principe est celui des
   * blocs de chiffres de tokens.css.
   */
  .records {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-3);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .record {
    display: grid;
    grid-row: span 6;
    grid-template-rows: subgrid;
    row-gap: var(--space-1);
    align-content: start;
    min-width: 0;
    padding: var(--space-4);
    border: 2px solid var(--border);
    border-radius: var(--radius);
    background: var(--bg);
  }

  @media (max-width: 40rem) {
    .records {
      gap: var(--space-2);
    }
    .record {
      padding: var(--space-3);
    }
  }

  .mouvement {
    display: flex;
    align-items: flex-start;
    gap: var(--space-1);
    font-size: var(--step--1);
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .mouvement svg {
    margin-top: 0.05em;
  }

  .valeur {
    font-size: var(--step-2);
    line-height: 1.1;
  }

  /* Le nom est un lien vers la fiche : 24 px de haut au moins, le plancher
     des WCAG pour une cible hors d'une phrase. */
  .detenteur a {
    display: inline-flex;
    align-items: center;
    min-height: 1.5rem;
    font-weight: 700;
  }

  .meta {
    font-size: var(--step--1);
    color: var(--muted);
  }

  .nowrap {
    white-space: nowrap;
  }

  /* L'équipé se lit en gras : c'est l'exception qui change la barre. */
  .meta [data-equipement='equipped'],
  .meta [data-equipement='wraps'] {
    font-weight: 700;
    color: var(--text);
  }

  .date {
    font-size: var(--step--1);
    color: var(--muted);
  }

  /* LA SAISON EN COURS EN APLAT. La date porte son année en toutes lettres,
     l'aplat ne fait que la signaler d'un coup d'œil. */
  .date [data-courante] {
    display: inline-block;
    padding: 0 var(--space-2);
    border-radius: var(--radius);
    background: var(--accent-fill);
    color: var(--on-accent);
    font-weight: 700;
  }

  .raw {
    margin-top: var(--space-1);
    padding-top: var(--space-2);
    border-top: 1px solid var(--border);
    font-size: var(--step--1);
    color: var(--muted);
  }
  .raw strong {
    color: var(--text);
  }

  /* LE BILAN : un carré par record, rangé sous sa saison. */
  .bilan {
    margin-top: var(--space-8);
    padding-top: var(--space-6);
    border-top: 1px solid var(--border);
  }

  .saisons {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    gap: var(--space-3) var(--space-4);
    margin: 0 0 var(--space-4);
    padding: 0;
    list-style: none;
  }

  .saisons li {
    display: grid;
    justify-items: start;
    gap: var(--space-1);
    min-width: 0;
  }

  .cases {
    display: flex;
    gap: var(--space-1);
  }

  .case {
    width: 1.5rem;
    height: 1.5rem;
    border-radius: 2px;
    background: color-mix(in srgb, var(--muted) 55%, var(--surface));
  }
  [data-courante] .case {
    background: var(--accent-fill);
  }

  .annee {
    font-size: var(--step--1);
    color: var(--muted);
  }
  .saisons [data-courante] .annee {
    color: var(--text);
    font-weight: 800;
  }

  .phrase + .phrase {
    margin-top: var(--space-2);
  }
</style>

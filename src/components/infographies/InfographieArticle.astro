---
/**
 * L'infographie d'un article, choisie par son champ `infographie`.
 *
 * Un article Markdown ne peut pas appeler un composant. Le champ du
 * frontmatter, proposé en menu dans le CMS, nomme l'infographie, et la page
 * d'article la pose entre le chapeau et le texte : le lecteur voit l'image
 * avant de lire le développement.
 */
import InfographieCategories from './InfographieCategories.astro';
import InfographieCommunes from './InfographieCommunes.astro';
import InfographieCompetition from './InfographieCompetition.astro';
import InfographieDivisions from './InfographieDivisions.astro';
import InfographieDonnees from './InfographieDonnees.astro';
import InfographieDots from './InfographieDots.astro';
import InfographieEquipement from './InfographieEquipement.astro';
import InfographieFormats from './InfographieFormats.astro';
import InfographieInternational from './InfographieInternational.astro';
import InfographieRecords from './InfographieRecords.astro';
import InfographieSaisons from './InfographieSaisons.astro';
import InfographieTotal from './InfographieTotal.astro';
import { INFOGRAPHIES, type FicheInfographie, type IdInfographie } from '../../lib/infographies';

interface Props {
  id: IdInfographie;
  /** Champ `competition` de l'article, que lit l'infographie d'une compétition. */
  competition?: string;
}

const { id, competition } = Astro.props;

const COMPOSANTS = {
  dots: InfographieDots,
  total: InfographieTotal,
  equipement: InfographieEquipement,
  categories: InfographieCategories,
  divisions: InfographieDivisions,
  saisons: InfographieSaisons,
  records: InfographieRecords,
  communes: InfographieCommunes,
  international: InfographieInternational,
  donnees: InfographieDonnees,
  formats: InfographieFormats,
} satisfies Record<Exclude<IdInfographie, 'competition'>, unknown>;

/*
 * L'infographie d'une compétition sans compétition désignée n'aurait rien à
 * montrer. La génération s'arrête plutôt que de publier un cadre vide.
 */
const fiche: FicheInfographie = INFOGRAPHIES[id];
if (fiche.exigeCompetition && !competition) {
  throw new Error(
    `L'infographie « ${id} » demande le champ « competition » de l'article.`,
  );
}

// Toutes s'affichent sans propriété, sauf celle d'une compétition.
const Composant = id === 'competition' ? null : COMPOSANTS[id];
---

{Composant ? <Composant /> : <InfographieCompetition chemin={competition!} />}

---
/**
 * Les deux classements et leur façon de noter l'athlète, en une image.
 *
 * UN TABLEAU À DEUX COLONNES, une ligne par point de comparaison : l'usage,
 * le poids de corps, la taille. L'officiel pèse, la communauté demande une
 * tranche, et la ligne les met face à face. Les usages reprennent le texte de
 * la page, la pesée l'article sur les catégories (« La pesée a lieu le jour
 * de la compétition »), les tranches lib/categories.ts.
 *
 * LES TRANCHES APPLIQUÉES AUX RÉSULTATS OFFICIELS. Rangés dans les tranches
 * de la communauté, les poids pesés sur l'île montrent ce qu'une tranche
 * garde d'un poids exact : la place de l'athlète dans l'ensemble. Hommes et
 * femmes sont comptés ensemble, les tranches étant communes aux deux sexes.
 *
 * RIEN N'EST RECOPIÉ. Les bornes viennent de COMMUNITY_WEIGHT_BRACKETS et
 * COMMUNITY_HEIGHT_BRACKETS. Les effectifs, le nombre de poids différents et
 * leurs extrêmes sont comptés dans les données.
 *
 * AUCUNE PROMESSE NOUVELLE. Le classement communauté n'existe pas encore : sa
 * colonne porte « En préparation », et la figure n'affirme rien que la page ne
 * dise déjà.
 */
import Icone from '../Icone.astro';
import Infographie from './Infographie.astro';
import {
  COMMUNITY_HEIGHT_BRACKETS,
  COMMUNITY_WEIGHT_BRACKETS,
  bracketFor,
  type Bracket,
} from '../../lib/categories';
import { periode, results } from '../../lib/data';
import { annee, nombre, pluriel } from '../../lib/format';

interface Props {
  // Aucune propriété : l'infographie ne sert qu'à la page /communaute/.
}

/* Les poids pesés en compétition, tels que les résultats les portent. */
const poids = results.map((r) => r.bodyweightKg).filter((p): p is number => p !== null);
const sansPoids = results.length - poids.length;
const poidsDifferents = new Set(poids).size;
const plusLeger = Math.min(...poids);
const plusLourd = Math.max(...poids);

/* Les mêmes poids, rangés dans les tranches de la communauté. */
const comptes = new Map<string, number>();
for (const p of poids) {
  const tranche = bracketFor(p, COMMUNITY_WEIGHT_BRACKETS);
  if (tranche) comptes.set(tranche.id, (comptes.get(tranche.id) ?? 0) + 1);
}
const colonnes = COMMUNITY_WEIGHT_BRACKETS.map((b) => ({ ...b, resultats: comptes.get(b.id) ?? 0 }));
const plusGrand = Math.max(...colonnes.map((c) => c.resultats));
const enTete = colonnes.filter((c) => c.resultats === plusGrand && plusGrand > 0);

/**
 * La largeur commune des tranches bornées des deux côtés, ou `null` si elles
 * diffèrent. Le titre ne la cite que si elle est la même pour toutes.
 */
function pas(tranches: Bracket[]): number | null {
  const largeurs = new Set(
    tranches.filter((b) => b.min !== null && b.max !== null).map((b) => b.max! - b.min!),
  );
  return largeurs.size === 1 ? [...largeurs][0] : null;
}
const pasPoids = pas(COMMUNITY_WEIGHT_BRACKETS);

/**
 * Le libellé d'une tranche, l'unité soudée au nombre : « 80 à 90 kg » ne
 * passe jamais à la ligne entre 90 et kg.
 */
const libelle = (b: Bracket) => b.label.replace(/ (kg|cm)$/, '\u00a0$1');

/** « de moins de 60 kg à plus de 120 kg » : les deux tranches des bords. */
const etendue = (tranches: Bracket[]) =>
  `de ${libelle(tranches[0])} à ${libelle(tranches.at(-1)!)}`;

/** « 80 à 90 kg », ou « 70 à 80 kg et 80 à 90 kg » en cas d'égalité. */
const tranchesEnTete =
  enTete.length > 1
    ? `${enTete.slice(0, -1).map(libelle).join(', ')} et ${libelle(enTete.at(-1)!)}`
    : enTete[0]
      ? libelle(enTete[0])
      : '';

const titre =
  pasPoids !== null
    ? `Une tranche de ${pasPoids}\u00a0kg suffit à situer une performance`
    : 'Une tranche suffit à situer une performance';
---

<Infographie
  titre={titre}
  source={`Résultats de compétition de La Réunion depuis ${annee(periode().debut)}. Tranches prévues pour le classement communauté.`}
>
  <div class="comparatif">
    {/* Les têtes de colonne sont visuelles. Chaque cellule répète son
        classement en texte masqué, pour qu'un lecteur d'écran sache toujours
        de quelle colonne il lit la valeur. */}
    <p class="tetes" aria-hidden="true">
      <span class="tete">
        <Icone nom="classement" />
        Officiel
      </span>
      <span class="tete">
        <Icone nom="communaute" />
        Communauté
        <span class="statut">En préparation</span>
      </span>
    </p>

    <dl class="lignes">
      <div class="ligne">
        <dt>Usage</dt>
        <dd>
          <span class="sr-only">Officiel :</span>
          <p class="mode">La référence pour les records de l'île</p>
        </dd>
        <dd>
          <span class="sr-only">Communauté, en préparation :</span>
          <p class="mode">Ouvert à ceux qui s'entraînent hors compétition</p>
        </dd>
      </div>

      <div class="ligne">
        <dt>Poids de corps</dt>
        <dd>
          <span class="sr-only">Officiel :</span>
          <p class="mode">Pesé le jour de la compétition</p>
          <p class="chiffre">
            <span class="num">{nombre(poidsDifferents)}</span>{' '}
            {pluriel(poidsDifferents, 'valeur différente', 'valeurs différentes')} sur l'île, de{' '}
            {nombre(plusLeger, 2)} à {nombre(plusLourd, 2)}&nbsp;kg
          </p>
        </dd>
        <dd>
          <span class="sr-only">Communauté :</span>
          <p class="mode">Déclaré par tranche</p>
          <p class="chiffre">
            <span class="num">{COMMUNITY_WEIGHT_BRACKETS.length}</span>{' '}
            {pluriel(COMMUNITY_WEIGHT_BRACKETS.length, 'tranche')},{' '}
            {etendue(COMMUNITY_WEIGHT_BRACKETS)}
          </p>
        </dd>
      </div>

      <div class="ligne">
        <dt>Taille</dt>
        <dd>
          <span class="sr-only">Officiel :</span>
          <p class="mode">Absente des résultats</p>
        </dd>
        <dd>
          <span class="sr-only">Communauté :</span>
          <p class="mode">Déclarée par tranche</p>
          <p class="chiffre">
            <span class="num">{COMMUNITY_HEIGHT_BRACKETS.length}</span>{' '}
            {pluriel(COMMUNITY_HEIGHT_BRACKETS.length, 'tranche')},{' '}
            {etendue(COMMUNITY_HEIGHT_BRACKETS)}
          </p>
        </dd>
      </div>
    </dl>
  </div>

  <div class="repartition">
    <p class="intitule" id="communaute-repartition">
      Les {nombre(poids.length)} résultats de l'île par tranche de poids de corps, hommes et
      femmes confondus
    </p>
    <ol
      class="colonnes"
      aria-labelledby="communaute-repartition"
      style={`--colonnes:${colonnes.length}`}
    >
      {
        colonnes.map((c) => (
          <li
            data-en-tete={enTete.includes(c) ? '' : undefined}
            style={`--part:${plusGrand > 0 ? c.resultats / plusGrand : 0}`}
          >
            <span class="sr-only">{`${libelle(c)} :`}</span>
            <span class="valeur num-tab">{nombre(c.resultats)}</span>
            <span class="sr-only">{` ${pluriel(c.resultats, 'résultat')}`}</span>
            <span class="barre" aria-hidden="true" />
          </li>
        ))
      }
    </ol>
    {/* Les graduations tombent sur les bornes, entre deux colonnes : la
        première colonne n'a pas de borne basse à afficher. */}
    <p class="axe" aria-hidden="true" style={`--colonnes:${colonnes.length}`}>
      {colonnes.map((c, i) => <span>{i > 0 && c.min !== null && <span>{c.min}</span>}</span>)}
    </p>
    <p class="unite-axe" aria-hidden="true">Poids de corps, en kg</p>

    {
      enTete.length > 0 && (
        <p class="bilan">
          {enTete.length > 1 ? 'Tranches les plus fréquentes' : 'Tranche la plus fréquente'} :{' '}
          <strong>{tranchesEnTete}</strong>, avec{' '}
          <strong class="num-tab">{nombre(plusGrand)}</strong>{' '}
          {pluriel(plusGrand, 'résultat')}
          {enTete.length > 1 && ' chacune'}.
        </p>
      )
    }
    {
      sansPoids > 0 && (
        <p class="note">
          {nombre(sansPoids)}{' '}
          {pluriel(sansPoids, 'résultat ne porte', 'résultats ne portent')} aucun poids de corps.
        </p>
      )
    }
  </div>
</Infographie>

<style>
  p {
    margin: 0;
  }

  /*
   * LE COMPARATIF. Deux colonnes, l'officiel à gauche, la communauté à droite,
   * gardées sur téléphone : c'est la mise en regard qui fait la comparaison.
   * L'intitulé de chaque ligne court au-dessus des deux cellules.
   */
  .comparatif {
    padding: var(--space-4);
    border: 2px solid var(--border);
    border-radius: var(--radius);
    background: var(--bg);
  }

  .tetes,
  .ligne {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    column-gap: var(--space-6);
  }

  /* Les deux têtes s'alignent par le haut : la seconde porte le statut sur
     une ligne de plus, sans faire descendre la première. */
  .tetes {
    align-items: start;
  }

  .tete {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-1) var(--space-2);
    min-width: 0;
    padding-bottom: var(--space-2);
    font-family: var(--font-display);
    font-size: var(--step-1);
    font-weight: 800;
    line-height: 1.1;
  }

  /* Sur téléphone, une colonne mesure 133 px. « Communauté » et son icône n'y
     tiennent sur une ligne qu'au corps du texte courant. */
  @media (max-width: 40rem) {
    .comparatif {
      padding: var(--space-3);
    }
    .tetes,
    .ligne {
      column-gap: var(--space-3);
    }
    .tete {
      font-size: var(--step-0);
      column-gap: var(--space-1);
    }
  }

  /* À 320 px, la colonne tombe à 106 px pour un mot de 108 : le cadre et
     l'écart se resserrent pour le loger. */
  @media (max-width: 22.5rem) {
    .comparatif {
      padding: var(--space-2);
    }
    .tetes,
    .ligne {
      column-gap: var(--space-2);
    }
  }

  /* Le statut se range à côté du nom, et passe dessous s'il manque de place. */
  .statut {
    padding: 0 var(--space-2);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    font-family: var(--font-body);
    font-size: var(--step--1);
    font-weight: 600;
    line-height: 1.5;
    color: var(--muted);
    white-space: nowrap;
  }

  .lignes {
    margin: 0;
  }

  .ligne {
    row-gap: var(--space-1);
    padding-top: var(--space-3);
    margin-top: var(--space-3);
    border-top: 1px solid var(--border);
  }

  dt {
    grid-column: 1 / -1;
    font-size: var(--step--1);
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--muted);
  }

  dd {
    min-width: 0;
    margin: 0;
  }

  .mode {
    font-weight: 700;
    line-height: 1.3;
  }

  .chiffre {
    margin-top: var(--space-1);
    font-size: var(--step--1);
    color: var(--muted);
  }
  .chiffre .num {
    font-size: var(--step-2);
    line-height: 1;
    color: var(--text);
  }

  /* LA RÉPARTITION. Une colonne par tranche, dans l'ordre des poids. Le texte
     vient avant la barre dans le document : tranche, puis effectif. */
  .repartition {
    margin-top: var(--space-8);
  }

  .intitule {
    margin-bottom: var(--space-3);
    font-size: var(--step--1);
    font-weight: 700;
  }

  .colonnes,
  .axe {
    display: grid;
    grid-template-columns: repeat(var(--colonnes), minmax(0, 1fr));
    gap: var(--space-1);
  }

  .colonnes {
    align-items: end;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .colonnes li {
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    gap: var(--space-1);
    min-width: 0;
    text-align: center;
  }

  .valeur {
    font-size: var(--step--1);
    color: var(--muted);
  }

  /* Le gris des colonnes secondaires est mêlé au fond, comme dans
     l'infographie des points Dots : le gris de texte seul pèserait autant que
     l'accent en thème sombre. Une tranche vide garde un filet visible. */
  .barre {
    height: calc(var(--part) * 5rem);
    min-height: 2px;
    border-radius: 2px 2px 0 0;
    background: color-mix(in srgb, var(--muted) 55%, var(--surface));
  }

  /* La tranche la plus fréquente ressort en aplat accentué. La phrase du
     bilan la nomme : la couleur ne porte pas l'information seule. */
  [data-en-tete] .barre {
    background: var(--accent-fill);
  }
  [data-en-tete] .valeur {
    color: var(--text);
    font-weight: 800;
  }

  /* L'AXE. Un filet sous les colonnes, et chaque borne centrée sur l'espace
     qui sépare deux colonnes. */
  .axe {
    border-top: 2px solid var(--border);
    padding-top: var(--space-1);
    font-size: var(--step--1);
    color: var(--muted);
  }
  .axe > span {
    position: relative;
    min-width: 0;
    min-height: 1.25rem;
  }
  .axe > span > span {
    position: absolute;
    left: calc(var(--space-1) / -2);
    transform: translateX(-50%);
    white-space: nowrap;
  }

  .unite-axe {
    margin-top: var(--space-1);
    font-size: var(--step--1);
    color: var(--muted);
    text-align: center;
  }

  .bilan {
    margin-top: var(--space-6);
    padding-top: var(--space-4);
    border-top: 1px solid var(--border);
  }

  .note {
    margin-top: var(--space-2);
    font-size: var(--step--1);
    color: var(--muted);
  }
</style>

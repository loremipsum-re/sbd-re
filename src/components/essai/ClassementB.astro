---
/**
 * ESSAI B, deuxième version — la carte hiérarchisée et alignée.
 *
 * CE QUI A CHANGÉ DEPUIS LA PREMIÈRE VERSION, et pourquoi.
 *
 * 1. LA COMPÉTITION DEVIENT UN BLOC À PART ENTIÈRE. Le nom, la commune et la
 *    date forment un seul lien vers la compétition : le lieu appartient à
 *    l'événement, pas à l'athlète. Ils vivaient avant en miettes, la date
 *    perdue en fin de ligne et la commune nulle part.
 *
 * 2. LA DATE AFFICHÉE EST CELLE DU TOTAL. C'était un vrai défaut : la carte
 *    montrait la date du meilleur DOTS à la suite du meilleur TOTAL, or les
 *    deux viennent de compétitions différentes pour 21 athlètes sur 312.
 *    Quand c'est le cas, le score Dots devient lui-même un lien vers SA
 *    compétition, signalé par un soulignement pointillé.
 *
 * 3. TROIS NIVEAUX DE LECTURE au lieu d'un seul. Mesuré sur la version
 *    précédente : Dots, date et étiquettes étaient tous à 14 px et au même
 *    contraste, et le rang était aussi gros que le total. Désormais le total
 *    domine seul, la compétition et les Dots forment le deuxième niveau, le
 *    contexte le troisième. Le rang redevient un repère discret.
 *
 * 4. DES COLONNES DE LARGEUR FIXE. Chaque ligne était une grille autonome,
 *    donc les blocs ne commençaient pas à la même abscisse d'une ligne à
 *    l'autre. Les quatre colonnes sont désormais identiques partout.
 *
 * 5. LES ÉTIQUETTES PERDENT LEUR FILET, mesuré à 1,37:1 contre le fond, donc
 *    invisible. Un aplat franc le remplace, ce qui est aussi plus proche du
 *    système Modernist que le filet fantôme.
 *
 * Deux informations quittent la liste : la tranche d'âge et le nombre de
 * compétitions. Elles décrivent l'athlète, pas la performance classée, et la
 * fiche les porte déjà. Les filtres, eux, les gardent.
 *
 * 6. LA COUPE DISPARAÎT DE LA LISTE, remplacée par le rang écrit en chiffres.
 *    Deux raisons mesurées.
 *
 *    Elle disait deux choses à la fois. Ailleurs sur le site, la coupe pleine
 *    signale un RECORD EN COURS : sur /records/, sur les fiches, dans les
 *    résultats de compétition. Ici elle signalait un PODIUM. Le même dessin
 *    pour deux notions, c'est une de trop.
 *
 *    Et surtout le podium devenait faux dès qu'on triait autrement : trier par
 *    poids de corps décernait la coupe d'or à l'athlète le plus léger. Un
 *    numéro, lui, reste vrai dans tous les cas, puisqu'il ne dit rien d'autre
 *    que le rang dans l'affichage courant.
 *
 *    La coupe garde donc un seul sens sur le site, le record en cours, et la
 *    médaille garde le sien, une place obtenue en compétition.
 */
import { equipmentLabel, parseWeightClass } from '../../lib/categories';
import { dateCourte, nombre, points } from '../../lib/format';
import type { AthleteRanking } from '../../lib/rankings';
import { meetPath } from '../../lib/slug';
import BadgeOfficiel from '../BadgeOfficiel.astro';

/**
 * QUATRE PRÉSENTATIONS, UN SEUL COMPOSANT.
 *
 * Le balisage, les attributs `data-` et le contrat de tri sont rigoureusement
 * identiques d'une présentation à l'autre : seule la feuille de style change.
 * C'est la seule façon de comparer honnêtement quatre mises en forme, et cela
 * évite de maintenir quatre copies qui divergeraient dès la première retouche.
 *
 *   standard — la version que tu as retenue, quatre colonnes alignées.
 *   compact  — la même, ramenée à une seule ligne par athlète sur grand écran.
 *   barres   — la même, avec une barre proportionnelle au meilleur total.
 *   aere     — la même, avec de l'air et des chiffres beaucoup plus grands.
 */
type Presentation = 'standard' | 'compact' | 'barres' | 'aere';

interface Props {
  entries: AthleteRanking[];
  id?: string;
  presentation?: Presentation;
}

const { entries, id, presentation = 'standard' } = Astro.props;

/*
 * Référence des barres : le meilleur total de la liste affichée. Calculé et
 * non codé en dur, la page des catégories passant des sous-ensembles.
 */
const meilleurTotal = Math.max(...entries.map((e) => e.totalKg), 1);
---

<div class={`cadre p-${presentation}`}>
  <table id={id} data-tableau>
    <thead class="sr-only">
      <tr>
        <th scope="col">Rang à La Réunion</th>
        <th scope="col" data-tri data-cle="nom">Nom</th>
        <th scope="col" data-tri data-cle="total" data-type="nombre">Total</th>
        <th scope="col" data-tri data-cle="dots" data-type="nombre">Dots</th>
        <th scope="col" data-tri data-cle="triCategorie" data-type="nombre">Catégorie</th>
        <th scope="col" data-tri data-cle="poids" data-type="nombre">Poids de corps</th>
        <th scope="col" data-tri data-cle="competitions" data-type="nombre">Compétitions</th>
      </tr>
    </thead>
    <tbody>
      {
        entries.map((e, i) => {
          const classe = parseWeightClass(e.weightClassKg);
          const comps = e.competitions + e.competitionsExterieur;
          const memeCompetition = e.date === e.dotsDate && e.meetName === e.dotsMeetName;
          return (
            <tr
              data-recherche={e.name}
              data-nom={e.name}
              data-total={e.totalKg}
              data-dots={e.dots}
              data-tri-categorie={classe?.kg ?? ''}
              data-poids={e.bodyweightKg ?? ''}
              data-competitions={comps}
              data-sexe={e.sex}
              data-categorie={e.weightClassKg}
              data-equipement={e.equipmentGroup}
              data-division={e.division}
              data-age={e.ageClass}
            >
              <td class="rang">
                <span class="rang-num">{i + 1}</span>
              </td>

              <th scope="row" class="nom">
                <a href={`/athlete/${e.slug}/`}>{e.name}</a>
                <BadgeOfficiel taille={14} />
              </th>

              <td class="contexte">
                <span class="etiquette">{equipmentLabel(e.equipmentGroup)}</span>
                <span class="etiquette">{e.weightClassKg ? `${e.weightClassKg} kg` : 'cat. inconnue'}</span>
                <span class="etiquette">{nombre(e.bodyweightKg)} kg de corps</span>
              </td>

              {/* Le lieu et la date appartiennent à la compétition : un seul lien. */}
              <td class="competition">
                <a href={`/competitions/${meetPath(e.date, e.meetName)}/`}>
                  <span class="meet">{e.meetName}</span>
                  <span class="ou">
                    {e.meetTown}
                    {' · '}
                    {dateCourte(e.date)}
                  </span>
                </a>
              </td>

              {/*
                Barre de comparaison, affichée par la seule présentation
                « barres ». Décorative : le total est écrit juste à côté, donc
                elle n'apporte rien à qui écoute la page.
              */}
              <td class="barre" aria-hidden="true">
                <span style={`width: ${((e.totalKg / meilleurTotal) * 100).toFixed(1)}%`}></span>
              </td>

              <td class="chiffres">
                <span class="total">
                  <span class="valeur num-tab">{nombre(e.totalKg)}</span>
                  <span class="unite">kg</span>
                </span>
                {
                  memeCompetition ? (
                    <span class="dots">
                      <span class="num-tab">{points(e.dots)}</span>
                      <span class="unite">Dots</span>
                    </span>
                  ) : (
                    <a
                      class="dots ailleurs"
                      href={`/competitions/${meetPath(e.dotsDate, e.dotsMeetName)}/`}
                      title={`Meilleurs Dots obtenus à ${e.dotsMeetName}, ${e.dotsMeetTown}, le ${dateCourte(e.dotsDate)}`}
                    >
                      <span class="num-tab">{points(e.dots)}</span>
                      <span class="unite">Dots</span>
                    </a>
                  )
                }
              </td>
            </tr>
          );
        })
      }
    </tbody>
  </table>
</div>

<style>
  .cadre {
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: var(--surface);
    overflow: hidden;
  }

  table {
    width: 100%;
    border-collapse: collapse;
  }

  td,
  th {
    padding: 0;
    text-align: left;
  }

  /* =====================================================================
     TÉLÉPHONE : trois lignes empilées, le total tenu à droite.
     ===================================================================== */
  tbody tr {
    display: grid;
    grid-template-columns: 2.5rem minmax(min(8rem, 100%), 1fr) auto;
    /* Le nom occupe sa propre ligne : partagée avec le total, il passait à la
       ligne pour 48 athlètes sur 80, ce qui coûtait plus de hauteur que le
       gain espéré. Le total descend d'un cran et garde sa taille. */
    grid-template-areas:
      'rang nom nom'
      'rang contexte chiffres'
      'rang competition competition';
    align-items: start;
    gap: var(--space-1) var(--space-3);
    padding: var(--space-3) var(--space-4);
    border-bottom: 1px solid var(--border);
  }
  tbody tr:last-child {
    border-bottom: 0;
  }

  /* Un rang sur deux légèrement teinté : sur une liste de plusieurs centaines
     de lignes, c'est ce qui empêche l'œil de sauter d'une ligne à l'autre. */
  tbody tr:nth-child(even) {
    background: color-mix(in srgb, var(--text) 3%, transparent);
  }
  tbody tr:hover {
    background: color-mix(in srgb, var(--accent) 7%, transparent);
  }

  /* ---------- Rang : un nombre, et rien d'autre ----------
     Ni coupe, ni métal, ni seuil à 50 : le rang dit la position dans
     l'affichage courant, ce qui reste vrai quel que soit le tri. Le script
     de tri le réécrit dans `.rang-num`, comme le veut le contrat des
     tableaux interactifs. */
  .rang {
    grid-area: rang;
    align-self: start;
    padding-top: 0.2em;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--step-0);
    line-height: 1.3;
    color: var(--muted);
    font-variant-numeric: tabular-nums;
  }

  /* ---------- Premier niveau : le nom et le total ---------- */
  .nom {
    grid-area: nom;
    min-width: 0;
    display: flex;
    align-items: center;
    /* Le nom et sa coche doivent pouvoir passer à la ligne ensemble : sans
       cela, un nom long déborde de 13 px de sa colonne sur un téléphone.
       Mesuré par élément, le débordement de page ne le montrait pas. */
    flex-wrap: wrap;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--step-1);
    line-height: 1.15;
  }
  .nom a {
    min-width: 0;
    overflow-wrap: break-word;
  }
  .nom a {
    color: var(--text);
  }
  .nom a:hover {
    color: var(--accent);
  }

  /* La barre n'existe que pour la présentation « barres ». Ailleurs, elle
     reste dans le document sans occuper un pixel. */
  .barre {
    grid-area: barre;
    display: none;
  }

  /* Au téléphone, total et Dots tiennent sur une ligne : empilés, ils
     imposaient leur hauteur à la ligne entière, 46 px contre 26 au nom. */
  .chiffres {
    grid-area: chiffres;
    display: flex;
    flex-direction: row;
    align-items: baseline;
    justify-content: end;
    gap: var(--space-2);
    text-align: right;
    white-space: nowrap;
  }
  .total {
    display: flex;
    align-items: baseline;
    gap: 0.25rem;
    font-size: var(--step-2);
    line-height: 1;
    color: var(--text);
  }
  /* L'unité passe au second plan : ce sont les chiffres qui se comparent, et
     « kg » répété trois cent fois n'apporte rien à la comparaison. */
  .unite {
    font-size: var(--step--1);
    font-weight: 400;
    color: var(--muted);
  }
  .dots {
    display: flex;
    align-items: baseline;
    gap: 0.25rem;
    font-size: var(--step-0);
    color: var(--muted);
  }
  /* Le pointillé signale que ce score vient d'une AUTRE compétition, et que le
     lien n'y mène donc pas au même endroit que celui de la ligne. */
  .dots.ailleurs {
    color: var(--muted);
    text-decoration: underline dotted;
    text-underline-offset: 0.2em;
  }
  .dots.ailleurs:hover {
    color: var(--accent);
  }

  /* ---------- Deuxième niveau : la compétition ---------- */
  .competition {
    grid-area: competition;
    min-width: 0;
  }
  .competition a {
    display: flex;
    flex-direction: column;
    gap: 0;
    color: var(--text);
    text-decoration: none;
  }
  .competition a:hover .meet {
    color: var(--accent);
    text-decoration: underline;
  }
  .meet {
    font-size: var(--step--1);
    line-height: 1.25;
  }
  .ou {
    font-size: var(--step--1);
    line-height: 1.25;
    color: var(--muted);
    white-space: nowrap;
  }

  /* ---------- Troisième niveau : le contexte ---------- */
  .contexte {
    grid-area: contexte;
    min-width: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-2);
  }
  /*
   * Même pastille que sur la fiche d'athlète : filet, angles ronds, gris.
   * L'aplat que j'avais essayé d'abord tombait à 4,36:1 en thème CLAIR une
   * fois posé sur une ligne zébrée, sous le seuil de 4,5. Sans fond, le texte
   * se lit sur la ligne elle-même, soit 5,38:1 en clair et 7,58:1 en sombre.
   * Et le site gagne une forme de moins à retenir.
   */
  /* Sur un téléphone, le poids de corps sort de la liste : trois pastilles
     passent à la ligne et coûtent 26 px à chaque athlète. Il reste dans le
     document pour le tri et les filtres, et sur la fiche. */
  .etiquette:nth-of-type(3) {
    display: none;
  }

  .etiquette {
    padding: var(--space-1) var(--space-3);
    border: 1px solid var(--border);
    border-radius: 999px;
    font-size: var(--step--1);
    font-weight: 600;
    color: var(--muted);
    white-space: nowrap;
  }

  /* Dès qu'il y a la place, le poids de corps revient : il éclaire le Dots. */
  @media (min-width: 40rem) {
    .etiquette:nth-of-type(3) {
      display: inline;
    }
  }

  /* =====================================================================
     À PARTIR DE 60rem : quatre colonnes identiques d'une ligne à l'autre.
     ===================================================================== */
  @media (min-width: 60rem) {
    tbody tr {
      grid-template-columns:
        3rem
        minmax(min(14rem, 100%), 1.1fr)
        minmax(min(12rem, 100%), 1fr)
        8.5rem;
      grid-template-areas:
        'rang nom competition chiffres'
        'rang contexte competition chiffres';
      gap: var(--space-1) var(--space-6);
      padding: var(--space-3) var(--space-6);
    }
    /* Le rang reste sous le nom : c'est un repère de position, pas une
       performance. Mesuré à égalité avec le nom dans la version précédente. */
    .rang {
      font-size: var(--step-0);
      padding-top: 0.35em;
    }
    .competition {
      align-self: center;
    }
    /* Sur grand écran, la colonne est assez large pour empiler : le total
       reprend sa ligne, les Dots la leur, et les deux s'alignent à droite. */
    .chiffres {
      flex-direction: column;
      align-items: end;
      gap: 0.15rem;
      align-self: center;
    }
  }

  /* =====================================================================
     PRÉSENTATION « COMPACT » — une seule ligne par athlète.

     Pour qui parcourt la liste de haut en bas et cherche un nom ou un rang.
     Tout tient sur une ligne au-delà de 60rem, sans rien retirer sauf le
     poids de corps, qui est la valeur la moins regardée des trois étiquettes.
     Sous 60rem, la présentation standard reprend la main : une ligne unique
     sur un téléphone reviendrait à tronquer, ce que le projet s'interdit.
     ===================================================================== */
  @media (min-width: 60rem) {
    .p-compact tbody tr {
      /* La colonne des étiquettes est FIXE et non `auto` : en automatique,
         elle prenait la largeur de son contenu, si bien que la compétition
         démarrait à cinq abscisses différentes selon la ligne. Mesuré. */
      grid-template-columns:
        2.75rem
        minmax(min(11rem, 100%), 1.1fr)
        10rem
        minmax(min(11rem, 100%), 1fr)
        12rem;
      grid-template-areas: 'rang nom contexte competition chiffres';
      align-items: center;
      gap: 0 var(--space-4);
      padding: var(--space-2) var(--space-6);
    }
    .p-compact .rang {
      align-self: center;
      padding-top: 0;
    }
    .p-compact .nom {
      font-size: var(--step-0);
    }
    .p-compact .contexte {
      flex-wrap: nowrap;
    }
    .p-compact .etiquette:nth-of-type(3) {
      display: none;
    }
    .p-compact .competition a {
      flex-direction: row;
      flex-wrap: wrap;
      align-items: baseline;
      gap: 0 var(--space-2);
    }
    .p-compact .chiffres {
      flex-direction: row;
      align-items: baseline;
      justify-content: end;
      gap: var(--space-3);
    }
    .p-compact .total {
      font-size: var(--step-1);
    }
  }

  /* =====================================================================
     PRÉSENTATION « BARRES » — le classement se voit, au lieu de se lire.

     Une barre proportionnelle au meilleur total de la liste. C'est ce qui
     manque le plus à une liste de nombres : l'ÉCART. Entre le 4e et le 12e,
     l'œil ne mesure rien sur « 720 » contre « 660 », alors qu'il voit tout
     de suite deux barres de longueurs différentes.

     La barre part de la droite, contre les chiffres : le regard descend le
     long d'un bord commun plutôt que de suivre des longueurs flottantes.
     ===================================================================== */
  .p-barres tbody tr {
    grid-template-areas:
      'rang nom nom'
      'rang contexte chiffres'
      'rang competition competition'
      'rang barre barre';
  }
  .p-barres .barre {
    display: flex;
    justify-content: flex-end;
    align-self: center;
    height: 0.4rem;
    /* La piste montre le 100 %, sans quoi une barre courte ne se compare à
       rien. Teinte franche et angles nets, comme le reste du système. */
    background: color-mix(in srgb, var(--text) 8%, transparent);
  }
  .p-barres .barre span {
    display: block;
    height: 100%;
    background: color-mix(in srgb, var(--accent) 60%, transparent);
  }

  @media (min-width: 60rem) {
    .p-barres tbody tr {
      grid-template-columns:
        3rem
        minmax(min(13rem, 100%), 1.1fr)
        minmax(min(10rem, 100%), 0.9fr)
        7rem
        8.5rem;
      grid-template-areas:
        'rang nom competition barre chiffres'
        'rang contexte competition barre chiffres';
    }
  }

  /* =====================================================================
     PRÉSENTATION « AÉRÉE » — la liste comme une page de magazine.

     Des chiffres qui se voient de loin, du blanc entre les lignes, et la
     zébrure retirée : l'espace suffit alors à séparer deux athlètes. Coûte
     du défilement, gagne en présence. À juger sur la page d'accueil autant
     que sur le classement complet.
     ===================================================================== */
  .p-aere tbody tr:nth-child(even) {
    background: transparent;
  }

  @media (min-width: 60rem) {
    .p-aere tbody tr {
      grid-template-columns:
        3.5rem
        minmax(min(14rem, 100%), 1.1fr)
        minmax(min(12rem, 100%), 1fr)
        11rem;
      gap: var(--space-2) var(--space-6);
      padding: var(--space-6);
    }
    .p-aere .rang {
      font-size: var(--step-1);
    }
    .p-aere .nom {
      font-size: var(--step-2);
    }
    .p-aere .meet {
      font-size: var(--step-0);
    }
    .p-aere .total {
      font-size: var(--step-3);
    }
    .p-aere .dots {
      font-size: var(--step-1);
    }
  }
</style>

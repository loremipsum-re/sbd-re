---
/**
 * Pictogramme de vérification, apposé sur une performance qui constitue
 * actuellement un record.
 *
 * Il ne certifie pas l'athlète, mais la performance : cette barre est la
 * meilleure jamais réalisée dans sa catégorie lors d'une compétition
 * réunionnaise. Le libellé accessible le dit explicitement, pour éviter toute
 * lecture en « compte vérifié » à la manière des réseaux sociaux.
 *
 * C'est la seule couleur du site en dehors de l'orange. Elle se justifie par
 * son rôle de pictogramme conventionnel, et n'apparaît nulle part ailleurs.
 */

interface Props {
  /** Précision reprise dans l'infobulle et le libellé pour lecteur d'écran. */
  detail?: string;
  taille?: number;
}

const { detail = 'Record de la catégorie', taille = 16 } = Astro.props;
---

<span class="badge" title={detail}>
  <svg
    width={taille}
    height={taille}
    viewBox="0 0 24 24"
    aria-hidden="true"
    focusable="false"
  >
    <path
      class="etoile"
      d="M12 1.5l2.4 2.1 3.2-.3.9 3.1 2.7 1.8-1.3 2.9 1.3 2.9-2.7 1.8-.9 3.1-3.2-.3L12 22.5l-2.4-2.1-3.2.3-.9-3.1-2.7-1.8 1.3-2.9-1.3-2.9 2.7-1.8.9-3.1 3.2.3z"
    ></path>
    <path
      class="coche"
      d="M8 12.2l2.6 2.6L16.2 9"
      fill="none"
      stroke-width="2.4"
      stroke-linecap="round"
      stroke-linejoin="round"></path>
  </svg>
  <span class="sr-only">{detail}</span>
</span>

<style>
  .badge {
    display: inline-flex;
    vertical-align: -0.18em;
    margin-left: 0.3em;
  }

  .etoile {
    fill: var(--verified);
  }

  /* La coche reprend la couleur du fond de la carte pour se découper
     proprement, quel que soit le thème actif. */
  .coche {
    stroke: var(--surface);
  }
</style>

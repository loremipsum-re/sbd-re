---
/**
 * Coche signalant un compétiteur officiel, dont les performances proviennent
 * d'une compétition homologuée.
 *
 * Forme festonnée à douze lobes, dans la famille visuelle des badges de
 * certification. Le tracé est dessiné ici et non repris de Twitter : leur
 * glyphe est une marque déposée, et l'afficher laisserait entendre que la
 * vérification vient d'eux.
 *
 * La coche est un VRAI trou dans la pastille, obtenu par un masque SVG, et non
 * un trait posé par-dessus. Le fond de la page transparaît donc à travers, ce
 * qui fonctionne aussi bien sur une carte que sur le fond de page, en thème
 * clair comme en thème sombre.
 *
 * La couleur est celle du texte qu'elle accompagne (`currentColor`). Un blanc
 * fixe disparaîtrait purement et simplement sur le thème clair, où les cartes
 * sont blanches.
 */

interface Props {
  taille?: number;
  detail?: string;
}

const { taille = 15, detail = 'Compétiteur officiel' } = Astro.props;

/*
 * Identifiant unique par instance : le badge apparaît jusqu'à 266 fois sur une
 * même page, et deux masques partageant un `id` produiraient un document
 * invalide, avec un rendu imprévisible selon les navigateurs.
 */
const idMasque = `coche-${Math.random().toString(36).slice(2, 9)}`;

/*
 * Douze lobes répartis sur un cercle de rayon 9, centrés en (12, 12), reliés
 * par des arcs qui bombent vers l'extérieur. Rayon d'arc 2,33 : la moitié de
 * la corde entre deux sommets, ce qui donne des lobes exactement
 * semi-circulaires.
 */
const SOMMETS = Array.from({ length: 12 }, (_, k) => {
  const angle = (-90 + k * 30) * (Math.PI / 180);
  return [12 + 9 * Math.cos(angle), 12 + 9 * Math.sin(angle)] as const;
});

const feston =
  `M ${SOMMETS[0][0].toFixed(2)} ${SOMMETS[0][1].toFixed(2)} ` +
  SOMMETS.slice(1)
    .concat([SOMMETS[0]])
    .map(([x, y]) => `A 2.33 2.33 0 0 1 ${x.toFixed(2)} ${y.toFixed(2)}`)
    .join(' ') +
  ' Z';
---

<span class="badge" title={detail}>
  <svg width={taille} height={taille} viewBox="0 0 24 24" aria-hidden="true" focusable="false">
    <mask id={idMasque}>
      {/* Blanc : ce qui reste visible. Noir : ce qui est évidé. */}
      <rect width="24" height="24" fill="white"></rect>
      <path
        d="M7.6 12.2 L10.5 15.1 L16.5 8.5"
        fill="none"
        stroke="black"
        stroke-width="2.4"
        stroke-linecap="round"
        stroke-linejoin="round"></path>
    </mask>
    <path d={feston} fill="currentColor" mask={`url(#${idMasque})`}></path>
  </svg>
  <span class="sr-only">{detail}</span>
</span>

<style>
  .badge {
    display: inline-flex;
    vertical-align: -0.15em;
    margin-left: 0.35em;
  }
</style>

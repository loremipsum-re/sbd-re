---
/**
 * Classement des athlètes, en cartes de quatre lignes.
 *
 *   🏆  Gabriel Begue ✓
 *       Raw • 9 comp. locales • 20 hors département
 *       93 kg • 91,3 kg • 24-34 ans
 *       782,5 kg • 502,4 Dots • 17/12/2022
 *
 * Le balisage reste un <table>, et l'en-tête existe toujours : simplement,
 * il n'est visible que des lecteurs d'écran. Ce sont des données tabulaires,
 * et les transformer en <div> ferait perdre le lien entre une valeur et son
 * intitulé pour qui navigue à l'oreille.
 *
 * Conséquence directe de cet affichage : les valeurs de tri vivent sur la
 * LIGNE, dans des attributs `data-`, et non plus dans les cellules. Trois
 * valeurs cohabitent par ligne, l'index de colonne ne veut donc plus rien dire.
 * Les en-têtes portent `data-cle` pour indiquer où lire.
 */
import { equipmentLabel, parseWeightClass } from '../lib/categories';
import { dateCourte, kg, nombre, points } from '../lib/format';
import type { AthleteRanking } from '../lib/rankings';
import { meetPath } from '../lib/slug';
import BadgeOfficiel from './BadgeOfficiel.astro';
import Coupe from './Coupe.astro';
import EtatVide from './EtatVide.astro';

interface Props {
  entries: AthleteRanking[];
  id?: string;
}

const { entries, id } = Astro.props;
const METAUX = ['or', 'argent', 'bronze'] as const;
---

<div class="cadre">
  <table id={id} data-tableau>
    <thead class="sr-only">
      <tr>
        <th scope="col" data-tri data-cle="nom">Nom</th>
        <th scope="col" data-tri data-cle="total" data-type="nombre">Total</th>
        <th scope="col" data-tri data-cle="dots" data-type="nombre">Dots</th>
        {/*
          `triCategorie` et non `categorie` : le filtre par catégorie lit déjà
          `data-categorie`, qui porte la valeur brute (« 120+ »). Le tri, lui,
          a besoin de la borne numérique. Deux usages, deux attributs.
        */}
        <th scope="col" data-tri data-cle="triCategorie" data-type="nombre">Catégorie</th>
        <th scope="col" data-tri data-cle="poids" data-type="nombre">Poids de corps</th>
        <th scope="col" data-tri data-cle="competitions" data-type="nombre">Compétitions</th>
      </tr>
    </thead>
    <tbody>
      {
        entries.map((e, i) => {
          const classe = parseWeightClass(e.weightClassKg);
          return (
            <tr
              data-recherche={e.name}
              data-nom={e.name}
              data-total={e.totalKg}
              data-dots={e.dots}
              data-tri-categorie={classe?.kg ?? ''}
              data-poids={e.bodyweightKg ?? ''}
              data-competitions={e.competitions + e.competitionsExterieur}
              data-sexe={e.sex}
              data-categorie={e.weightClassKg}
              data-equipement={e.equipmentGroup}
              data-division={e.division}
              data-age={e.ageClass}
            >
              <td
                class="rang"
                data-podium={i < 3 ? METAUX[i] : undefined}
                data-niveau={i < 50 ? 'haut' : 'bas'}
              >
                <span class="rang-num">{i + 1}</span>
                <Coupe detail={`${i + 1}e du classement`} taille={26} />
              </td>

              <th scope="row" class="nom">
                <a href={`/athlete/${e.slug}/`}>{e.name}</a>
                <BadgeOfficiel taille={14} />
              </th>

              <td class="ligne contexte">
                <span>{equipmentLabel(e.equipmentGroup)}</span>
                <span>
                  {e.competitions} comp. locale{e.competitions > 1 ? 's' : ''}
                </span>
                <span>
                  {e.competitionsExterieur} hors département
                </span>
              </td>

              <td class="ligne physique">
                <span>{e.weightClassKg ? `${e.weightClassKg} kg` : 'catégorie inconnue'}</span>
                <span>{nombre(e.bodyweightKg)} kg</span>
                <span>{e.ageClass ? `${e.ageClass} ans` : 'âge inconnu'}</span>
              </td>

              <td class="ligne perf">
                <span class="fort num-tab">{kg(e.totalKg)}</span>
                <span class="fort num-tab">{points(e.dots)} Dots</span>
                <a href={`/competitions/${meetPath(e.dotsDate, e.dotsMeetName)}/`}>
                  {dateCourte(e.dotsDate)}
                </a>
              </td>
            </tr>
          );
        })
      }
    </tbody>
  </table>

  {
    /*
     * Sans cadre : le bloc s'affiche déjà dans `.cadre`, et deux bordures
     * emboîtées de même rayon divergeraient à l'œil.
     */
    entries.length === 0 && (
      <EtatVide titre="Aucun athlète dans cette catégorie" encadre={false}>
        Elle attend son premier résultat. Le classement se régénère chaque mois
        depuis OpenPowerlifting.
      </EtatVide>
    )
  }
</div>

<style>
  .cadre {
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: var(--surface);
    overflow: hidden;
  }

  table {
    width: 100%;
    border-collapse: collapse;
  }

  /* ---------- La carte ---------- */
  tbody tr {
    display: grid;
    grid-template-columns: 3.25rem 1fr;
    grid-template-areas:
      'rang nom'
      'rang contexte'
      'rang physique'
      'rang perf';
    gap: var(--space-1) var(--space-3);
    padding: var(--space-4);
    border-bottom: 1px solid var(--border);
  }
  tbody tr:last-child {
    border-bottom: 0;
  }
  tbody tr:hover {
    background: color-mix(in srgb, var(--accent) 5%, transparent);
  }

  td,
  th {
    padding: 0;
    text-align: left;
  }

  .rang {
    grid-area: rang;
    align-self: start;
    padding-top: 0.1em;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--step-2);
    line-height: 1;
    font-variant-numeric: tabular-nums;
  }

  /* Les cinquante premiers en doré, les suivants en gris. */
  .rang[data-niveau='haut'] {
    color: var(--or);
  }
  .rang[data-niveau='bas'] {
    color: var(--muted);
  }

  /* Sur le podium, la coupe remplace le chiffre et prend le métal de la place.
     La coupe hérite de `color`, ce qui suffit à la teinter. */
  .rang :global(.coupe) {
    display: none;
  }
  .rang[data-podium] :global(.coupe) {
    display: inline-flex;
    margin-left: 0;
  }
  .rang[data-podium] .rang-num {
    display: none;
  }
  .rang[data-podium='or'] {
    color: var(--or);
  }
  .rang[data-podium='argent'] {
    color: var(--argent);
  }
  .rang[data-podium='bronze'] {
    color: var(--bronze);
  }

  .nom {
    grid-area: nom;
    display: flex;
    align-items: center;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--step-1);
    line-height: 1.15;
  }
  .nom a {
    color: var(--text);
  }
  .nom a:hover {
    color: var(--accent);
  }

  /* Les trois lignes d'information, séparées par des puces. */
  .ligne {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-1) var(--space-2);
    font-size: var(--step--1);
    color: var(--muted);
  }

  .contexte {
    grid-area: contexte;
  }
  .physique {
    grid-area: physique;
  }
  .perf {
    grid-area: perf;
    margin-top: var(--space-1);
  }

  /* Le séparateur est décoratif : il vit dans le CSS pour ne pas polluer le
     texte lu par un lecteur d'écran, ni la recherche. */
  .ligne > *:not(:last-child)::after {
    content: '•';
    margin-left: var(--space-2);
    color: var(--border);
  }

  .fort {
    color: var(--text);
    font-weight: 700;
    font-size: var(--step-0);
  }

  .perf a {
    color: var(--muted);
  }
  .perf a:hover {
    color: var(--accent);
  }

  @media (min-width: 40rem) {
    tbody tr {
      grid-template-columns: 4rem 1fr;
      padding: var(--space-4) var(--space-6);
    }
    .rang {
      font-size: var(--step-3);
    }
  }
</style>

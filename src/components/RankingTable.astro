---
/**
 * Tableau de classement.
 *
 * Deux mises en forme pour le même balisage : cartes empilées en mobile,
 * tableau à partir de 48rem. Le balisage reste un <table> dans les deux cas.
 *
 * La colonne de rang mérite une attention particulière. Elle contient à la
 * fois un numéro et une coupe, et le script de tri recalcule le podium à
 * chaque interaction. Le numéro vit donc dans son propre `.rang-num`, et la
 * couleur passe par des attributs sur la cellule, jamais par un remplacement
 * du pictogramme.
 */
import { equipmentLabel, parseWeightClass } from '../lib/categories';
import { kg, nombre, points } from '../lib/format';
import type { AthleteRanking } from '../lib/rankings';
import { meetPath } from '../lib/slug';
import BadgeOfficiel from './BadgeOfficiel.astro';
import Coupe from './Coupe.astro';

interface Props {
  entries: AthleteRanking[];
  miseEnAvant?: 'total' | 'dots';
  id?: string;
}

const { entries, miseEnAvant = 'total', id } = Astro.props;
const METAUX = ['or', 'argent', 'bronze'] as const;
---

<div class="cadre">
  <table id={id} data-tableau>
    <thead>
      <tr>
        <th scope="col" class="rang">#</th>
        <th scope="col" data-tri>Athlète</th>
        <th scope="col" class="nombre" data-tri data-type="nombre">Cat.</th>
        <th scope="col" class="nombre" data-tri data-type="nombre">Poids</th>
        <th scope="col" class="nombre" data-tri data-type="nombre">Total</th>
        <th scope="col" class="nombre" data-tri data-type="nombre">Dots</th>
        <th scope="col" class="masquer-mobile" data-tri>Compétition</th>
      </tr>
    </thead>
    <tbody>
      {
        entries.map((e, i) => {
          const classe = parseWeightClass(e.weightClassKg);
          return (
            <tr
              data-recherche={e.name}
              data-sexe={e.sex}
              data-categorie={e.weightClassKg}
              data-equipement={e.equipmentGroup}
              data-division={e.division}
              data-age={e.ageClass}
            >
              <td
                class="rang"
                data-podium={i < 3 ? METAUX[i] : undefined}
                data-niveau={i < 50 ? 'haut' : 'bas'}
              >
                <span class="rang-num">{i + 1}</span>
                <Coupe detail={`${i + 1}e du classement`} taille={19} />
              </td>
              <th scope="row" class="athlete">
                <span class="nom-ligne">
                  <a href={`/athlete/${e.slug}/`}>{e.name}</a>
                  <BadgeOfficiel taille={13} />
                </span>
                <span class="meta">
                  {equipmentLabel(e.equipmentGroup)} · {e.competitions} compét.
                </span>
              </th>
              <td class="nombre" data-libelle="Catégorie" data-valeur={classe?.kg ?? ''}>
                {e.weightClassKg ? `${e.weightClassKg} kg` : '—'}
              </td>
              <td class="nombre" data-libelle="Poids de corps" data-valeur={e.bodyweightKg ?? ''}>
                {nombre(e.bodyweightKg)}
              </td>
              <td
                class="nombre num-tab"
                data-libelle="Total"
                data-valeur={e.totalKg}
                data-fort={miseEnAvant === 'total'}
              >
                {kg(e.totalKg)}
              </td>
              <td
                class="nombre num-tab"
                data-libelle="Dots"
                data-valeur={e.dots}
                data-fort={miseEnAvant === 'dots'}
              >
                {points(e.dots)}
              </td>
              <td class="masquer-mobile competition">
                <a href={`/competitions/${meetPath(e.date, e.meetName)}/`}>{e.meetName}</a>
                <span class="meta">{e.date.slice(0, 4)}</span>
              </td>
            </tr>
          );
        })
      }
    </tbody>
  </table>

  {entries.length === 0 && <p class="vide">Aucun résultat pour ces critères.</p>}
</div>

<style>
  .cadre {
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: var(--surface);
    overflow: hidden;
  }

  table {
    width: 100%;
    border-collapse: collapse;
    font-size: var(--step--1);
  }

  thead {
    display: none;
  }

  th,
  td {
    text-align: left;
    padding: var(--space-2) var(--space-3);
  }

  .vide {
    padding: var(--space-8);
    text-align: center;
    color: var(--muted);
    margin: 0;
  }

  /* ---------- Colonne de rang ---------- */
  .rang {
    font-family: var(--font-display);
    font-weight: 700;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  /* Les cinquante premiers en doré, les suivants en gris. */
  .rang[data-niveau='haut'] {
    color: var(--or);
  }
  .rang[data-niveau='bas'] {
    color: var(--muted);
  }

  /* Sur le podium, la coupe remplace le chiffre et prend le métal de la place.
     La coupe hérite de `color`, ce qui suffit à la teinter. */
  .rang :global(.coupe) {
    display: none;
  }
  .rang[data-podium] :global(.coupe) {
    display: inline-flex;
    margin-left: 0;
  }
  .rang[data-podium] .rang-num {
    display: none;
  }
  .rang[data-podium='or'] {
    color: var(--or);
  }
  .rang[data-podium='argent'] {
    color: var(--argent);
  }
  .rang[data-podium='bronze'] {
    color: var(--bronze);
  }

  /* ---------- Mobile : une carte par athlète ---------- */
  @media (max-width: 47.999rem) {
    tbody tr {
      display: grid;
      grid-template-columns: auto 1fr;
      gap: var(--space-1) var(--space-3);
      padding: var(--space-3);
      border-bottom: 1px solid var(--border);
    }

    .rang {
      grid-row: 1 / 3;
      align-self: center;
      font-size: var(--step-1);
    }

    .athlete {
      padding: 0;
    }

    td.nombre {
      display: flex;
      justify-content: space-between;
      grid-column: 2;
      padding: 0;
      color: var(--muted);
    }

    td.nombre::before {
      content: attr(data-libelle);
    }

    td[data-fort='true'] {
      color: var(--text);
      font-size: var(--step-0);
    }

    .masquer-mobile {
      display: none;
    }
  }

  /* ---------- Desktop : tableau classique ---------- */
  @media (min-width: 48rem) {
    thead {
      display: table-header-group;
    }

    thead th {
      font-size: var(--step--1);
      font-weight: 600;
      color: var(--muted);
      text-transform: uppercase;
      letter-spacing: 0.04em;
      border-bottom: 1px solid var(--border);
      white-space: nowrap;
    }

    tbody tr {
      border-bottom: 1px solid var(--border);
    }
    tbody tr:last-child {
      border-bottom: 0;
    }
    tbody tr:hover {
      background: color-mix(in srgb, var(--accent) 6%, transparent);
    }

    td.nombre,
    th.nombre {
      text-align: right;
      font-variant-numeric: tabular-nums;
    }

    td[data-fort='true'] {
      font-size: var(--step-0);
    }
  }

  .athlete {
    font-weight: 600;
  }

  .nom-ligne {
    display: inline-flex;
    align-items: center;
  }

  .athlete a {
    color: var(--text);
  }
  .athlete a:hover {
    color: var(--accent);
  }

  .meta {
    display: block;
    font-size: var(--step--1);
    font-weight: 400;
    color: var(--muted);
  }

  .competition a {
    display: block;
    max-width: 22ch;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    color: var(--text);
  }
  .competition a:hover {
    color: var(--accent);
  }
</style>

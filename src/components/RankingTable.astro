---
/**
 * Tableau de classement.
 *
 * Deux mises en forme pour le même balisage : cartes empilées en mobile,
 * tableau à partir de 48rem. Le balisage reste un <table> dans les deux cas.
 * Un tableau de résultats est un tableau : le transformer en <div> ferait
 * perdre au lecteur d'écran le lien entre une valeur et son en-tête.
 *
 * Les attributs `data-valeur` portent la valeur exacte pour le tri : sans eux,
 * « 782,5 kg » serait comparé comme du texte et 90 passerait après 1000.
 */
import { equipmentLabel, parseWeightClass } from '../lib/categories';
import { kg, nombre, points } from '../lib/format';
import type { AthleteRanking } from '../lib/rankings';
import { cleRecord, clesRecords } from '../lib/records';
import { meetSlug } from '../lib/slug';
import VerifiedBadge from './VerifiedBadge.astro';

interface Props {
  entries: AthleteRanking[];
  miseEnAvant?: 'total' | 'dots';
  id?: string;
}

const { entries, miseEnAvant = 'total', id } = Astro.props;
const records = clesRecords();
---

<div class="cadre">
  <table id={id} data-tableau>
    <thead>
      <tr>
        <th scope="col" class="rang">#</th>
        <th scope="col" data-tri>Athlète</th>
        <th scope="col" class="nombre" data-tri data-type="nombre">Cat.</th>
        <th scope="col" class="nombre" data-tri data-type="nombre">Poids</th>
        <th scope="col" class="nombre" data-tri data-type="nombre">Total</th>
        <th scope="col" class="nombre" data-tri data-type="nombre">Dots</th>
        <th scope="col" class="masquer-mobile" data-tri>Compétition</th>
      </tr>
    </thead>
    <tbody>
      {
        entries.map((e, i) => {
          const classe = parseWeightClass(e.weightClassKg);
          const estRecord = records.has(cleRecord('total', e.name, e.date, e.meetName));
          return (
            <tr
              data-sexe={e.sex}
              data-categorie={e.weightClassKg}
              data-equipement={e.equipmentGroup}
            >
              <td class="rang" data-podium={i < 3 ? i + 1 : undefined}>
                {i + 1}
              </td>
              <th scope="row" class="athlete">
                <a href={`/athlete/${e.slug}/`}>{e.name}</a>
                {estRecord && <VerifiedBadge detail="Record de sa catégorie" />}
                <span class="meta">
                  {equipmentLabel(e.equipmentGroup)} · {e.competitions} compét.
                </span>
              </th>
              <td class="nombre" data-libelle="Catégorie" data-valeur={classe?.kg ?? ''}>
                {e.weightClassKg ? `${e.weightClassKg} kg` : '—'}
              </td>
              <td class="nombre" data-libelle="Poids de corps" data-valeur={e.bodyweightKg ?? ''}>
                {nombre(e.bodyweightKg)}
              </td>
              <td
                class="nombre num-tab"
                data-libelle="Total"
                data-valeur={e.totalKg}
                data-fort={miseEnAvant === 'total'}
              >
                {kg(e.totalKg)}
              </td>
              <td
                class="nombre num-tab"
                data-libelle="Dots"
                data-valeur={e.dots}
                data-fort={miseEnAvant === 'dots'}
              >
                {points(e.dots)}
              </td>
              <td class="masquer-mobile competition">
                <a href={`/competitions/${meetSlug(e.date, e.meetName)}/`}>{e.meetName}</a>
                <span class="meta">{e.date.slice(0, 4)}</span>
              </td>
            </tr>
          );
        })
      }
    </tbody>
  </table>

  {entries.length === 0 && <p class="vide">Aucun résultat pour ces critères.</p>}
</div>

<style>
  .cadre {
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: var(--surface);
    overflow: hidden;
  }

  table {
    width: 100%;
    border-collapse: collapse;
    font-size: var(--step--1);
  }

  thead {
    display: none;
  }

  th,
  td {
    text-align: left;
    padding: var(--space-2) var(--space-3);
  }

  .vide {
    padding: var(--space-8);
    text-align: center;
    color: var(--muted);
    margin: 0;
  }

  /* ---------- Mobile : une carte par athlète ---------- */
  @media (max-width: 47.999rem) {
    tbody tr {
      display: grid;
      grid-template-columns: auto 1fr;
      gap: var(--space-1) var(--space-3);
      padding: var(--space-3);
      border-bottom: 1px solid var(--border);
    }

    .rang {
      grid-row: 1 / 3;
      align-self: center;
      font-size: var(--step-1);
    }

    .athlete {
      padding: 0;
    }

    td.nombre {
      display: flex;
      justify-content: space-between;
      grid-column: 2;
      padding: 0;
      color: var(--muted);
    }

    td.nombre::before {
      content: attr(data-libelle);
    }

    td[data-fort='true'] {
      color: var(--text);
      font-size: var(--step-0);
    }

    .masquer-mobile {
      display: none;
    }
  }

  /* ---------- Desktop : tableau classique ---------- */
  @media (min-width: 48rem) {
    thead {
      display: table-header-group;
    }

    thead th {
      font-size: var(--step--1);
      font-weight: 600;
      color: var(--muted);
      text-transform: uppercase;
      letter-spacing: 0.04em;
      border-bottom: 1px solid var(--border);
      white-space: nowrap;
    }

    tbody tr {
      border-bottom: 1px solid var(--border);
    }
    tbody tr:last-child {
      border-bottom: 0;
    }
    tbody tr:hover {
      background: color-mix(in srgb, var(--accent) 6%, transparent);
    }

    td.nombre,
    th.nombre {
      text-align: right;
      font-variant-numeric: tabular-nums;
    }

    td[data-fort='true'] {
      font-size: var(--step-0);
    }
  }

  .rang {
    font-family: var(--font-display);
    font-weight: 700;
    color: var(--muted);
    font-variant-numeric: tabular-nums;
  }

  /* Les trois premiers ressortent : c'est ce qu'on vient chercher sur un
     classement, et ça donne au tableau son air de podium. */
  .rang[data-podium] {
    color: var(--accent);
  }
  .rang[data-podium='1'] {
    font-size: var(--step-1);
  }

  .athlete {
    font-weight: 600;
  }
  .athlete a {
    color: var(--text);
  }
  .athlete a:hover {
    color: var(--accent);
  }

  .meta {
    display: block;
    font-size: var(--step--1);
    font-weight: 400;
    color: var(--muted);
  }

  .competition a {
    display: block;
    max-width: 22ch;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    color: var(--text);
  }
  .competition a:hover {
    color: var(--accent);
  }
</style>

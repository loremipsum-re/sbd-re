---
/**
 * Bannière de consentement pour la mesure d'audience.
 *
 * POURQUOI ELLE EXISTE
 *
 * Microsoft Clarity dépose des cookies, enregistre les sessions et transmet
 * les données à Microsoft. Il ne relève donc pas de l'exemption que la CNIL
 * accorde à la simple mesure d'audience : le consentement préalable est
 * obligatoire, et le refus doit être aussi simple que l'acceptation.
 *
 * D'où deux boutons de même poids visuel, et aucune case pré-cochée. Un
 * bandeau où « Accepter » serait mis en avant et « Refuser » caché dans un
 * sous-menu est précisément ce que la CNIL sanctionne.
 *
 * Tant que rien n'est accepté, AUCUN script tiers n'est chargé.
 */
---

<div class="banniere" data-banniere-consentement hidden>
  <div class="wrap contenu">
    <div class="texte">
      <p class="titre">Mesure d'audience</p>
      <p>
        Ce site peut mesurer la façon dont ses pages sont consultées, à l'aide
        d'un outil qui dépose des cookies et transmet ces données à Microsoft.
        Cette mesure sert uniquement à améliorer le site. Elle reste facultative,
        et le site fonctionne identiquement sans elle.
        {' '}<a href="/confidentialite/">En savoir plus</a>.
      </p>
    </div>
    <div class="actions">
      <button type="button" data-consentement="non">Refuser</button>
      <button type="button" data-consentement="oui">Accepter</button>
    </div>
  </div>
</div>

<script>
  const CLE = 'sbd-mesure';
  const banniere = document.querySelector<HTMLElement>('[data-banniere-consentement]');

  function lireChoix(): string | null {
    try {
      return localStorage.getItem(CLE);
    } catch {
      // Navigation privée ou stockage refusé : on considère qu'aucun choix
      // n'a été exprimé, donc rien n'est chargé.
      return null;
    }
  }

  if (banniere && lireChoix() === null) banniere.hidden = false;

  for (const bouton of banniere?.querySelectorAll<HTMLButtonElement>('[data-consentement]') ??
    []) {
    bouton.addEventListener('click', () => {
      const choix = bouton.dataset.consentement === 'oui' ? 'oui' : 'non';
      try {
        localStorage.setItem(CLE, choix);
      } catch {
        // Sans stockage, le choix ne vaut que pour la visite en cours.
      }
      if (banniere) banniere.hidden = true;
      // Chargement immédiat en cas d'acceptation : recharger la page pour
      // activer la mesure serait une friction inutile.
      if (choix === 'oui') window.sbdChargerMesure?.();
    });
  }
</script>

<style>
  .banniere {
    position: fixed;
    inset-inline: 0;
    bottom: 0;
    z-index: 20;
    border-top: 1px solid var(--border);
    background: var(--surface);
    box-shadow: 0 -4px 24px rgb(0 0 0 / 0.18);
  }

  .banniere[hidden] {
    display: none;
  }

  .contenu {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    padding-block: var(--space-4);
  }

  .texte {
    flex: 1 1 22rem;
  }

  .titre {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--step-0);
    margin-bottom: var(--space-1);
  }

  .texte p {
    margin: 0;
    font-size: var(--step--1);
    color: var(--muted);
    max-width: 68ch;
  }

  .actions {
    display: flex;
    gap: var(--space-3);
  }

  /*
   * Les deux boutons ont volontairement le même poids visuel. Mettre en avant
   * l'acceptation et effacer le refus est exactement ce que la CNIL considère
   * comme un consentement non valide.
   */
  .actions button {
    padding: var(--space-3) var(--space-6);
    border: 1px solid var(--accent);
    border-radius: var(--radius);
    background: var(--surface);
    color: var(--accent);
    font: inherit;
    font-size: var(--step--1);
    font-weight: 700;
    cursor: pointer;
  }

  .actions button:hover {
    background: color-mix(in srgb, var(--accent) 12%, transparent);
  }
</style>

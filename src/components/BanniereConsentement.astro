---
/**
 * Bannière de consentement pour la mesure d'audience.
 *
 * POURQUOI ELLE EXISTE
 *
 * L'outil de mesure dépose des cookies et transmet les données à un tiers. Il
 * ne relève donc pas de l'exemption que la CNIL accorde à la simple mesure
 * d'audience : le consentement préalable est obligatoire, et le refus doit
 * être aussi simple que l'acceptation.
 *
 * D'où deux boutons de même poids visuel, et aucune case pré-cochée. Un
 * bandeau où « Accepter » serait mis en avant et « Refuser » relégué est
 * précisément ce que la CNIL sanctionne.
 *
 * Le texte reste volontairement court. Le détail du traitement, des cookies
 * déposés et du destinataire vit sur /confidentialite/. Ce schéma est valide
 * À CONDITION que le lien reste visible dans la bannière : sans lui, le
 * consentement ne serait pas éclairé. Ne pas le retirer.
 *
 * Tant que rien n'est accepté, AUCUN script tiers n'est chargé.
 */
---

<div class="banniere" data-banniere-consentement hidden>
  <p class="titre">Améliorer le site</p>
  <p class="texte">
    Ce site peut analyser la navigation pour repérer ce qui gêne et corriger
    l'ergonomie. C'est entièrement facultatif, et tout fonctionne à l'identique
    sans. <a href="/confidentialite/">En savoir plus</a>.
  </p>
  <div class="actions">
    <button type="button" data-consentement="non">Refuser</button>
    <button type="button" data-consentement="oui">Accepter</button>
  </div>
</div>

<script>
  const CLE = 'sbd-mesure';
  const banniere = document.querySelector<HTMLElement>('[data-banniere-consentement]');

  function lireChoix(): string | null {
    try {
      return localStorage.getItem(CLE);
    } catch {
      // Navigation privée ou stockage refusé : on considère qu'aucun choix
      // n'a été exprimé, donc rien n'est chargé.
      return null;
    }
  }

  if (banniere && lireChoix() === null) banniere.hidden = false;

  for (const bouton of banniere?.querySelectorAll<HTMLButtonElement>('[data-consentement]') ??
    []) {
    bouton.addEventListener('click', () => {
      const choix = bouton.dataset.consentement === 'oui' ? 'oui' : 'non';
      try {
        localStorage.setItem(CLE, choix);
      } catch {
        // Sans stockage, le choix ne vaut que pour la visite en cours.
      }
      if (banniere) banniere.hidden = true;
      // Chargement immédiat en cas d'acceptation : recharger la page pour
      // activer la mesure serait une friction inutile.
      if (choix === 'oui') window.sbdChargerMesure?.();
    });
  }
</script>

<style>
  .banniere {
    position: fixed;
    z-index: 20;
    inset-block-end: var(--space-4);
    inset-inline-end: var(--space-4);
    inline-size: min(23rem, calc(100vw - 2 * var(--space-4)));
    padding: var(--space-5, var(--space-4)) var(--space-6);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: var(--surface);
    /* Ombre portée marquée : la carte doit se détacher du contenu qu'elle
       recouvre, sans quoi elle se confond avec une section de la page. */
    box-shadow: 0 8px 32px rgb(0 0 0 / 0.28);
  }

  .banniere[hidden] {
    display: none;
  }

  .titre {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--step-0);
    margin: 0 0 var(--space-2);
  }

  .texte {
    margin: 0 0 var(--space-4);
    font-size: var(--step--1);
    color: var(--muted);
  }

  .actions {
    display: flex;
    gap: var(--space-2);
  }

  /*
   * Les deux boutons ont volontairement le même poids visuel et la même
   * largeur. Mettre en avant l'acceptation et effacer le refus est exactement
   * ce que la CNIL considère comme un consentement non valide.
   */
  .actions button {
    flex: 1;
    padding: var(--space-3) var(--space-4);
    border: 1px solid var(--accent);
    border-radius: var(--radius);
    background: var(--bg);
    color: var(--accent);
    font: inherit;
    font-size: var(--step--1);
    font-weight: 700;
    cursor: pointer;
  }

  .actions button:hover {
    background: color-mix(in srgb, var(--accent) 12%, transparent);
  }

  /* Sur les écrans étroits, la carte s'étire d'un bord à l'autre : une carte
     de 23rem flottant dans un coin y serait à l'étroit. */
  @media (max-width: 30rem) {
    .banniere {
      inset-inline: var(--space-3);
      inset-block-end: var(--space-3);
      inline-size: auto;
      padding: var(--space-4);
    }
  }
</style>

---
/**
 * Gabarit commun à toutes les pages : en-tête, navigation, pied de page, méta.
 */
import BanniereConsentement from '../components/BanniereConsentement.astro';
import BoutonSuggestion from '../components/BoutonSuggestion.astro';
import EtiquetteRubrique from '../components/EtiquetteRubrique.astro';
import Icone from '../components/Icone.astro';
import Logo from '../components/Logo.astro';
import SiteFooter from '../components/SiteFooter.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
import { ID_ANNONCE_SORTIE, TEXTE_ANNONCE_SORTIE } from '../lib/liens-sortants';
import { groupesMenu, rubriquesBarre } from '../lib/navigation';
import { version } from '../../package.json';
// Les déclarations de polices d'abord : tokens.css s'en sert immédiatement.
import '../styles/fonts.css';
import '../styles/tokens.css';
/* Après les jetons, qu'elle emploie. Voir l'en-tête du fichier : c'est la
   grammaire commune aux sept listes du site. */
import '../styles/listes.css';

interface Props {
  titre: string;
  description: string;
  /** Titre de l'onglet. Par défaut « <titre> | SBD.re ». */
  titreOnglet?: string;
  /**
   * Image de partage, chemin absolu depuis la racine du site.
   * Sans elle, aucune balise `og:image` n'est émise : mieux vaut pas d'image
   * du tout qu'une balise pointant vers un fichier inexistant, que les réseaux
   * sociaux mettent en cache durablement.
   */
  image?: string;
  imageAlt?: string;
}

/**
 * Image de partage par défaut, en attente du système de design.
 *
 * Dès que le logo sera prêt : déposer le fichier dans `public/`, renseigner
 * cette constante, et toutes les pages en hériteront. Format recommandé
 * 1200 × 630 pixels, en PNG ou JPEG. Le SVG est mal pris en charge par les
 * réseaux sociaux.
 */
const IMAGE_PARTAGE_DEFAUT: string | null = null;

const { titre, description, titreOnglet, image, imageAlt } = Astro.props;

const canonique = new URL(Astro.url.pathname, Astro.site);
const chemin = Astro.url.pathname;

// Les réseaux sociaux exigent une URL absolue : un chemin relatif est ignoré.
const imagePartage = image ?? IMAGE_PARTAGE_DEFAUT;
const imageAbsolue = imagePartage ? new URL(imagePartage, Astro.site).href : null;

/** Identifiant du projet Microsoft Clarity, pour la mesure d'audience. */
const CLARITY_ID = 'xtvqmm4cxo';

/**
 * La barre ne porte que TROIS entrées : Classement, Records, Catégories.
 *
 * Le menu les reprend en tête, puis range le reste du site en trois familles
 * titrées. Une navigation qui montre tout ne met rien en avant : huit
 * rubriques alignées laissaient le visiteur choisir sans indice, et
 * débordaient de l'écran sur téléphone.
 *
 * Le partage est déclaré dans lib/navigation, avec les libellés, les adresses,
 * les familles et les icônes. Ajouter une rubrique au site se fait là-bas, et
 * nulle part ailleurs.
 *
 * LA RUBRIQUE EN COURS, pour `aria-current` : « page » sur la page de la
 * rubrique, « true » sur une page intérieure. Sur /categories/hommes/93/, le
 * lien « Catégories » s'annonçait « page en cours » et menait pourtant
 * ailleurs. « true » le désigne comme l'entrée en cours de la liste. Le
 * style des deux valeurs est le même.
 */
const courant = (href: string) =>
  chemin === href ? 'page' : chemin.startsWith(href) ? 'true' : undefined;
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titreOnglet ?? `${titre} | SBD.re`}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonique.href} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="SBD.re" />
    <meta property="og:title" content={titre} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonique.href} />
    <meta property="og:locale" content="fr_FR" />
    {
      imageAbsolue ? (
        <>
          <meta property="og:image" content={imageAbsolue} />
          <meta property="og:image:alt" content={imageAlt ?? titre} />
          <meta name="twitter:card" content="summary_large_image" />
          <meta name="twitter:image" content={imageAbsolue} />
        </>
      ) : (
        <meta name="twitter:card" content="summary" />
      )
    }

    {/*
      L'empreinte de version dans l'adresse n'est pas de la coquetterie.

      Ces deux fichiers ont un nom stable : leur contenu change, leur adresse
      non. Un navigateur qui a déjà vu l'ancien favicon le garde, et le
      `.htaccess` lui a longtemps interdit de revenir vérifier. Changer
      l'adresse est le SEUL moyen d'atteindre les visiteurs déjà venus.

      `version` vient de package.json, comme le badge du pied de page : un
      `npm version` suffit à distribuer un nouveau favicon à tout le monde.
    */}
    <link rel="icon" href={`/favicon.svg?v=${version}`} type="image/svg+xml" />
    <link rel="icon" href={`/favicon.ico?v=${version}`} sizes="32x32" />

    {/*
      Le navigateur ne découvre normalement une police qu'après avoir lu le CSS,
      qu'il doit lui-même d'abord télécharger : le texte s'affiche donc deux fois,
      d'abord en police système puis en Archivo. `preload` lance le
      téléchargement immédiatement, en parallèle du CSS.

      Un seul fichier depuis juillet 2026 : Archivo, variable sur la graisse et
      la largeur, remplace Oswald et Inter. Le préchargement s'en trouve allégé
      d'une requête.

      `crossorigin` est obligatoire pour les polices, même servies depuis le même
      domaine — sans lui le navigateur télécharge le fichier une seconde fois.
      Seuls les fichiers « latin » sont préchargés : « latin-ext » ne sert qu'à
      de rares caractères et reste chargé à la demande.
    */}
    <link
      rel="preload"
      href="/fonts/archivo-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    {/*
      Applique le thème AVANT le premier rendu.

      `is:inline` demande à Astro de laisser ce script tel quel, sans le
      regrouper dans un fichier externe : un fichier séparé serait chargé trop
      tard, et la page apparaîtrait en blanc une fraction de seconde avant de
      basculer en sombre. C'est le fameux « flash » — visible, désagréable, et
      la première chose qu'on remarque sur un site mal fait.
    */}
    <script is:inline>
      (function () {
        /*
         * Le sombre est le défaut, et le réglage du système n'est plus
         * consulté. Une majorité de machines sortent d'usine en clair : le
         * suivre revenait à servir un site clair à presque tout le monde.
         *
         * Seul un choix explicite, mémorisé par le bouton, fait autre chose.
         */
        try {
          document.documentElement.dataset.theme =
            localStorage.getItem('sbd-theme') || 'dark';
        } catch (e) {
          document.documentElement.dataset.theme = 'dark';
        }
      })();
    </script>

    {/*
      Mesure d'audience Microsoft Clarity, SOUS CONDITION DE CONSENTEMENT.

      Le script n'est pas posé ici : seule la fonction qui sait le charger l'est.
      Elle n'est appelée que si le visiteur a déjà accepté lors d'une visite
      précédente, ou lorsqu'il accepte via la bannière.

      Tant que rien n'est accepté, aucune requête ne part vers clarity.ms et
      aucun cookie n'est déposé. C'est ce que le RGPD et la doctrine de la CNIL
      exigent pour un outil qui enregistre les sessions et transmet les données
      à un tiers.
    */}
    <script is:inline define:vars={{ CLARITY_ID }}>
      window.sbdChargerMesure = function () {
        if (window.__sbdMesureChargee) return;
        window.__sbdMesureChargee = true;
        (function (c, l, a, r, i, t, y) {
          c[a] =
            c[a] ||
            function () {
              (c[a].q = c[a].q || []).push(arguments);
            };
          t = l.createElement(r);
          t.async = 1;
          t.src = 'https://www.clarity.ms/tag/' + i;
          y = l.getElementsByTagName(r)[0];
          y.parentNode.insertBefore(t, y);
        })(window, document, 'clarity', 'script', CLARITY_ID);
      };

      try {
        if (localStorage.getItem('sbd-mesure') === 'oui') window.sbdChargerMesure();
      } catch (e) {
        // Stockage indisponible : on ne charge rien, faute de consentement vérifiable.
      }
    </script>
  </head>

  <body>
    {/*
      Cible du bouton « retour en haut ».

      Elle a sa propre balise, et surtout PAS l'en-tête. `id="top"` était posé
      sur `.entete`, qui est en `position: sticky` : une fois la page défilée,
      sa boîte est déjà collée en haut de la fenêtre. Le navigateur en concluait
      qu'aucun défilement n'était nécessaire, et le bouton ne faisait rien. Il
      écrivait bien « #top » dans l'adresse, ce qui donnait l'illusion d'un lien
      valide, mais la page ne bougeait pas d'un pixel.

      Une ancre de retour en haut ne doit jamais viser un élément collant.
    */}
    <span id="top"></span>

    {/*
      Annonce des liens sortants, lue par les lecteurs d'écran après le nom de
      chaque lien vers un autre site. Masquée, et lue quand même : voir
      lib/liens-sortants.ts.
    */}
    <span id={ID_ANNONCE_SORTIE} hidden>{TEXTE_ANNONCE_SORTIE}</span>

    <a class="evitement" href="#contenu">Aller au contenu</a>

    <header class="entete">
      <div class="wrap barre">
        <a class="marque lien-nu" href="/" aria-label="SBD.re, accueil">
          <Logo />
        </a>

        <nav class="nav-large" aria-label="Navigation principale">
          <ul>
            {
              rubriquesBarre.map((lien) => (
                <li>
                  <a
                    class="lien-nu"
                    href={lien.href}
                    aria-current={courant(lien.href)}
                  >
                    <Icone nom={lien.icone} />
                    {lien.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>

        {/*
          LE GRAND MENU, en <details> plutôt qu'en JavaScript.

          Le navigateur gère lui-même l'ouverture, la fermeture, le clavier et
          l'annonce aux lecteurs d'écran. Aucun piège au focus à écrire, et le
          menu fonctionne même si le JavaScript échoue. Il se referme tout seul
          au changement de page, puisque la page est rechargée.

          IL EXISTE À TOUTES LES LARGEURS. Les trois rubriques de la barre
          restent le chemin rapide, le menu ouvre tout le reste.

          TROIS FAMILLES TITRÉES ET DES LIBELLÉS COURTS, demande de l'auteur du
          27 octobre 2026. Chaque rubrique portait une phrase de résumé. Le
          titre de la famille dit désormais ce que la phrase disait, une fois
          pour plusieurs rubriques.

          Mesuré sur un écran de 375 × 812 : le panneau passe de 1 417 px à
          492 px. Il montrait 6 rubriques sur 14 sans défiler, il montre
          désormais ses 13 rubriques. Les mises à jour et les pages légales
          vivent au pied de page.
        */}
        <details class="menu">
          <summary aria-label="Ouvrir le menu">
            <span class="barres-menu" aria-hidden="true"></span>
            <span class="mot-menu">Menu</span>
          </summary>

          {/* Voile sur le contenu, décoratif : il n'apporte aucune
              information, il retire seulement celle du dessous. */}
          <div class="voile" aria-hidden="true"></div>

          <div class="panneau">
            {/*
              LA BASCULE DE THÈME VIT DANS LE MENU, demande de l'auteur du
              1er octobre 2026. Elle occupait un bouton permanent de l'en-tête,
              à côté du menu, pour un réglage qu'on change une fois et qu'on
              oublie : la barre du haut est rendue à ce qu'on y cherche
              vraiment, le logo et l'accès aux rubriques.
              Elle est posée DANS le panneau, et non à côté : le script de
              fermeture ne referme le menu que sur un clic hors du panneau, si
              bien que le changement de thème se voit sans que le menu se
              dérobe.

              EN TÊTE DU PANNEAU, ET NON EN PIED. Mesuré sur un téléphone de
              375 px : le panneau montre 738 px de ses 1313, et la rangée posée
              après les treize rubriques demandait 575 px de défilement pour un
              réglage qui tenait auparavant à un seul appui.
            */}
            <div class="reglages wrap">
              {/* Le bouton garde son propre nom accessible, « Changer de
                  thème » : l'intitulé visible situe la rangée, il ne nomme pas
                  la commande. */}
              <span class="intitule-reglage">Apparence</span>
              <ThemeToggle />
            </div>

            {/*
              UNE SEULE NAVIGATION, TROIS LISTES NOMMÉES. Chaque liste porte le
              titre de sa famille par `aria-labelledby` : un lecteur d'écran
              le donne en entrant dans la liste. Les titres sont des
              paragraphes et non des <h2> : ils précéderaient le <h1> de chaque
              page dans l'ordre du document, et dérangeraient la descente des
              titres que l'audit d'accessibilité vérifie.
            */}
            <nav class="wrap" aria-label="Navigation">
              <div class="familles">
                {
                  groupesMenu.map((groupe) => (
                    <div class:list={['famille', `famille-${groupe.id}`]}>
                      <p class="titre-famille" id={`menu-${groupe.id}`}>
                        {groupe.titre}
                      </p>
                      <ul aria-labelledby={`menu-${groupe.id}`}>
                        {groupe.rubriques.map((lien) => (
                          <li>
                            <a
                              class="lien-nu"
                              href={lien.href}
                              aria-current={courant(lien.href)}
                            >
                              <Icone nom={lien.icone} />
                              <span class="intitule">
                                {lien.label}
                                {lien.etiquette && (
                                  <>
                                    {' '}
                                    <EtiquetteRubrique texte={lien.etiquette} />
                                  </>
                                )}
                              </span>
                            </a>
                          </li>
                        ))}
                      </ul>
                    </div>
                  ))
                }
              </div>
            </nav>
          </div>
        </details>
      </div>
    </header>

    <main id="contenu">
      <slot />
    </main>

    <SiteFooter />
    <BanniereConsentement />

    {/*
      Le bouton de suggestion, partout SAUF sur sa propre page : y proposer
      d'ouvrir une fenêtre contenant le formulaire déjà affiché dessous n'aurait
      aucun sens.
    */}
    {Astro.url.pathname !== '/suggestions/' && <BoutonSuggestion />}

    {/*
      Retour en haut. C'est un LIEN vers l'ancre du haut de page, pas un bouton :
      sans JavaScript il fonctionne quand même, et le clavier le traite
      naturellement. Le script ne fait que le montrer une fois la page
      suffisamment défilée, pour qu'il n'encombre pas le premier écran.
    */}
    <a class="haut" href="#top" aria-label="Revenir en haut de la page" hidden>
      <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
        <path
          d="M12 5l7 7-1.4 1.4L13 8.8V20h-2V8.8l-4.6 4.6L5 12z"
          fill="currentColor"></path>
      </svg>
    </a>

    {/*
      FERMETURE DU GRAND MENU, en amélioration seulement.

      Un `<details>` ne se referme ni à la touche Échap, ni au clic à côté :
      le navigateur n'a rien prévu pour cela. Tant que le panneau était un
      petit menu de 14rem, on pouvait s'en passer ; en pleine largeur il
      couvre la page, et rester coincé dedans devient pénible.

      Ces quelques lignes n'ajoutent RIEN d'indispensable : sans JavaScript,
      le menu s'ouvre et se referme toujours par son propre bouton.

      LE FOCUS QUI QUITTE LE MENU LE REFERME. Après la dernière rubrique, la
      tabulation passait au contenu de la page, caché sous le panneau et son
      voile : mesuré à 375 comme à 1 280 px, le lien suivant recevait le focus
      sans qu'aucun pixel n'en soit visible (critère 2.4.11 des WCAG 2.2). Le
      focus poursuit sa route, il n'est pas ramené au bouton. Sans élément de
      destination, rien ne se ferme : un clic dans le vide du panneau, ou sur
      une commande que Safari ne focalise pas, laisse le focus nulle part, et
      le clic à côté a son propre traitement.

      Cette note vit ici et non dans le script : un script `is:inline` part
      tel quel, commentaires compris, dans chacune des pages du site.
    */}
    <script is:inline>
      (() => {
        const menu = document.querySelector('details.menu');
        if (!menu) return;

        const fermer = () => {
          if (!menu.open) return;
          menu.open = false;
          // Le focus revient au bouton : sans cela il resterait dans un
          // panneau devenu invisible, et la tabulation repartirait du début.
          menu.querySelector('summary')?.focus();
        };

        document.addEventListener('keydown', (evenement) => {
          if (evenement.key === 'Escape') fermer();
        });

        /*
         * On ferme dès que le clic tombe HORS DU PANNEAU ET HORS DU BOUTON.
         *
         * Et non « hors du <details> » : le voile est un enfant de ce dernier,
         * si bien qu'un clic dessus aurait été compté comme un clic dedans.
         * Or voiler la page, c'est précisément inviter à cliquer à côté.
         */
        document.addEventListener('click', (evenement) => {
          if (!menu.open) return;
          const cible = evenement.target;
          if (cible.closest('.panneau') || cible.closest('summary')) return;
          fermer();
        });

        // Le focus qui sort du menu le referme : voir la note avant ce script.
        menu.addEventListener('focusout', (evenement) => {
          const suivant = evenement.relatedTarget;
          if (menu.open && suivant && !menu.contains(suivant)) menu.open = false;
        });
      })();

      /*
       * LES DEUX BOUTONS FLOTTANTS, retour en haut et suggestion, réglés ici
       * ensemble : ils forment une paire et doivent paraître ensemble.
       *
       * Ils recouvraient les chiffres. Mesuré le 27 octobre 2026 : à 375 px,
       * le total et les Dots de la carte qui passe dessous ; jusqu'à 1 280 px,
       * où « Proposer » porte son mot, une colonne de chiffres. Rien à 1 440.
       * Quand ils empiètent sur la colonne du contenu, ils se retirent donc
       * pendant la descente, qui est la lecture, et reviennent dès que l'on
       * remonte, qui est le moment où l'on cherche le haut. Ils restent en bas
       * de page, et tant que l'un d'eux a le focus.
       *
       * Une gouttière de 60 px réservée aux chiffres aurait coûté 44 px de
       * largeur à chaque carte d'un téléphone, et les deux boutons regroupés
       * recouvriraient encore un coin de carte.
       */
      (() => {
        const boutons = [...document.querySelectorAll('.haut, [data-ouvrir-suggestion]')];
        if (!boutons.length) return;
        const colonne = document.querySelector('main .wrap') ?? document.querySelector('main');

        // Un seuil généreux : sous 600 px de défilement, le haut de page est
        // encore à portée de pouce et les boutons ne serviraient qu'à masquer
        // du contenu.
        const SEUIL = 600;
        // Quelques pixels de marge, pour qu'un rebond de fin de défilement ne
        // fasse pas clignoter les boutons.
        const PAS = 8;

        /*
         * Les boutons empiètent-ils sur la colonne du contenu ? Mesuré sur les
         * boutons eux-mêmes, affichés le temps de la mesure sans être peints :
         * leur largeur dépend de la feuille de style, « Proposer » perdant son
         * mot sous 30rem.
         */
        let empietent = true;
        const mesurer = () => {
          if (!colonne) return;
          const r = colonne.getBoundingClientRect();
          const droite = r.right - parseFloat(getComputedStyle(colonne).paddingRight);
          empietent = boutons.some((b) => {
            const cache = b.hidden;
            b.hidden = false;
            b.style.visibility = 'hidden';
            const gauche = b.getBoundingClientRect().left;
            b.style.visibility = '';
            b.hidden = cache;
            return gauche < droite;
          });
        };

        let repere = window.scrollY;
        let visibles = false;
        const basculer = () => {
          const y = window.scrollY;
          const enBas = y + innerHeight >= document.documentElement.scrollHeight - 2;
          const focus = boutons.includes(document.activeElement);
          if (y < SEUIL) visibles = false;
          else if (!empietent || enBas || focus || y < repere - PAS) visibles = true;
          else if (y > repere + PAS) visibles = false;
          if (y < SEUIL || Math.abs(y - repere) > PAS) repere = y;
          for (const b of boutons) b.hidden = !visibles;
        };

        // `passive` indique au navigateur que l'écouteur ne bloquera jamais le
        // défilement : sans lui, il doit attendre l'exécution du script avant
        // de faire bouger la page, ce qui se sent au doigt sur téléphone.
        addEventListener('scroll', basculer, { passive: true });
        addEventListener('resize', () => {
          mesurer();
          basculer();
        });
        mesurer();
        basculer();
      })();
    </script>
  </body>
</html>

<style>
  .evitement {
    position: absolute;
    left: -9999px;
    z-index: 10;
    padding: var(--space-3) var(--space-4);
    /*
     * L'APLAT, pas l'accent de texte. La distinction est tout sauf cosmétique.
     *
     * Ce bloc posait --accent en fond sous --on-accent : en thème clair, du
     * basalte #201e1d sur le jaune sombre #676700, soit 2.78:1. Sous le seuil,
     * sur le tout premier élément qu'atteint une navigation au clavier.
     *
     * --accent-fill est le jaune franc #d6d600, dont tokens.css documente
     * justement la paire avec le basalte. Mesuré après correction : 10.66:1.
     * Le thème sombre était indemne, les deux jetons y valant la même couleur.
     */
    background: var(--accent-fill);
    color: var(--on-accent);
    border-radius: 0 0 var(--radius) 0;
  }
  /* Le lien d'évitement n'apparaît qu'au clavier : il fait gagner un temps
     considérable à qui navigue sans souris, sans encombrer l'écran des autres. */
  .evitement:focus {
    left: 0;
    top: 0;
  }

  .entete {
    position: sticky;
    top: 0;
    /* Au-dessus des bulles du lexique (5), elles-mêmes au-dessus des boutons
       flottants (4) : une bulle ouverte glisse sous l'en-tête quand la page
       défile. Voir tokens.css. */
    z-index: 6;
    background: color-mix(in srgb, var(--bg) 85%, transparent);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--border);
  }

  /* ----------------------------------------------------------------------
   * Navigation : trois entrées et le menu dès 48rem, le menu seul en dessous.
   *
   * Les deux existent dans le HTML et c'est le CSS qui choisit. Basculer en
   * JavaScript imposerait d'attendre son exécution, avec un scintillement à
   * chaque chargement.
   * -------------------------------------------------------------------- */

  .menu {
    /*
     * Pousse le bouton de menu contre le bord droit.
     *
     * Dès 48rem c'est la navigation, en `flex: 1`, qui occupe l'espace
     * disponible. Elle disparaît en dessous, et sans cette marge automatique
     * le bouton se tasserait à gauche contre le logo.
     *
     * VOLONTAIREMENT SANS `position: relative` : le panneau se cale alors sur
     * l'en-tête, qui est collante et fait donc bloc de référence, et peut
     * ainsi occuper toute la largeur de la fenêtre.
     */
    margin-left: auto;
  }

  .menu summary {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    /* 44 px de haut comme tout contrôle du site, et une taille de texte qui
       ne demande pas d'effort : le bouton était à 14 px. */
    min-height: var(--cible-min);
    padding: var(--space-2) var(--space-4);
    border: 2px solid var(--border);
    border-radius: var(--radius);
    color: var(--text);
    font-size: var(--step-0);
    font-weight: 700;
    cursor: pointer;
    /* Retire la flèche que Safari et Chrome ajoutent d'office. */
    list-style: none;
  }
  .menu summary::-webkit-details-marker {
    display: none;
  }
  .menu summary:hover {
    border-color: var(--accent);
    color: var(--accent);
  }
  .menu[open] summary {
    border-color: var(--accent);
    color: var(--accent);
  }

  /* Trois traits dessinés en dégradé plutôt qu'en trois éléments : un seul
     nœud dans le DOM pour la même image. */
  .barres-menu {
    width: 1.15em;
    height: 0.75em;
    background:
      linear-gradient(currentColor 0 0) 0 0 / 100% 2px no-repeat,
      linear-gradient(currentColor 0 0) 0 50% / 100% 2px no-repeat,
      linear-gradient(currentColor 0 0) 0 100% / 100% 2px no-repeat;
  }

  /*
   * LE PANNEAU PREND TOUTE LA LARGEUR, sous l'en-tête.
   *
   * Il était un menu déroulant de 14rem accroché au bord droit : douze
   * intitulés en colonne, sans rien dire de ce qu'ils contiennent. En pleine
   * largeur, les trois familles se placent côte à côte dès qu'elles tiennent,
   * et l'ensemble se lit d'un coup d'œil.
   *
   * AUCUNE OMBRE PORTÉE. Il en avait une, héritée d'avant le système
   * Modernist, qui n'en emploie nulle part : c'est le filet de 2 px et
   * l'aplat de surface qui détachent le panneau du contenu.
   */
  /*
   * VOILE. Mesuré : le panneau se détachait de l'en-tête par 1,28 et du
   * contenu par 1,10, soit trois surfaces que l'œil confond. Un aplat sombre
   * posé sur la page creuse l'écart sans rien changer aux couleurs du
   * panneau, et dit du même coup que le reste attend.
   *
   * Ce n'est PAS une ombre portée, que le système Modernist proscrit : c'est
   * un aplat franc, uniforme, sans dégradé ni flou.
   *
   * Posé sous l'en-tête et non par-dessus : la barre, le logo et le bouton
   * restent nets, seule la page est voilée.
   */
  .voile {
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    /*
     * `100vh` moins la hauteur de l'en-tête, et non `100vh` tout court : le
     * pourcentage se rapporte ici au bloc de référence, qui est l'en-tête.
     *
     * Mesuré : posé à 100vh, le voile dépassait de 72 px sous la fenêtre et
     * allongeait d'autant une page courte, faisant apparaître une barre de
     * défilement pour rien. Un élément en absolu ne prend pas de place dans
     * le flux, mais il compte bien dans la zone défilable.
     *
     * `dvh` en second, voir le panneau. La ligne en `vh` sert de repli au
     * navigateur qui ne connaît pas cette unité.
     */
    height: calc(100vh - 100%);
    height: calc(100dvh - 100%);
    z-index: 9;
    background: color-mix(in srgb, #000 55%, transparent);
  }

  .panneau {
    position: absolute;
    left: 0;
    right: 0;
    top: 100%;
    z-index: 10;
    /* Une surface RELEVÉE, et non celle des cartes : le panneau flotte
       au-dessus de la page, il doit donc être plus clair qu'elle en thème
       sombre, et plus franc en thème clair. */
    background: color-mix(in srgb, var(--text) 7%, var(--surface));
    /* Le filet d'accent tient lieu de séparation avec l'en-tête : il dit que
       ce panneau appartient au menu ouvert, et non à la page. */
    border-top: 2px solid var(--accent);
    border-bottom: 2px solid var(--border);
    padding: var(--space-4) 0 var(--space-6);
    /*
     * Sur un petit téléphone, le panneau peut dépasser la hauteur de l'écran :
     * il défile alors au lieu de pousser le contenu hors de vue.
     *
     * `dvh` suit la hauteur réellement visible. Safari sur iOS donne à
     * `100vh` la hauteur de la fenêtre barres d'outils repliées : barres
     * affichées, le bas du panneau se trouve donc dessous, et le défilement
     * propre au panneau ne les replie pas. La ligne en `vh` sert de repli au
     * navigateur qui ne connaît pas `dvh`.
     */
    max-height: calc(100vh - 100%);
    max-height: calc(100dvh - 100%);
    overflow-y: auto;
    /*
     * LE RETRAIT DES RUBRIQUES, partagé par les titres de famille et par
     * l'intitulé « Apparence », qui s'alignent sur les icônes. 8 px au
     * téléphone, où chaque pixel de colonne compte, 12 px dès 48rem.
     */
    --retrait: var(--space-2);
  }

  @media (min-width: 48rem) {
    .panneau {
      --retrait: var(--space-3);
    }
  }

  /*
   * La rangée de réglage ouvre le panneau, séparée des rubriques par un filet.
   * Elle n'est pas un lien : on y agit sans quitter la page, d'où une forme
   * différente de celle des entrées du menu.
   */
  .reglages {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    margin-bottom: var(--space-4);
    padding-bottom: var(--space-4);
    border-bottom: 1px solid var(--border);
  }

  /* Sur l'axe des icônes : le retrait des rubriques, plus leur filet
     transparent d'un pixel. */
  .intitule-reglage {
    padding-left: calc(var(--retrait) + 1px);
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--step-0);
  }

  /*
   * LES TROIS FAMILLES : deux colonnes au téléphone, trois dès 48rem.
   *
   * Au téléphone, Classements et Outils s'empilent à gauche, Le site occupe
   * la droite. Empilées sur une seule colonne, les familles mesuraient 797 px,
   * et le panneau défilait : de 59 px sur un écran de 375 × 812, de 231 px
   * sur un écran de 360 × 640, Communauté restant hors de vue. Sur deux
   * colonnes, le panneau mesure 492 px et tient entier sur ces écrans.
   *
   * Le prix : deux libellés passent sur deux lignes, « Proposer une idée » et
   * « Communauté » avec son étiquette. Ils restent lisibles, voir l'alignement
   * de l'icône plus bas. Les deux colonnes ne s'écartent que de 8 px : chaque
   * rubrique porte déjà son propre retrait, de part et d'autre.
   *
   * DEUX COLONNES DÈS 22,5rem, soit 360 px, et une seule en dessous. Les mots
   * les plus longs, « Communauté » et « Compétitions », mesurent 104 px et
   * ne se coupent pas. Avec l'icône, ses 8 px d'écart, le retrait et le
   * filet, une rubrique demande 150 px, que la colonne offre dès 340 px de
   * largeur utile. À 320 px, elle n'en offre que 140, et le mot sortirait de
   * sa colonne. La bascule en rem suit la taille de texte choisie dans le
   * navigateur, qui agrandit aussi les mots.
   *
   * Dès 48rem, trois colonnes, la famille « Le site » un quart plus large que
   * les deux autres : « Communauté » et son étiquette y tiennent sur une ligne,
   * 258 px de colonne pour 240 px de rubrique, mesuré à 768 px de large.
   *
   * Les zones portent l'identifiant des familles de lib/navigation.
   */
  .familles {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    grid-template-areas:
      'classements'
      'outils'
      'site';
    align-items: start;
    gap: var(--space-4) var(--space-2);
  }

  @media (min-width: 22.5rem) {
    .familles {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      grid-template-areas:
        'classements site'
        'outils site';
    }
  }

  @media (min-width: 48rem) {
    .familles {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr) minmax(0, 1.25fr);
      grid-template-areas: 'classements outils site';
      column-gap: var(--space-8);
    }
  }

  .famille-classements {
    grid-area: classements;
  }
  .famille-outils {
    grid-area: outils;
  }
  .famille-site {
    grid-area: site;
  }

  .famille {
    min-width: 0;
  }

  /*
   * Le titre de famille, en capitales espacées et en petit corps, comme les
   * surtitres de l'accueil. En gris et non en accent : l'accent de texte ne
   * donne que 4,3:1 sur l'aplat relevé du panneau en thème clair, sous le
   * seuil d'un texte de cette taille.
   */
  .titre-famille {
    margin: 0 0 var(--space-1);
    padding-inline: calc(var(--retrait) + 1px);
    font-size: var(--step--1);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
  }

  /* Des lignes jointives, comme une liste : chaque rubrique fait déjà 44 px. */
  .famille ul {
    display: grid;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  /*
   * L'ICÔNE SUR LA PREMIÈRE LIGNE DU LIBELLÉ, et non au milieu du bloc.
   * Centrée, elle flottait entre les deux lignes d'un libellé replié, au lieu
   * de marquer le début de la rubrique.
   *
   * D'où `flex-start`, et un rembourrage vertical calculé pour qu'une ligne
   * seule, filets compris, fasse exactement 44 px : (44 px − 2 px − une
   * ligne) / 2, soit 8 px à 375 px de large. Une rubrique d'une ligne reste
   * donc centrée dans sa cible. La ligne vaut 1,6 em, écrit ici pour que le
   * calcul ne dépende pas d'un héritage. `max()` garde 4 px au moins quand le
   * visiteur agrandit le texte. L'icône descend de la moitié de l'écart entre
   * la ligne et ses 20 px.
   *
   * 8 px entre l'icône et le libellé, comme dans la barre et au pied de page.
   *
   * Le rayon ordinaire du site, le panneau n'ayant pas d'angles arrondis dans
   * lesquels ces liens seraient emboîtés.
   */
  .famille a {
    display: flex;
    align-items: flex-start;
    gap: var(--space-2);
    min-height: var(--cible-min);
    padding: max(var(--space-1), calc((var(--cible-min) - 2px - 1.6em) / 2)) var(--retrait);
    border: 1px solid transparent;
    border-radius: var(--radius);
    color: var(--muted);
    font-size: var(--step-0);
    line-height: 1.6;
  }

  .famille a > :global(.icone) {
    margin-top: calc((1.6em - 20px) / 2);
  }

  /* La bordure existe déjà, transparente : sans elle, le survol décalerait le
     texte d'un pixel en faisant apparaître un filet. */
  .famille a:hover {
    border-color: var(--accent);
    background: var(--surface);
    color: var(--text);
  }

  .famille a[aria-current] {
    border-color: var(--border);
    background: color-mix(in srgb, var(--accent) 10%, transparent);
    color: var(--accent);
  }

  /* L'étiquette « Bientôt » passe à la ligne sous le libellé quand la
     colonne manque de place, au lieu de déborder de la rubrique. */
  .famille .intitule {
    min-width: 0;
    font-weight: 700;
    color: var(--text);
  }

  /*
   * Sous 48rem, les onglets cèdent la place au seul bouton de menu. Au-dessus,
   * les deux cohabitent : les trois rubriques de la barre en accès direct, et
   * le menu pour l'ensemble.
   *
   * 48rem et non plus 52rem. Mesuré à 768 px, logo, onglets et bouton
   * demandent 668 px pour 736 px de largeur utile. Les anciens libellés,
   * « Classement officiel », « Communauté » et « Comparer », en demandaient
   * 754 : ils ne pouvaient pas descendre jusque-là.
   */
  @media (max-width: 47.99rem) {
    .nav-large {
      display: none;
    }
  }

  /* ----------------------------------------------------------------------
   * Retour en haut
   * -------------------------------------------------------------------- */

  .haut {
    position: fixed;
    right: var(--space-4);
    bottom: var(--space-4);
    z-index: 4;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 50%;
    border: 2px solid var(--border);
    background: var(--surface);
    color: var(--text);
    text-decoration: none;
    box-shadow: 0 6px 20px rgb(0 0 0 / 0.25);
  }
  .haut:hover {
    border-color: var(--accent);
    color: var(--accent);
  }
  .haut svg {
    width: 1.4rem;
    height: 1.4rem;
  }
  /* `hidden` doit l'emporter sur `display: flex`, sinon le bouton resterait
     visible dès le haut de page. */
  .haut[hidden] {
    display: none;
  }

  .barre {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    padding-block: var(--space-3);
  }

  /*
   * Le logo est un lien vers l'accueil : il relève de la règle des 44 px. Il
   * mesurait 26 px de haut à 375 px de large, 31 à 1 280, le dessin seul
   * faisant la cible. La boîte du lien grandit autour de lui, le dessin
   * garde sa taille et sa place, centré comme avant dans la barre. La barre
   * ne grandit pas : le bouton Menu y mesure déjà 46 px.
   */
  .marque {
    display: inline-flex;
    align-items: center;
    min-height: var(--cible-min);
    font-size: var(--step-1);
    color: var(--text);
    flex-shrink: 0;
  }

  .nav-large {
    flex: 1;
    min-width: 0;
  }

  /*
   * AUCUN `overflow-x` sur cette liste. Il datait du temps où la barre
   * défilait de côté sur téléphone, et il rognait le contour de focus des
   * onglets : la liste n'étant pas plus haute qu'eux, seuls les deux bords
   * verticaux du contour restaient visibles, mesuré à 1 280 px. Les trois
   * onglets tiennent désormais sans défiler partout où ils s'affichent.
   */
  .nav-large ul {
    display: flex;
    gap: var(--space-1);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  /*
   * Les onglets s'affichent dès 48rem, soit 768 px : une tablette en portrait
   * y est, et c'est un écran tactile. Ils relèvent donc bien de la règle des
   * 44 px.
   *
   * Le passage en `flex` sert uniquement à recentrer le libellé une fois la
   * hauteur imposée ; sans lui il collerait en haut de l'onglet.
   */
  .nav-large a {
    display: flex;
    align-items: center;
    /* L'icône colle au libellé qu'elle accompagne : 8 px les lient sans les
       confondre avec la rubrique voisine, qui est bien plus loin. */
    gap: var(--space-2);
    min-height: var(--cible-min);
    padding: var(--space-2) var(--space-3);
    border-radius: var(--radius);
    color: var(--muted);
    white-space: nowrap;
    /* La taille du corps de texte, et non un cran en dessous : les rubriques
       étaient à 14 px, ce qui les rendait moins lisibles que le contenu
       qu'elles annoncent. */
    font-size: var(--step-0);
    font-weight: 600;
  }

  .nav-large a:hover {
    color: var(--text);
    background: var(--surface);
  }

  .nav-large a[aria-current] {
    color: var(--accent);
    background: color-mix(in srgb, var(--accent) 12%, transparent);
  }

  main {
    padding-top: var(--space-8);
  }
</style>

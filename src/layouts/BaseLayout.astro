---
/**
 * Gabarit commun à toutes les pages : en-tête, navigation, pied de page, méta.
 */
import BanniereConsentement from '../components/BanniereConsentement.astro';
import Icone from '../components/Icone.astro';
import Logo from '../components/Logo.astro';
import SiteFooter from '../components/SiteFooter.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
import { rubriquesPrincipales, rubriquesSecondaires } from '../lib/navigation';
import { version } from '../../package.json';
// Les déclarations de polices d'abord : tokens.css s'en sert immédiatement.
import '../styles/fonts.css';
import '../styles/tokens.css';
/* Après les jetons, qu'elle emploie. Voir l'en-tête du fichier : c'est la
   grammaire commune aux sept listes du site. */
import '../styles/listes.css';

interface Props {
  titre: string;
  description: string;
  /** Titre de l'onglet. Par défaut « <titre> | SBD.re ». */
  titreOnglet?: string;
  /**
   * Image de partage, chemin absolu depuis la racine du site.
   * Sans elle, aucune balise `og:image` n'est émise : mieux vaut pas d'image
   * du tout qu'une balise pointant vers un fichier inexistant, que les réseaux
   * sociaux mettent en cache durablement.
   */
  image?: string;
  imageAlt?: string;
}

/**
 * Image de partage par défaut, en attente du système de design.
 *
 * Dès que le logo sera prêt : déposer le fichier dans `public/`, renseigner
 * cette constante, et toutes les pages en hériteront. Format recommandé
 * 1200 × 630 pixels, en PNG ou JPEG. Le SVG est mal pris en charge par les
 * réseaux sociaux.
 */
const IMAGE_PARTAGE_DEFAUT: string | null = null;

const { titre, description, titreOnglet, image, imageAlt } = Astro.props;

const canonique = new URL(Astro.url.pathname, Astro.site);
const chemin = Astro.url.pathname;

// Les réseaux sociaux exigent une URL absolue : un chemin relatif est ignoré.
const imagePartage = image ?? IMAGE_PARTAGE_DEFAUT;
const imageAbsolue = imagePartage ? new URL(imagePartage, Astro.site).href : null;

/** Identifiant du projet Microsoft Clarity, pour la mesure d'audience. */
const CLARITY_ID = 'xtvqmm4cxo';

/**
 * L'en-tête ne porte que les TROIS entrées principales.
 *
 * Le reste vit dans le menu du téléphone et dans le pied de page. Une
 * navigation qui montre tout ne met rien en avant : huit rubriques alignées
 * laissaient le visiteur choisir sans indice, et débordaient de l'écran sur
 * téléphone.
 *
 * Le partage entre principales et secondaires est déclaré dans
 * lib/navigation, avec les libellés, les adresses et les icônes. Ajouter une
 * rubrique au site se fait là-bas, et nulle part ailleurs.
 */
const liensPrincipaux = rubriquesPrincipales;
const liensSecondaires = rubriquesSecondaires;

const estActif = (href: string) => chemin === href || chemin.startsWith(href);
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titreOnglet ?? `${titre} | SBD.re`}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonique.href} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="SBD.re" />
    <meta property="og:title" content={titre} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonique.href} />
    <meta property="og:locale" content="fr_FR" />
    {
      imageAbsolue ? (
        <>
          <meta property="og:image" content={imageAbsolue} />
          <meta property="og:image:alt" content={imageAlt ?? titre} />
          <meta name="twitter:card" content="summary_large_image" />
          <meta name="twitter:image" content={imageAbsolue} />
        </>
      ) : (
        <meta name="twitter:card" content="summary" />
      )
    }

    {/*
      L'empreinte de version dans l'adresse n'est pas de la coquetterie.

      Ces deux fichiers ont un nom stable : leur contenu change, leur adresse
      non. Un navigateur qui a déjà vu l'ancien favicon le garde, et le
      `.htaccess` lui a longtemps interdit de revenir vérifier. Changer
      l'adresse est le SEUL moyen d'atteindre les visiteurs déjà venus.

      `version` vient de package.json, comme le badge du pied de page : un
      `npm version` suffit à distribuer un nouveau favicon à tout le monde.
    */}
    <link rel="icon" href={`/favicon.svg?v=${version}`} type="image/svg+xml" />
    <link rel="icon" href={`/favicon.ico?v=${version}`} sizes="32x32" />

    {/*
      Le navigateur ne découvre normalement une police qu'après avoir lu le CSS,
      qu'il doit lui-même d'abord télécharger : le texte s'affiche donc deux fois,
      d'abord en police système puis en Archivo. `preload` lance le
      téléchargement immédiatement, en parallèle du CSS.

      Un seul fichier depuis juillet 2026 : Archivo, variable sur la graisse et
      la largeur, remplace Oswald et Inter. Le préchargement s'en trouve allégé
      d'une requête.

      `crossorigin` est obligatoire pour les polices, même servies depuis le même
      domaine — sans lui le navigateur télécharge le fichier une seconde fois.
      Seuls les fichiers « latin » sont préchargés : « latin-ext » ne sert qu'à
      de rares caractères et reste chargé à la demande.
    */}
    <link
      rel="preload"
      href="/fonts/archivo-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    {/*
      Applique le thème AVANT le premier rendu.

      `is:inline` demande à Astro de laisser ce script tel quel, sans le
      regrouper dans un fichier externe : un fichier séparé serait chargé trop
      tard, et la page apparaîtrait en blanc une fraction de seconde avant de
      basculer en sombre. C'est le fameux « flash » — visible, désagréable, et
      la première chose qu'on remarque sur un site mal fait.
    */}
    <script is:inline>
      (function () {
        /*
         * Le sombre est le défaut, et le réglage du système n'est plus
         * consulté. Une majorité de machines sortent d'usine en clair : le
         * suivre revenait à servir un site clair à presque tout le monde.
         *
         * Seul un choix explicite, mémorisé par le bouton, fait autre chose.
         */
        try {
          document.documentElement.dataset.theme =
            localStorage.getItem('sbd-theme') || 'dark';
        } catch (e) {
          document.documentElement.dataset.theme = 'dark';
        }
      })();
    </script>

    {/*
      Mesure d'audience Microsoft Clarity, SOUS CONDITION DE CONSENTEMENT.

      Le script n'est pas posé ici : seule la fonction qui sait le charger l'est.
      Elle n'est appelée que si le visiteur a déjà accepté lors d'une visite
      précédente, ou lorsqu'il accepte via la bannière.

      Tant que rien n'est accepté, aucune requête ne part vers clarity.ms et
      aucun cookie n'est déposé. C'est ce que le RGPD et la doctrine de la CNIL
      exigent pour un outil qui enregistre les sessions et transmet les données
      à un tiers.
    */}
    <script is:inline define:vars={{ CLARITY_ID }}>
      window.sbdChargerMesure = function () {
        if (window.__sbdMesureChargee) return;
        window.__sbdMesureChargee = true;
        (function (c, l, a, r, i, t, y) {
          c[a] =
            c[a] ||
            function () {
              (c[a].q = c[a].q || []).push(arguments);
            };
          t = l.createElement(r);
          t.async = 1;
          t.src = 'https://www.clarity.ms/tag/' + i;
          y = l.getElementsByTagName(r)[0];
          y.parentNode.insertBefore(t, y);
        })(window, document, 'clarity', 'script', CLARITY_ID);
      };

      try {
        if (localStorage.getItem('sbd-mesure') === 'oui') window.sbdChargerMesure();
      } catch (e) {
        // Stockage indisponible : on ne charge rien, faute de consentement vérifiable.
      }
    </script>
  </head>

  <body>
    {/*
      Cible du bouton « retour en haut ».

      Elle a sa propre balise, et surtout PAS l'en-tête. `id="top"` était posé
      sur `.entete`, qui est en `position: sticky` : une fois la page défilée,
      sa boîte est déjà collée en haut de la fenêtre. Le navigateur en concluait
      qu'aucun défilement n'était nécessaire, et le bouton ne faisait rien. Il
      écrivait bien « #top » dans l'adresse, ce qui donnait l'illusion d'un lien
      valide, mais la page ne bougeait pas d'un pixel.

      Une ancre de retour en haut ne doit jamais viser un élément collant.
    */}
    <span id="top"></span>

    <a class="evitement" href="#contenu">Aller au contenu</a>

    <header class="entete">
      <div class="wrap barre">
        <a class="marque lien-nu" href="/" aria-label="SBD.re, accueil">
          <Logo />
        </a>

        <nav class="nav-large" aria-label="Navigation principale">
          <ul>
            {
              liensPrincipaux.map((lien) => (
                <li>
                  <a
                    class="lien-nu"
                    href={lien.href}
                    aria-current={estActif(lien.href) ? 'page' : undefined}
                  >
                    <Icone nom={lien.icone} />
                    {lien.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>

        {/*
          LE GRAND MENU, en <details> plutôt qu'en JavaScript.

          Le navigateur gère lui-même l'ouverture, la fermeture, le clavier et
          l'annonce aux lecteurs d'écran. Aucun piège au focus à écrire, et le
          menu fonctionne même si le JavaScript échoue. Il se referme tout seul
          au changement de page, puisque la page est rechargée.

          IL EXISTE À TOUTES LES LARGEURS, et non plus sur téléphone seulement.
          Les trois rubriques de la barre restent le chemin rapide ; les neuf
          autres n'étaient atteignables, sur grand écran, que par le pied de
          page. Chacune porte désormais une phrase qui dit ce qu'on y trouve :
          un intitulé seul demande de deviner, ce qui est précisément ce qu'on
          ne veut pas d'un menu.
        */}
        <details class="menu">
          <summary aria-label="Ouvrir le menu">
            <span class="barres-menu" aria-hidden="true"></span>
            <span class="mot-menu">Menu</span>
          </summary>

          {/* Voile sur le contenu, décoratif : il n'apporte aucune
              information, il retire seulement celle du dessous. */}
          <div class="voile" aria-hidden="true"></div>

          <div class="panneau">
            <nav class="wrap" aria-label="Navigation">
              <ul>
                {
                  [...liensPrincipaux, ...liensSecondaires].map((lien) => (
                    <li>
                      <a
                        class="lien-nu"
                        href={lien.href}
                        aria-current={estActif(lien.href) ? 'page' : undefined}
                      >
                        <Icone nom={lien.icone} taille={22} />
                        <span class="texte">
                          <span class="intitule">{lien.labelLong ?? lien.label}</span>
                          <span class="resume">{lien.resume}</span>
                        </span>
                      </a>
                    </li>
                  ))
                }
              </ul>
            </nav>
          </div>
        </details>

        <ThemeToggle />
      </div>
    </header>

    <main id="contenu">
      <slot />
    </main>

    <SiteFooter />
    <BanniereConsentement />

    {/*
      Retour en haut. C'est un LIEN vers l'ancre du haut de page, pas un bouton :
      sans JavaScript il fonctionne quand même, et le clavier le traite
      naturellement. Le script ne fait que le montrer une fois la page
      suffisamment défilée, pour qu'il n'encombre pas le premier écran.
    */}
    <a class="haut" href="#top" aria-label="Revenir en haut de la page" hidden>
      <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
        <path
          d="M12 5l7 7-1.4 1.4L13 8.8V20h-2V8.8l-4.6 4.6L5 12z"
          fill="currentColor"></path>
      </svg>
    </a>

    {/*
      FERMETURE DU GRAND MENU, en amélioration seulement.

      Un `<details>` ne se referme ni à la touche Échap, ni au clic à côté :
      le navigateur n'a rien prévu pour cela. Tant que le panneau était un
      petit menu de 14rem, on pouvait s'en passer ; en pleine largeur il
      couvre la page, et rester coincé dedans devient pénible.

      Ces quelques lignes n'ajoutent RIEN d'indispensable : sans JavaScript,
      le menu s'ouvre et se referme toujours par son propre bouton.
    */}
    <script is:inline>
      (() => {
        const menu = document.querySelector('details.menu');
        if (!menu) return;

        const fermer = () => {
          if (!menu.open) return;
          menu.open = false;
          // Le focus revient au bouton : sans cela il resterait dans un
          // panneau devenu invisible, et la tabulation repartirait du début.
          menu.querySelector('summary')?.focus();
        };

        document.addEventListener('keydown', (evenement) => {
          if (evenement.key === 'Escape') fermer();
        });

        /*
         * On ferme dès que le clic tombe HORS DU PANNEAU ET HORS DU BOUTON.
         *
         * Et non « hors du <details> » : le voile est un enfant de ce dernier,
         * si bien qu'un clic dessus aurait été compté comme un clic dedans.
         * Or voiler la page, c'est précisément inviter à cliquer à côté.
         */
        document.addEventListener('click', (evenement) => {
          if (!menu.open) return;
          const cible = evenement.target;
          if (cible.closest('.panneau') || cible.closest('summary')) return;
          fermer();
        });
      })();

      (() => {
        const bouton = document.querySelector('.haut');
        if (!bouton) return;

        // Un seuil généreux : sous 600 px de défilement, le haut de page est
        // encore à portée de pouce et le bouton ne servirait qu'à masquer du
        // contenu.
        const basculer = () => {
          bouton.hidden = window.scrollY < 600;
        };

        // `passive` indique au navigateur que l'écouteur ne bloquera jamais le
        // défilement : sans lui, il doit attendre l'exécution du script avant
        // de faire bouger la page, ce qui se sent au doigt sur téléphone.
        addEventListener('scroll', basculer, { passive: true });
        basculer();
      })();
    </script>
  </body>
</html>

<style>
  .evitement {
    position: absolute;
    left: -9999px;
    z-index: 10;
    padding: var(--space-3) var(--space-4);
    /*
     * L'APLAT, pas l'accent de texte. La distinction est tout sauf cosmétique.
     *
     * Ce bloc posait --accent en fond sous --on-accent : en thème clair, du
     * basalte #201e1d sur le jaune sombre #676700, soit 2.78:1. Sous le seuil,
     * sur le tout premier élément qu'atteint une navigation au clavier.
     *
     * --accent-fill est le jaune franc #d6d600, dont tokens.css documente
     * justement la paire avec le basalte. Mesuré après correction : 10.66:1.
     * Le thème sombre était indemne, les deux jetons y valant la même couleur.
     */
    background: var(--accent-fill);
    color: var(--on-accent);
    border-radius: 0 0 var(--radius) 0;
  }
  /* Le lien d'évitement n'apparaît qu'au clavier : il fait gagner un temps
     considérable à qui navigue sans souris, sans encombrer l'écran des autres. */
  .evitement:focus {
    left: 0;
    top: 0;
  }

  .entete {
    position: sticky;
    top: 0;
    z-index: 5;
    background: color-mix(in srgb, var(--bg) 85%, transparent);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--border);
  }

  /* ----------------------------------------------------------------------
   * Navigation : trois entrées sur grand écran, un menu sur téléphone.
   *
   * Les deux existent dans le HTML et c'est le CSS qui choisit. Basculer en
   * JavaScript imposerait d'attendre son exécution, avec un scintillement à
   * chaque chargement.
   * -------------------------------------------------------------------- */

  .menu {
    /*
     * Pousse le menu ET le bouton de thème contre le bord droit.
     *
     * Sur grand écran c'est la navigation, en `flex: 1`, qui occupe l'espace
     * disponible. Elle disparaît sur téléphone, et sans cette marge
     * automatique tout se tasserait à gauche contre le logo. Le bouton de
     * thème, dernier élément de la barre, se retrouve ainsi tout à droite et
     * le menu juste à sa gauche.
     *
     * VOLONTAIREMENT SANS `position: relative` : le panneau se cale alors sur
     * l'en-tête, qui est collante et fait donc bloc de référence, et peut
     * ainsi occuper toute la largeur de la fenêtre.
     */
    margin-left: auto;
  }

  .menu summary {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    /* 44 px de haut comme tout contrôle du site, et une taille de texte qui
       ne demande pas d'effort : le bouton était à 14 px. */
    min-height: var(--cible-min);
    padding: var(--space-2) var(--space-4);
    border: 2px solid var(--border);
    border-radius: var(--radius);
    color: var(--text);
    font-size: var(--step-0);
    font-weight: 700;
    cursor: pointer;
    /* Retire la flèche que Safari et Chrome ajoutent d'office. */
    list-style: none;
  }
  .menu summary::-webkit-details-marker {
    display: none;
  }
  .menu summary:hover {
    border-color: var(--accent);
    color: var(--accent);
  }
  .menu[open] summary {
    border-color: var(--accent);
    color: var(--accent);
  }

  /* Trois traits dessinés en dégradé plutôt qu'en trois éléments : un seul
     nœud dans le DOM pour la même image. */
  .barres-menu {
    width: 1.15em;
    height: 0.75em;
    background:
      linear-gradient(currentColor 0 0) 0 0 / 100% 2px no-repeat,
      linear-gradient(currentColor 0 0) 0 50% / 100% 2px no-repeat,
      linear-gradient(currentColor 0 0) 0 100% / 100% 2px no-repeat;
  }

  /*
   * LE PANNEAU PREND TOUTE LA LARGEUR, sous l'en-tête.
   *
   * Il était un menu déroulant de 14rem accroché au bord droit : douze
   * intitulés en colonne, sans rien dire de ce qu'ils contiennent. En pleine
   * largeur, les rubriques tiennent en deux ou trois colonnes, chacune avec sa
   * phrase, et l'ensemble se lit d'un coup d'œil.
   *
   * AUCUNE OMBRE PORTÉE. Il en avait une, héritée d'avant le système
   * Modernist, qui n'en emploie nulle part : c'est le filet de 2 px et
   * l'aplat de surface qui détachent le panneau du contenu.
   */
  /*
   * VOILE. Mesuré : le panneau se détachait de l'en-tête par 1,28 et du
   * contenu par 1,10, soit trois surfaces que l'œil confond. Un aplat sombre
   * posé sur la page creuse l'écart sans rien changer aux couleurs du
   * panneau, et dit du même coup que le reste attend.
   *
   * Ce n'est PAS une ombre portée, que le système Modernist proscrit : c'est
   * un aplat franc, uniforme, sans dégradé ni flou.
   *
   * Posé sous l'en-tête et non par-dessus : la barre, le logo et le bouton
   * restent nets, seule la page est voilée.
   */
  .voile {
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    /*
     * `100vh` moins la hauteur de l'en-tête, et non `100vh` tout court : le
     * pourcentage se rapporte ici au bloc de référence, qui est l'en-tête.
     *
     * Mesuré : posé à 100vh, le voile dépassait de 72 px sous la fenêtre et
     * allongeait d'autant une page courte, faisant apparaître une barre de
     * défilement pour rien. Un élément en absolu ne prend pas de place dans
     * le flux, mais il compte bien dans la zone défilable.
     */
    height: calc(100vh - 100%);
    z-index: 9;
    background: color-mix(in srgb, #000 55%, transparent);
  }

  .panneau {
    position: absolute;
    left: 0;
    right: 0;
    top: 100%;
    z-index: 10;
    /* Une surface RELEVÉE, et non celle des cartes : le panneau flotte
       au-dessus de la page, il doit donc être plus clair qu'elle en thème
       sombre, et plus franc en thème clair. */
    background: color-mix(in srgb, var(--text) 7%, var(--surface));
    /* Le filet d'accent tient lieu de séparation avec l'en-tête : il dit que
       ce panneau appartient au menu ouvert, et non à la page. */
    border-top: 2px solid var(--accent);
    border-bottom: 2px solid var(--border);
    padding: var(--space-4) 0 var(--space-6);
    /* Sur un téléphone, douze rubriques dépassent la hauteur de l'écran : le
       panneau défile au lieu de pousser le contenu hors de vue. */
    max-height: calc(100vh - 100%);
    overflow-y: auto;
  }

  .menu nav ul {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(18rem, 100%), 1fr));
    gap: var(--space-2);
    overflow: visible;
  }

  /*
   * Le rayon imbriqué n'a plus lieu d'être : le panneau occupe toute la
   * largeur et ne porte donc pas d'angles arrondis dans lesquels ces liens
   * seraient emboîtés. Ils reprennent le rayon ordinaire du site.
   */
  .menu nav a {
    /*
     * `flex` et non `block` depuis l'arrivée des icônes : l'icône doit rester
     * sur l'axe gauche et le libellé se replier à côté d'elle, pas dessous.
     * `align-items: start` plutôt que `center` : sur un libellé qui passe à
     * la ligne, une icône centrée verticalement flotterait entre les deux
     * lignes au lieu de marquer le début de la rubrique.
     */
    display: flex;
    align-items: start;
    gap: var(--space-3);
    padding: var(--space-3);
    border: 1px solid transparent;
    border-radius: var(--radius);
    white-space: normal;
  }

  /* La bordure existe déjà, transparente : sans elle, le survol décalerait le
     texte d'un pixel en faisant apparaître un filet. */
  .menu nav a:hover {
    border-color: var(--accent);
  }

  .menu nav a[aria-current='page'] {
    border-color: var(--border);
    background: color-mix(in srgb, var(--accent) 10%, transparent);
  }

  .menu .texte {
    display: grid;
    gap: 0.1rem;
    min-width: 0;
  }

  .menu .intitule {
    font-weight: 700;
    color: var(--text);
  }

  .menu .resume {
    font-size: var(--step--1);
    color: var(--muted);
  }

  /* Sous 52rem, les onglets cèdent la place au seul bouton de menu. Au-dessus,
     les deux cohabitent : les trois rubriques principales en accès direct, et
     le menu pour les neuf autres. */
  @media (max-width: 51.99rem) {
    .nav-large {
      display: none;
    }
  }

  /* ----------------------------------------------------------------------
   * Retour en haut
   * -------------------------------------------------------------------- */

  .haut {
    position: fixed;
    right: var(--space-4);
    bottom: var(--space-4);
    z-index: 4;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 50%;
    border: 2px solid var(--border);
    background: var(--surface);
    color: var(--text);
    text-decoration: none;
    box-shadow: 0 6px 20px rgb(0 0 0 / 0.25);
  }
  .haut:hover {
    border-color: var(--accent);

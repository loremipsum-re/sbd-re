---
import AnneesRecords from '../components/AnneesRecords.astro';
import IconeMouvement from '../components/IconeMouvement.astro';
import SpriteMouvements from '../components/SpriteMouvements.astro';
import InteractiveTable from '../components/InteractiveTable.astro';
import Repli from '../components/Repli.astro';
import Terme from '../components/Terme.astro';
import InfographieEquipement from '../components/infographies/InfographieEquipement.astro';
import InfographieRecords from '../components/infographies/InfographieRecords.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import {
  EQUIPMENT_GROUPS,
  LIFTS,
  compareWeightClass,
  type EquipmentGroup,
  type WeightClass,
} from '../lib/categories';
import { annee, kg } from '../lib/format';
import { SEXE_SLUG, classeSlug, listeCategories } from '../lib/categoriesPages';
import { equipementsPresents, recordsPour, type RecordEntry } from '../lib/records';
import { meetPath } from '../lib/slug';
import type { LiftKey, Sex } from '../lib/types';
import Partenaire from '../components/Partenaire.astro';

/**
 * Une grille par couple sexe et équipement, avec les catégories de poids en
 * lignes et les quatre mouvements en colonnes.
 *
 * C'est la forme classique d'un tableau de records, et la plus dense : on lit
 * d'un coup d'œil « chez les hommes, en Raw, en 93 kg, voilà les quatre
 * meilleures barres de l'île ». Découper mouvement par mouvement donnerait
 * seize grilles illisibles.
 */

const index = new Map<string, RecordEntry>();
for (const lift of LIFTS) {
  for (const rec of recordsPour(lift.id)) {
    index.set(`${lift.id}|${rec.sex}|${rec.weightClass.id}|${rec.equipment}`, rec);
  }
}

const equipements = equipementsPresents();
const sexes: { id: Sex; label: string }[] = [
  { id: 'M', label: 'Hommes' },
  { id: 'F', label: 'Femmes' },
];

/** Catégories possédant au moins un record pour ce couple sexe et équipement. */
function categoriesUtiles(sex: Sex, equipement: EquipmentGroup): WeightClass[] {
  const vues = new Map<string, WeightClass>();
  for (const lift of LIFTS) {
    for (const rec of recordsPour(lift.id)) {
      if (rec.sex !== sex || rec.equipment !== equipement) continue;
      vues.set(rec.weightClass.id, rec.weightClass);
    }
  }
  return [...vues.values()].sort(compareWeightClass);
}

const grilles = equipements
  .flatMap((equipement) =>
    sexes.map((sexe) => ({
      equipement,
      sexe,
      categories: categoriesUtiles(sexe.id, equipement),
    })),
  )
  // Une section vide vaut moins qu'une section absente : mieux vaut aucune
  // grille qu'une grille de tirets.
  .filter((t) => t.categories.length > 0);

/*
 * Le compteur du composant dénombre des LIGNES, et une ligne vaut ici une
 * catégorie de poids, pas un record. Annoncer « 101 records » puis retomber à
 * « 26 » après une recherche laisserait croire à un bug : on compte donc des
 * catégories, ce que le tableau affiche réellement.
 */
const totalLignes = grilles.reduce((n, g) => n + g.categories.length, 0);

/*
 * LES CATÉGORIES DU FILTRE SONT L'UNION DE CELLES DES QUATRE GRILLES, chacune
 * portant les sexes où elle existe. Le composant s'en sert pour masquer une
 * option devenue sans objet : choisir « Femmes » puis « −105 kg » donnerait
 * sinon une page vide sans qu'on comprenne pourquoi.
 */
const categoriesFiltre = [...
  grilles
    .flatMap((g) => g.categories.map((c) => ({ classe: c, sexe: g.sexe.id })))
    .reduce((acc, { classe, sexe }) => {
      const vue = acc.get(classe.id) ?? { classe, sexes: new Set<Sex>() };
      vue.sexes.add(sexe);
      return acc.set(classe.id, vue);
    }, new Map<string, { classe: WeightClass; sexes: Set<Sex> }>())
    .values(),
].sort((a, b) => compareWeightClass(a.classe, b.classe));

/*
 * Une catégorie n'a sa propre page que si elle a été disputée en full power.
 * Les catégories qui n'existent qu'au développé couché n'en ont donc pas, et
 * leur libellé reste du texte : un lien mort vaut moins qu'un mot.
 */
const pagesCategories = new Set(listeCategories().map((c) => c.chemin));
const cheminCategorie = (sex: Sex, id: string) => `${SEXE_SLUG[sex]}/${classeSlug(id)}`;

const libelleEquipement = (id: EquipmentGroup) =>
  EQUIPMENT_GROUPS.find((e) => e.id === id)?.label ?? id;

/*
 * Intitulés COURTS pour les cartes. « Développé couché » tient sur deux lignes
 * dans une colonne de 140 px, et l'en-tête de colonne qui le portait en entier
 * disparaît justement en mode carte. Mêmes abréviations que l'historique d'une
 * fiche, pour qu'un visiteur ne réapprenne rien d'une page à l'autre.
 */
const COURT: Record<LiftKey, string> = {
  squat: 'Squat',
  bench: 'DC',
  deadlift: 'SDT',
  total: 'Total',
};

const recordDe = (lift: LiftKey, sex: Sex, categorie: string, equipement: EquipmentGroup) =>
  index.get(`${lift}|${sex}|${categorie}|${equipement}`);
---

<BaseLayout
  titre="Records de La Réunion"
  description="Records officiels de force athlétique à La Réunion, par mouvement, sexe, catégorie de poids et équipement. Squat, développé couché, soulevé de terre et total."
>
  <SpriteMouvements />
    <div class="wrap">
    {/*
      L'EN-TÊTE PORTE L'ÂGE DES RECORDS, à droite du chapeau sur ordinateur,
      dessous sur téléphone. Il dit d'un regard lesquels tiennent depuis
      longtemps, ce que les cases des grilles ne disent qu'une à une.

      COÛT MESURÉ le 28 octobre 2026 : la première grille descend de 78 px à
      1 280 px, où les colonnes partagent la hauteur du chapeau, et de 140 px
      à 375 px, les pastilles y regagnant une ligne.
    */}
    <header class="entete-page entete-records">
      <h1>Records de La Réunion</h1>
      {/*
        UN SEUL CHAPEAU, COURT. Les deux paragraphes d'avant occupaient 560 px
        sur un téléphone, et les commandes n'apparaissaient qu'au bas du
        premier écran. Le mode d'emploi est parti : des boutons qui montrent
        leurs trois choix n'ont pas besoin d'être expliqués. La règle de calcul
        du développé couché vit dans la note sous les grilles, où elle sert à
        qui lit les chiffres.

        DEUX PHRASES, une par information : ce qu'est un record ici, puis ce
        que séparent les grilles. « Record » reste sans soulignement, le
        chapeau le définit.
      */}
      <p class="chapeau">
        Le record de chaque <Terme cle="categorie">catégorie</Terme> de poids,
        mouvement par mouvement, réalisé en compétition à La Réunion. Les grilles
        séparent hommes et femmes, <Terme cle="raw">raw</Terme> et{' '}
        <Terme cle="equipped">équipé</Terme>.
      </p>
      <AnneesRecords />
    </header>

    {/*
      L'ÉQUIPEMENT EN IMAGES, REPLIÉ. Une pastille de 44 px entre le chapeau
      et les commandes : le choix Raw ou Équipé se fait juste dessous, et qui
      ignore ce qui les sépare l'apprend avant de choisir.

      LES RECORDS DE L'ÎLE, REPLIÉS DANS LA MÊME RANGÉE. Les grilles donnent
      le record de chaque catégorie. L'image donne la barre la plus lourde de
      chaque mouvement, toutes catégories confondues, avec sa saison. Dépliée,
      elle mesure 1 487 px à 375 px de large et repousserait les commandes de
      près de deux écrans.

      LES PASTILLES NOMMENT LEUR QUESTION, et tiennent ainsi sur une ligne à
      375 px : 143 et 168 px, plus l'écart de 8, pour 343 disponibles, mesuré
      le 28 octobre 2026. « Raw, bandes et équipé en images » et « Records de
      l'île en images » prenaient deux lignes et 52 px de plus. À 320 px, la
      seconde passe encore dessous.
    */}
    <div class="rangee-replis">
      <Repli titre={'Raw ou équipé\u00a0?'}>
        <InfographieEquipement lienArticle="equipement" />
      </Repli>
      <Repli titre={'Qui soulève le plus\u00a0?'}>
        <InfographieRecords lienArticle="records" />
      </Repli>
    </div>

    <InteractiveTable
      recherche="Nom d'athlète, catégorie…"
      singulier="catégorie"
      pluriel="catégories"
      total={totalLignes}
    >
      {/*
        TROIS FILTRES, ET LA PAGE RESTE ENTIÈRE PAR DÉFAUT. Les cent quatre
        rangées sont toutes affichées au chargement : qui veut comparer le raw
        et l'équipé, ou simplement lire, ne perd rien. Qui cherche une
        catégorie précise la ramène à une seule rangée en deux choix.

        Des onglets auraient fait l'inverse : ils cachent la taxonomie, privent
        le navigateur de sa propre recherche sur la page, et n'existent nulle
        part ailleurs sur le site.

        Les filtres s'écrivent dans l'adresse, si bien qu'une grille filtrée se
        partage par un lien.
      */}
      <Fragment slot="filtres">
        {/*
          SEXE ET ÉQUIPEMENT EN BOUTONS À BASCULE, et non en menus déroulants.
          Mesuré le 24 octobre 2026 : atteindre « Femmes Raw 63 kg » demandait
          quatre à six gestes dans trois menus, ou 4,8 écrans de défilement sur
          un téléphone. Trois choix se lisent d'un coup d'œil et se prennent
          d'un seul geste, l'état restant visible.

          LE MENU RESTE, MASQUÉ : il est le moteur que le composant écoute.
          Les boutons radio écrivent sa valeur et déclenchent son `change`, si
          bien que l'adresse partageable, le menu Catégorie restreint par le
          sexe et l'affichage de tout par défaut fonctionnent sans qu'une
          ligne du composant ne change. Le script de synchronisation est en
          bas de page.
        */}
        <fieldset class="champ bascule" data-bascule>
          <legend>Sexe</legend>
          <div class="segments">
            <label>
              <input type="radio" name="bascule-sexe" value="" checked />
              <span>Tous</span>
            </label>
            {
              sexes.map((s) => (
                <label>
                  <input type="radio" name="bascule-sexe" value={s.id} />
                  <span>{s.label}</span>
                </label>
              ))
            }
          </div>
          <select data-filtre="sexe" hidden>
            <option value="">Tous</option>
            {sexes.map((s) => <option value={s.id}>{s.label}</option>)}
          </select>
        </fieldset>

        <fieldset class="champ bascule" data-bascule>
          <legend>Équipement</legend>
          <div class="segments">
            <label>
              <input type="radio" name="bascule-equipement" value="" checked />
              <span>Tous</span>
            </label>
            {
              equipements.map((e) => (
                <label>
                  <input type="radio" name="bascule-equipement" value={e} />
                  <span>{libelleEquipement(e)}</span>
                </label>
              ))
            }
          </div>
          <select data-filtre="equipement" hidden>
            <option value="">Tous</option>
            {
              equipements.map((e) => (
                <option value={e}>{libelleEquipement(e)}</option>
              ))
            }
          </select>
        </fieldset>

        <div class="champ">
          <label for="f-categorie">Catégorie</label>
          <select id="f-categorie" data-filtre="categorie" data-restreint-par="sexe">
            <option value="">Toutes</option>
            {
              categoriesFiltre.map(({ classe, sexes: presents }) => (
                <option value={classe.id} data-compatible={[...presents].join('')}>
                  {classe.label}
                </option>
              ))
            }
          </select>
        </div>
      </Fragment>
      {
        grilles.map(({ equipement, sexe, categories }) => (
          <section class="section" data-section-tableau>
            <h2>
              {sexe.label} <span class="equip">{libelleEquipement(equipement)}</span>
            </h2>

            <div class="liste liste-barres records">
              <table data-tableau>
                <thead>
                  <tr>
                    <th scope="col" data-tri data-type="nombre">
                      Catégorie
                    </th>
                    {LIFTS.map((l) => (
                      <th scope="col" class="nombre" data-tri data-type="nombre">
                        <IconeMouvement mouvement={l.id} taille={20} />
                        {l.label}
                      </th>
                    ))}
                  </tr>
                </thead>
                <tbody>
                  {categories.map((cat) => (
                    <tr
                      data-sexe={sexe.id}
                      data-equipement={equipement}
                      data-categorie={cat.id}
                    >
                      <th scope="row" class="categorie" data-valeur={cat.kg}>
                        {
                          pagesCategories.has(cheminCategorie(sexe.id, cat.id)) ? (
                            <a href={`/categories/${cheminCategorie(sexe.id, cat.id)}/`}>
                              {cat.label}
                            </a>
                          ) : (
                            cat.label
                          )
                        }
                      </th>
                      {LIFTS.map((l) => {
                        const rec = recordDe(l.id, sexe.id, cat.id, equipement);
                        return (
                          <td class="nombre" data-libelle={l.label} data-valeur={rec?.valueKg ?? ''}>
                            <span class="intitule">
                              <IconeMouvement mouvement={l.id} taille={18} />
                              {COURT[l.id]}
                            </span>
                            {rec ? (
                              <>
                                <span class="valeur num">{kg(rec.valueKg)}</span>
                                <a class="detenteur" href={`/athlete/${rec.slug}/`}>
                                  {rec.holder}
                                </a>
                                <a class="quand" href={`/competitions/${meetPath(rec.date, rec.meetName)}/`}>
                                  {annee(rec.date)}
                                </a>
                              </>
                            ) : (
                              <span class="absent">—</span>
                            )}
                          </td>
                        );
                      })}
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          </section>
        ))
      }
    </InteractiveTable>

    <p class="note">
      Le développé couché tient compte des compétitions dédiées à ce mouvement.
      Squat, soulevé de terre et <Terme cle="total">total</Terme> viennent du{' '}
      <Terme cle="full-power">full power</Terme>. Les résultats
      de squat seul et de soulevé de terre seul figurent sans catégorie de
      poids dans les données. Un tiret signale une catégorie où aucune
      performance n'a encore été enregistrée lors d'une compétition
      réunionnaise. Chaque{' '}
      <a href="/categories/">catégorie de poids</a> a aussi sa page, avec son
      classement et l'histoire de ses records.
    </p>

    <Partenaire emplacement="records" />
  </div>
</BaseLayout>

<script>
  /*
   * Les boutons radio pilotent le menu masqué, qui reste le moteur du filtre.
   *
   * L'ÉTAT INITIAL VIENT DE L'ADRESSE, lue ici directement et non recopiée
   * depuis le menu : l'ordre d'exécution des scripts n'est pas garanti, et le
   * composant peut lire l'adresse avant ou après celui-ci. Une même source,
   * lue deux fois, donne le même résultat quel que soit l'ordre.
   *
   * LE CHEMIN INVERSE EXISTE AUSSI. La barre peut vider le menu sans passer
   * par les radios : une étiquette « Femmes » retirée, « Réinitialiser »,
   * « Tout afficher ». Elle émet alors `sbd:filtres`, et les radios
   * recopient le menu. Sans cela, « Femmes » restait coché sur une grille
   * qui montrait tout le monde.
   */
  for (const groupe of document.querySelectorAll<HTMLFieldSetElement>('[data-bascule]')) {
    const menu = groupe.querySelector<HTMLSelectElement>('select[data-filtre]');
    const boutons = groupe.querySelectorAll<HTMLInputElement>('input[type="radio"]');
    if (!menu) continue;

    const valeurs = new Set(Array.from(menu.options, (o) => o.value));
    const demande = new URLSearchParams(location.search).get(menu.dataset.filtre ?? '') ?? '';
    const initial = valeurs.has(demande) ? demande : '';
    for (const bouton of boutons) bouton.checked = bouton.value === initial;

    for (const bouton of boutons) {
      bouton.addEventListener('change', () => {
        if (!bouton.checked) return;
        menu.value = bouton.value;
        menu.dispatchEvent(new Event('change'));
      });
    }

    groupe.closest('[data-tableau-interactif]')?.addEventListener('sbd:filtres', () => {
      for (const bouton of boutons) bouton.checked = bouton.value === menu.value;
    });
  }
</script>

<style>
  /*
   * LES BOUTONS À BASCULE vivent dans src/styles/filtres.css, avec le reste
   * de la barre : une commande segmentée de 44 px, au filet et au rayon des
   * menus voisins, dont le segment choisi prend l'aplat d'accent. Un
   * `<fieldset>` par critère, sa `<legend>` tenant lieu d'étiquette.
   */

  /*
   * L'EN-TÊTE SUR DEUX COLONNES dès 60rem : le chapeau à gauche, l'âge des
   * records à droite, calés sur leur haut, le chapeau restant collé au titre.
   * Dessous, les colonnes suivent le chapeau à l'écart d'un paragraphe, la
   * marge que tokens.css lui donne quand un bloc le suit.
   */
  @media (min-width: 60rem) {
    .entete-records {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(18rem, 26rem);
      column-gap: var(--space-12);
      align-items: start;
    }

    .entete-records h1 {
      grid-column: 1 / -1;
    }

    .entete-records .chapeau {
      margin-bottom: 0;
    }
  }

  .section {
    margin-bottom: var(--space-12);
  }

  .section h2 {
    display: flex;
    align-items: baseline;
    gap: var(--space-3);
    margin-bottom: var(--space-4);
  }

  .equip {
    font-family: var(--font-body);
    font-size: var(--step--1);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--accent);
    padding: var(--space-1) var(--space-2);
    border: 1px solid var(--accent);
    border-radius: var(--radius);
  }

  /*
   * La forme de la liste vit dans src/styles/listes.css. Ne restent ici que
   * les trois morceaux propres à une grille de records : la marque, son
   * détenteur et son année, qui cohabitent dans une même cellule.
   */

  .valeur {
    display: block;
    font-size: var(--step-1);
    line-height: 1.1;
  }

  /* Le nom passe à la ligne : la cellule d'un nombre interdit le retour, et
     à 320 px « Christan Pounoussamy » recouvrait le nom de la colonne
     voisine, mesuré le 27 octobre 2026. */
  .detenteur {
    display: block;
    font-size: var(--step--1);
    color: var(--muted);
    white-space: normal;
  }
  .detenteur:hover {
    color: var(--accent);
  }

  .quand {
    font-size: var(--step--1);
    color: var(--muted);
  }
  .quand:hover {
    color: var(--accent);
  }

  .absent {
    color: var(--muted);
    font-size: var(--step-1);
  }

  /*
   * LA CATÉGORIE EST L'IDENTITÉ DE LA RANGÉE, et elle était ce qu'il y avait
   * de plus faible à l'écran : un petit texte dans une colonne étroite, à
   * côté de quatre cellules denses. Elle passe en gros caractères et reçoit un
   * filet d'accent, qui sert de repère quand l'œil descend les vingt-six
   * catégories.
   */
  .categorie {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--step-1);
    white-space: nowrap;
  }

  /*
   * La colonne des catégories se détache par un APLAT DISCRET plutôt que par
   * un filet d'accent. Vingt-six rangées par tableau et quatre tableaux font
   * cent quatre filets, soit un rail jaune continu sur toute la page : la
   * couleur d'accent perd son sens à être répétée autant.
   */
  @media (min-width: 60rem) {
    .liste.records tbody .categorie {
      background: color-mix(in srgb, var(--text) 5%, transparent);
    }
  }

  /*
   * DEUX MARQUES PAR RANGÉE EN CARTES, et non une seule.
   *
   * Une marque tient trois lignes, la charge, son détenteur et son année. Les
   * empiler une par rangée donnait des cartes de 395 px et une page de
   * 12 757 px sur un téléphone, mesuré. Rangées deux par deux, avec l'intitulé
   * et son icône au-dessus, les quatre marques tiennent en deux rangées.
   */
  .liste.liste-barres.records {
    --pas: 3;
  }

  @media (max-width: 59.999rem) {
    /* La catégorie ouvre la carte sur toute sa largeur, comme la date ouvre
       celle d'un historique. */
    .liste.records tbody .categorie {
      grid-column: 1 / -1;
      font-size: var(--step-1);
    }

    /* Les trois éléments d'une marque s'empilent dans leur colonne. */
    .liste.records tbody td[data-libelle] .valeur,
    .liste.records tbody td[data-libelle] .detenteur,
    .liste.records tbody td[data-libelle] .quand {
      display: block;
    }

    .liste.records tbody td[data-libelle] .quand {
      margin-top: 2px;
    }
  }

</style>

---
import BadgeOfficiel from '../../../components/BadgeOfficiel.astro';
import Coupe from '../../../components/Coupe.astro';
import InteractiveTable from '../../../components/InteractiveTable.astro';
import Medaille from '../../../components/Medaille.astro';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import {
  EQUIPMENT_GROUPS,
  compareWeightClass,
  equipmentGroup,
  equipmentLabel,
  parseWeightClass,
  sexLabel,
} from '../../../lib/categories';
import { articlesDeLaCompetition } from '../../../lib/actualites';
import { dateLongue, nombre, place, points } from '../../../lib/format';
import { editionsDe, libelleEvent, listeMeets, resultatsDuMeet } from '../../../lib/meets';
import { cleRecord, clesRecords } from '../../../lib/records';
import { athleteSlug } from '../../../lib/slug';
import type { LiftKey, Metal, Result } from '../../../lib/types';

export async function getStaticPaths() {
  return listeMeets().map((meet) => ({
    params: { nom: meet.nomSlug, date: meet.date },
    props: { meet },
  }));
}

const { meet } = Astro.props;
const articlesDuMeet = await articlesDeLaCompetition(meet.chemin);
const resultats = resultatsDuMeet(meet.key);
const records = clesRecords();
const autresEditions = editionsDe(meet.nomSlug).filter((e) => e.date !== meet.date);

const aDuFullPower = meet.events.includes('SBD');
const hommes = resultats.filter((r) => r.sex === 'M').length;
const femmes = resultats.filter((r) => r.sex === 'F').length;

const estRecord = (r: Result, lift: LiftKey) =>
  records.has(cleRecord(lift, r.name, r.date, r.meetName));

/**
 * Médaille du podium, décernée par CATÉGORIE et non sur l'ensemble du plateau.
 *
 * Une compétition de force athlétique se dispute catégorie par catégorie : il y
 * a autant de premières places que de catégories engagées. Attribuer une seule
 * médaille d'or au meilleur total de la journée serait un contresens sportif.
 */
const METAUX: Metal[] = ['or', 'argent', 'bronze'];
const medailleDe = (r: Result): Metal | null => {
  const rang = Number.parseInt(r.place, 10);
  return Number.isFinite(rang) && rang >= 1 && rang <= 3 ? METAUX[rang - 1] : null;
};

/*
 * Filtres alignés sur ceux du classement : sexe, catégorie, équipement,
 * division et âge. Les valeurs sont tirées de CETTE compétition, pour ne jamais
 * proposer un filtre qui ne renverrait rien.
 */
const sexesParClasse = new Map<string, Set<string>>();
for (const r of resultats) {
  if (!r.weightClassKg) continue;
  const set = sexesParClasse.get(r.weightClassKg) ?? new Set<string>();
  set.add(r.sex);
  sexesParClasse.set(r.weightClassKg, set);
}

const categories = [...sexesParClasse.entries()]
  .map(([id, sexes]) => ({ id, classe: parseWeightClass(id)!, sexes: [...sexes].sort().join('') }))
  .filter((c) => c.classe)
  .sort((a, b) => compareWeightClass(a.classe, b.classe));

const equipements = [...new Set(resultats.map((r) => equipmentGroup(r.equipment)))];
const divisions = [...new Set(resultats.map((r) => r.division).filter(Boolean))].sort((a, b) =>
  a.localeCompare(b, 'fr'),
);
const ages = [...new Set(resultats.map((r) => r.ageClass).filter(Boolean))].sort(
  (a, b) => Number.parseInt(a, 10) - Number.parseInt(b, 10),
);

const libelleEquipement = (id: string) =>
  EQUIPMENT_GROUPS.find((e) => e.id === id)?.label ?? id;

const description =
  `${meet.meetName}, ${dateLongue(meet.date)}` +
  (meet.meetTown ? ` à ${meet.meetTown}` : '') +
  `. Résultats complets des ${meet.athletes} powerlifters engagés.`;
---

<BaseLayout titre={meet.meetName} description={description}>
  <div class="wrap">
    <p class="fil"><a href="/competitions/">Toutes les compétitions</a></p>

    <header class="entete-page">
      <h1>{meet.meetName}</h1>
      <p class="lieu">
        {dateLongue(meet.date)}
        {meet.meetTown && <> à {meet.meetTown}</>}
      </p>
      <p class="formats">
        {meet.events.map((e) => <span class="format">{libelleEvent(e)}</span>)}
      </p>
    </header>

    {
      autresEditions.length > 0 && (
        <nav class="editions" aria-label="Autres éditions">
          <span>Autres éditions :</span>
          {autresEditions.map((e) => (
            <a href={`/competitions/${e.chemin}/`}>{e.date.slice(0, 4)}</a>
          ))}
        </nav>
      )
    }

    <dl class="stats">
      <div>
        <dt>Athlètes</dt>
        <dd class="num">{meet.athletes}</dd>
      </div>
      <div>
        <dt>Résultats</dt>
        <dd class="num">{meet.resultats}</dd>
      </div>
      <div>
        <dt>Hommes</dt>
        <dd class="num">{hommes}</dd>
      </div>
      <div>
        <dt>Femmes</dt>
        <dd class="num">{femmes}</dd>
      </div>
    </dl>

    <h2>Résultats</h2>

    <InteractiveTable
      recherche="Nom d'un athlète"
      singulier="résultat"
      pluriel="résultats"
      total={resultats.length}
      barreDeTri
    >
      <Fragment slot="filtres">
        <div class="champ">
          <label for="f-sexe">Sexe</label>
          <select id="f-sexe" data-filtre="sexe">
            <option value="">Tous</option>
            <option value="M">Hommes</option>
            <option value="F">Femmes</option>
          </select>
        </div>

        <div class="champ">
          <label for="f-categorie">Catégorie</label>
          <select id="f-categorie" data-filtre="categorie" data-restreint-par="sexe">
            <option value="">Toutes</option>
            {
              categories.map((c) => (
                <option value={c.id} data-compatible={c.sexes}>
                  {c.classe.label}
                </option>
              ))
            }
          </select>
        </div>

        {
          equipements.length > 1 && (
            <div class="champ">
              <label for="f-equipement">Équipement</label>
              <select id="f-equipement" data-filtre="equipement">
                <option value="">Tous</option>
                {equipements.map((e) => (
                  <option value={e}>{libelleEquipement(e)}</option>
                ))}
              </select>
            </div>
          )
        }

        {
          divisions.length > 1 && (
            <div class="champ">
              <label for="f-division">Division</label>
              <select id="f-division" data-filtre="division">
                <option value="">Toutes</option>
                {divisions.map((d) => (
                  <option value={d}>{d}</option>
                ))}
              </select>
            </div>
          )
        }

        {
          ages.length > 1 && (
            <div class="champ">
              <label for="f-age">Âge</label>
              <select id="f-age" data-filtre="age">
                <option value="">Tous</option>
                {ages.map((a) => (
                  <option value={a}>{a} ans</option>
                ))}
              </select>
            </div>
          )
        }
      </Fragment>

      <div class="cadre">
        <table data-tableau>
          <thead class="sr-only">
            <tr>
              <th scope="col" data-tri data-cle="triPlace" data-type="nombre">Place</th>
              <th scope="col" data-tri data-cle="nom">Nom</th>
              <th scope="col" data-tri data-cle="triCategorie" data-type="nombre">Catégorie</th>
              <th scope="col" data-tri data-cle="poids" data-type="nombre">Poids de corps</th>
              <th scope="col" data-tri data-cle="squat" data-type="nombre">Squat</th>
              <th scope="col" data-tri data-cle="bench" data-type="nombre">Développé couché</th>
              <th scope="col" data-tri data-cle="deadlift" data-type="nombre">Soulevé de terre</th>
              <th scope="col" data-tri data-cle="total" data-type="nombre">Total</th>
              <th scope="col" data-tri data-cle="dots" data-type="nombre">Dots</th>
            </tr>
          </thead>
          <tbody>
            {
              resultats.map((r) => {
                const classe = parseWeightClass(r.weightClassKg);
                const metal = medailleDe(r);
                const estFullPower = r.event === 'SBD';
                return (
                  <tr
                    data-recherche={r.name}
                    data-nom={r.name}
                    data-tri-place={Number.parseInt(r.place, 10) || 999}
                    data-tri-categorie={classe?.kg ?? ''}
                    data-poids={r.bodyweightKg ?? ''}
                    data-squat={r.bestSquatKg ?? ''}
                    data-bench={r.bestBenchKg ?? ''}
                    data-deadlift={r.bestDeadliftKg ?? ''}
                    data-total={estFullPower ? (r.totalKg ?? '') : ''}
                    data-dots={estFullPower ? (r.dots ?? '') : ''}
                    data-sexe={r.sex}
                    data-categorie={r.weightClassKg}
                    data-equipement={equipmentGroup(r.equipment)}
                    data-division={r.division}
                    data-age={r.ageClass}
                    data-podium={metal ?? undefined}
                  >
                    <td class="place" data-metal={metal ?? undefined}>
                      {metal ? (
                        <Medaille metal={metal} detail={`${place(r.place)} de sa catégorie`} taille={26} />
                      ) : (
                        <span class="place-num">{place(r.place)}</span>
                      )}
                    </td>

                    <th scope="row" class="nom">
                      <a href={`/athlete/${athleteSlug(r.name)}/`}>{r.name}</a>
                      <BadgeOfficiel taille={14} />
                    </th>

                    <td class="ligne contexte">
                      <span>{sexLabel(r.sex)}</span>
                      <span>{equipmentLabel(equipmentGroup(r.equipment))}</span>
                      {r.division && <span>{r.division}</span>}
                      {r.ageClass && <span>{r.ageClass} ans</span>}
                    </td>

                    <td class="ligne physique">
                      <span>{r.weightClassKg ? `${r.weightClassKg} kg` : 'catégorie inconnue'}</span>
                      <span>{nombre(r.bodyweightKg)} kg de corps</span>
                    </td>

                    <td class="ligne barres">
                      <span>
                        SQ <b class="num-tab">{nombre(r.bestSquatKg)}</b>
                        {r.bestSquatKg && estRecord(r, 'squat') && <Coupe metal="or" detail="Record du squat" taille={13} />}
                      </span>
                      <span>
                        DC <b class="num-tab">{nombre(r.bestBenchKg)}</b>
                        {r.bestBenchKg && estRecord(r, 'bench') && <Coupe metal="or" detail="Record du développé couché" taille={13} />}
                      </span>
                      <span>
                        SDT <b class="num-tab">{nombre(r.bestDeadliftKg)}</b>
                        {r.bestDeadliftKg && estRecord(r, 'deadlift') && <Coupe metal="or" detail="Record du soulevé de terre" taille={13} />}
                      </span>
                    </td>

                    <td class="ligne perf">
                      <span class="fort num-tab">
                        {estFullPower ? `${nombre(r.totalKg)} kg` : 'sans total'}
                        {estFullPower && estRecord(r, 'total') && <Coupe metal="or" detail="Record au total" taille={14} />}
                      </span>
                      {estFullPower && <span class="fort num-tab">{points(r.dots)} Dots</span>}
                    </td>
                  </tr>
                );
              })
            }
          </tbody>
        </table>
      </div>
    </InteractiveTable>

    <p class="note">
      Les médailles distinguent le podium <strong>de chaque catégorie</strong>,
      puisqu'une compétition se dispute catégorie par catégorie. La coupe
      signale une barre qui constitue aujourd'hui un record à La Réunion.
      {
        aDuFullPower
          ? ' Le total et les points Dots concernent le full power.'
          : ' Cette compétition portait sur un seul mouvement, le total et les points Dots ne s’y appliquent pas.'
      }
    </p>

    {
      /*
        Le lien RETOUR vers les articles. Rien ne se saisit ici : la liste vient
        du champ `competition` déclaré dans l'en-tête de chaque Markdown. Écrire
        un article suffit à le faire apparaître sur la compétition qu'il traite.
      */
      articlesDuMeet.length > 0 && (
        <section class="actus">
          <h2>Sur cette compétition</h2>
          <ul>
            {articlesDuMeet.map((a) => (
              <li>
                <a href={`/actualites/${a.id}/`}>{a.data.titre}</a>
                <span class="quand">
                  {dateLongue(a.data.date.toISOString().slice(0, 10))}
                </span>
              </li>
            ))}
          </ul>
        </section>
      )
    }
  </div>
</BaseLayout>

<style>
  .fil {
    font-size: var(--step--1);
    margin-bottom: var(--space-4);
  }

  .entete-page {
    margin-bottom: var(--space-4);
  }

  h1 {
    margin-bottom: var(--space-2);
  }

  .lieu {
    color: var(--muted);
    font-size: var(--step-1);
    margin-bottom: var(--space-3);
  }

  .formats {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin: 0;
  }

  .format {
    font-size: var(--step--1);
    font-weight: 600;
    padding: var(--space-1) var(--space-3);
    border: 1px solid var(--accent);
    border-radius: 999px;
    color: var(--accent);
  }

  .editions {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-3);
    margin-bottom: var(--space-6);
    font-size: var(--step--1);
    color: var(--muted);
  }

  .stats {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-4);
    margin: 0 0 var(--space-12);
    padding: var(--space-6);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: var(--surface);
  }

  @media (min-width: 48rem) {
    .stats {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .stats dt {
    font-size: var(--step--1);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--muted);
    margin-bottom: var(--space-1);
  }

  .stats dd {
    margin: 0;
    font-size: var(--step-2);
    line-height: 1;
  }

  .champ {
    display: grid;
    gap: var(--space-1);
    flex: 1 1 9rem;
  }

  label {
    font-size: var(--step--1);
    font-weight: 600;
    color: var(--muted);
  }

  select {
    padding: var(--space-2) var(--space-3);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--bg);
    color: var(--text);
    font: inherit;
    font-size: var(--step--1);
  }

  .cadre {
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: var(--surface);
    overflow: hidden;
  }

  table {
    width: 100%;
    border-collapse: collapse;
  }

  /* ---------- La carte, même structure que le classement ---------- */
  tbody tr {
    display: grid;
    grid-template-columns: 3.25rem 1fr;
    grid-template-areas:
      'place nom'
      'place contexte'
      'place physique'
      'place barres'
      'place perf';
    gap: var(--space-1) var(--space-3);
    padding: var(--space-4);
    border-bottom: 1px solid var(--border);
  }
  tbody tr:last-child {
    border-bottom: 0;
  }
  tbody tr:hover {
    background: color-mix(in srgb, var(--accent) 5%, transparent);
  }

  /* Une ligne de podium se remarque discrètement, sans écraser la liste. */
  tr[data-podium='or'] {
    background: color-mix(in srgb, var(--or) 7%, transparent);
  }
  tr[data-podium='argent'] {
    background: color-mix(in srgb, var(--argent) 6%, transparent);
  }
  tr[data-podium='bronze'] {
    background: color-mix(in srgb, var(--bronze) 6%, transparent);
  }

  td,
  th {
    padding: 0;
    text-align: left;
  }

  .place {
    grid-area: place;
    align-self: start;
    padding-top: 0.1em;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--step-2);
    line-height: 1;
    color: var(--muted);
    font-variant-numeric: tabular-nums;
  }

  .nom {
    grid-area: nom;
    display: flex;
    align-items: center;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--step-1);
    line-height: 1.15;
  }
  .nom a {
    color: var(--text);
  }
  .nom a:hover {
    color: var(--accent);
  }

  .ligne {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-1) var(--space-2);
    font-size: var(--step--1);
    color: var(--muted);
  }

  .contexte {
    grid-area: contexte;
  }
  .physique {
    grid-area: physique;
  }
  .barres {
    grid-area: barres;
  }
  .perf {
    grid-area: perf;
    margin-top: var(--space-1);
  }

  /* Séparateur décoratif, dans le CSS pour ne polluer ni la lecture à voix
     haute ni la recherche. */
  .ligne > *:not(:last-child)::after {
    content: '•';
    margin-left: var(--space-2);
    color: var(--border);
  }

  .barres b {
    color: var(--text);
    font-weight: 700;
  }

  .fort {
    color: var(--text);
    font-weight: 700;
    font-size: var(--step-0);
  }

  @media (min-width: 40rem) {
    tbody tr {
      grid-template-columns: 4rem 1fr;
      padding: var(--space-4) var(--space-6);
    }
    .place {
      font-size: var(--step-3);
    }
  }

  .note {
    margin-top: var(--space-4);
    font-size: var(--step--1);
    color: var(--muted);
    max-width: 68ch;
  }
  /* Articles rattachés à cette compétition. Le bloc n'existe que s'il y a
     quelque chose à montrer : voir la condition dans le gabarit. */
  .actus {
    margin-top: var(--space-12);
    padding-top: var(--space-6);
    border-top: 1px solid var(--border);
  }

  .actus h2 {
    font-size: var(--step-1);
    margin-bottom: var(--space-3);
  }

  .actus ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-1);
  }

  .actus > ul > li {
    min-width: 0;
  }

  .actus li a {
    display: flex;
    align-items: center;
    min-height: var(--cible-min);
    font-weight: 600;
  }

  .actus .quand {
    display: block;
    font-size: var(--step--1);
    color: var(--muted);
  }
</style>

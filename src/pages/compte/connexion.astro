---
/**
 * Se connecter. Le serveur ne dit pas lequel de l'adresse ou du mot de passe
 * est faux, et freine les essais en série (public/api/connexion.php).
 *
 * Page `prive` : ni indexée, ni mesurée.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import '../../styles/compte.css';
---

<BaseLayout
  titre="Se connecter"
  description="Se connecter à son compte SBD.re."
  prive
>
  <div class="wrap page-compte">
    <div class="colonne">
      <header class="entete-page">
        <h1>Se connecter</h1>
      </header>

      {/* Le résultat du lien de confirmation, posé par /api/verifier.php. */}
      <p class="etat-compte" data-retour role="status" aria-live="polite" hidden></p>

      <noscript>
        <p class="aide">Ce formulaire demande JavaScript.</p>
      </noscript>

      <form class="form-compte" data-connexion novalidate>
        <div class="champ">
          <label for="courriel">Adresse électronique</label>
          <input id="courriel" name="courriel" type="email" required autocomplete="email" />
        </div>

        <div class="champ">
          <label for="mot-de-passe">Mot de passe</label>
          <input
            id="mot-de-passe"
            name="mot_de_passe"
            type="password"
            required
            autocomplete="current-password"
          />
        </div>

        <div class="appat" aria-hidden="true">
          <label for="site">Ne remplissez pas ce champ</label>
          <input id="site" name="site" type="text" tabindex="-1" autocomplete="off" />
        </div>

        <div class="actions">
          <button type="submit">Se connecter</button>
        </div>

        <p class="etat-compte" data-etat role="status" aria-live="polite" hidden></p>
      </form>

      <ul class="liens-compte">
        <li><a href="/compte/mot-de-passe/">Mot de passe oublié</a></li>
        <li><a href="/compte/inscription/">Pas encore de compte ? En créer un</a></li>
      </ul>
    </div>
  </div>
</BaseLayout>

<script>
  import { afficher, api, brancher, champ } from '../../lib/api-compte';

  const form = document.querySelector<HTMLFormElement>('[data-connexion]')!;
  const retour = document.querySelector<HTMLElement>('[data-retour]')!;

  const adresse = new URLSearchParams(location.search).get('adresse');
  if (adresse === 'confirmee') {
    afficher(retour, 'Adresse confirmée. Votre compte est actif : connectez-vous.', true);
  } else if (adresse === 'lien-invalide') {
    afficher(
      retour,
      'Ce lien a expiré ou a déjà servi. Connectez-vous : un nouveau lien partira si le compte attend encore sa confirmation.',
      false,
    );
  }
  if (adresse) history.replaceState(null, '', location.pathname);

  brancher(
    form,
    (donnees) =>
      api('/api/connexion.php', 'POST', {
        courriel: champ(donnees, 'courriel'),
        mot_de_passe: champ(donnees, 'mot_de_passe'),
        site: champ(donnees, 'site'),
      }),
    () => location.assign('/compte/'),
  );
</script>

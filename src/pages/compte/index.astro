---
/**
 * L'accueil du membre : ses performances d'abord, puis où elles le
 * placeraient au classement officiel. Les réglages (profil, session,
 * effacement) se rangent derrière l'engrenage, à /compte/reglages/.
 * Demande de l'auteur du 7 novembre 2026. « Mes sujets » et « Sujets suivis »
 * ferment la page, rendus par `GET /api/moi.php` ; un sujet suivi se quitte
 * d'un bouton, qui coupe ses notifications et son récapitulatif.
 *
 * La page est statique et se remplit par `GET /api/performances.php`, qui
 * rend aussi les records, calculés par la même règle que le profil public.
 * Sans session, elle renvoie vers la connexion.
 *
 * LE TABLEAU DE BORD, demande de l'auteur du 10 novembre 2026 : l'avatar et
 * le pseudo en tête, quatre chiffres d'un coup d'œil (barres publiées,
 * vérifiées, en attente d'avis, notifications non lues), les raccourcis en
 * tuiles, puis deux colonnes dès 56rem : les performances à gauche, la
 * position, la fiche, les sujets à droite. Les non lues et la file de
 * l'admin viennent de la lecture de la cloche (évènement `sbd:compte`) :
 * aucune requête de plus.
 *
 * Page `prive` : ni indexée, ni mesurée.
 */
import FenetreConfirmation from '../../components/FenetreConfirmation.astro';
import Icone from '../../components/Icone.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { EQUIPMENT_GROUPS, LIFTS, compareWeightClass, parseWeightClass } from '../../lib/categories';
import '../../styles/compte.css';

/*
 * Les catégories de poids actuelles de la fédération, femmes et hommes
 * mêlées : le compte ne connaît pas le sexe du membre. Elles ne se recoupent
 * pas, ce qui permet de déduire le sexe de la catégorie pour situer le membre.
 * Le serveur n'en contrôle que la forme (lib/performances.php).
 */
const categories = ['47', '52', '57', '63', '69', '76', '84', '84+', '59', '66', '74', '83', '93', '105', '120', '120+']
  .map((c) => parseWeightClass(c)!)
  .sort(compareWeightClass);
const mouvements = LIFTS.filter((l) => l.id !== 'total');
---

<BaseLayout titre="Mon espace" description="L'espace membre de SBD.re." prive>
  <div class="wrap page-compte page-espace">
    <header class="entete-espace">
      <div class="identite-espace">
        <img class="avatar-espace" data-avatar alt="" width="64" height="64" hidden />
        <div>
          <h1>Mon espace</h1>
          <p class="chapeau" data-bonjour>Chargement du compte…</p>
        </div>
      </div>
      <div class="gestes-espace">
        <a class="lien-reglages" href="/compte/" data-lien-profil>
          <Icone nom="compte" />
          <span>Mon profil</span>
        </a>
        <a class="lien-reglages" href="/compte/reglages/">
          <Icone nom="reglages" />
          <span>Réglages</span>
        </a>
      </div>
    </header>

    <noscript>
      <p class="aide">Cette page demande JavaScript.</p>
    </noscript>

    <section data-compte hidden>
      <h2 class="sr-only">En bref</h2>
      <dl class="chiffres-espace">
        <div><dt>barres publiées</dt><dd data-chiffre="publiees">…</dd></div>
        <div class="chiffre-verifie"><dt>vérifiées</dt><dd data-chiffre="verifiees">…</dd></div>
        <div><dt>en attente d'avis</dt><dd data-chiffre="attente">…</dd></div>
        <div><dt>notifications non lues</dt><dd data-chiffre="notifications">…</dd></div>
      </dl>

      <nav class="tuiles-espace" aria-label="Raccourcis de l'espace">
        <ul>
          <li>
            <a href="#publier" data-aller-publier>
              <Icone nom="publier" />
              <span>Publier une barre</span>
            </a>
          </li>
          <li>
            <a href="/compte/a-verifier/">
              <Icone nom="valide" />
              <span>Vérifier des barres</span>
            </a>
          </li>
          <li>
            <a href="/compte/notifications/">
              <Icone nom="cloche" />
              <span>Notifications</span>
              <span class="pastille" data-pastille="notifications" hidden></span>
            </a>
          </li>
          <li>
            <a href="/forum/">
              <Icone nom="forum" />
              <span>Le forum</span>
            </a>
          </li>
          <li data-lien-admin hidden>
            <a href="/compte/admin/">
              <Icone nom="moderation" />
              <span>Modération</span>
              <span class="pastille" data-pastille="admin" hidden></span>
            </a>
          </li>
        </ul>
      </nav>

      <div class="tableau-espace">
        <div class="colonne-principale">
          <h2>Mes performances</h2>
          <ul class="liste-perfs-compte" data-liste-perfs></ul>
          <p class="aide" data-aucune-perf hidden>Aucune performance pour l'instant.</p>
          <p class="etat-compte" data-etat-perfs role="status" aria-live="polite" hidden></p>

          <details class="repli publier" id="publier" data-publier>
            <summary>Publier une performance</summary>
            <form class="form-compte" data-perf novalidate>
              <div class="champ">
                <label for="mouvement">Mouvement</label>
                <select id="mouvement" name="mouvement" required>
                  {mouvements.map((m) => <option value={m.id}>{m.label}</option>)}
                </select>
              </div>

              <div class="champ">
                <label for="equipement">Équipement</label>
                <select id="equipement" name="equipement" required>
                  {EQUIPMENT_GROUPS.map((e) => <option value={e.id}>{e.label}, {e.hint.toLowerCase()}</option>)}
                </select>
              </div>

              <div class="champ">
                <label for="charge">Charge, en kilos</label>
                <input id="charge" name="charge_kg" type="text" inputmode="decimal" required maxlength="6" />
              </div>

              <div class="champ">
                <label for="date-perf">Date</label>
                <input id="date-perf" name="date_performance" type="date" required min="2000-01-01" data-date-max />
              </div>

              <div class="champ">
                <label for="categorie">Catégorie de poids</label>
                <select id="categorie" name="categorie" aria-describedby="aide-categorie">
                  <option value="">Non précisée</option>
                  {categories.map((c) => <option value={c.id}>{c.label}</option>)}
                </select>
                <p class="aide" id="aide-categorie">
                  Facultative, mais c'est elle qui vous situe au classement.
                </p>
              </div>

              <div class="champ">
                <label for="video">Lien de la vidéo</label>
                <input
                  id="video"
                  name="lien_video"
                  type="url"
                  required
                  maxlength="500"
                  autocomplete="off"
                  aria-describedby="aide-video"
                />
                <p class="aide" id="aide-video">
                  Instagram, YouTube ou TikTok, et la barre en entier à l'image. Une
                  performance ne se modifie pas : pour la corriger, retirez-la et
                  publiez-la de nouveau.
                </p>
              </div>

              <div class="actions">
                <button type="submit">Publier la performance</button>
              </div>
              <p class="etat-compte" data-etat role="status" aria-live="polite" hidden></p>
            </form>
          </details>
        </div>

        <div class="colonne-cote">
          <section class="bloc-espace" aria-labelledby="titre-position">
            <h2 id="titre-position">Ma position</h2>
            <p class="aide">
              Où vos records vous placeraient au classement officiel de La Réunion,
              dans votre catégorie et votre équipement. Une barre de salle n'est pas
              une barre de compétition : arbitrage, pesée et tenue y changent tout.
              Le rang donne une idée, pas une place.
            </p>
            <ul class="positions" data-positions></ul>
            <ul class="liens-compte">
              <li><a href="/simulateur/">Me situer en détail</a></li>
            </ul>
          </section>

          <section class="bloc-espace" aria-labelledby="titre-fiche">
            <h2 id="titre-fiche">Ma fiche d'athlète</h2>
            <p class="aide" data-fiche-etat>Chargement…</p>
            <ul class="liens-compte" data-fiche-gestes hidden>
              <li><button type="button" class="secondaire" data-fiche-retirer></button></li>
            </ul>
          </section>

          <section class="bloc-espace" aria-labelledby="titre-sujets">
            <h2 id="titre-sujets">Mes sujets</h2>
            <ul class="liste-perfs-compte liste-sujets-compte" data-liste-sujets></ul>
            <p class="aide" data-aucun-sujet hidden>
              Aucun sujet pour l'instant. <a href="/forum/">Le forum</a> attend le premier.
            </p>
          </section>

          <section class="bloc-espace" aria-labelledby="titre-suivis">
            <h2 id="titre-suivis">Sujets suivis</h2>
            <p class="aide">
              Une réponse dans un sujet suivi vous parvient en notification. Ceux
              que vous ouvrez se suivent d'office.
            </p>
            <ul class="liste-perfs-compte liste-sujets-compte" data-liste-suivis></ul>
            <p class="aide" data-aucun-suivi hidden>Aucun sujet suivi pour l'instant.</p>
            <p class="etat-compte" data-etat-suivis role="status" aria-live="polite" hidden></p>
          </section>
        </div>
      </div>
    </section>
  </div>

  <FenetreConfirmation />
</BaseLayout>

<script>
  import { afficher, api, brancher, champ, confirmer } from '../../lib/api-compte';
  import { deNom } from '../../lib/format';
  import { marquerLienSortant } from '../../lib/liens-sortants';

  interface Performance {
    id: number;
    mouvement: 'squat' | 'bench' | 'deadlift';
    equipement: 'raw' | 'wraps' | 'equipped';
    charge_kg: string;
    categorie: string | null;
    date_performance: string;
    lien_video: string;
    /** Calculé par badgeDe() de lib/performances.php, comme sur le profil. */
    badge: '' | 'admin' | 'communaute';
    votes: number | string;
  }
  type Records = Record<string, { barres: Partial<Record<Performance['mouvement'], Performance>>; total: number | null }>;

  const MOUVEMENTS = { squat: 'Squat', bench: 'Développé couché', deadlift: 'Soulevé de terre' };
  const EQUIPEMENTS: Record<string, string> = { raw: 'Raw', wraps: 'Bandes', equipped: 'Équipé' };
  /** Les mêmes mots que LIBELLES_BADGE de lib/profil.php. */
  const BADGES = { admin: 'Vérifiée par SBD.re', communaute: 'Vérifiée par la communauté', '': 'Non vérifiée' };
  /** Les catégories féminines actuelles : elles ne recoupent pas les masculines. */
  const FEMMES = new Set(['47', '52', '57', '63', '69', '76', '84', '84+']);

  const bonjour = document.querySelector<HTMLElement>('[data-bonjour]')!;
  const section = document.querySelector<HTMLElement>('[data-compte]')!;
  const formPerf = document.querySelector<HTMLFormElement>('[data-perf]')!;
  const listePerfs = document.querySelector<HTMLUListElement>('[data-liste-perfs]')!;
  const aucune = document.querySelector<HTMLElement>('[data-aucune-perf]')!;
  const etatPerfs = document.querySelector<HTMLElement>('[data-etat-perfs]')!;
  const publier = document.querySelector<HTMLDetailsElement>('[data-publier]')!;
  const listePositions = document.querySelector<HTMLUListElement>('[data-positions]')!;

  const kg = (valeur: number | string) => `${Number(valeur).toLocaleString('fr-FR')} kg`;
  const libelleCategorie = (c: string) => (c.endsWith('+') ? `+${c.slice(0, -1)} kg` : `−${c} kg`);
  const ordinal = (rang: number, feminin: boolean) => (rang === 1 ? (feminin ? '1re' : '1er') : `${rang}e`);

  // La date du jour, posée par le script et non à la génération, qui la
  // figerait au jour du build.
  const aujourdhui = new Date(Date.now() - new Date().getTimezoneOffset() * 60000).toISOString().slice(0, 10);
  formPerf.querySelector<HTMLInputElement>('[data-date-max]')!.max = aujourdhui;

  const datePerf = (p: Performance) =>
    new Date(`${p.date_performance}T12:00:00`).toLocaleDateString('fr-FR', { day: 'numeric', month: 'long', year: 'numeric' });
  /** « Squat · Raw · 200 kg », écrit en texte, jamais en HTML. */
  const barre = (p: Performance) => [MOUVEMENTS[p.mouvement], EQUIPEMENTS[p.equipement], kg(p.charge_kg)].join(' · ');
  /** « 1 novembre 2026 · Squat · Raw · 200 kg », pour la confirmation. */
  const decrire = (p: Performance) => `${datePerf(p)} · ${barre(p)}`;

  /* --- Les chiffres et les pastilles du tableau de bord ------------------- */

  const chiffre = (cle: string, n: number) => {
    document.querySelector<HTMLElement>(`[data-chiffre="${cle}"]`)!.textContent = String(n);
  };

  /** Une pastille sur une tuile : le nombre à l'œil, la phrase à l'oreille. */
  const pastille = (cle: string, n: number, phrase: string) => {
    const zone = document.querySelector<HTMLElement>(`[data-pastille="${cle}"]`)!;
    const nombre = Object.assign(document.createElement('span'), { textContent: n > 99 ? '99+' : String(n) });
    nombre.setAttribute('aria-hidden', 'true');
    zone.replaceChildren(nombre, Object.assign(document.createElement('span'), { className: 'sr-only', textContent: `, ${phrase}` }));
    zone.hidden = n === 0;
  };

  // La cloche lit l'état du compte une fois par minute (lib/cloche.ts) : la
  // page s'en sert plutôt que d'interroger le serveur une fois de plus.
  document.addEventListener('sbd:compte', (evenement) => {
    const etat = (evenement as CustomEvent<Record<string, unknown>>).detail;
    if (etat.deconnecte) return;
    const nonLues = Number(etat.non_lues) || 0;
    chiffre('notifications', nonLues);
    pastille('notifications', nonLues, `${nonLues} non lue${nonLues > 1 ? 's' : ''}`);
    const file = Number(etat.signalements) || 0;
    pastille('admin', file, `${file} en attente`);
  });

  // « Publier une barre » ouvre le formulaire replié, l'ancre fait défiler.
  document.querySelector('[data-aller-publier]')!.addEventListener('click', () => {
    publier.open = true;
  });

  /* --- Ma fiche d'athlète (public/api/lib/revendications.php) ------------- */

  interface EtatFiche {
    lien: { slug: string; nom: string } | null;
    attente: { slug: string; nom: string } | null;
  }

  /** Le texte et le lien de la fiche, écrits en nœuds : un nom n'est jamais du HTML. */
  const afficherFiche = (e: EtatFiche) => {
    const zone = document.querySelector<HTMLElement>('[data-fiche-etat]')!;
    const gestes = document.querySelector<HTMLElement>('[data-fiche-gestes]')!;
    const bouton = document.querySelector<HTMLButtonElement>('[data-fiche-retirer]')!;
    const fiche = e.lien ?? e.attente;
    if (!fiche) {
      const classement = Object.assign(document.createElement('a'), { href: '/classement/', textContent: 'classement' });
      zone.replaceChildren(
        "Si vous avez concouru à La Réunion, trouvez votre fiche au ",
        classement,
        ", puis « C'est votre fiche ? » en bas de page. L'admin relie les deux pages.",
      );
      gestes.hidden = true;
      return;
    }
    // Le lien porte le nom seul : « d' » ou « de » le précède, en texte.
    const de = deNom(fiche.nom).slice(0, -fiche.nom.length);
    const a = Object.assign(document.createElement('a'), { href: `/athlete/${fiche.slug}/`, textContent: fiche.nom });
    zone.replaceChildren(...(e.lien ? [`Votre compte est relié à la fiche ${de}`, a, '.'] : [`Votre demande pour la fiche ${de}`, a, " attend l'admin."]));
    bouton.textContent = e.lien ? 'Retirer le lien' : 'Annuler la demande';
    gestes.hidden = false;
  };

  const chargerFiche = () =>
    void api('/api/revendication.php', 'GET').then((r) => {
      if (r.ok) afficherFiche(r as unknown as EtatFiche);
    });
  chargerFiche();

  document.querySelector<HTMLButtonElement>('[data-fiche-retirer]')!.addEventListener('click', async () => {
    const oui = await confirmer(
      ['Votre profil et votre fiche d\'athlète ne se renverront plus l\'un à l\'autre.', 'Une nouvelle demande repasse par l\'admin.'],
      'Retirer le lien',
    );
    if (!oui) return;
    const r = await api('/api/revendication.php', 'DELETE');
    afficher(etatPerfs, r.message, r.ok);
    chargerFiche();
  });

  /* --- Mes sujets --------------------------------------------------------- */

  interface Sujet {
    id: number;
    titre: string;
    forum: string;
    lien: string;
    reponses: number;
    dernier_pseudo: string;
    /** « 7 novembre 2026 à 14 h 05 », écrit par le serveur. */
    dernier: string;
  }

  /** Le titre en lien, puis le forum et la dernière réponse, en texte. */
  const ligneSujet = (s: Sujet) => {
    const ligne = document.createElement('li');
    const lien = Object.assign(document.createElement('a'), { href: s.lien, textContent: s.titre });
    const suite =
      s.reponses === 0
        ? 'aucune réponse'
        : `${s.reponses} réponse${s.reponses > 1 ? 's' : ''}, la dernière de ${s.dernier_pseudo} le ${s.dernier}`;
    const meta = Object.assign(document.createElement('span'), { className: 'meta', textContent: `${s.forum} · ${suite}` });
    ligne.append(lien, meta);
    return ligne;
  };

  const afficherSujets = (sujets: Sujet[]) => {
    document.querySelector<HTMLElement>('[data-aucun-sujet]')!.hidden = sujets.length > 0;
    document.querySelector<HTMLUListElement>('[data-liste-sujets]')!.replaceChildren(...sujets.map(ligneSujet));
  };

  /** Chaque sujet suivi, et « Ne plus suivre » : la ligne part, le message le dit. */
  const afficherSuivis = (suivis: Sujet[]) => {
    const liste = document.querySelector<HTMLUListElement>('[data-liste-suivis]')!;
    const aucun = document.querySelector<HTMLElement>('[data-aucun-suivi]')!;
    const etat = document.querySelector<HTMLElement>('[data-etat-suivis]')!;
    aucun.hidden = suivis.length > 0;
    liste.replaceChildren(
      ...suivis.map((s) => {
        const ligne = ligneSujet(s);
        const quitter = Object.assign(document.createElement('button'), { type: 'button', className: 'secondaire', textContent: 'Ne plus suivre' });
        quitter.addEventListener('click', async () => {
          quitter.disabled = true;
          const r = await api('/api/forum.php', 'POST', { action: 'suivre', sujet_id: s.id, suivre: false });
          // Texte fabriqué ici : il échappe au middleware, d'où les insécables écrites.
          afficher(etat, r.ok ? `Vous ne suivez plus « ${s.titre} ».` : r.message, r.ok);
          if (!r.ok) {
            quitter.disabled = false;
            return;
          }
          ligne.remove();
          aucun.hidden = liste.childElementCount > 0;
          // La ligne partie emporte le focus : il passe au message qui le dit.
          etat.tabIndex = -1;
          etat.focus();
        });
        ligne.append(quitter);
        return ligne;
      }),
    );
  };

  /* --- Le compte, pour le bonjour et le lien du profil -------------------- */

  void api('/api/moi.php', 'GET').then((lecture) => {
    if (lecture.statut === 401) {
      location.replace('/compte/connexion/');
      return;
    }
    if (!lecture.ok) {
      bonjour.textContent = lecture.message;
      return;
    }
    const compte = lecture.compte as { pseudo: string; admin?: boolean; avatar?: string };
    if (compte.avatar) {
      const avatar = document.querySelector<HTMLImageElement>('[data-avatar]')!;
      avatar.src = compte.avatar;
      avatar.hidden = false;
    }
    afficherSujets((lecture.sujets ?? []) as Sujet[]);
    afficherSuivis((lecture.suivis ?? []) as Sujet[]);
    document.querySelector<HTMLElement>('[data-lien-admin]')!.hidden = compte.admin !== true;
    bonjour.textContent = `Bonjour ${compte.pseudo}.`;
    document.querySelector<HTMLAnchorElement>('[data-lien-profil]')!.href = `/membres/${compte.pseudo}/`;
    section.hidden = false;
  });

  /* --- Ma position -------------------------------------------------------- */

  let positions: Record<string, Record<string, number[]>> | null = null;

  /** Le rang d'une marque parmi les meilleures marques officielles, ex aequo compris. */
  const situer = (cle: string, mouvement: string, marque: number) => {
    const liste = positions?.[cle]?.[mouvement] ?? [];
    return { rang: liste.filter((v) => v > marque).length + 1, sur: liste.length + 1 };
  };

  const afficherPositions = async (records: Records) => {
    const lignes: string[] = [];
    let sansCategorie = false;

    if (Object.keys(records).length > 0 && positions === null) {
      positions = await fetch('/api/positions.json').then((r) => r.json()).catch(() => ({}));
    }

    for (const [equipement, record] of Object.entries(records)) {
      const barres = Object.entries(record.barres) as [Performance['mouvement'], Performance][];

      // Le total d'abord, quand les trois barres sont dans la même catégorie.
      const cats = new Set(barres.map(([, b]) => b.categorie));
      const categorieTotal = cats.size === 1 ? [...cats][0] : null;
      if (record.total !== null && categorieTotal) {
        const feminin = FEMMES.has(categorieTotal);
        const { rang, sur } = situer(`${feminin ? 'F' : 'M'}|${categorieTotal}|${equipement}`, 'total', record.total);
        lignes.push(
          `Total ${EQUIPEMENTS[equipement].toLowerCase()}, ${libelleCategorie(categorieTotal)} : ${kg(record.total)}, ${ordinal(rang, feminin)} sur ${sur}.`,
        );
      }

      for (const [mouvement, barre] of barres) {
        if (!barre.categorie) {
          sansCategorie = true;
          continue;
        }
        const feminin = FEMMES.has(barre.categorie);
        const { rang, sur } = situer(
          `${feminin ? 'F' : 'M'}|${barre.categorie}|${equipement}`,
          mouvement,
          Number(barre.charge_kg),
        );
        lignes.push(
          `${MOUVEMENTS[mouvement]} ${EQUIPEMENTS[equipement].toLowerCase()}, ${libelleCategorie(barre.categorie)} : ${kg(barre.charge_kg)}, ${ordinal(rang, feminin)} sur ${sur}.`,
        );
      }
    }

    if (Object.keys(records).length === 0) {
      lignes.push('Publiez une performance pour vous situer.');
    } else if (sansCategorie) {
      lignes.push('Ajoutez la catégorie de poids à une performance pour la situer aussi.');
    }

    listePositions.replaceChildren(
      ...lignes.map((texte) => Object.assign(document.createElement('li'), { textContent: texte })),
    );
  };

  /* --- Mes performances --------------------------------------------------- */

  const chargerPerfs = () =>
    void api('/api/performances.php', 'GET').then((lecture) => {
      if (!lecture.ok) return;
      const perfs = lecture.performances as Performance[];

      aucune.hidden = perfs.length > 0;
      const verifiees = perfs.filter((p) => p.badge !== '').length;
      chiffre('publiees', perfs.length);
      chiffre('verifiees', verifiees);
      chiffre('attente', perfs.length - verifiees);
      // Sans performance, le formulaire s'ouvre de lui-même : c'est le seul
      // geste utile de la page.
      if (perfs.length === 0) publier.open = true;

      listePerfs.replaceChildren(
        ...perfs.map((p) => {
          // La barre en gras, dessous la date, la vidéo et l'état ; Retirer au bout.
          const ligne = Object.assign(document.createElement('li'), { className: 'perf-compte' });
          const quoi = Object.assign(document.createElement('span'), { className: 'perf-barre', textContent: barre(p) });

          // Lien fabriqué en JavaScript : il échappe au middleware, d'où
          // marquerLienSortant, comme la carte des salles.
          const video = Object.assign(document.createElement('a'), { href: p.lien_video, textContent: 'Vidéo' });
          video.rel = 'ugc nofollow';
          marquerLienSortant(video);

          // Sans badge, le nombre d'avis dit où en est la vérification.
          const avis = Number(p.votes);
          const etat = Object.assign(document.createElement('span'), {
            className: p.badge ? 'verif verif-oui' : 'verif verif-non',
            textContent: p.badge || avis === 0 ? BADGES[p.badge] : `${BADGES['']}, ${avis} avis`,
          });

          const retirer = Object.assign(document.createElement('button'), {
            type: 'button',
            className: 'secondaire',
            textContent: 'Retirer',
          });
          retirer.addEventListener('click', async () => {
            const oui = await confirmer(
              [`${decrire(p)}.`, 'Elle disparaît du profil, et les votes reçus avec elle.'],
              'Retirer cette performance',
            );
            if (!oui) return;
            const reponse = await api('/api/performances.php', 'DELETE', { id: p.id });
            afficher(etatPerfs, reponse.message, reponse.ok);
            if (reponse.ok) chargerPerfs();
          });

          const meta = Object.assign(document.createElement('span'), { className: 'perf-meta' });
          meta.append(datePerf(p), ' · ', video, ' ', etat);
          const texte = Object.assign(document.createElement('div'), { className: 'perf-texte' });
          texte.append(quoi, meta);
          ligne.append(texte, retirer);
          return ligne;
        }),
      );

      void afficherPositions(lecture.records as Records);
    });
  chargerPerfs();

  brancher(
    formPerf,
    (donnees) =>
      api('/api/performances.php', 'POST', {
        mouvement: champ(donnees, 'mouvement'),
        equipement: champ(donnees, 'equipement'),
        charge_kg: champ(donnees, 'charge_kg'),
        date_performance: champ(donnees, 'date_performance'),
        categorie: champ(donnees, 'categorie'),
        lien_video: champ(donnees, 'lien_video'),
      }),
    () => {
      formPerf.querySelector<HTMLInputElement>('[name="charge_kg"]')!.value = '';
      formPerf.querySelector<HTMLInputElement>('[name="lien_video"]')!.value = '';
      chargerPerfs();
    },
  );
</script>

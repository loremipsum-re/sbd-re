---
import BaseLayout from '../layouts/BaseLayout.astro';
import { dateLongue } from '../lib/format';
import { libelleEvent, listeMeets, meetsParAnnee } from '../lib/meets';

const annees = meetsParAnnee();
const total = listeMeets().length;
---

<BaseLayout
  titre="Compétitions"
  description="Toutes les compétitions de force athlétique organisées à La Réunion et enregistrées par OpenPowerlifting, depuis 2017."
>
  <div class="wrap">
    <header class="entete-page">
      <h1>Compétitions</h1>
      <p class="chapeau">
        Les {total} compétitions réunionnaises présentes dans les données
        officielles, de la plus récente à la plus ancienne. Full power et
        développé couché seul.
      </p>
      <p class="note">
        OpenPowerlifting ne publie pas d'identifiant de compétition dans son
        jeu de données téléchargeable : impossible de créer un lien direct vers
        la fiche de chaque meet sans inventer une adresse qui ne fonctionnerait
        pas. Les compétitions restent consultables depuis{' '}
        <a href="https://www.openpowerlifting.org/mlist" rel="noopener">
          la liste des meets
        </a>, et chaque athlète a un lien direct sur sa page.
      </p>
    </header>

    {
      annees.map(({ annee, meets }) => (
        <section class="annee">
          <h2>
            {annee}
            <span class="compte">
              {meets.length} compétition{meets.length > 1 ? 's' : ''}
            </span>
          </h2>

          <ul class="liste">
            {meets.map((meet) => (
              <li>
                <div class="principal">
                  <p class="nom">{meet.meetName}</p>
                  <p class="lieu">
                    {dateLongue(meet.date)}
                    {meet.meetTown && <> · {meet.meetTown}</>}
                  </p>
                </div>

                <div class="secondaire">
                  {meet.events.map((e) => (
                    <span class="format">{libelleEvent(e)}</span>
                  ))}
                  <span class="athletes">
                    <span class="num">{meet.athletes}</span> athlète
                    {meet.athletes > 1 ? 's' : ''}
                  </span>
                </div>
              </li>
            ))}
          </ul>
        </section>
      ))
    }
  </div>
</BaseLayout>

<style>
  .entete-page {
    margin-bottom: var(--space-8);
  }

  .chapeau {
    color: var(--muted);
    max-width: 68ch;
  }

  .note {
    font-size: var(--step--1);
    color: var(--muted);
    max-width: 68ch;
    padding: var(--space-3) var(--space-4);
    border-left: 3px solid var(--border);
    background: var(--surface);
    border-radius: 0 var(--radius) var(--radius) 0;
  }

  .annee {
    margin-bottom: var(--space-8);
  }

  .annee h2 {
    display: flex;
    align-items: baseline;
    gap: var(--space-3);
    padding-bottom: var(--space-2);
    border-bottom: 1px solid var(--border);
  }

  .compte {
    font-family: var(--font-body);
    font-size: var(--step--1);
    font-weight: 400;
    color: var(--muted);
  }

  .liste {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .liste li {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    padding: var(--space-4) 0;
    border-bottom: 1px solid var(--border);
  }
  .liste li:last-child {
    border-bottom: 0;
  }

  .nom {
    font-weight: 600;
    margin: 0 0 var(--space-1);
  }

  .lieu {
    margin: 0;
    font-size: var(--step--1);
    color: var(--muted);
  }

  .secondaire {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    flex-wrap: wrap;
  }

  .format {
    font-size: var(--step--1);
    font-weight: 600;
    padding: var(--space-1) var(--space-3);
    border: 1px solid var(--border);
    border-radius: 999px;
    color: var(--muted);
    white-space: nowrap;
  }

  .athletes {
    font-size: var(--step--1);
    color: var(--muted);
    white-space: nowrap;
  }

  .athletes .num {
    color: var(--accent);
    font-size: var(--step-0);
  }
</style>

---
import InteractiveTable from '../components/InteractiveTable.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { dateCourte } from '../lib/format';
import { libelleEvent, listeMeets } from '../lib/meets';

const meets = listeMeets();
const villes = [...new Set(meets.map((m) => m.meetTown).filter(Boolean))].sort((a, b) =>
  a.localeCompare(b, 'fr'),
);
const annees = [...new Set(meets.map((m) => m.date.slice(0, 4)))].sort().reverse();
---

<BaseLayout
  titre="Compétitions"
  description="Toutes les compétitions de force athlétique organisées à La Réunion et enregistrées officiellement depuis 2017. Résultats complets par compétition."
>
  <div class="wrap">
    <header class="entete-page">
      <h1>Compétitions</h1>
      <p class="chapeau">
        Les {meets.length} compétitions organisées à La Réunion et présentes dans
        les données officielles. Ouvrez une compétition pour consulter le
        détail des barres de chaque athlète engagé.
      </p>
    </header>

    <InteractiveTable
      recherche="Nom d'une compétition"
      singulier="compétition"
      pluriel="compétitions"
      total={meets.length}
    >
      <Fragment slot="filtres">
        <div class="champ">
          <label for="f-annee">Année</label>
          <select id="f-annee" data-filtre="annee">
            <option value="">Toutes</option>
            {annees.map((a) => <option value={a}>{a}</option>)}
          </select>
        </div>

        <div class="champ">
          <label for="f-ville">Commune</label>
          <select id="f-ville" data-filtre="ville">
            <option value="">Toutes</option>
            {villes.map((v) => <option value={v}>{v}</option>)}
          </select>
        </div>
      </Fragment>

      <div class="liste">
        <table data-tableau>
          <thead>
            <tr>
              <th scope="col" data-tri data-type="nombre">Date</th>
              <th scope="col" data-tri>Compétition</th>
              <th scope="col" data-tri>Commune</th>
              <th scope="col">Format</th>
              <th scope="col" class="nombre" data-tri data-type="nombre">Athlètes</th>
            </tr>
          </thead>
          <tbody>
            {
              meets.map((meet) => (
                <tr
                  data-recherche={meet.meetName}
                  data-annee={meet.date.slice(0, 4)}
                  data-ville={meet.meetTown}
                >
                  <td class="date" data-libelle="Date" data-valeur={meet.date.replace(/-/g, '')}>
                    {dateCourte(meet.date)}
                  </td>
                  <th scope="row" class="nom">
                    <a href={`/competitions/${meet.chemin}/`}>{meet.meetName}</a>
                  </th>
                  <td data-libelle="Commune">{meet.meetTown || '—'}</td>
                  <td data-libelle="Format">
                    <span class="etiquettes">
                      {meet.events.map((e) => (
                        <span class="etiquette">{libelleEvent(e)}</span>
                      ))}
                    </span>
                  </td>
                  <td class="nombre num-tab" data-libelle="Athlètes" data-valeur={meet.athletes}>
                    {meet.athletes}
                  </td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
    </InteractiveTable>

    <p class="note">
      Les données proviennent du projet OpenPowerlifting, qui recense les
      résultats homologués. Chaque fiche d'athlète renvoie vers sa page sur ce
      même projet, où figure l'intégralité de son parcours, y compris hors de
      La Réunion.
    </p>
  </div>
</BaseLayout>

<style>
  .entete-page {
    margin-bottom: var(--space-8);
  }

  .chapeau {
    color: var(--muted);
    max-width: 68ch;
  }

  .note {
    margin-top: var(--space-4);
    font-size: var(--step--1);
    color: var(--muted);
    max-width: 68ch;
  }
</style>

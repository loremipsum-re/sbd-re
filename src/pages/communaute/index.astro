---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icone from '../../components/Icone.astro';
import { ANCIENNETE_VOTE_JOURS, FAVORABLES_POURCENT, VOTES_MIN } from '../../lib/communaute';

/**
 * L'entrée de la communauté, depuis l'ouverture (docs/comptes.md, phase 9).
 * Elle remplace la page d'attente du classement communauté, ses tranches et
 * son infographie : le classement par tranches n'est pas ce qui a été
 * construit, les profils et la vérification par la communauté le sont.
 *
 * LE PREMIER ÉCRAN DIT CE QU'ON TROUVE ICI ET Y MÈNE. Quatre actions : le
 * forum en bouton plein, le fil, les barres à vérifier, et le compte. Puis
 * le fonctionnement en une liste courte, et le chat, qui se lit sans compte.
 * Il vit en fenêtre flottante sur toutes les pages depuis le 9 novembre
 * (components/Chat.astro) : la page l'annonce et l'ouvre. `#chat`, où
 * renvoie l'ancienne adresse /communaute/chat/, l'ouvre aussi.
 *
 * LES SEUILS SE LISENT DANS lib/communaute.ts, recopiés de
 * public/api/lib/autorisation.php et contrôlés par db/verifier-autorisation.php :
 * une page qui annoncerait 20 avis quand le serveur en demande 25 tromperait
 * le visiteur.
 */
---

<BaseLayout
  titre="Communauté"
  description="La communauté de force athlétique de La Réunion : le forum, le chat, et des performances de salle vérifiées sur vidéo par les membres."
>
  <div class="wrap page">
    <header class="entete-page">
      <h1>Communauté</h1>
      <p class="chapeau">
        Le forum, le chat, et les barres de salle des membres, vérifiées sur
        vidéo par la communauté.
      </p>
    </header>

    <ul class="actions">
      <li>
        <a class="primaire" href="/forum/">
          <Icone nom="forum" />
          Le forum
        </a>
      </li>
      <li>
        <a href="/forum/fil/">
          <Icone nom="actualites" />
          Le fil de l'activité
        </a>
      </li>
      <li>
        <a href="/membres/">
          <Icone nom="communaute" />
          Les membres
        </a>
      </li>
      <li>
        <a href="/compte/a-verifier/">
          <Icone nom="valide" />
          Vérifier des barres
        </a>
      </li>
      <li>
        <a href="/compte/">
          <Icone nom="reglages" />
          Mon espace, ou créer un compte
        </a>
      </li>
    </ul>

    <section class="fonctionnement" aria-labelledby="titre-fonctionnement">
      <h2 id="titre-fonctionnement">Le fonctionnement</h2>
      <ul class="principes">
        <li>Un compte par personne, un pseudo, dès 18 ans. Le profil est public.</li>
        <li>Chaque barre se publie avec la vidéo où on la voit en entier.</li>
        <li>
          Une barre est vérifiée par la communauté à {VOTES_MIN} avis, dont {FAVORABLES_POURCENT}{' '}%
          favorables, ou par SBD.re. On vote {ANCIENNETE_VOTE_JOURS} jours après son inscription.
        </li>
        <li>Le forum se range par mouvement. Les membres y créent aussi leurs forums.</li>
        <li>Le classement officiel et les records restent réservés aux compétitions homologuées.</li>
      </ul>
      <p>
        Les règles tiennent sur une page : <a href="/communaute/charte/">la charte</a>.
      </p>
    </section>

    <section class="bloc-chat" id="chat" aria-labelledby="titre-bloc-chat">
      <h2 id="titre-bloc-chat">Le chat</h2>
      <p>
        Cinq salons, un thème chacun, la charte partout. Les membres lisent les
        sept derniers jours, les visiteurs voient arriver les nouveaux messages.
        Il s'ouvre aussi du bouton « Chat », en bas à droite de chaque page.
      </p>
      <button type="button" class="ouvrir-chat" data-ouvrir-chat aria-controls="chat-flottant" aria-expanded="false">
        <Icone nom="forum" />
        Ouvrir le chat
      </button>
    </section>
  </div>
</BaseLayout>

<style>
  .page {
    padding-bottom: var(--space-8);
  }

  /*
   * LES ACTIONS. Empilées sur téléphone, sur toute la largeur, pour le pouce.
   * En ligne dès que la place le permet. Bordure de 2 px et angles du système
   * Modernist, 44 px au moins comme tout contrôle du site.
   */
  .actions {
    display: grid;
    gap: var(--space-3);
    margin: 0 0 var(--space-8);
    padding: 0;
    list-style: none;
  }

  @media (min-width: 40rem) {
    .actions {
      display: flex;
      flex-wrap: wrap;
    }
  }

  .actions a {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    min-height: var(--cible-min);
    padding: var(--space-2) var(--space-4);
    border: 2px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
    color: var(--text);
    font-weight: 700;
    line-height: 1.3;
    text-decoration: none;
  }

  .actions a:hover {
    border-color: var(--accent);
    color: var(--accent);
  }

  /* L'APLAT, jamais l'accent de texte : --accent en fond sous --on-accent
     donne 2,78:1 en thème clair. Voir la note de .evitement dans BaseLayout. */
  .actions .primaire {
    border-color: var(--accent-fill);
    background: var(--accent-fill);
    color: var(--on-accent);
  }

  .actions .primaire:hover {
    border-color: var(--accent-fill-hover);
    background: var(--accent-fill-hover);
    color: var(--on-accent);
  }

  /* Une ligne par fait, séparées d'un filet, à la mesure du chapeau. */
  .principes {
    max-width: 62ch;
    margin: 0 0 var(--space-4);
    padding: 0;
    list-style: none;
    border-bottom: 1px solid var(--border);
  }

  .principes li {
    position: relative;
    padding: var(--space-3) 0 var(--space-3) var(--space-6);
    border-top: 1px solid var(--border);
  }

  /* Un carré plein, aux angles nets du système, centré sur la première ligne.
     L'accent de texte et non l'aplat : le jaune de l'aplat disparaît sur le
     fond clair, et le carré ne porte aucun texte. */
  .principes li::before {
    content: '';
    position: absolute;
    left: 0;
    top: calc(var(--space-3) + 0.8em - 3px);
    width: 6px;
    height: 6px;
    background: var(--accent);
  }

  .fonctionnement {
    margin-bottom: var(--space-12);
  }

  .bloc-chat p {
    max-width: 62ch;
  }

  /* L'aplat sous --on-accent, comme le bouton du forum plus haut. */
  .ouvrir-chat {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: var(--cible-min);
    padding: var(--space-2) var(--space-6);
    border: 2px solid var(--accent-fill);
    border-radius: var(--radius);
    background: var(--accent-fill);
    color: var(--on-accent);
    font: inherit;
    font-weight: 700;
    cursor: pointer;
  }

  .ouvrir-chat:hover,
  .ouvrir-chat:focus-visible {
    border-color: var(--accent-fill-hover);
    background: var(--accent-fill-hover);
  }
</style>

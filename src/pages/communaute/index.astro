---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icone from '../../components/Icone.astro';
import IconeMouvement from '../../components/IconeMouvement.astro';
import SpriteMouvements from '../../components/SpriteMouvements.astro';
import { ANCIENNETE_VOTE_JOURS, FAVORABLES_POURCENT, TOP_PAR_MOUVEMENT, VOTES_MIN } from '../../lib/communaute';
import { articles } from '../../lib/actualites';
import { LIFTS } from '../../lib/categories';
import { dateLongue } from '../../lib/format';

/**
 * L'entrée de la communauté, depuis l'ouverture (docs/comptes.md, phase 9).
 * Elle remplace la page d'attente du classement communauté, ses tranches et
 * son infographie : le classement par tranches n'est pas ce qui a été
 * construit, les profils et la vérification par la communauté le sont.
 *
 * LE PREMIER ÉCRAN DIT CE QU'ON TROUVE ICI ET Y MÈNE. Quatre actions : le
 * forum en bouton plein, le fil, les barres à vérifier, et le compte. Puis
 * le fonctionnement en une liste courte, et le chat, qui se lit sans compte.
 * Il vit en fenêtre flottante sur toutes les pages depuis le 9 novembre
 * (components/Chat.astro) : la page l'annonce et l'ouvre. `#chat`, où
 * renvoie l'ancienne adresse /communaute/chat/, l'ouvre aussi.
 *
 * LA VITRINE, demande de l'auteur du 9 novembre 2026 : les dernières
 * nouvelles (les actualités, lues à la génération), le top des membres et
 * les dernières barres (public/api/communaute.php, lu à la visite). Le top
 * prend les barres vérifiées en raw, une par membre et par mouvement.
 *
 * LES SEUILS SE LISENT DANS lib/communaute.ts, recopiés de
 * public/api/lib/autorisation.php et contrôlés par db/verifier-autorisation.php :
 * une page qui annoncerait 20 avis quand le serveur en demande 25 tromperait
 * le visiteur.
 */
const nouvelles = (await articles()).slice(0, 3);
const mouvements = LIFTS.filter((l) => l.id !== 'total');
const nombreEnLettres = ['zéro', 'une', 'deux', 'trois', 'quatre', 'cinq'][TOP_PAR_MOUVEMENT] ?? String(TOP_PAR_MOUVEMENT);
---

<BaseLayout
  titre="Communauté"
  description="La communauté de force athlétique de La Réunion : le forum, le chat, et des performances de salle vérifiées sur vidéo par les membres."
>
  <div class="wrap page">
    <header class="entete-page">
      <h1>Communauté</h1>
      <p class="chapeau">
        Le forum, le chat, et les barres de salle des membres, vérifiées sur
        vidéo par la communauté.
      </p>
    </header>

    <ul class="actions">
      <li>
        <a class="primaire" href="/forum/">
          <Icone nom="forum" />
          Le forum
        </a>
      </li>
      <li>
        <a href="/forum/fil/">
          <Icone nom="actualites" />
          Le fil de l'activité
        </a>
      </li>
      <li>
        <a href="/membres/">
          <Icone nom="communaute" />
          Les membres
        </a>
      </li>
      <li>
        <a href="/compte/a-verifier/">
          <Icone nom="valide" />
          Vérifier des barres
        </a>
      </li>
      <li>
        <a href="/compte/">
          <Icone nom="reglages" />
          Mon espace, ou créer un compte
        </a>
      </li>
    </ul>

    <SpriteMouvements />

    <section class="bloc-vitrine" aria-labelledby="titre-nouvelles">
      <h2 id="titre-nouvelles">Les dernières nouvelles</h2>
      <ul class="nouvelles">
        {
          nouvelles.map((a) => (
            <li>
              <p class="date">{dateLongue(a.data.date.toISOString().slice(0, 10))}</p>
              <a href={`/actualites/${a.id}/`}>{a.data.titre}</a>
              <p class="resume">{a.data.description}</p>
            </li>
          ))
        }
      </ul>
      <p><a href="/actualites/">Toutes les actualités</a></p>
    </section>

    <section class="bloc-vitrine" aria-labelledby="titre-top">
      <h2 id="titre-top">Le top des membres</h2>
      <p class="aide-vitrine">
        Les {nombreEnLettres} barres vérifiées les plus lourdes de chaque mouvement, en
        raw, une par membre. Des barres de salle : le classement officiel reste
        celui des compétitions.
      </p>
      <div class="top-mouvements">
        {
          mouvements.map((m) => (
            <section class="top-mouvement" aria-labelledby={`top-${m.id}`}>
              <h3 id={`top-${m.id}`}>
                <IconeMouvement mouvement={m.id} taille={24} />
                {m.label}
              </h3>
              <ol data-top={m.id}>
                <li class="attente">Chargement…</li>
              </ol>
            </section>
          ))
        }
      </div>
    </section>

    <section class="bloc-vitrine" aria-labelledby="titre-dernieres">
      <h2 id="titre-dernieres">Les dernières barres</h2>
      <ul class="dernieres-barres" data-dernieres>
        <li class="attente">Chargement…</li>
      </ul>
      <p><a href="/compte/a-verifier/">Vérifier des barres</a></p>
    </section>

    <section class="fonctionnement" aria-labelledby="titre-fonctionnement">
      <h2 id="titre-fonctionnement">Le fonctionnement</h2>
      <ul class="principes">
        <li>Un compte par personne, un pseudo, dès 18 ans. Le profil est public.</li>
        <li>Chaque barre se publie avec la vidéo où on la voit en entier.</li>
        <li>
          Une barre est vérifiée par la communauté à {VOTES_MIN} avis, dont {FAVORABLES_POURCENT}{' '}%
          favorables, ou par SBD.re. On vote {ANCIENNETE_VOTE_JOURS} jours après son inscription.
        </li>
        <li>Le forum se range par mouvement. Les membres y créent aussi leurs forums.</li>
        <li>Le classement officiel et les records restent réservés aux compétitions homologuées.</li>
      </ul>
      <p>
        Les règles tiennent sur une page : <a href="/communaute/charte/">la charte</a>.
      </p>
    </section>

    <section class="bloc-chat" id="chat" aria-labelledby="titre-bloc-chat">
      <h2 id="titre-bloc-chat">Le chat</h2>
      <p>
        Deux salons généraux, la charte partout. Les membres lisent les
        sept derniers jours, les visiteurs voient arriver les nouveaux messages.
        Il s'ouvre aussi du bouton « Chat », en bas à droite de chaque page.
      </p>
      <button type="button" class="ouvrir-chat" data-ouvrir-chat aria-controls="chat-flottant" aria-expanded="false">
        <Icone nom="forum" />
        Ouvrir le chat
      </button>
    </section>
  </div>
</BaseLayout>

<script>
  interface Barre {
    pseudo: string;
    mouvement: 'squat' | 'bench' | 'deadlift';
    equipement: 'raw' | 'wraps' | 'equipped';
    charge: number;
    date: string;
    verifiee: boolean;
  }

  const MOUVEMENTS = { squat: 'Squat', bench: 'Développé couché', deadlift: 'Soulevé de terre' };
  const EQUIPEMENTS = { raw: 'raw', wraps: 'bandes', equipped: 'équipé' };
  // Texte fabriqué ici : il échappe au middleware, d'où l'insécable écrite.
  const kg = (n: number) => `${n.toLocaleString('fr-FR')}\u00a0kg`;
  const quand = (iso: string) =>
    new Date(`${iso}T12:00:00`).toLocaleDateString('fr-FR', { day: 'numeric', month: 'long', year: 'numeric' });

  /** Le pseudo en lien vers le profil, écrit en nœud : jamais du HTML. */
  const profil = (pseudo: string) => Object.assign(document.createElement('a'), { href: `/membres/${pseudo}/`, textContent: pseudo });

  const vide = (texte: string) => Object.assign(document.createElement('li'), { className: 'attente', textContent: texte });

  const remplir = (r: { top: Record<string, Omit<Barre, 'mouvement' | 'equipement' | 'verifiee'>[]>; dernieres: Barre[] }) => {
    for (const liste of document.querySelectorAll<HTMLOListElement>('[data-top]')) {
      const top = r.top[liste.dataset.top!] ?? [];
      liste.replaceChildren(
        ...(top.length === 0
          ? [vide('Aucune barre vérifiée pour l\'instant.')]
          : top.map((b) => {
              const li = document.createElement('li');
              li.append(profil(b.pseudo), Object.assign(document.createElement('span'), { className: 'charge', textContent: kg(b.charge) }));
              return li;
            })),
      );
    }

    const dernieres = document.querySelector<HTMLUListElement>('[data-dernieres]')!;
    dernieres.replaceChildren(
      ...(r.dernieres.length === 0
        ? [vide('Aucune barre publiée pour l\'instant.')]
        : r.dernieres.map((b) => {
            const li = document.createElement('li');
            const quoi = Object.assign(document.createElement('p'), {
              className: 'barre',
              textContent: `${MOUVEMENTS[b.mouvement]} ${EQUIPEMENTS[b.equipement]} · ${kg(b.charge)}`,
            });
            const qui = Object.assign(document.createElement('p'), { className: 'meta' });
            qui.append(profil(b.pseudo), ` · ${quand(b.date)} · `);
            qui.append(
              Object.assign(document.createElement('span'), {
                className: b.verifiee ? 'verif verif-oui' : 'verif verif-non',
                textContent: b.verifiee ? 'Vérifiée' : 'Non vérifiée',
              }),
            );
            li.append(quoi, qui);
            return li;
          })),
    );
  };

  fetch('/api/communaute.php', { credentials: 'same-origin' })
    .then((reponse) => reponse.json())
    .then((r) => {
      if (r.ok) remplir(r);
      else throw new Error();
    })
    .catch(() => {
      for (const liste of document.querySelectorAll('[data-top], [data-dernieres]')) {
        liste.replaceChildren(vide('Les barres des membres ne se chargent pas pour l\'instant. Réessayez dans quelques minutes.'));
      }
    });
</script>

<style>
  .page {
    padding-bottom: var(--space-8);
  }

  /*
   * LES ACTIONS. Empilées sur téléphone, sur toute la largeur, pour le pouce.
   * En ligne dès que la place le permet. Bordure de 2 px et angles du système
   * Modernist, 44 px au moins comme tout contrôle du site.
   */
  .actions {
    display: grid;
    gap: var(--space-3);
    margin: 0 0 var(--space-8);
    padding: 0;
    list-style: none;
  }

  @media (min-width: 40rem) {
    .actions {
      display: flex;
      flex-wrap: wrap;
    }
  }

  .actions a {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    min-height: var(--cible-min);
    padding: var(--space-2) var(--space-4);
    border: 2px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
    color: var(--text);
    font-weight: 700;
    line-height: 1.3;
    text-decoration: none;
  }

  .actions a:hover {
    border-color: var(--accent);
    color: var(--accent);
  }

  /* L'APLAT, jamais l'accent de texte : --accent en fond sous --on-accent
     donne 2,78:1 en thème clair. Voir la note de .evitement dans BaseLayout. */
  .actions .primaire {
    border-color: var(--accent-fill);
    background: var(--accent-fill);
    color: var(--on-accent);
  }

  .actions .primaire:hover {
    border-color: var(--accent-fill-hover);
    background: var(--accent-fill-hover);
    color: var(--on-accent);
  }

  /* Une ligne par fait, séparées d'un filet, à la mesure du chapeau. */
  .principes {
    max-width: 62ch;
    margin: 0 0 var(--space-4);
    padding: 0;
    list-style: none;
    border-bottom: 1px solid var(--border);
  }

  .principes li {
    position: relative;
    padding: var(--space-3) 0 var(--space-3) var(--space-6);
    border-top: 1px solid var(--border);
  }

  /* Un carré plein, aux angles nets du système, centré sur la première ligne.
     L'accent de texte et non l'aplat : le jaune de l'aplat disparaît sur le
     fond clair, et le carré ne porte aucun texte. */
  .principes li::before {
    content: '';
    position: absolute;
    left: 0;
    top: calc(var(--space-3) + 0.8em - 3px);
    width: 6px;
    height: 6px;
    background: var(--accent);
  }

  .fonctionnement {
    margin-bottom: var(--space-12);
  }

  .bloc-chat p {
    max-width: 62ch;
  }

  /* L'aplat sous --on-accent, comme le bouton du forum plus haut. */
  .ouvrir-chat {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: var(--cible-min);
    padding: var(--space-2) var(--space-6);
    border: 2px solid var(--accent-fill);
    border-radius: var(--radius);
    background: var(--accent-fill);
    color: var(--on-accent);
    font: inherit;
    font-weight: 700;
    cursor: pointer;
  }

  .ouvrir-chat:hover,
  .ouvrir-chat:focus-visible {
    border-color: var(--accent-fill-hover);
    background: var(--accent-fill-hover);
  }

  /* --- La vitrine : nouvelles, top, dernières barres ------------------- */

  .bloc-vitrine {
    margin-bottom: var(--space-12);
  }

  .aide-vitrine {
    max-width: 62ch;
    color: var(--muted);
  }

  .nouvelles {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(16rem, 100%), 1fr));
    gap: var(--space-4);
    margin: 0 0 var(--space-4);
    padding: 0;
    list-style: none;
  }

  .nouvelles li {
    display: grid;
    align-content: start;
    gap: var(--space-2);
    min-width: 0;
    padding: var(--space-4);
    border: 2px solid var(--border);
    border-radius: var(--radius);
  }

  .nouvelles a {
    font-weight: 700;
  }

  .nouvelles p {
    margin: 0;
  }

  .nouvelles .date,
  .nouvelles .resume {
    color: var(--muted);
    font-size: var(--step--1);
  }

  .top-mouvements {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(14rem, 100%), 1fr));
    gap: var(--space-4);
  }

  .top-mouvement {
    min-width: 0;
    padding: var(--space-4);
    border: 2px solid var(--border);
    border-radius: var(--radius);
  }

  .top-mouvement h3 {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    margin: 0 0 var(--space-3);
    font-size: var(--step-1);
  }

  /* Le rang écrit par un compteur : en flex, une ligne perd la puce
     numérotée de la liste, que les lecteurs d'écran gardent. */
  .top-mouvement ol {
    margin: 0;
    padding: 0;
    list-style: none;
    counter-reset: rang;
  }

  .top-mouvement :global(li:not(.attente))::before {
    content: counter(rang);
    counter-increment: rang;
    min-width: 1.5rem;
    color: var(--muted);
    font-weight: 700;
    font-variant-numeric: tabular-nums;
  }

  .top-mouvement :global(li:not(.attente) a) {
    flex: 1;
  }

  /* Les lignes viennent du script : hors de la portée des styles d'Astro,
     d'où :global() sous le bloc. */
  .top-mouvement :global(li) {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0 var(--space-3);
    min-height: var(--cible-min);
    border-bottom: 1px solid var(--border);
  }

  .top-mouvement :global(li:last-child) {
    border-bottom: 0;
  }

  .top-mouvement :global(.charge) {
    font-weight: 700;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  .top-mouvement :global(a),
  .dernieres-barres :global(a) {
    display: inline-flex;
    align-items: center;
    min-height: var(--cible-min);
    overflow-wrap: anywhere;
  }

  .dernieres-barres {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(18rem, 100%), 1fr));
    gap: var(--space-2) var(--space-6);
    margin: 0 0 var(--space-4);
    padding: 0;
    list-style: none;
  }

  .dernieres-barres :global(li) {
    min-width: 0;
    padding: var(--space-2) 0;
    border-bottom: 1px solid var(--border);
  }

  .dernieres-barres :global(p) {
    margin: 0;
  }

  .dernieres-barres :global(.barre) {
    font-weight: 700;
  }

  .dernieres-barres :global(.meta) {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0 var(--space-1);
    color: var(--muted);
    font-size: var(--step--1);
  }

  .bloc-vitrine :global(.attente) {
    color: var(--muted);
    list-style: none;
  }

  /* Vérifiée en vert, non vérifiée en ambre, le mot toujours écrit, comme
     sur le profil et dans l'espace du membre. */
  .dernieres-barres :global(.verif) {
    padding: 0 var(--space-2);
    border: 1px solid currentColor;
    border-radius: 999px;
    font-weight: 600;
    white-space: nowrap;
  }

  .dernieres-barres :global(.verif-oui) {
    color: var(--succes);
  }

  .dernieres-barres :global(.verif-non) {
    color: var(--alerte);
  }
</style>

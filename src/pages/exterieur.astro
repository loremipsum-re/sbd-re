---
import BadgeOfficiel from '../components/BadgeOfficiel.astro';
import InteractiveTable from '../components/InteractiveTable.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { equipmentGroup, parseWeightClass } from '../lib/categories';
import {
  paysFr,
  resultatsExterieur,
  statsExterieur,
  valeursFrequentes,
} from '../lib/exterieur';
import { annee, dateCourte, nombre, place, points } from '../lib/format';
import { libelleEvent } from '../lib/meets';
import { athleteSlug } from '../lib/slug';

const stats = statsExterieur();
const pays = valeursFrequentes('meetCountry');
const federations = valeursFrequentes('federation');

// Du plus récent au plus ancien : c'est l'actualité qui intéresse en premier.
const resultats = [...resultatsExterieur].sort((a, b) => b.date.localeCompare(a.date));
---

<BaseLayout
  titre="Résultats hors de La Réunion"
  description="Les powerlifters réunionnais en déplacement : résultats obtenus en métropole et à l'étranger, hors des compétitions organisées sur l'île."
>
  <div class="wrap">
    <header class="entete-page">
      <h1>Hors de La Réunion</h1>
      <p class="chapeau">
        Les athlètes de l'île se déplacent, en métropole comme à l'étranger.
        Cette page rassemble {stats.resultats} résultats obtenus sur ces
        plateaux-là, par {stats.athletes} athlètes, dans {stats.pays} pays et
        sous {stats.federations} fédérations, de {annee(stats.debut)} à {annee(stats.fin)}.
      </p>
      <div class="avertissement">
        <p>
          <strong>Ces résultats restent en dehors du classement et des records.</strong>
        </p>
        <p>
          Les records de La Réunion récompensent des barres soulevées sur un
          plateau réunionnais, et le classement mesure la scène locale. Une
          performance réalisée à Prague ou à Lyon appartient au parcours de
          l'athlète, et elle figure à ce titre sur sa fiche, mais elle laisse
          intacte la hiérarchie de l'île.
        </p>
      </div>
    </header>

    <InteractiveTable
      recherche="Nom d'un athlète"
      singulier="résultat"
      pluriel="résultats"
      total={resultats.length}
    >
      <Fragment slot="filtres">
        <div class="champ">
          <label for="f-sexe">Sexe</label>
          <select id="f-sexe" data-filtre="sexe">
            <option value="">Tous</option>
            <option value="M">Hommes</option>
            <option value="F">Femmes</option>
          </select>
        </div>

        <div class="champ">
          <label for="f-pays">Pays</label>
          <select id="f-pays" data-filtre="pays">
            <option value="">Tous</option>
            {pays.map((p) => <option value={p}>{paysFr(p)}</option>)}
          </select>
        </div>

        <div class="champ">
          <label for="f-federation">Fédération</label>
          <select id="f-federation" data-filtre="federation">
            <option value="">Toutes</option>
            {federations.map((f) => <option value={f}>{f}</option>)}
          </select>
        </div>
      </Fragment>

      <div class="cadre">
        <table data-tableau>
          <thead>
            <tr>
              <th scope="col" data-tri data-type="nombre">Date</th>
              <th scope="col" data-tri>Athlète</th>
              <th scope="col" data-tri>Compétition</th>
              <th scope="col" data-tri>Pays</th>
              <th scope="col" class="nombre" data-tri data-type="nombre">Cat.</th>
              <th scope="col" class="nombre" data-tri data-type="nombre">Total</th>
              <th scope="col" class="nombre" data-tri data-type="nombre">Dots</th>
              <th scope="col" class="nombre" data-tri data-type="nombre">Place</th>
            </tr>
          </thead>
          <tbody>
            {
              resultats.map((r) => {
                const classe = parseWeightClass(r.weightClassKg);
                return (
                  <tr
                    data-recherche={r.name}
                    data-sexe={r.sex}
                    data-pays={r.meetCountry}
                    data-federation={r.federation}
                    data-equipement={equipmentGroup(r.equipment)}
                  >
                    <td class="date" data-libelle="Date" data-valeur={r.date.replace(/-/g, '')}>
                      {dateCourte(r.date)}
                    </td>
                    <th scope="row" class="athlete">
                      <span class="nom-ligne">
                        <a href={`/athlete/${athleteSlug(r.name)}/`}>{r.name}</a>
                        <BadgeOfficiel taille={13} />
                      </span>
                    </th>
                    <td data-libelle="Compétition" class="competition">
                      {r.meetName}
                      <span class="meta">
                        {r.federation}
                        {r.meetTown && <> · {r.meetTown}</>}
                        {' · '}
                        {libelleEvent(r.event)}
                      </span>
                    </td>
                    <td data-libelle="Pays">{paysFr(r.meetCountry)}</td>
                    <td class="nombre" data-libelle="Catégorie" data-valeur={classe?.kg ?? ''}>
                      {r.weightClassKg ? `${r.weightClassKg} kg` : '—'}
                    </td>
                    <td class="nombre num-tab" data-libelle="Total" data-valeur={r.event === 'SBD' ? (r.totalKg ?? '') : ''}>
                      {r.event === 'SBD' ? nombre(r.totalKg) : '—'}
                    </td>
                    <td class="nombre" data-libelle="Dots" data-valeur={r.event === 'SBD' ? (r.dots ?? '') : ''}>
                      {r.event === 'SBD' ? points(r.dots) : '—'}
                    </td>
                    <td class="nombre" data-libelle="Place" data-valeur={Number.parseInt(r.place, 10) || 999}>
                      {place(r.place)}
                    </td>
                  </tr>
                );
              })
            }
          </tbody>
        </table>
      </div>
    </InteractiveTable>

    <p class="note">
      Le rattachement d'un résultat à un athlète repose sur son nom tel
      qu'OpenPowerlifting l'écrit. Le projet distingue les homonymes par un
      suffixe numéroté, mais il lui arrive de ne pas les avoir repérés. Si tu
      repères une compétition qui n'est pas la tienne, écris-nous : elle sera
      retirée, et le doublon signalé à la source.
    </p>
  </div>
</BaseLayout>

<style>
  .entete-page {
    margin-bottom: var(--space-8);
  }

  .chapeau {
    color: var(--muted);
    max-width: 68ch;
  }

  .avertissement {
    max-width: 68ch;
    padding: var(--space-4) var(--space-6);
    border: 1px solid var(--border);
    border-left: 4px solid var(--accent);
    border-radius: 0 var(--radius-lg) var(--radius-lg) 0;
    background: var(--surface);
  }

  .avertissement p {
    margin: 0 0 var(--space-2);
    font-size: var(--step--1);
  }
  .avertissement p:last-child {
    margin-bottom: 0;
    color: var(--muted);
  }

  .champ {
    display: grid;
    gap: var(--space-1);
    flex: 1 1 9rem;
  }

  label {
    font-size: var(--step--1);
    font-weight: 600;
    color: var(--muted);
  }

  select {
    padding: var(--space-2) var(--space-3);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--bg);
    color: var(--text);
    font: inherit;
    font-size: var(--step--1);
  }

  .cadre {
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: var(--surface);
    overflow: hidden;
  }

  table {
    width: 100%;
    border-collapse: collapse;
    font-size: var(--step--1);
  }

  th,
  td {
    text-align: left;
    padding: var(--space-2) var(--space-3);
  }

  thead {
    display: none;
  }

  .athlete {
    font-weight: 600;
  }

  .nom-ligne {
    display: inline-flex;
    align-items: center;
  }

  .athlete a {
    color: var(--text);
  }
  .athlete a:hover {
    color: var(--accent);
  }

  .meta {
    display: block;
    font-size: var(--step--1);
    font-weight: 400;
    color: var(--muted);
  }

  .date {
    white-space: nowrap;
    font-variant-numeric: tabular-nums;
    color: var(--muted);
  }

  /* ---------- Mobile : une carte par résultat ---------- */
  @media (max-width: 61.999rem) {
    tbody tr {
      display: block;
      padding: var(--space-4);
      border-bottom: 1px solid var(--border);
    }
    tbody tr:last-child {
      border-bottom: 0;
    }

    .athlete {
      display: block;
      padding: 0 0 var(--space-2);
      font-size: var(--step-0);
    }

    td {
      display: flex;
      justify-content: space-between;
      gap: var(--space-3);
      padding: var(--space-1) 0;
    }

    td::before {
      content: attr(data-libelle);
      color: var(--muted);
      font-weight: 600;
    }

    .competition {
      flex-direction: column;
      align-items: flex-start;
    }
  }

  /* ---------- Desktop ---------- */
  @media (min-width: 62rem) {
    thead {
      display: table-header-group;
    }

    thead th {
      font-size: var(--step--1);
      font-weight: 600;
      color: var(--muted);
      text-transform: uppercase;
      letter-spacing: 0.04em;
      border-bottom: 1px solid var(--border);
      white-space: nowrap;
    }

    td.nombre,
    th.nombre {
      text-align: right;
      font-variant-numeric: tabular-nums;
    }

    tbody tr {
      border-bottom: 1px solid var(--border);
    }
    tbody tr:last-child {
      border-bottom: 0;
    }
    tbody tr:hover {
      background: color-mix(in srgb, var(--accent) 6%, transparent);
    }

    td::before {
      display: none;
    }
  }

  .note {
    margin-top: var(--space-4);
    font-size: var(--step--1);
    color: var(--muted);
    max-width: 68ch;
  }
</style>

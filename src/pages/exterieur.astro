---
import BadgeOfficiel from '../components/BadgeOfficiel.astro';
import InteractiveTable from '../components/InteractiveTable.astro';
import Repli from '../components/Repli.astro';
import Terme from '../components/Terme.astro';
import InfographieDonnees from '../components/infographies/InfographieDonnees.astro';
import InfographieInternational from '../components/infographies/InfographieInternational.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { equipmentGroup, parseWeightClass } from '../lib/categories';
import {
  paysFr,
  resultatsExterieur,
  statsExterieur,
  valeursFrequentes,
} from '../lib/exterieur';
import { annee, dateCourte, nombre, place, points } from '../lib/format';
import { libelleEvent } from '../lib/meets';
import { athleteSlug } from '../lib/slug';

const stats = statsExterieur();
const pays = valeursFrequentes('meetCountry');
const federations = valeursFrequentes('federation');

// Du plus récent au plus ancien : c'est l'actualité qui intéresse en premier.
const resultats = [...resultatsExterieur].sort((a, b) => b.date.localeCompare(a.date));
---

<BaseLayout
  titre="Résultats hors de La Réunion"
  description="Les powerlifters réunionnais en déplacement : résultats obtenus en métropole et à l'étranger, hors des compétitions organisées sur l'île."
>
  <div class="wrap">
    <header class="entete-page">
      <h1>Hors de La Réunion</h1>
      {/*
        UNE PHRASE, COMME LE CHAPEAU DU CLASSEMENT. Les deux phrases d'avant
        comptaient 41 mots, dont un « plateaux-là » de jargon. Les cinq
        chiffres sont calculés par lib/exterieur.ts.
      */}
      <p class="chapeau">
        {stats.resultats} résultats obtenus hors de l'île par {stats.athletes}{' '}
        athlètes du site, dans {stats.pays} pays et {stats.federations}{' '}
        fédérations, de {annee(stats.debut)} à {annee(stats.fin)}.
      </p>
      {/*
        DEUX PHRASES COURTES pour la seconde ligne de l'encadré. Elle en
        comptait deux, dont une de 30 mots coupée par « et » puis « mais ».
      */}
      <div class="avertissement">
        <p>
          <strong>
            Ces résultats restent en dehors du classement et des{' '}
            <Terme cle="record">records</Terme>.
          </strong>
        </p>
        <p>
          Ils figurent sur la fiche de chaque athlète. Le classement et les
          records retiennent les <Terme cle="barre">barres</Terme> soulevées à
          La Réunion.
        </p>
      </div>
    </header>

    {/*
      PAYS, FÉDÉRATIONS ET TITRES EN IMAGES, REPLIÉS. La pastille tient sur
      une ligne entre l'avertissement et la recherche : la liste reste le
      premier contenu de la page, et qui veut savoir d'où viennent ces
      résultats l'ouvre.

      LA PROVENANCE SUR LA MÊME RANGÉE. Elle montre pourquoi ces résultats
      vivent ici et sur les fiches, hors du classement et des records : c'est
      la question que pose cette page.
    */}
    {/*
      LES PASTILLES DISENT LEUR QUESTION. Mesuré à 320 et 375 px, les deux
      pastilles occupaient déjà deux rangées, une chacune, et les nouveaux
      libellés y tiennent : aucune rangée de plus. À 1 280 px, elles restent
      côte à côte.
    */}
    <div class="rangee-replis">
      <Repli titre="Quels pays, quels titres ?">
        <InfographieInternational lienArticle="international" />
      </Repli>
      <Repli titre="D'où viennent les données ?">
        <InfographieDonnees />
      </Repli>
    </div>

    {/*
      LES FILTRES REPLIÉS SUR TÉLÉPHONE SEULEMENT, comme les résultats d'une
      compétition : trois menus y prennent deux rangées, 317 px de barre à
      375 px de large. Repliée, la barre en mesure 154, et le premier
      résultat remonte. Au-delà de 40rem, les trois menus tiennent sur une
      rangée et restent ouverts.
    */}
    <InteractiveTable
      recherche="Nom d'un athlète"
      singulier="résultat"
      pluriel="résultats"
      total={resultats.length}
      replier="telephone"
    >
      <Fragment slot="filtres">
        <div class="champ">
          <label for="f-sexe">Sexe</label>
          <select id="f-sexe" data-filtre="sexe">
            <option value="">Tous</option>
            <option value="M">Hommes</option>
            <option value="F">Femmes</option>
          </select>
        </div>

        <div class="champ">
          <label for="f-pays">Pays</label>
          <select id="f-pays" data-filtre="pays">
            <option value="">Tous</option>
            {pays.map((p) => <option value={p}>{paysFr(p)}</option>)}
          </select>
        </div>

        <div class="champ">
          <label for="f-federation">Fédération</label>
          <select id="f-federation" data-filtre="federation">
            <option value="">Toutes</option>
            {federations.map((f) => <option value={f}>{f}</option>)}
          </select>
        </div>
      </Fragment>

      <div class="liste liste-barres">
        <table data-tableau>
          <thead>
            <tr>
              <th scope="col" data-tri data-type="nombre">Date</th>
              <th scope="col" data-tri>Athlète</th>
              <th scope="col" data-tri>Compétition</th>
              <th scope="col" data-tri>Pays</th>
              <th scope="col" class="nombre" data-tri data-type="nombre">Cat.</th>
              <th scope="col" class="nombre" data-tri data-type="nombre">Total</th>
              <th scope="col" class="nombre" data-tri data-type="nombre">Dots</th>
              <th scope="col" class="nombre" data-tri data-type="nombre">Place</th>
            </tr>
          </thead>
          <tbody>
            {
              resultats.map((r) => {
                const classe = parseWeightClass(r.weightClassKg);
                return (
                  <tr
                    data-recherche={r.name}
                    data-sexe={r.sex}
                    data-pays={r.meetCountry}
                    data-federation={r.federation}
                    data-equipement={equipmentGroup(r.equipment)}
                  >
                    <td class="date" data-libelle="Date" data-valeur={r.date.replace(/-/g, '')}>
                      {dateCourte(r.date)}
                    </td>
                    <th scope="row" class="nom">
                      <a href={`/athlete/${athleteSlug(r.name)}/`}>{r.name}</a>
                      <BadgeOfficiel taille={13} />
                    </th>
                    <td data-libelle="Compétition" class="competition">
                      <span class="meet">{r.meetName}</span>
                      <span class="ou">
                        {r.federation}
                        {r.meetTown && <> · {r.meetTown}</>}
                        {' · '}
                        {libelleEvent(r.event)}
                      </span>
                    </td>
                    <td data-libelle="Pays" class="cellule-annexe">
                      <span class="etiquette">{paysFr(r.meetCountry)}</span>
                    </td>
                    {/* La virgule décimale du français : OpenPowerlifting
                        écrit « 67.5 », 30 résultats anciens portent ces
                        catégories à demi-kilo. */}
                    <td class="nombre" data-libelle="Catégorie" data-valeur={classe?.kg ?? ''}>
                      {r.weightClassKg ? `${r.weightClassKg.replace('.', ',')} kg` : '—'}
                    </td>
                    {/* L'espace avant l'unité est écrite : Astro supprime
                        celle qui sépare deux expressions, et la cellule
                        lisait « 427,5kg » sur toutes les lignes. */}
                    <td class="nombre num-tab" data-libelle="Total" data-valeur={r.event === 'SBD' ? (r.totalKg ?? '') : ''}>
                      {r.event === 'SBD' ? nombre(r.totalKg) : '—'}
                      {r.event === 'SBD' && r.totalKg ? <>{' '}<span class="unite">kg</span></> : null}
                    </td>
                    <td class="nombre" data-libelle="Dots" data-valeur={r.event === 'SBD' ? (r.dots ?? '') : ''}>
                      {r.event === 'SBD' ? points(r.dots) : '—'}
                    </td>
                    <td class="nombre" data-libelle="Place" data-valeur={Number.parseInt(r.place, 10) || 999}>
                      {place(r.place)}
                    </td>
                  </tr>
                );
              })
            }
          </tbody>
        </table>
      </div>
    </InteractiveTable>

    {/*
      LE VOUVOIEMENT, COMME PARTOUT AILLEURS SUR LE SITE, et un lien vers la
      boîte à suggestions au lieu d'un « écris-nous » qui ne disait pas où.
    */}
    <p class="note">
      Le rattachement d'un résultat à un athlète repose sur son nom, tel
      qu'OpenPowerlifting l'écrit. Ce projet distingue les homonymes par un
      suffixe numéroté, et certains lui échappent encore. Un résultat à votre
      nom vient d'un homonyme ? Signalez-le depuis la page{' '}
      <a href="/suggestions/">Proposer une amélioration</a>. Il sera retiré, et
      le doublon signalé à OpenPowerlifting.
    </p>
  </div>
</BaseLayout>

<style>
  /* Quatre chiffres par ligne, catégorie, total, Dots et place : rangés trois
     par rangée, le quatrième resterait seul. Deux par rangée les apparient. */
  .liste.liste-barres {
    --pas: 3;
  }



  .avertissement {
    max-width: 68ch;
    padding: var(--space-4) var(--space-6);
    border: 1px solid var(--border);
    border-left: 4px solid var(--accent);
    border-radius: 0 var(--radius-lg) var(--radius-lg) 0;
    background: var(--surface);
  }

  .avertissement p {
    margin: 0 0 var(--space-2);
    font-size: var(--step--1);
  }
  .avertissement p:last-child {
    margin-bottom: 0;
    color: var(--muted);
  }

</style>

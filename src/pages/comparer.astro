---
import Repli from '../components/Repli.astro';
import Terme from '../components/Terme.astro';
import InfographieComparer from '../components/infographies/InfographieComparer.astro';
import '../styles/filtres.css';
import BaseLayout from '../layouts/BaseLayout.astro';
import { equipmentGroup, equipmentLabel } from '../lib/categories';
import { results } from '../lib/data';
import { athleteSlug } from '../lib/slug';
import type { Result } from '../lib/types';

/**
 * Comparaison d'athlètes, jusqu'à quatre à la fois.
 *
 * POURQUOI TOUTES LES DONNÉES SONT DANS LA PAGE
 * ---------------------------------------------
 * Le site est statique : il n'y a pas de serveur à interroger quand le
 * visiteur change de sélection. Les 312 athlètes sont donc résumés une fois au
 * build et livrés dans la page, ce qui rend la comparaison instantanée et
 * fonctionnelle hors ligne. Le résumé est volontairement maigre — dix nombres
 * par athlète — parce que c'est ce qui décide du poids de la page.
 *
 * L'ÉTAT VIT DANS L'ADRESSE
 * -------------------------
 * La sélection s'écrit dans l'URL, comme les filtres du reste du site. Une
 * comparaison se partage donc par simple copie du lien, ce qui est exactement
 * l'usage attendu d'un tel outil.
 */

interface Resume {
  n: string; // nom
  s: string; // slug
  x: string; // sexe
  c: string; // catégorie de poids
  p: number | null; // poids de corps
  e: string; // équipement
  sq: number; // meilleur squat
  bp: number; // meilleur développé couché
  dl: number; // meilleur soulevé de terre
  t: number; // meilleur total full power
  d: number; // meilleur Dots
  co: number; // compétitions à La Réunion
  r: number; // rang aux Dots à La Réunion, 0 si non classé
}

/**
 * Un athlète, résumé par ses MEILLEURES barres, tous formats confondus.
 *
 * Les mouvements isolés comptent : une barre soulevée devant des juges compte,
 * qu'elle vienne d'un full power ou d'une compétition de développé couché seul.
 * Le total et le Dots, eux, ne viennent QUE du full power — c'est l'invariant
 * le plus important du projet, un « total » de compétition de bench seul ne
 * vaut que cette barre-là.
 */
const parAthlete = new Map<string, Result[]>();
for (const r of results) {
  const liste = parAthlete.get(r.name);
  if (liste) liste.push(r);
  else parAthlete.set(r.name, [r]);
}

const athletes: Resume[] = [...parAthlete.entries()]
  .map(([nom, lignes]) => {
    const fullPower = lignes.filter((r) => r.event === 'SBD');
    const max = (f: (r: Result) => number | null | undefined) =>
      Math.max(0, ...lignes.map((r) => f(r) ?? 0));

    // La ligne du meilleur total sert de référence pour la catégorie et
    // l'équipement : c'est la performance qui définit le mieux l'athlète.
    const reference =
      fullPower.reduce<Result | null>(
        (a, b) => ((b.totalKg ?? 0) > (a?.totalKg ?? 0) ? b : a),
        null,
      ) ?? lignes[0];

    return {
      n: nom,
      s: athleteSlug(nom),
      x: reference.sex,
      c: reference.weightClassKg,
      p: reference.bodyweightKg,
      e: equipmentLabel(equipmentGroup(reference.equipment)),
      sq: max((r) => r.bestSquatKg),
      bp: max((r) => r.bestBenchKg),
      dl: max((r) => r.bestDeadliftKg),
      t: Math.max(0, ...fullPower.map((r) => r.totalKg ?? 0)),
      d: Math.max(0, ...fullPower.map((r) => r.dots ?? 0)),
      co: fullPower.length,
      r: 0,
    };
  });

/**
 * Le rang à La Réunion, calculé sur les points DOTS.
 *
 * Les Dots plutôt que le total brut : c'est le score qui rapporte la
 * performance au poids de corps, et donc le seul qui permette de situer un
 * athlète de 66 kg face à un de 120 kg. Le classement du site emploie la même
 * mesure.
 *
 * Un athlète sans total full power n'est pas classé : son « total » de
 * compétition de développé couché seul ne vaut que cette barre-là, et le
 * comparer aux autres serait faux. Il porte alors le rang 0, affiché « — ».
 */
const classes = athletes.filter((a) => a.d > 0).sort((a, b) => b.d - a.d);
classes.forEach((a, i) => {
  a.r = i + 1;
});

const nombreClasses = classes.length;
athletes.sort((a, b) => a.n.localeCompare(b.n, 'fr'));

const nombreAthletes = athletes.length;
---

<BaseLayout
  titre="Comparer des athlètes"
  description={`Comparez jusqu'à quatre athlètes de force athlétique de La Réunion parmi ${nombreAthletes} : squat, développé couché, soulevé de terre, total et points Dots, avec l'écart en pourcentage.`}
>
  <div class="wrap page-comparer">
    <h1>Comparer des athlètes</h1>

    <p class="chapeau">
      Choisissez jusqu'à quatre athlètes et comparez leurs meilleures{' '}
      <Terme cle="barre">barres</Terme>. L'écart s'affiche en pourcentage par
      rapport au meilleur de chaque ligne. L'adresse de la page garde votre
      sélection, et le lien se partage tel quel.
    </p>

    {/*
      L'ÉCART EN IMAGES, REPLIÉ. Une pastille entre le chapeau et le choix des
      athlètes : le chapeau annonce l'écart au meilleur de chaque ligne, la
      pastille en donne le calcul à qui le demande. Mesuré, elle descend le
      champ et le tableau de 60 px, à 375 comme à 1 280 px. Dépliée dans la
      section « Lire la comparaison », l'infographie coupait le texte en deux
      et repoussait ses deux derniers paragraphes de 1 720 px sur téléphone.
    */}
    <div class="rangee-replis">
      <Repli titre="L'écart en images">
        <InfographieComparer />
      </Repli>
    </div>

    {/*
      LA BARRE DE FILTRES COMMUNE, celle des listes et de la carte. Le champ
      en tête sur toute la largeur, « Ajouter » au bout comme « Filtres »
      ailleurs, puis la rangée d'état : le compte à gauche, « Réinitialiser »
      à droite, et les athlètes choisis en étiquettes qu'un geste retire.
      La forme vit dans src/styles/filtres.css.
    */}
    <div class="barre-filtres choix" data-pret>
      <div class="rangee-recherche">
        <div class="champ">
          <label for="recherche">Ajouter un athlète</label>
          {/* L'invite des listes : l'ancienne, « Tapez un nom, par exemple
              Gabriel Begue », était coupée à 375 px par le bouton voisin. */}
          <input
            id="recherche"
            type="text"
            list="liste-athletes"
            placeholder="Nom d'un athlète"
            autocomplete="off"
            aria-describedby="aide-recherche"
          />
        </div>
        <button type="button" id="ajouter" class="ajouter">Ajouter</button>
      </div>
      <datalist id="liste-athletes">
        {athletes.map((a) => <option value={a.n} />)}
      </datalist>
      <p class="aide" id="aide-recherche">
        {nombreAthletes} athlètes disponibles. Quatre au maximum dans une
        comparaison, au-delà le tableau devient illisible.
      </p>
      <div class="rangee-etat" id="etat-selection" hidden>
        <p class="compteur" id="compte-selection" aria-live="polite"></p>
        <button type="button" id="vider" class="bouton-outil bouton-reinitialiser" hidden>Réinitialiser</button>
        <ul id="selection" class="etiquettes-actives" aria-label="Athlètes comparés"></ul>
      </div>
    </div>

    <div id="vide" class="vide">
      {/* `tabindex="-1"` : le focus s'y pose quand la sélection se vide,
          voir le script. */}
      <p id="message-vide" tabindex="-1">Aucun athlète sélectionné pour l'instant.</p>
      <p class="fin">
        Commencez par en ajouter un, ou essayez directement{' '}
        <a href="?a=gabriel-begue,noah-nativel">une comparaison d'exemple</a>.
      </p>
    </div>

    <div id="tableau" class="tableau-zone" hidden></div>
    {/*
      Masquée tant que le tableau tient dans l'écran. Le script la révèle
      uniquement s'il déborde vraiment, pour ne pas annoncer un geste inutile.
    */}
    <p class="indication-defilement" data-indication-defilement hidden>
      Le tableau est plus large que l'écran. Faites-le glisser vers la gauche
      pour voir les colonnes suivantes.
    </p>

    {/*
      UN TITRE QUI DIT LE GESTE. « Ce que ces chiffres disent, et ce qu'ils ne
      disent pas » opposait deux moitiés, et la section explique comment lire
      le tableau. Ses trois paragraphes tiennent en phrases affirmatives, une
      information chacune.
    */}
    <h2>Lire la comparaison</h2>
    <p>
      Les meilleures barres d'un athlète peuvent venir de compétitions et
      d'années différentes. Un squat de 2019 peut ainsi côtoyer un soulevé de
      terre de 2025.
    </p>
    <p>
      Le <Terme cle="total">total</Terme> et les points{' '}
      <Terme cle="dots">Dots</Terme> proviennent uniquement du full power, seul
      format où les trois mouvements s'enchaînent. Les barres isolées, elles,
      comptent quel que soit le format de la compétition.
    </p>
    <p>
      Les points Dots rapportent le total au{' '}
      <Terme cle="poids-corps">poids de corps</Terme>. Ils permettent de
      comparer deux athlètes de <Terme cle="categorie">catégories</Terme>{' '}
      différentes.
    </p>
  </div>
</BaseLayout>

<script is:inline define:vars={{ athletes, nombreClasses }}>
  (() => {
    const MAX = 4;
    const parSlug = new Map(athletes.map((a) => [a.s, a]));

    const champ = document.getElementById('recherche');
    const bouton = document.getElementById('ajouter');
    const zoneSelection = document.getElementById('selection');
    const rangeeEtat = document.getElementById('etat-selection');
    const compte = document.getElementById('compte-selection');
    const vider = document.getElementById('vider');
    const zoneTableau = document.getElementById('tableau');
    const indication = document.querySelector('[data-indication-defilement]');
    const zoneVide = document.getElementById('vide');
    const messageVide = document.getElementById('message-vide');

    /**
     * Échappe une valeur avant de l'insérer dans du HTML construit à la main.
     *
     * Les noms d'athlètes viennent d'OpenPowerlifting, donc d'un tiers, et
     * atterrissaient tels quels dans `innerHTML` : en contenu de balise, en
     * texte de lien, et jusque dans un attribut `aria-label`. Aucun des 312
     * noms actuels ne contient de caractère dangereux, mais le jeu de données
     * est régénéré chaque mois et personne ne relit 312 noms.
     *
     * Un nom contenant un guillemet suffirait à sortir de l'attribut. Le coût
     * de cette fonction est nul, celui de l'oubli ne l'est pas.
     */
    const echapper = (v) =>
      String(v).replace(
        /[&<>"']/g,
        (c) =>
          ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c],
      );

    /** Les lignes du tableau. `dec` = nombre de décimales à l'affichage. */
    const LIGNES = [
      // `rang: true` inverse tout : le meilleur est le PLUS PETIT, et l'écart
      // se compte en places plutôt qu'en pourcentage. Un rang deux fois plus
      // grand ne veut rien dire ; douze places d'écart, si.
      { clef: 'r', label: 'Rang à La Réunion', unite: '', dec: 0, rang: true },
      { clef: 'sq', label: 'Squat', unite: 'kg', dec: 1 },
      { clef: 'bp', label: 'Développé couché', unite: 'kg', dec: 1 },
      { clef: 'dl', label: 'Soulevé de terre', unite: 'kg', dec: 1 },
      { clef: 't', label: 'Total', unite: 'kg', dec: 1 },
      { clef: 'd', label: 'Points Dots', unite: '', dec: 1 },
      { clef: 'co', label: 'Compétitions', unite: '', dec: 0 },
    ];

    const nombre = (v, dec) =>
      v.toLocaleString('fr-FR', {
        minimumFractionDigits: 0,
        maximumFractionDigits: dec,
      });

    /** Slugs sélectionnés, lus dans l'adresse. */
    function selection() {
      const brut = new URLSearchParams(location.search).get('a') ?? '';
      const vus = new Set();
      return brut
        .split(',')
        .map((s) => s.trim())
        .filter((s) => {
          // Un slug inconnu ou répété est ignoré plutôt que d'afficher une
          // colonne vide : une adresse bricolée à la main ne doit pas casser
          // la page.
          if (!s || vus.has(s) || !parSlug.has(s)) return false;
          vus.add(s);
          return true;
        })
        .slice(0, MAX);
    }

    function ecrire(slugs) {
      const url = new URL(location.href);
      if (slugs.length) url.searchParams.set('a', slugs.join(','));
      else url.searchParams.delete('a');
      history.replaceState(null, '', url);
      rendre();
    }

    function rendre() {
      const slugs = selection();
      const choisis = slugs.map((s) => parSlug.get(s));

      /*
       * LES ATHLÈTES CHOISIS, EN ÉTIQUETTES DE LA BARRE COMMUNE. L'étiquette
       * entière est le bouton qui la retire : la croix seule, d'avant, faisait
       * une cible de 18 px de large. « Réinitialiser » paraît dès le premier
       * athlète, comme dans les listes dès le premier filtre : il est au même
       * endroit sur toutes les pages, quoi qu'il y ait à défaire.
       */
      zoneSelection.innerHTML = choisis
        .map(
          (a) =>
            `<li><button type="button" class="etiquette-active" data-retirer="${echapper(a.s)}" aria-label="Retirer ${echapper(a.n)}">${echapper(a.n)}</button></li>`,
        )
        .join('');
      rangeeEtat.hidden = choisis.length === 0;
      vider.hidden = choisis.length === 0;
      compte.textContent = `${choisis.length} athlète${choisis.length > 1 ? 's' : ''} sur ${MAX}`;

      zoneVide.hidden = choisis.length > 0;
      zoneTableau.hidden = choisis.length === 0;
      // Sans tableau, pas d'indication de défilement à afficher.
      if (indication && !choisis.length) indication.hidden = true;
      if (!choisis.length) return;

      const enTetes = choisis
        .map(
          (a) =>
            `<th scope="col"><a href="/athlete/${echapper(a.s)}/">${echapper(a.n)}</a><span class="sous">${echapper(a.c)} kg · ${echapper(a.e)}</span></th>`,
        )
        .join('');

      const corps = LIGNES.map((l) => {
        const valeurs = choisis.map((a) => a[l.clef]);
        const connus = valeurs.filter((v) => v > 0);

        // L'écart se lit par rapport au MEILLEUR de la ligne : c'est la seule
        // référence qui ne dépende pas de l'ordre de sélection. Pour un rang,
        // « meilleur » veut dire le plus petit nombre.
        const meilleur = connus.length
          ? l.rang
            ? Math.min(...connus)
            : Math.max(...connus)
          : 0;

        const cellules = valeurs
          .map((v) => {
            if (!v) {
              return `<td class="absent">—<span class="ecart">${l.rang ? 'non classé' : 'aucune barre'}</span></td>`;
            }

            const chef = v === meilleur;
            let badge;

            if (chef) {
              badge = '<span class="ecart positif">meilleur</span>';
            } else if (l.rang) {
              // Un rang plus grand est moins bon : l'écart est donc négatif,
              // même si le nombre de places, lui, augmente.
              const places = v - meilleur;
              badge = `<span class="ecart negatif">−${places} place${places > 1 ? 's' : ''}</span>`;
            } else {
              const ecart = ((v - meilleur) / meilleur) * 100;
              badge = `<span class="ecart negatif">${nombre(ecart, 1)} %</span>`;
            }

            const affiche = l.rang
              ? `${nombre(v, 0)}<span class="sur">e</span>`
              : `${nombre(v, l.dec)}${l.unite ? ' ' + l.unite : ''}`;

            return `<td class="${chef ? 'est-chef' : ''}"><span class="valeur num-tab">${affiche}</span>${badge}</td>`;
          })
          .join('');

        const precision = l.rang
          ? `<span class="sous">sur ${nombreClasses} classés</span>`
          : '';

        return `<tr><th scope="row">${l.label}${precision}</th>${cellules}</tr>`;
      }).join('');

      zoneTableau.innerHTML =
        `<table class="comparaison"><thead><tr><th scope="col"><span class="sr-only">Mesure</span></th>${enTetes}</tr></thead><tbody>${corps}</tbody></table>`;

      signalerDefilement();
    }

    /**
     * Rend le défilement du tableau visible, et atteignable au clavier.
     *
     * À quatre athlètes sur téléphone, le tableau fait 544 px dans une zone de
     * 328 : plus de 200 px existent hors de l'écran et RIEN ne le disait. Une
     * information qu'on ne sait pas aller chercher n'existe pas.
     *
     * Deux manques comblés d'un coup. L'indication visible, qui n'apparaît que
     * lorsqu'il y a vraiment quelque chose à atteindre. Et `tabindex="0"`, sans
     * lequel une zone défilante reste inaccessible à qui n'a pas de souris :
     * le clavier ne peut pas faire défiler un conteneur qu'il ne peut pas
     * atteindre.
     */
    function signalerDefilement() {
      const deborde = zoneTableau.scrollWidth > zoneTableau.clientWidth + 1;

      if (deborde) {
        zoneTableau.setAttribute('tabindex', '0');
        zoneTableau.setAttribute('role', 'region');
        zoneTableau.setAttribute('aria-label', 'Tableau de comparaison, défilant');
      } else {
        zoneTableau.removeAttribute('tabindex');
        zoneTableau.removeAttribute('role');
        zoneTableau.removeAttribute('aria-label');
      }

      if (indication) indication.hidden = !deborde;
    }

    function ajouter(nom) {
      const trouve = athletes.find(
        (a) => a.n.toLowerCase() === nom.trim().toLowerCase(),
      );
      if (!trouve) return false;

      const slugs = selection();
      if (slugs.includes(trouve.s) || slugs.length >= MAX) return false;

      ecrire([...slugs, trouve.s]);
      return true;
    }

    bouton.addEventListener('click', () => {
      if (ajouter(champ.value)) champ.value = '';
    });

    champ.addEventListener('keydown', (e) => {
      if (e.key !== 'Enter') return;
      e.preventDefault();
      if (ajouter(champ.value)) champ.value = '';
    });

    // Choisir dans la liste native valide directement, sans passer par le
    // bouton : c'est le geste attendu.
    champ.addEventListener('input', () => {
      if (athletes.some((a) => a.n === champ.value) && ajouter(champ.value)) {
        champ.value = '';
      }
    });

    /*
     * Retirer un athlète redessine les étiquettes : le focus passe à la
     * suivante, sinon à la précédente. Après la dernière, la rangée d'état
     * disparaît, et le focus va au message qui dit la sélection vide. Le
     * champ, autre candidat, ferait surgir le clavier d'un téléphone : c'est
     * la règle des listes, où une remise à zéro ne vise jamais la recherche.
     */
    zoneSelection.addEventListener('click', (e) => {
      const cible = e.target.closest('[data-retirer]');
      if (!cible) return;
      const position = [...zoneSelection.querySelectorAll('[data-retirer]')].indexOf(cible);
      ecrire(selection().filter((s) => s !== cible.dataset.retirer));
      const restantes = zoneSelection.querySelectorAll('[data-retirer]');
      (restantes[position] ?? restantes[position - 1] ?? messageVide).focus();
    });

    // Même règle après « Réinitialiser » : le focus va au message.
    vider.addEventListener('click', () => {
      ecrire([]);
      messageVide.focus();
    });

    // Les boutons Précédent et Suivant du navigateur doivent fonctionner :
    // l'adresse EST l'état.
    window.addEventListener('popstate', rendre);

    // Une rotation de téléphone peut faire entrer le tableau dans l'écran, ou
    // l'en faire sortir : l'indication doit suivre.
    window.addEventListener('resize', () => {
      if (!zoneTableau.hidden) signalerDefilement();
    });

    rendre();
  })();
</script>

<style>
  /*
   * La barre, son champ, son compte et ses étiquettes viennent de
   * src/styles/filtres.css. Ne restent ici que l'écart avant la suite de la
   * page, le bouton « Ajouter » et la phrase d'aide.
   */
  .choix {
    margin-bottom: var(--space-6);
  }

  /*
   * « AJOUTER » EST L'ACTION DE LA PAGE, d'où l'aplat que n'ont pas les
   * boutons de la barre. Son survol passait en --accent sous du texte
   * --bg : --accent est un accent de texte, l'aplat survolé a son jeton.
   */
  .ajouter {
    flex-shrink: 0;
    min-height: var(--cible-min);
    padding: 0 var(--space-6);
    border: 1px solid var(--accent-fill);
    border-radius: var(--radius);
    background: var(--accent-fill);
    color: var(--on-accent);
    font: inherit;
    font-weight: 700;
    cursor: pointer;
  }
  .ajouter:hover {
    border-color: var(--accent-fill-hover);
    background: var(--accent-fill-hover);
  }

  .aide {
    margin: 0;
    font-size: var(--step--1);
    color: var(--muted);
  }

  .vide {
    border: 2px dashed var(--border);
    border-radius: var(--radius-lg);
    padding: var(--space-8);
    text-align: center;
    color: var(--muted);
  }
  .vide p {
    margin: 0;
  }
  .vide .fin {
    font-size: var(--step--1);
    margin-top: var(--space-2);
  }

  /* Le tableau peut dépasser sur mobile avec quatre colonnes : il défile
     dans son propre conteneur, jamais la page entière. */
  .tableau-zone {
    overflow-x: auto;
  }

  /* Le focus clavier doit se voir sur la zone défilante elle-même, sans quoi
     on ne sait pas ce que les flèches vont déplacer. */
  .tableau-zone:focus-visible {
    outline: 3px solid var(--accent);
    outline-offset: 4px;
  }

  .indication-defilement {
    margin: var(--space-3) 0 var(--space-12);
    font-size: var(--step--1);
    color: var(--muted);
  }

  .indication-defilement[hidden] {
    display: none;
  }

  /* Quand l'indication est masquée, c'est elle qui portait la marge basse :
     la zone la reprend. */
  .tableau-zone:not(:has(+ .indication-defilement:not([hidden]))) {
    margin-bottom: var(--space-12);
  }

  h2 {
    margin-top: var(--space-12);
    padding-top: var(--space-4);
    border-top: 1px solid var(--border);
  }
</style>

{/*
  Styles des éléments CONSTRUITS EN JAVASCRIPT.

  Astro limite ses styles aux éléments présents au moment du build : il leur
  ajoute un attribut de portée que le navigateur exige pour appliquer la règle.
  Le tableau de comparaison n'existant qu'après un clic, il ne porte pas cet
  attribut et les règles scopées l'ignorent purement et simplement — il
  s'affiche alors sans aucune mise en forme. Les étiquettes des athlètes
  choisis, elles aussi construites ici, prennent leur forme dans la feuille
  globale de la barre, src/styles/filtres.css.

  D'où ce second bloc en `is:global`, volontairement préfixé par

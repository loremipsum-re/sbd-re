---
import InfographiePartenaires from '../components/infographies/InfographiePartenaires.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { nombreAthletes, results } from '../lib/data';
import {
  ACCROCHE_MAX,
  BANNIERE_SUR_TELEPHONE,
  EMPLACEMENTS,
  FORMATS,
  IMAGES,
  PLUS_PETIT_ECRAN,
  TEXTE_BANNIERE_MIN,
  emplacementsDuFormat,
  enPixels,
  enumeration,
  type IdFormat,
} from '../lib/formats-partenaires';
import { listeMeets } from '../lib/meets';

const meets = listeMeets();

/*
 * LES TROIS FORMATS, LUS DANS LA TABLE. Dimensions et pages viennent de
 * lib/formats-partenaires.ts, comme le schéma et le CMS : une page qui change
 * de format change ici de paragraphe, sans qu'on y touche. `enPixels` garde
 * chaque dimension d'un seul tenant, unité comprise.
 */
const surLesPages = (format: 'banniere' | 'carte') =>
  `Sur ${enumeration(emplacementsDuFormat(format).map((id) => EMPLACEMENTS[id].pages))}.`;

const formats: { id: IdFormat; phrases: string[]; pages: string }[] = [
  {
    id: 'banniere',
    phrases: [
      `Votre image de ${enPixels(IMAGES.banniere)}.`,
      `Elle s'affiche sur ${enPixels(FORMATS.banniere.affichage.largeur)} de large au plus, et sur toute la largeur d'un téléphone.`,
    ],
    pages: surLesPages('banniere'),
  },
  {
    id: 'carte',
    phrases: [
      `Votre logo de ${enPixels(IMAGES.logo)}, votre nom et une phrase de ${ACCROCHE_MAX} caractères au plus.`,
      `Le logo s'affiche sur ${enPixels(FORMATS.carte.affichage)}.`,
    ],
    pages: surLesPages('carte'),
  },
  {
    id: 'logo',
    phrases: [
      'Le logo de la carte, dans le bandeau du pied de page.',
      `Il s'affiche sur ${enPixels(FORMATS.logo.affichage)}.`,
    ],
    pages: "Sur toutes les pages, sauf les fiches d'athlète.",
  },
];

/** Ce que mesure à l'écran le plus petit texte permis dans une bannière. */
const texteSurTelephone = Math.floor(
  (TEXTE_BANNIERE_MIN * BANNIERE_SUR_TELEPHONE) / IMAGES.banniere.largeur,
);
---

<BaseLayout
  titre="Partenariats"
  description="Marques de compléments, équipementiers, salles et organisateurs : proposer un partenariat à sbd.re, le site des classements et records de force athlétique à La Réunion."
>
  <div class="wrap page">
    <h1>Partenariats</h1>
    <p class="chapeau">
      Le site est indépendant et gratuit. Un partenaire aide à couvrir le nom de
      domaine, l'hébergement et le temps passé.
    </p>

    <section class="chiffres">
      <h2>Ce que touche le site</h2>
      <dl class="chiffres-cles">
        <div>
          <dt>Athlètes recensés</dt>
          <dd class="num">{nombreAthletes()}</dd>
        </div>
        <div>
          <dt>Compétitions</dt>
          <dd class="num">{meets.length}</dd>
        </div>
        <div>
          <dt>Résultats publiés</dt>
          <dd class="num">{results.length.toLocaleString('fr-FR')}</dd>
        </div>
      </dl>
      <p class="fin">
        Le public est celui de la force athlétique réunionnaise : pratiquants en
        club, compétiteurs, entraîneurs et organisateurs.
      </p>
    </section>

    <section class="regles">
      <h2>Ce qu'un partenariat peut être</h2>
      <p>
        Une image et un lien, hébergés sur le site. Aucun script extérieur,
        aucun pistage, aucune donnée de visiteur transmise à qui que ce soit.
      </p>
      <p>Trois formats existent, chacun à une place fixe après le contenu.</p>

      {/*
        LE GABARIT DE CHAQUE FORMAT, À SON RAPPORT : 4:1 pour la bannière, 2:1
        pour le logo. Il montre la forme de l'image à fournir, que les
        dimensions disent en chiffres juste à côté. Décoratif pour un lecteur
        d'écran, qui a les chiffres.
      */}
      <ul class="formats">
        {
          formats.map((f) => (
            <li>
              <span class="gabarit" data-format={f.id} aria-hidden="true">
                {f.id === 'carte' && (
                  <>
                    <span class="gabarit-logo" />
                    <span class="gabarit-lignes">
                      <span />
                      <span />
                    </span>
                  </>
                )}
              </span>
              <h3>{FORMATS[f.id].libelle}</h3>
              <div class="texte-format">
                {f.phrases.map((p) => (
                  <p>{p}</p>
                ))}
                <p class="pages">{f.pages}</p>
              </div>
            </li>
          ))
        }
      </ul>

      <p class="fin">
        Les images arrivent en PNG, JPEG, WebP ou SVG. Un logo sur fond plein
        reste lisible dans les deux thèmes du site. Sur un téléphone de
        {' '}{enPixels(PLUS_PETIT_ECRAN)}, la bannière mesure
        {' '}{enPixels(BANNIERE_SUR_TELEPHONE)} de large. Écrivez le texte de
        l'image en {enPixels(TEXTE_BANNIERE_MIN)} de haut au moins. Il mesure
        alors {enPixels(texteSurTelephone)} à l'écran.
      </p>
      {/*
        LA RÈGLE D'UNE PLACE PAR PAGE porte sur le CONTENU. Le bandeau du pied
        de page est à part, et le texte le dit : sans cette phrase, une page de
        compétition qui montre une bannière puis le bandeau contredirait la
        règle annoncée. Voir lib/sponsors.ts.
      */}
      <p class="fin">
        Une page porte un seul emplacement de contenu, placé après ses
        classements et ses tableaux. Le bandeau du pied de page est compté à
        part. Chaque emplacement porte la mention « Partenaire », comme la loi
        l'exige.
      </p>

      {/*
        L'infographie est DÉPLIÉE, en fin de section. Sur une page de données,
        elle irait dans une pastille repliée pour ne pas repousser la liste.
        Ici, la page est un texte, et le schéma répond à la question que la
        section pose : où un partenaire apparaît. Elle vient après le texte,
        qui reste la première lecture.

        LE COÛT EST MESURÉ : le formulaire descend d'environ 950 px à 375 px
        de large, et d'environ 780 px à 1 280 px. C'est la hauteur de la
        figure, compactée pour cette place : les pages en trois colonnes même
        sur téléphone, aucun intitulé au-dessus du schéma.
      */}
      <InfographiePartenaires />
    </section>

    <section class="formulaire">
      <h2>Proposer un partenariat</h2>

      <noscript>
        <p class="repli">
          Ce formulaire demande JavaScript. Écrivez directement à{' '}
          <a href="mailto:hello@loremipsum.re">hello@loremipsum.re</a>.
        </p>
      </noscript>

      <form id="contact" novalidate>
        <div class="champ">
          <label for="nom">Votre nom</label>
          <input id="nom" name="nom" type="text" required maxlength="100" autocomplete="name" />
        </div>

        <div class="champ">
          <label for="organisation">Organisation <span class="option">facultatif</span></label>
          <input
            id="organisation"
            name="organisation"
            type="text"
            maxlength="120"
            autocomplete="organization"
          />
        </div>

        <div class="champ">
          <label for="courriel">Adresse électronique</label>
          <input
            id="courriel"
            name="courriel"
            type="email"
            required
            maxlength="190"
            autocomplete="email"
          />
        </div>

        <div class="champ">
          <label for="sujet">Objet</label>
          <select id="sujet" name="sujet" required>
            <option value="partenariat">Proposition de partenariat</option>
            <option value="produit">Compléments ou équipement</option>
            <option value="evenement">Compétition ou événement</option>
            <option value="autre">Autre demande</option>
          </select>
        </div>

        <div class="champ">
          <label for="message">Votre demande</label>
          <textarea id="message" name="message" required rows="7" maxlength="4000"></textarea>
          <p class="aide">
            Dites qui vous êtes, ce que vous proposez, et sur quelle durée.
          </p>
        </div>

        {/*
          Champ appât. Invisible pour un humain, rempli par un robot qui
          complète tout ce qu'il trouve. Il est masqué en CSS et non par
          `hidden` : certains robots ignorent les champs `hidden`, aucun ne
          calcule le CSS. `aria-hidden` et `tabindex` l'écartent des lecteurs
          d'écran et du parcours au clavier, pour qu'aucun humain ne tombe
          dessus par accident.
        */}
        <div class="appat" aria-hidden="true">
          <label for="site">Ne remplissez pas ce champ</label>
          <input id="site" name="site" type="text" tabindex="-1" autocomplete="off" />
        </div>

        {/*
          Horodatage posé PAR LE SCRIPT au chargement, jamais à la génération.
          Une valeur figée au build serait vieille de plusieurs jours à la
          première visite, et le serveur rejetterait tout le monde.
        */}
        <input id="depuis" name="depuis" type="hidden" value="" />

        <button type="submit">Envoyer la demande</button>

        <p class="etat" data-etat role="status" aria-live="polite" hidden></p>

        <p class="rgpd">
          Votre nom et votre adresse servent uniquement à vous répondre. Ils ne
          sont ni publiés, ni cédés. Voir la{' '}
          <a href="/confidentialite/">page de confidentialité</a>.
        </p>
      </form>
    </section>
  </div>
</BaseLayout>

<script is:inline>
  (() => {
    const form = document.getElementById('contact');
    if (!form) return;

    const etat = form.querySelector('[data-etat]');
    const bouton = form.querySelector('button[type="submit"]');
    const depuis = form.querySelector('#depuis');

    // L'horodatage se pose maintenant, à l'ouverture de la page.
    depuis.value = String(Math.floor(Date.now() / 1000));

    const afficher = (texte, ok) => {
      etat.textContent = texte;
      etat.dataset.ok = ok ? 'oui' : 'non';
      etat.hidden = false;
    };

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      bouton.disabled = true;
      afficher('Envoi en cours…', true);

      try {
        const reponse = await fetch('/api/contact.php', {
          method: 'POST',
          body: new FormData(form),
        });
        const donnees = await reponse.json();
        afficher(donnees.message, donnees.ok === true);
        if (donnees.ok) form.reset();
      } catch {
        afficher(
          "L'envoi a échoué. Écrivez directement à hello@loremipsum.re.",
          false,
        );
      } finally {
        // Réactivé quoi qu'il arrive : un bouton mort après une panne réseau
        // enferme le visiteur.
        bouton.disabled = false;
      }
    });
  })();
</script>

<style>
  .page {
    padding-block: var(--space-8) var(--space-16);
  }


  section {
    max-width: 68ch;
    margin-bottom: var(--space-12);
  }

  /* Colonnes et alignement des rangées : voir `.chiffres-cles` dans
     tokens.css. Trois chiffres, donc trois colonnes une fois la place venue. */
  .chiffres dl {
    --colonnes: 3;
    gap: var(--space-6);
    margin: 0 0 var(--space-4);
    padding: var(--space-6);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: var(--surface);
  }
  .chiffres dt {
    font-size: var(--step--1);
    color: var(--muted);
  }
  .chiffres dd {
    margin: 0;
    font-size: var(--step-3);
    line-height: 1;
  }

  /*
   * LES TROIS FORMATS, en fiches. Le gabarit a la largeur fixe des maquettes
   * de l'infographie, 88 px.
   *
   * SUR TÉLÉPHONE, LE GABARIT ACCOMPAGNE LE TITRE et le texte prend toute la
   * largeur de la fiche. Placé à gauche de tout le texte, il ne lui laissait
   * que 205 px à 375 px de large : mesurées, les trois fiches y prenaient
   * 758 px de haut. Dès 40rem, il reprend sa colonne, à gauche du titre et
   * du texte.
   */
  .formats {
    display: grid;
    gap: var(--space-3);
    margin: 0 0 var(--space-4);
    padding: 0;
    list-style: none;
  }

  .formats > li {
    display: grid;
    grid-template-columns: 5.5rem minmax(0, 1fr);
    grid-template-areas:
      'gabarit titre'
      'texte texte';
    gap: var(--space-2) var(--space-4);
    align-items: center;
    min-width: 0;
    padding: var(--space-4);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: var(--surface);
  }
  @media (min-width: 40rem) {
    .formats > li {
      grid-template-areas:
        'gabarit titre'
        'gabarit texte';
      align-items: start;
    }
    .gabarit {
      margin-top: 0.3rem;
    }
  }

  .formats h3 {
    grid-area: titre;
    min-width: 0;
    margin: 0;
  }

  .texte-format {
    grid-area: texte;
    min-width: 0;
  }

  .texte-format p {
    margin: 0 0 var(--space-1);
  }

  .texte-format .pages {
    margin: var(--space-2) 0 0;
    font-size: var(--step--1);
    color: var(--muted);
  }

  /* LE GABARIT. L'aplat d'accent marque la place du partenaire, comme dans
     l'infographie qui suit. Le rapport est celui de l'image à fournir. */
  .gabarit {
    grid-area: gabarit;
    display: block;
  }

  .gabarit[data-format='banniere'] {
    aspect-ratio: 4 / 1;
    background: var(--accent-fill);
  }

  .gabarit[data-format='logo'] {
    width: 50%;
    aspect-ratio: 2 / 1;
    background: var(--accent-fill);
  }

  /* La carte : un cadre, le logo à son rapport 2:1, et deux lignes de texte. */
  .gabarit[data-format='carte'] {
    display: flex;
    align-items: center;
    gap: 4px;
    padding: 4px;
    border: 2px solid var(--border);
    background: var(--bg);
  }

  .gabarit-logo {
    flex-shrink: 0;
    width: 40%;
    aspect-ratio: 2 / 1;
    background: var(--accent-fill);
  }

  .gabarit-lignes {
    flex: 1;
    display: grid;
    gap: 4px;
  }

  .gabarit-lignes span {
    height: 0.25rem;
    background: color-mix(in srgb, var(--muted) 40%, var(--bg));
  }

  .gabarit-lignes span + span {
    width: 70%;
  }

  .fin {
    color: var(--muted);
    max-width: 68ch;
  }

  form {
    display: grid;
    gap: var(--space-6);
  }

  .champ {
    display: grid;
    gap: var(--space-2);
    min-width: 0;
  }

  label {
    font-weight: 700;
  }

  .option {
    font-weight: 400;
    color: var(--muted);
  }

  input,
  select,
  textarea {
    min-height: var(--cible-min);
    padding: var(--space-3);
    border: 2px solid var(--border);
    border-radius: var(--radius);
    background: var(--bg);
    color: var(--text);
    font: inherit;
    /* `font: inherit` reprend la taille du parent : le jeton la tient à
       16 px au moins, seuil sous lequel Safari zoome au toucher. */
    font-size: var(--police-champ);
    min-width: 0;
  }
  input:focus-visible,
  select:focus-visible,
  textarea:focus-visible {
    border-color: var(--accent);
  }

  textarea {
    resize: vertical;
    line-height: 1.6;
  }

  .aide {
    margin: 0;
    font-size: var(--step--1);
    color: var(--muted);
  }

  /*
   * L'appât sort du flux sans `display: none`, que certains robots détectent.
   * Il reste hors de l'écran, inatteignable au clavier grâce à tabindex="-1".
   */
  .appat {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  button[type='submit'] {
    justify-self: start;
    min-height: var(--cible-min);
    padding-inline: var(--space-8);
    border: 2px solid var(--accent-fill);
    border-radius: var(--radius);
    background: var(--accent-fill);
    color: var(--on-accent);
    font: inherit;
    font-weight: 700;
    cursor: pointer;
  }
  button[type='submit']:hover {
    background: var(--accent-fill-hover);
    border-color: var(--accent-fill-hover);
  }
  button[type='submit']:disabled {
    opacity: 0.6;
    cursor: progress;
  }

  .etat {
    margin: 0;
    padding: var(--space-3) var(--space-4);
    border: 2px solid var(--border);
    border-radius: var(--radius);
    font-weight: 700;
  }
  .etat[data-etat][data-ok='oui'] {
    border-color: var(--succes);
    color: var(--succes);
  }
  .etat[data-etat][data-ok='non'] {
    border-color: var(--danger);
    color: var(--danger);
  }
  .etat[hidden] {
    display: none;
  }

  .rgpd,
  .repli {
    margin: 0;
    font-size: var(--step--1);
    color: var(--muted);
  }
</style>

---
/**
 * Boîte à suggestions, anonyme par défaut.
 *
 * POURQUOI ANONYME. Demander une identité pour recevoir une idée écarte la
 * moitié de ceux qui en ont une. Le message suffit donc : l'adresse est
 * proposée à qui veut une réponse, et laissée vide elle ne manque à rien.
 *
 * POURQUOI PAS GITHUB SEUL. Les issues du dépôt restent ouvertes et sont citées
 * plus bas, mais elles supposent un compte, donc un nom, donc l'inverse de
 * l'anonymat. Le formulaire reste la porte principale.
 *
 * La mécanique d'envoi est celle de /partenariats/, éprouvée en production :
 * même champ appât, même délai minimal, même compteur par adresse IP. Le détail
 * du raisonnement vit dans public/api/contact.php.
 */
import FormulaireSuggestion from '../components/FormulaireSuggestion.astro';
import InfographieSuggestion from '../components/infographies/InfographieSuggestion.astro';
import Repli from '../components/Repli.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  titre="Proposer une amélioration"
  description="Signaler une donnée fausse, un problème technique ou proposer une idée pour SBD.re. Anonyme, sans compte à créer."
>
  <div class="wrap page">
    <header class="entete-page">
      <h1>Proposer une amélioration</h1>
      <p class="chapeau">
        Une donnée qui cloche, une page qui résiste, une idée qui manque : tout
        se dit ici. Le message suffit, l'adresse électronique reste facultative.
      </p>
    </header>

    <section class="formulaire">
      <noscript>
        <p class="sans-script">
          Ce formulaire demande JavaScript. Écrivez directement à{' '}
          <a href="mailto:hello@loremipsum.re">hello@loremipsum.re</a>.
        </p>
      </noscript>

      <FormulaireSuggestion prefixe="page" origine="page" />

      {/*
        L'INFOGRAPHIE VIENT APRÈS LE FORMULAIRE, REPLIÉE. Le formulaire est la
        raison de la page et reste le premier geste. La figure répond à la
        question de qui hésite à envoyer : ce qui part, ce qui est vérifié, ce
        qui est gardé.

        LE COÛT EST MESURÉ. Dépliée, la figure mesure environ 2 140 px de haut
        à 375 px de large, et 1 490 px à 1 280 px : elle séparerait le bouton
        d'envoi de la section « Autrement » de plusieurs écrans. Repliée, elle
        tient sur la ligne d'une pastille, celle du glossaire et des pages de
        données. Le bouton d'envoi ne bouge pas, « Autrement » descend de 68 px
        aux deux largeurs.

        La classe du message sans JavaScript s'appelait `.repli`, comme la
        pastille de tokens.css. Elle est renommée pour que les deux ne se
        confondent pas sur la même page.
      */}
      <div class="rangee-replis trajet">
        <Repli titre="Le trajet d'une suggestion">
          <InfographieSuggestion />
        </Repli>
      </div>
    </section>

    <section class="autrement">
      <h2>Autrement</h2>
      <p>
        Le code du site est public. Qui a déjà un compte GitHub peut ouvrir une
        demande et suivre son traitement sur{' '}
        <a href="https://github.com/loremipsum-re/sbd-re/issues" rel="noopener">
          le dépôt du projet
        </a>. Les changements déjà livrés se lisent sur la page{' '}
        <a href="/mises-a-jour/">Mises à jour</a>.
      </p>
    </section>
  </div>
</BaseLayout>

<style>
  .page {
    padding-block: var(--space-8) var(--space-16);
  }

  .formulaire {
    max-width: 44rem;
    margin-bottom: var(--space-12);
  }

  .sans-script {
    margin: 0;
    font-size: var(--step--1);
    color: var(--muted);
    max-width: 68ch;
  }

  /* La pastille se détache du formulaire. Ouverte, la figure prend la
     largeur du formulaire. */
  .trajet {
    margin: var(--space-6) 0 0;
  }

  .autrement {
    max-width: 68ch;
  }

  .autrement h2 {
    margin-bottom: var(--space-3);
  }
</style>

---
import Icone from '../../components/Icone.astro';
import Partenaire from '../../components/Partenaire.astro';
import Terme from '../../components/Terme.astro';
import InfographieArticle from '../../components/infographies/InfographieArticle.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import {
  articles,
  articlesLies,
  cheminAthlete,
  competitionDe,
  verifierCompetitions,
} from '../../lib/actualites';
import { dateLongue } from '../../lib/format';
import { chapeauDecoupe } from '../../lib/lexique-markdown';
import { libelleEvent } from '../../lib/meets';
import { render } from 'astro:content';

export async function getStaticPaths() {
  const liste = await articles();
  verifierCompetitions(liste);
  return liste.map((article) => ({ params: { slug: article.id }, props: { article } }));
}

const { article } = Astro.props;
const { Content, remarkPluginFrontmatter } = await render(article);

/*
 * LE CHAPEAU SOULIGNÉ, découpé par le greffon des articles dans le même
 * passage que le corps : un terme du chapeau y est souligné, une seule fois
 * pour tout l'article. La page pose un <Terme> là où le découpage le dit.
 * Voir lib/lexique-markdown.ts.
 *
 * La description reste du texte brut partout ailleurs : balise description,
 * partage, liste des actualités, flux RSS.
 */
const chapeau = chapeauDecoupe(remarkPluginFrontmatter, article.data.description, article.id);

const meet = competitionDe(article);
const lies = await articlesLies(article);
const jour = article.data.date.toISOString().slice(0, 10);
---

<BaseLayout titre={article.data.titre} description={article.data.description}>
  <div class="wrap page">
    <nav class="fil" aria-label="Fil d'Ariane">
      <a href="/actualites/">Actualités</a>
    </nav>

    <article class="article">
      <header>
        <p class="date">
          <time datetime={jour}>{dateLongue(jour)}</time>
          {article.data.brouillon && <span class="brouillon">Brouillon</span>}
        </p>
        <h1>{article.data.titre}</h1>
        <p class="chapeau">{chapeau.map((m) => (typeof m === 'string' ? m : <Terme cle={m.cle}>{m.mot}</Terme>))}</p>
      </header>

      {
        article.data.infographie && (
          <InfographieArticle
            id={article.data.infographie}
            competition={article.data.competition}
          />
        )
      }

      <div class="corps">
        <Content />
      </div>
    </article>

    {
      meet && (
        <aside class="encart">
          <h2>
            <Icone nom="competitions" taille={20} />
            La compétition
          </h2>
          <p class="nom">
            <a href={`/competitions/${meet.chemin}/`}>{meet.meetName}</a>
          </p>
          <p class="details">
            {dateLongue(meet.date)} à {meet.meetTown} · {meet.athletes} athlètes ·{' '}
            {meet.events.map((e) => libelleEvent(e)).join(', ')}
          </p>
          <p class="fin">
            Les résultats complets, barre par barre, sont sur la page de la
            compétition.
          </p>
        </aside>
      )
    }

    {
      article.data.athletes.length > 0 && (
        <section class="cites">
          <h2>Athlètes cités</h2>
          <ul>
            {article.data.athletes.map((nom) => (
              <li>
                <a href={cheminAthlete(nom)}>{nom}</a>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    <Partenaire emplacement="article" />

    {
      lies.length > 0 && (
        <section class="lies">
          <h2>À lire aussi</h2>
          <ul>
            {lies.map((a) => (
              <li>
                <a href={`/actualites/${a.id}/`}>{a.data.titre}</a>
                <span class="quand">{dateLongue(a.data.date.toISOString().slice(0, 10))}</span>
              </li>
            ))}
          </ul>
        </section>
      )
    }
  </div>
</BaseLayout>

<script>
  /*
   * UNE ZONE QUI DÉFILE DOIT ÊTRE ATTEIGNABLE AU CLAVIER. Un tableau d'article
   * plus large que l'écran défile horizontalement. Sans arrêt de tabulation,
   * les colonnes de droite restent hors de portée pour qui navigue au clavier.
   * Les navigateurs récents posent cet arrêt d'eux-mêmes, celui-ci couvre les
   * autres.
   *
   * Le `tabindex` se pose UNIQUEMENT sur un tableau qui déborde vraiment. Un
   * arrêt de tabulation sur un tableau entièrement visible ferait perdre du
   * temps sans rien apporter. D'où la réévaluation au redimensionnement.
   *
   * Aucun `role` posé ici. `role="region"` remplacerait le rôle de tableau et
   * ferait perdre l'annonce des lignes et des colonnes, donc davantage que ce
   * qu'il apporterait. L'étiquette suffit à nommer la zone.
   */
  const tableaux = [...document.querySelectorAll<HTMLTableElement>('.corps table')];

  /*
   * Le texte de l'élément qui précède le tableau, SANS LES BULLES DU LEXIQUE.
   * Un terme souligné porte sa définition dans la page, masquée : lue telle
   * quelle, elle s'insérait dans l'étiquette, collée au mot. Mesuré le
   * 28 octobre 2026 sur un article d'essai, « les points Dots » devenait
   * « les points Score qui ramène un total […] différents.Dots ».
   */
  function texteSansBulles(element: Element | null) {
    if (!element) return '';
    const copie = element.cloneNode(true) as Element;
    for (const bulle of copie.querySelectorAll('.lexique-bulle')) bulle.remove();
    return copie.textContent?.trim() ?? '';
  }

  function marquerLesTableauxLarges() {
    for (const tableau of tableaux) {
      if (tableau.scrollWidth > tableau.clientWidth + 1) {
        const titre = texteSansBulles(tableau.previousElementSibling);
        tableau.tabIndex = 0;
        tableau.setAttribute(
          'aria-label',
          titre ? `${titre}, tableau à faire défiler` : 'Tableau à faire défiler',
        );
      } else {
        tableau.removeAttribute('tabindex');
        tableau.removeAttribute('aria-label');
      }
    }
  }

  if (tableaux.length > 0) {
    marquerLesTableauxLarges();
    addEventListener('resize', marquerLesTableauxLarges, { passive: true });
  }
</script>

<style>
  .page {
    padding-block: var(--space-8) var(--space-16);
  }

  .fil {
    margin-bottom: var(--space-6);
    font-size: var(--step--1);
  }

  .article {
    max-width: 68ch;
  }

  .date {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    margin-bottom: var(--space-2);
    font-size: var(--step--1);
    color: var(--muted);
  }

  .brouillon {
    padding: 1px var(--space-2);
    border: 1px solid var(--alerte);
    border-radius: var(--radius);
    color: var(--alerte);
    font-weight: 700;
  }


  .corps :global(h2) {
    font-size: var(--step-2);
    margin-top: var(--space-8);
  }
  .corps :global(p) {
    max-width: 68ch;
  }
  /*
   * TABLEAUX D'ARTICLE. Un tableau Markdown arrive sans classe et sans
   * conteneur. Les règles de `.liste` ne l'atteignent donc pas, et le style du
   * navigateur donnerait des colonnes collées sans séparateur.
   *
   * Le texte des cellules passe à la ligne, un nom d'athlète devant rester
   * entier. Les valeurs chiffrées tiennent sur une ligne par l'espace
   * insécable écrit dans le Markdown, « 180 kg » et non « 180 » puis « kg ».
   *
   * Le défilement horizontal reste en secours pour un tableau large écrit
   * plus tard depuis l'administration.
   */
  .corps :global(table) {
    display: block;
    width: fit-content;
    max-width: 100%;
    overflow-x: auto;
    margin-block: var(--space-6);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    border-collapse: collapse;
    background: var(--surface);
    font-size: var(--step--1);
  }

  .corps :global(th),
  .corps :global(td) {
    padding: var(--space-3) var(--space-4);
    text-align: left;
    vertical-align: top;
  }

  /*
   * Sous 40 rem, le rembourrage mange la place utile. Resserré, un relevé de
   * huit lignes et quatre colonnes tient dans la largeur d'un téléphone, donc
   * le défilement horizontal ne se déclenche plus.
   */
  @media (max-width: 40rem) {
    .corps :global(th),
    .corps :global(td) {
      padding: var(--space-2);
    }
  }

  .corps :global(thead th) {
    border-bottom: 1px solid var(--border);
    font-weight: 700;
    color: var(--muted);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .corps :global(tbody tr) {
    border-top: 1px solid var(--border);
  }

  .corps :global(tbody tr:first-child) {
    border-top: 0;
  }

  .corps :global(strong) {
    color: var(--text);
    font-weight: 700;
  }

  /*
   * Le lien de fin d'article ferme la lecture par une action. Il en prend donc
   * la forme et la cible de 44 px, là où un lien de prose garde la sienne.
   * Le sélecteur vise le dernier paragraphe s'il ne contient QUE ce lien.
   */
  .corps :global(p:last-child > a:only-child) {
    display: inline-flex;
    align-items: center;
    min-height: var(--cible-min);
    padding-inline: var(--space-6);
    border: 2px solid var(--accent);
    border-radius: var(--radius);
    color: var(--accent);
    font-weight: 700;
    text-decoration: none;
  }
  .corps :global(p:last-child > a:only-child:hover) {
    background: var(--accent-fill);
    border-color: var(--accent-fill);
    color: var(--on-accent);
  }

  /* Le lien RETOUR vers la compétition, qui est tout l'intérêt du champ
     `competition` : il existe aussi dans l'autre sens, sur la page du meet. */
  .encart {
    max-width: 68ch;
    margin-top: var(--space-12);
    padding: var(--space-6);
    border: 2px solid var(--border);
    border-radius: var(--radius-lg);
    background: var(--surface);
  }

  .encart h2,
  .cites h2,
  .lies h2 {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--step-1);
    margin-bottom: var(--space-3);
  }

  .nom {
    font-size: var(--step-1);
    font-weight: 700;
    margin-bottom: var(--space-1);
  }

  .details,
  .fin {
    margin: 0;
    font-size: var(--step--1);
    color: var(--muted);
  }
  .fin {
    margin-top: var(--space-3);
  }

  .cites,
  .lies {
    max-width: 68ch;
    margin-top: var(--space-12);
    padding-top: var(--space-6);
    border-top: 1px solid var(--border);
  }

  .cites ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .cites a {
    display: inline-flex;
    align-items: center;
    min-height: var(--cible-min);
    padding-inline: var(--space-4);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    text-decoration: none;
  }
  .cites a:hover {
    border-color: var(--accent);
  }

  .lies ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-1);
  }
  .lies > ul > li {
    min-width: 0;
  }

  .lies li a {
    display: flex;
    align-items: center;
    min-height: var(--cible-min);
    font-weight: 600;
  }

  .quand {
    display: block;
    font-size: var(--step--1);
    color: var(--muted);
  }
</style>

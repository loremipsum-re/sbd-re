---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SEXE_LABEL, listeCategories } from '../../lib/categoriesPages';
import { kg } from '../../lib/format';
import { recordsPour } from '../../lib/records';
import type { Sex } from '../../lib/types';

const categories = listeCategories();
const totalRecords = recordsPour('total');

/** Record au total en Raw, la marque de référence d'une catégorie. */
const recordDe = (sex: Sex, classeId: string) =>
  totalRecords.find(
    (r) => r.sex === sex && r.weightClass.id === classeId && r.equipment === 'raw',
  );

const parSexe: { sex: Sex; label: string; liste: typeof categories }[] = [
  { sex: 'M', label: SEXE_LABEL.M, liste: categories.filter((c) => c.sex === 'M') },
  { sex: 'F', label: SEXE_LABEL.F, liste: categories.filter((c) => c.sex === 'F') },
];
---

<BaseLayout
  titre="Catégories de poids"
  description="Les catégories de poids de la force athlétique à La Réunion : classement, records et histoire de chaque catégorie, chez les hommes comme chez les femmes."
>
  <div class="wrap">
    <header class="entete-page">
      <h1>Catégories de poids</h1>
      <p class="chapeau">
        Une compétition de force athlétique se dispute catégorie par catégorie.
        Chacune a son classement, ses records et son histoire, que vous trouverez
        sur sa page.
      </p>
    </header>

    {
      parSexe.map(({ label, liste }) => (
        <section class="bloc">
          <h2>{label}</h2>
          <ul class="grille">
            {liste.map((cat) => {
              const rec = recordDe(cat.sex, cat.classe.id);
              return (
                <li>
                  <a class="carte lien-nu" href={`/categories/${cat.chemin}/`}>
                    <span class="poids num">{cat.classe.label}</span>
                    <span class="corps">
                      <span class="effectif">
                        {cat.athletes} athlète{cat.athletes > 1 ? 's' : ''}
                      </span>
                      {rec ? (
                        <span class="record">
                          Record {kg(rec.valueKg)}
                          <span class="detenteur">{rec.holder}</span>
                        </span>
                      ) : (
                        <span class="record">Aucun record en Raw</span>
                      )}
                    </span>
                  </a>
                </li>
              );
            })}
          </ul>
        </section>
      ))
    }

    <p class="note">
      Les records affichés ici sont ceux du total en Raw, la marque de référence
      d'une catégorie. Le détail par mouvement et par équipement figure sur
      chaque page, ainsi que dans les <a href="/records/">records de La Réunion</a>.
    </p>
  </div>
</BaseLayout>

<style>
  .entete-page {
    margin-bottom: var(--space-8);
  }

  .chapeau {
    color: var(--muted);
    font-size: var(--step-1);
    max-width: 62ch;
  }

  .bloc {
    margin-bottom: var(--space-12);
  }

  .grille {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    /*
     * Le `min()` n'est pas décoratif. `minmax(15rem, 1fr)` impose 240 px à
     * chaque colonne, y compris quand l'écran en offre moins : la grille
     * déborde alors au lieu de se replier. `min(15rem, 100%)` laisse la
     * colonne tomber à la largeur disponible sur les très petits écrans.
     */
    grid-template-columns: repeat(auto-fill, minmax(min(15rem, 100%), 1fr));
    gap: var(--space-3);
  }

  /* Un élément de grille vaut `min-width: auto` : sans cette ligne il peut
     dépasser sa colonne pour loger un nom un peu long. */
  .grille > li {
    min-width: 0;
  }

  .carte {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    height: 100%;
    padding: var(--space-4);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: var(--surface);
    color: var(--text);
  }
  .carte:hover {
    border-color: var(--accent);
    color: var(--text);
  }

  .poids {
    font-size: var(--step-2);
    line-height: 1;
    color: var(--accent);
    white-space: nowrap;
  }

  .corps {
    display: grid;
    gap: var(--space-1);
    min-width: 0;
  }

  .effectif {
    font-size: var(--step--1);
    color: var(--muted);
  }

  .record {
    font-size: var(--step--1);
    font-weight: 600;
  }

  /*
   * Le nom du détenteur passe à la ligne au lieu d'être tronqué.
   *
   * « Christan Pounoussamy » et « Jean-Gérald Hoareau » y perdaient leur fin
   * sur téléphone. Tronquer le nom d'un athlète est le pire endroit du site où
   * le faire : c'est précisément l'information que la carte existe pour
   * donner.
   */
  .detenteur {
    display: block;
    font-weight: 400;
    color: var(--muted);
    overflow-wrap: break-word;
  }

  .note {
    font-size: var(--step--1);
    color: var(--muted);
    max-width: 68ch;
  }
</style>

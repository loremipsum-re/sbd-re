---
/**
 * Les catégories de poids, en liste filtrable.
 *
 * C'EST LA PAGE LA PLUS VISITÉE DU SITE, relevé par la mesure d'audience du
 * 14 octobre 2026. Elle était une grille de cartes sans aucun moyen de chercher
 * ni de trier : vingt-six catégories à parcourir à l'œil pour en trouver une.
 *
 * UN SÉLECTEUR DIRECT D'ABORD, LES TABLEAUX ENSUITE. Mesuré le 24 octobre
 * 2026 : avec une barre de recherche et un menu Sexe pour dix-sept liens, la
 * catégorie 63 kg femmes, la plus fournie chez les femmes, tombait 2,7 écrans
 * sous le haut de page sur un téléphone, et demandait deux gestes dans un menu
 * pour remonter. Dix-sept pastilles tiennent sur deux rangées au-dessus du pli
 * et mènent chacune à sa page en un geste.
 *
 * Les tableaux restent en dessous, triables par en-tête : ils portent le
 * contenu que les moteurs indexent, l'effectif et le record de chaque
 * catégorie. La recherche et le filtre sont retirés de cette page : sur un
 * menu de dix-sept entrées que le visiteur connaît déjà, ils coûtaient plus
 * qu'ils ne rapportaient.
 */
import InteractiveTable from '../../components/InteractiveTable.astro';
import Terme from '../../components/Terme.astro';
import InfographieCategories from '../../components/infographies/InfographieCategories.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SEXE_LABEL, listeCategories, plusFournies } from '../../lib/categoriesPages';
import { kg, pluriel } from '../../lib/format';
import { recordsPour } from '../../lib/records';
import type { Sex } from '../../lib/types';
import Partenaire from '../../components/Partenaire.astro';

const categories = listeCategories();
const totalRecords = recordsPour('total');

/** Record au total en Raw, la marque de référence d'une catégorie. */
const recordDe = (sex: Sex, classeId: string) =>
  totalRecords.find(
    (r) => r.sex === sex && r.weightClass.id === classeId && r.equipment === 'raw',
  );

const parSexe: { sex: Sex; label: string; liste: typeof categories }[] = [
  { sex: 'M', label: SEXE_LABEL.M, liste: categories.filter((c) => c.sex === 'M') },
  { sex: 'F', label: SEXE_LABEL.F, liste: categories.filter((c) => c.sex === 'F') },
];

/** Les trois plus fournies de chaque sexe, surlignées dans le sélecteur. La
    légende sous les pastilles écrit « trois » en toutes lettres. */
const FOURNIES_PAR_SEXE = 3;
const fournies = new Set(
  parSexe.flatMap(({ liste }) => [...plusFournies(liste, FOURNIES_PAR_SEXE)]),
);
---

<BaseLayout
  titre="Catégories de poids"
  description="Les catégories de poids de la force athlétique à La Réunion : classement, records et histoire de chaque catégorie, chez les hommes comme chez les femmes."
>
  <div class="wrap">
    <header class="entete-page">
      <h1>Catégories de poids</h1>
      <p class="chapeau">
        Une compétition de force athlétique se dispute{' '}
        <Terme cle="categorie">catégorie</Terme> par catégorie. Chacune a son
        classement, ses <Terme cle="record">records</Terme> et son histoire, que
        vous trouverez sur sa page.
      </p>
    </header>

    {/*
      LE CHOIX EN UN GESTE. Chaque pastille est le lien vers la page de sa
      catégorie. Deux rangées, hommes puis femmes, dans l'ordre des poids :
      c'est l'ordre dans lequel on se cherche. Un `<nav>` nommé, pour qu'un
      lecteur d'écran l'annonce et permette de le sauter.
    */}
    <nav class="choix" aria-label="Choisir une catégorie">
      {
        parSexe.map(({ sex, label, liste }) => (
          <div class="groupe">
            <p class="intitule" id={`choix-${sex}`}>
              {label}
            </p>
            <ul aria-labelledby={`choix-${sex}`}>
              {liste.map((cat) => (
                <li>
                  {/* L'effectif se lit à l'œil, masqué au lecteur d'écran,
                      qui entend la phrase complète : « 61 » seul après
                      « −83 kg » ne dirait pas de quoi il s'agit. */}
                  <a
                    href={`/categories/${cat.chemin}/`}
                    class:list={[{ fournie: fournies.has(cat.chemin) }]}
                  >
                    {cat.classe.label}
                    <span class="effectif num-tab" aria-hidden="true">{cat.athletes}</span>
                    <span class="sr-only">
                      , {cat.athletes} {pluriel(cat.athletes, 'athlète')}
                    </span>
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
      <p class="legende">
        Le chiffre donne le nombre d'athlètes. En jaune, les trois catégories
        les plus fournies de chaque sexe.
      </p>
    </nav>

    {/*
      L'INFOGRAPHIE APRÈS LE SÉLECTEUR, DÉPLIÉE. Le sélecteur reste le premier
      geste de la page. L'image sert qui ne sait pas encore dans quelle
      catégorie il se range, et elle précède les tableaux, qui s'adressent à
      qui le sait.
    */}
    <InfographieCategories lienArticle="categories" />

    {/*
      Ni recherche, ni filtre, ni compteur : le sélecteur au-dessus fait ce
      travail en un geste. Le composant ne sert plus ici qu'au tri par en-tête,
      qui reste utile pour classer les catégories par effectif ou par record.
    */}
    <InteractiveTable singulier="catégorie" pluriel="catégories">

      {
        parSexe.map(({ sex, label, liste }) => (
          <section class="bloc" data-section-tableau>
            <h2>{label}</h2>

            <div class="liste liste-barres">
              <table data-tableau>
                <thead>
                  <tr>
                    <th scope="col" data-tri data-cle="poids" data-type="nombre">
                      Catégorie
                    </th>
                    <th scope="col" class="nombre" data-tri data-cle="athletes" data-type="nombre">
                      Athlètes
                    </th>
                    <th scope="col" class="nombre" data-tri data-cle="record" data-type="nombre">
                      Record au total
                    </th>
                  </tr>
                </thead>
                <tbody>
                  {liste.map((cat) => {
                    const rec = recordDe(cat.sex, cat.classe.id);
                    return (
                      <tr
                        data-recherche={`${cat.classe.label} ${rec?.holder ?? ''}`}
                        data-sexe={sex}
                        data-poids={cat.classe.kg}
                        data-athletes={cat.athletes}
                        data-record={rec?.valueKg ?? ''}
                      >
                        <th scope="row" class="categorie" data-valeur={cat.classe.kg}>
                          <a href={`/categories/${cat.chemin}/`}>{cat.classe.label}</a>
                        </th>

                        {/* Le nombre seul : l'intitulé de la colonne, « Athlètes »,
                            dit déjà de quoi il s'agit. */}
                        <td class="nombre num-tab" data-libelle="Athlètes" data-valeur={cat.athletes}>
                          {cat.athletes}
                        </td>

                        <td class="nombre" data-libelle="Record" data-valeur={rec?.valueKg ?? ''}>
                          {rec ? (
                            <>
                              {/* L'unité DANS la valeur : posée à côté, elle
                                  tombait sur sa propre ligne, la valeur étant
                                  un bloc en mode carte. */}
                              <span class="valeur num">{kg(rec.valueKg)}</span>
                              <span class="detenteur">{rec.holder}</span>
                            </>
                          ) : (
                            <span class="absent">—</span>
                          )}
                        </td>
                      </tr>
                    );
                  })}
                </tbody>
              </table>
            </div>
          </section>
        ))
      }
    </InteractiveTable>

    <p class="note">
      Les records affichés ici sont ceux du <Terme cle="total">total</Terme> en{' '}
      <Terme cle="raw">Raw</Terme>, la marque de référence d'une catégorie. Le
      détail par mouvement et par équipement figure sur chaque page, ainsi que
      dans les <a href="/records/">records de La Réunion</a>.
    </p>

    <Partenaire emplacement="categories" />
  </div>
</BaseLayout>

<style>
  /*
   * LES PASTILLES DU SÉLECTEUR. Même forme que les badges d'une fiche
   * d'athlète et que les boutons de tri, pour qu'on les reconnaisse comme des
   * commandes. La hauteur vaut la cible minimale du site : ce sont les liens
   * les plus tapés de la page la plus visitée.
   */
  .choix {
    display: grid;
    gap: var(--space-6);
    margin-bottom: var(--space-8);
  }

  .groupe {
    display: grid;
    gap: var(--space-2);
  }

  .intitule {
    margin: 0;
    font-size: var(--step--1);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--muted);
  }

  .choix ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .choix a {
    display: inline-flex;
    align-items: center;
    min-height: var(--cible-min);
    padding: 0 var(--space-3);
    border: 1px solid var(--border);
    border-radius: 999px;
    background: var(--surface);
    color: var(--text);
    font-family: var(--font-display);
    font-size: var(--step-0);
    font-weight: 700;
    text-decoration: none;
    white-space: nowrap;
  }

  .choix a:hover {
    border-color: var(--accent);
    color: var(--accent);
  }

  /*
   * L'EFFECTIF DANS LA PASTILLE, plus petit et en second plan : la catégorie
   * reste ce qu'on lit d'abord. Il élargit chaque pastille, d'où le
   * rembourrage ramené de 16 à 12 px. Mesuré le 28 octobre 2026 : à 375 px,
   * six rangées avec ou sans l'effectif, la dernière pastille finissant à
   * 721 px. Seul l'écran de 320 px y perd, neuf rangées au lieu de six.
   */
  .choix a {
    gap: var(--space-2);
  }

  .effectif {
    font-size: var(--step--1);
    color: var(--muted);
  }

  /*
   * LES PLUS FOURNIES EN APLAT. Le jaune plein est celui des boutons
   * principaux : il désigne ici les catégories où la concurrence est la plus
   * dense. Le basalte dessus donne 10,66:1 en clair. Le survol assombrit
   * l'aplat en clair et l'éclaircit en sombre, comme celui d'un bouton.
   */
  .choix a.fournie,
  .choix a.fournie .effectif {
    color: var(--on-accent);
  }

  .choix a.fournie {
    border-color: var(--accent-fill);
    background: var(--accent-fill);
  }

  .choix a.fournie:hover {
    border-color: var(--accent-fill-hover);
    background: var(--accent-fill-hover);
  }

  .legende {
    margin: 0;
    font-size: var(--step--1);
    color: var(--muted);
  }




  /*
   * La catégorie ouvre la rangée, comme sur la grille des records : même rôle,
   * même traitement, pour qu'on la retrouve d'une page à l'autre.
   */
  .categorie {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--step-1);
    white-space: nowrap;
  }

  @media (min-width: 60rem) {
    .liste tbody .categorie {
      background: color-mix(in srgb, var(--text) 5%, transparent);
    }
  }

  @media (max-width: 59.999rem) {
    .liste tbody .categorie {
      grid-column: 1 / -1;
    }

    /* Deux chiffres par carte, l'effectif et le record : trois colonnes
       laisseraient une place vide, et chaque valeur a de quoi respirer. */
    .liste.liste-barres {
      --pas: 3;
    }

    .liste tbody .valeur {
      display: block;
    }
  }

  .valeur {
    font-size: var(--step-1);
    line-height: 1.1;
  }

  /* Le détenteur passe toujours à la ligne, en tableau comme en carte : collé
     à la charge, on lisait « 720 kgAnthony Costarigot ». */
  .detenteur {
    display: block;
    font-size: var(--step--1);
    color: var(--muted);
  }

  .absent {
    color: var(--muted);
  }

</style>

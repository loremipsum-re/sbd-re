---
/**
 * Les catégories de poids, en liste filtrable.
 *
 * C'EST LA PAGE LA PLUS VISITÉE DU SITE, relevé par la mesure d'audience du
 * 14 octobre 2026. Elle était une grille de cartes sans aucun moyen de chercher
 * ni de trier : vingt-six catégories à parcourir à l'œil pour en trouver une.
 *
 * Elle reprend donc la grammaire des listes du site, qui apporte d'un coup la
 * recherche, le filtre par sexe, le tri par poids, par effectif et par record,
 * et l'état écrit dans l'adresse. TOUT RESTE AFFICHÉ PAR DÉFAUT : l'affinage
 * est une aide, pas un péage.
 */
import InteractiveTable from '../../components/InteractiveTable.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SEXE_LABEL, listeCategories } from '../../lib/categoriesPages';
import { kg } from '../../lib/format';
import { recordsPour } from '../../lib/records';
import type { Sex } from '../../lib/types';

const categories = listeCategories();
const totalRecords = recordsPour('total');

/** Record au total en Raw, la marque de référence d'une catégorie. */
const recordDe = (sex: Sex, classeId: string) =>
  totalRecords.find(
    (r) => r.sex === sex && r.weightClass.id === classeId && r.equipment === 'raw',
  );

const parSexe: { sex: Sex; label: string; liste: typeof categories }[] = [
  { sex: 'M', label: SEXE_LABEL.M, liste: categories.filter((c) => c.sex === 'M') },
  { sex: 'F', label: SEXE_LABEL.F, liste: categories.filter((c) => c.sex === 'F') },
];
---

<BaseLayout
  titre="Catégories de poids"
  description="Les catégories de poids de la force athlétique à La Réunion : classement, records et histoire de chaque catégorie, chez les hommes comme chez les femmes."
>
  <div class="wrap">
    <header class="entete-page">
      <h1>Catégories de poids</h1>
      <p class="chapeau">
        Une compétition de force athlétique se dispute catégorie par catégorie.
        Chacune a son classement, ses records et son histoire, que vous trouverez
        sur sa page.
      </p>
    </header>

    <InteractiveTable
      recherche="Catégorie, détenteur du record…"
      singulier="catégorie"
      pluriel="catégories"
      total={categories.length}
    >
      {/*
        PAS DE BARRE « TRIER PAR » ICI. Elle se construit à partir des en-têtes
        d'un tableau, et la page en compte deux, un par sexe : la barre
        affichait donc six boutons pour trois critères. Le tri par clic sur
        l'en-tête reste disponible dès que les colonnes apparaissent, et en
        carte la recherche et le filtre couvrent le besoin.
      */}
      <Fragment slot="filtres">
        <div class="champ">
          <label for="f-sexe">Sexe</label>
          <select id="f-sexe" data-filtre="sexe">
            <option value="">Tous</option>
            <option value="M">Hommes</option>
            <option value="F">Femmes</option>
          </select>
        </div>
      </Fragment>

      {
        parSexe.map(({ sex, label, liste }) => (
          <section class="bloc" data-section-tableau>
            <h2>{label}</h2>

            <div class="liste liste-barres">
              <table data-tableau>
                <thead>
                  <tr>
                    <th scope="col" data-tri data-cle="poids" data-type="nombre">
                      Catégorie
                    </th>
                    <th scope="col" class="nombre" data-tri data-cle="athletes" data-type="nombre">
                      Athlètes
                    </th>
                    <th scope="col" class="nombre" data-tri data-cle="record" data-type="nombre">
                      Record au total
                    </th>
                  </tr>
                </thead>
                <tbody>
                  {liste.map((cat) => {
                    const rec = recordDe(cat.sex, cat.classe.id);
                    return (
                      <tr
                        data-recherche={`${cat.classe.label} ${rec?.holder ?? ''}`}
                        data-sexe={sex}
                        data-poids={cat.classe.kg}
                        data-athletes={cat.athletes}
                        data-record={rec?.valueKg ?? ''}
                      >
                        <th scope="row" class="categorie" data-valeur={cat.classe.kg}>
                          <a href={`/categories/${cat.chemin}/`}>{cat.classe.label}</a>
                        </th>

                        {/* Le nombre seul : l'intitulé de la colonne, « Athlètes »,
                            dit déjà de quoi il s'agit. */}
                        <td class="nombre num-tab" data-libelle="Athlètes" data-valeur={cat.athletes}>
                          {cat.athletes}
                        </td>

                        <td class="nombre" data-libelle="Record" data-valeur={rec?.valueKg ?? ''}>
                          {rec ? (
                            <>
                              {/* L'unité DANS la valeur : posée à côté, elle
                                  tombait sur sa propre ligne, la valeur étant
                                  un bloc en mode carte. */}
                              <span class="valeur num">{kg(rec.valueKg)}</span>
                              <span class="detenteur">{rec.holder}</span>
                            </>
                          ) : (
                            <span class="absent">—</span>
                          )}
                        </td>
                      </tr>
                    );
                  })}
                </tbody>
              </table>
            </div>
          </section>
        ))
      }
    </InteractiveTable>

    <p class="note">
      Les records affichés ici sont ceux du total en Raw, la marque de référence
      d'une catégorie. Le détail par mouvement et par équipement figure sur
      chaque page, ainsi que dans les <a href="/records/">records de La Réunion</a>.
    </p>
  </div>
</BaseLayout>

<style>



  /*
   * La catégorie ouvre la rangée, comme sur la grille des records : même rôle,
   * même traitement, pour qu'on la retrouve d'une page à l'autre.
   */
  .categorie {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--step-1);
    white-space: nowrap;
  }

  @media (min-width: 60rem) {
    .liste tbody .categorie {
      background: color-mix(in srgb, var(--text) 5%, transparent);
    }
  }

  @media (max-width: 59.999rem) {
    .liste tbody .categorie {
      grid-column: 1 / -1;
    }

    /* Deux chiffres par carte, l'effectif et le record : trois colonnes
       laisseraient une place vide, et chaque valeur a de quoi respirer. */
    .liste.liste-barres {
      --pas: 3;
    }

    .liste tbody .valeur {
      display: block;
    }
  }

  .valeur {
    font-size: var(--step-1);
    line-height: 1.1;
  }

  /* Le détenteur passe toujours à la ligne, en tableau comme en carte : collé
     à la charge, on lisait « 720 kgAnthony Costarigot ». */
  .detenteur {
    display: block;
    font-size: var(--step--1);
    color: var(--muted);
  }

  .absent {
    color: var(--muted);
  }

</style>

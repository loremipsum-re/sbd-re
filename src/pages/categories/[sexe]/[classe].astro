---
import Coupe from '../../../components/Coupe.astro';
import InteractiveTable from '../../../components/InteractiveTable.astro';
import Glossaire from '../../../components/Glossaire.astro';
import RankingTable from '../../../components/RankingTable.astro';
import Repli from '../../../components/Repli.astro';
import InfographieCategories from '../../../components/infographies/InfographieCategories.astro';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { EQUIPMENT_GROUPS, LIFTS, type EquipmentGroup } from '../../../lib/categories';
import {
  athletesDeCategorie,
  equipementsDeCategorie,
  listeCategories,
} from '../../../lib/categoriesPages';
import { dateLongue, kg, nombre } from '../../../lib/format';
import { progressionRecord, recordsPour } from '../../../lib/records';
import { meetPath } from '../../../lib/slug';
import type { LiftKey } from '../../../lib/types';
import Partenaire from '../../../components/Partenaire.astro';

export async function getStaticPaths() {
  return listeCategories().map((cat) => ({
    params: { sexe: cat.sexeSlug, classe: cat.classeSlug },
    props: { cat },
  }));
}

const { cat } = Astro.props;
const classement = athletesDeCategorie(cat.sex, cat.classe.id);
const equipements = equipementsDeCategorie(cat.sex, cat.classe.id);

/** Records actuels de la catégorie, par mouvement et par équipement. */
const recordActuel = (lift: LiftKey, equipement: EquipmentGroup) =>
  recordsPour(lift).find(
    (r) =>
      r.sex === cat.sex && r.weightClass.id === cat.classe.id && r.equipment === equipement,
  );

/*
 * Chronologie du record au total, en Raw.
 *
 * On la limite à un seul mouvement et à un seul type d'équipement : afficher
 * les quatre mouvements pour chaque équipement donnerait huit chronologies sur
 * une même page, et l'histoire se perdrait dans le tableau. Le total en Raw est
 * la marque de référence, celle que tout le monde cite.
 */
const chronologie = progressionRecord('total', cat.sex, cat.classe.id, 'raw');

const libelleEquipement = (id: EquipmentGroup) =>
  EQUIPMENT_GROUPS.find((e) => e.id === id)?.label ?? id;

const titre = `${cat.sexeLabel} ${cat.classe.label}`;
const description =
  `Classement et records de la catégorie ${cat.sexeLabel.toLowerCase()} ${cat.classe.label} ` +
  `en force athlétique à La Réunion. ${cat.athletes} athlètes classés, ` +
  `historique des records depuis 2017.`;
---

<BaseLayout titre={titre} description={description}>
  <div class="wrap">
    <p class="fil"><a href="/categories/">Toutes les catégories</a></p>

    <header class="entete-page">
      <h1>{titre}</h1>
      <p class="chapeau">
        {cat.athletes} athlètes classés dans cette catégorie, pour
        {' '}{cat.resultats} performances en full power lors de compétitions
        réunionnaises.
      </p>
    </header>

    <section class="bloc">
      <h2>Records de la catégorie</h2>

      {
        equipements.map((equipement) => (
          <div class="groupe">
            <h3>{libelleEquipement(equipement)}</h3>
            <dl class="records">
              {LIFTS.map((l) => {
                const rec = recordActuel(l.id, equipement);
                return (
                  <div>
                    <dt>{l.label}</dt>
                    <dd>
                      {rec ? (
                        <>
                          <span class="valeur num">
                            {kg(rec.valueKg)}
                            <Coupe metal="or" detail={`Record ${l.label}`} taille={14} />
                          </span>
                          <a class="detenteur" href={`/athlete/${rec.slug}/`}>
                            {rec.holder}
                          </a>
                          <a
                            class="quand"
                            href={`/competitions/${meetPath(rec.date, rec.meetName)}/`}
                          >
                            {dateLongue(rec.date)}
                          </a>
                        </>
                      ) : (
                        <span class="absent">Place libre</span>
                      )}
                    </dd>
                  </div>
                );
              })}
            </dl>
          </div>
        ))
      }
    </section>

    {
      chronologie.length > 1 && (
        <section class="bloc">
          <h2>Histoire du record au total</h2>
          <p class="fin">
            Les {chronologie.length} marques qui se sont succédé en Raw depuis que
            la catégorie est suivie. Seule une amélioration réelle figure ici : à
            performance égale, la marque la plus ancienne conserve le record. La
            durée de règne de chaque marque se lit entre deux dates.
          </p>

          <ol class="chrono">
            {chronologie.map((etape, i) => (
              <li data-actuel={i === chronologie.length - 1 ? '' : undefined}>
                <span class="chrono-valeur num">{kg(etape.valueKg)}</span>
                <span class="chrono-corps">
                  <a class="chrono-nom" href={`/athlete/${etape.slug}/`}>
                    {etape.holder}
                  </a>
                  <span class="chrono-meta">
                    <a href={`/competitions/${meetPath(etape.date, etape.meetName)}/`}>
                      {dateLongue(etape.date)}
                    </a>
                    {etape.gainKg > 0 && (
                      <span class="evolution" data-sens="hausse">
                        <span aria-hidden="true">▲</span>
                        {`${nombre(etape.gainKg)} kg`}
                        <span class="sr-only">de plus que la marque précédente</span>
                      </span>
                    )}
                    {i === chronologie.length - 1 && <span class="encours">record actuel</span>}
                  </span>
                </span>
              </li>
            ))}
          </ol>
        </section>
      )
    }

    <section class="bloc">
      <h2>Classement de la catégorie</h2>

      {/*
        DEUX PASTILLES SUR UNE LIGNE, comme sur /classement/. Le vocabulaire,
        puis la règle des catégories avec CELLE DE LA PAGE mise en avant.
        Repliées, elles tiennent sur la ligne que le glossaire occupait déjà :
        mesuré à 375 comme à 1 280 px, la liste ne bouge pas d'un pixel. Le
        libellé est court pour cette raison, « Catégorie en images » passait à
        la ligne sur téléphone. À 360 px, la seconde pastille passe dessous et
        la liste descend de 52 px, comme sur /classement/ et /simulateur/. Une
        catégorie qui n'est plus disputée y trouve la tranche qu'elle couvrait,
        sous la règle actuelle.
      */}
      <div class="rangee-replis">
        <Glossaire />
        <Repli titre="Poids en images">
          <InfographieCategories
            sexe={cat.sex}
            classe={cat.classe.id}
            lienArticle="categories"
          />
        </Repli>
      </div>

      <InteractiveTable
        recherche="Nom d'un athlète"
        singulier="athlète"
        pluriel="athlètes"
        total={classement.length}
        barreDeTri
      >
        <RankingTable entries={classement} />
      </InteractiveTable>

      <p class="note">
        Voir ces athlètes dans le
        {' '}<a href={`/classement/?sexe=${cat.sex}&categorie=${encodeURIComponent(cat.classe.id)}`}>
          classement général filtré
        </a>.
      </p>
    </section>

    <Partenaire emplacement="categorie" />
  </div>
</BaseLayout>

<style>
  .fil {
    font-size: var(--step--1);
    margin-bottom: var(--space-4);
  }




  .fin {
    color: var(--muted);
    font-size: var(--step--1);
    max-width: 68ch;
    margin-bottom: var(--space-4);
  }

  .groupe {
    margin-bottom: var(--space-6);
  }

  .groupe h3 {
    font-family: var(--font-body);
    font-size: var(--step--1);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--accent);
    margin-bottom: var(--space-3);
  }

  .records {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(11rem, 100%), 1fr));
    gap: var(--space-4);
    margin: 0;
    padding: var(--space-6);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: var(--surface);
  }

  .records dt {
    font-size: var(--step--1);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--muted);
    margin-bottom: var(--space-1);
  }

  .records dd {
    margin: 0;
  }

  .valeur {
    display: block;
    font-size: var(--step-1);
    line-height: 1.1;
  }

  .detenteur,
  .quand {
    display: block;
    font-size: var(--step--1);
    color: var(--muted);
  }
  .detenteur:hover,
  .quand:hover {
    color: var(--accent);
  }

  .absent {
    color: var(--muted);
  }

  /* ---------- Chronologie ---------- */
  .chrono {
    list-style: none;
    margin: 0;
    padding: 0;
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: var(--surface);
    overflow: hidden;
  }

  .chrono li {
    display: flex;
    align-items: baseline;
    gap: var(--space-4);
    padding: var(--space-3) var(--space-6);
    border-bottom: 1px solid var(--border);
  }
  .chrono li:last-child {
    border-bottom: 0;
  }

  /* La marque en cours se distingue : c'est celle qu'on vient chercher. */
  .chrono li[data-actuel] {
    background: color-mix(in srgb, var(--or) 8%, transparent);
  }

  .chrono-valeur {
    min-width: 6rem;
    font-size: var(--step-1);
    color: var(--muted);
  }
  .chrono li[data-actuel] .chrono-valeur {
    color: var(--or);
  }

  .chrono-corps {
    display: grid;
    gap: var(--space-1);
  }

  .chrono-nom {
    font-weight: 600;
    color: var(--text);
  }
  .chrono-nom:hover {
    color: var(--accent);
  }

  .chrono-meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-3);
    font-size: var(--step--1);
    color: var(--muted);
  }

  /* Le marqueur d'écart est commun au site et vit dans tokens.css. Rien à
     régler ici : `.chrono-meta` est déjà une rangée flex, le marqueur y est
     donc un élément parmi les autres et tient sa ligne. */

  /*
   * LE TEXTE DE LA LIGNE EN COURS, LISIBLE SUR SA TEINTE. Le doré à 8 % fonce
   * le fond de la carte, et le thème clair y passait sous le seuil, mesuré le
   * 27 octobre 2026 : 4,10:1 pour « record actuel » en doré, 4,47:1 pour la
   * date en accent. La mention passe au texte courant, 12,4:1, et le lien au
   * survol de l'accent, 8,0:1. Seul le grand chiffre garde le doré, à
   * 4,1:1 : en graisse 800 et à 19 px au moins, il relève du seuil des
   * grands textes, 3:1. En thème sombre : 12,3, 10,5 et 9,0:1. Recalculé le
   * 28 octobre 2026 sur la teinte réelle, posée sur --surface.
   */
  .encours {
    font-weight: 600;
    color: var(--text);
  }

  .chrono li[data-actuel] .chrono-meta a {
    color: var(--accent-hover);
  }

</style>

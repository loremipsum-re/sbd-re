---
/**
 * « Me situer » : où se placerait une performance dans le classement.
 *
 * L'IDÉE. Quelqu'un qui s'entraîne connaît ses barres mais pas ce qu'elles
 * valent sur un plateau réunionnais. Il saisit ses trois mouvements, son
 * équipement et son poids de corps, et la page lui rend sa place, les trois
 * athlètes devant, les trois derrière, et surtout LES KILOS QUI L'EN
 * SÉPARENT. C'est la question que l'on se pose vraiment : combien il me
 * manque pour passer devant.
 *
 * LE FORMULAIRE EST EN DEUX GROUPES, ce qu'on choisit et ce qu'on chiffre.
 * Mélangés sur une même rangée, un menu déroulant et un champ de saisie se
 * ressemblent sans se comporter pareil : les séparer dit d'un coup d'œil
 * quelle main est attendue où.
 *
 * LA CATÉGORIE N'EST PAS DEMANDÉE, elle est DÉDUITE du poids de corps, puis
 * annoncée. C'est une information que le visiteur possède rarement de tête
 * alors qu'elle se calcule sans lui. Il peut ensuite comparer dans une autre
 * catégorie, une fois son résultat sous les yeux.
 *
 * TOUT SE CALCULE DANS LE NAVIGATEUR. Aucune saisie ne part sur le réseau, ni
 * vers le serveur, ni ailleurs : le classement est déposé dans la page, et le
 * script le lit sur place. Le site n'a donc rien à recueillir, rien à
 * conserver, et rien à déclarer.
 *
 * CE N'EST PAS UNE INSCRIPTION AU CLASSEMENT. Le classement officiel ne
 * recense que des performances réalisées en compétition homologuée. Cette
 * page dit « tu SERAIS », jamais « tu ES », et la formulation compte.
 */
import Glossaire from '../components/Glossaire.astro';
import Repli from '../components/Repli.astro';
import Terme from '../components/Terme.astro';
import InfographieDots from '../components/infographies/InfographieDots.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/filtres.css';
import { EQUIPMENT_GROUPS, weightClassesFor } from '../lib/categories';
import { fullPowerResults } from '../lib/data';
import { equipementsPresents } from '../lib/records';
import { meilleurTotalParAthlete } from '../lib/rankings';

const classement = meilleurTotalParAthlete();

/*
 * Le classement déposé dans la page, en clés courtes : 312 athlètes pèsent
 * ainsi une vingtaine de kilo-octets, contre le triple en clés lisibles. Le
 * script est le seul à les lire, et il est juste en dessous.
 */
const donnees = classement.map((a) => ({
  n: a.name,
  s: a.slug,
  t: a.totalKg,
  d: a.dots,
  x: a.sex,
  c: a.weightClassKg,
  e: a.equipmentGroup,
}));

/*
 * CATÉGORIES EN USAGE, déduites des quatre dernières années de compétition et
 * jamais codées en dur. Les classes ont changé au fil des réformes de la
 * fédération : la catégorie 72 kg féminine, encore présente dans les données
 * anciennes, a disparu des plateaux après 2022. Les figer ici ferait déduire
 * une catégorie qui n'existe plus, et il faudrait y repenser à la prochaine
 * réforme. Les lire dans les données récentes suit les réformes tout seul.
 */
const derniereAnnee = Number(
  fullPowerResults.reduce((max, r) => (r.date > max ? r.date : max), '').slice(0, 4),
);
const recents = fullPowerResults.filter((r) => Number(r.date.slice(0, 4)) >= derniereAnnee - 3);

const classesParSexe = {
  M: weightClassesFor(recents, 'M').map((c) => ({ id: c.id, label: c.label, kg: c.kg, o: c.open })),
  F: weightClassesFor(recents, 'F').map((c) => ({ id: c.id, label: c.label, kg: c.kg, o: c.open })),
};

const equipements = equipementsPresents(fullPowerResults);
const libelleEquipement = (id: string) => EQUIPMENT_GROUPS.find((e) => e.id === id)?.label ?? id;
---

<BaseLayout
  titre="Me situer dans le classement"
  description="Saisissez votre poids de corps et vos trois barres. La page calcule votre place au classement de La Réunion, et l'écart avec les athlètes devant vous."
>
  <div class="wrap">
    <header class="entete-page">
      <h1>Me situer</h1>
      <p class="chapeau">
        Saisissez votre <Terme cle="poids-corps">poids de corps</Terme> et vos
        trois <Terme cle="barre">barres</Terme>. La page calcule la place de
        votre <Terme cle="total">total</Terme> au classement de La Réunion, et
        l'écart avec les athlètes juste devant.
      </p>
      <p class="chapeau petit">
        Le calcul se fait dans votre navigateur. Vos valeurs restent sur votre
        appareil. Seules les performances réalisées en compétition
        {' '}<Terme cle="homologue">homologuée</Terme> entrent au classement
        officiel.
      </p>
    </header>

    {/* La pastille nomme ce que l'infographie explique, et non sa forme.
        « Calcul des Dots » tient sur la rangée du glossaire à 375 px, comme
        « Dots en images » : mesuré, 138 px pour 150 disponibles. « Comment
        se calculent les Dots » en demandait 231 et passait dessous. À 320
        px, la seconde pastille passe déjà dessous, quel que soit le libellé. */}
    <div class="rangee-replis">
      <Glossaire />
      <Repli titre="Calcul des Dots">
        <InfographieDots lienArticle="dots" />
      </Repli>
    </div>

    {/*
      LA BARRE COMMUNE DES ZONES DE CHOIX, celle des listes, de la carte et
      de la comparaison : libellés au-dessus, champs de 44 px sur une même
      grille, puis la rangée d'état, le total à gauche et « Réinitialiser » à
      droite. La forme vit dans src/styles/filtres.css. Les deux groupes
      partagent la même grille : leurs bords tombent les uns sous les autres,
      deux colonnes sur un téléphone, où chaque champ en prenait une rangée.

      `data-pret` est écrit d'office : la barre reste visible sans script,
      comme le formulaire l'était.
    */}
    <form class="barre-filtres formulaire" id="formulaire" autocomplete="off" data-pret>
      {/* Ce qu'on CHOISIT dans une liste. */}
      <fieldset class="groupe">
        <legend>Votre profil</legend>
        <div class="grille-champs">
          <div class="champ">
            <label for="sexe">Sexe</label>
            <select id="sexe" name="sexe">
              <option value="M">Hommes</option>
              <option value="F">Femmes</option>
            </select>
          </div>

          <div class="champ">
            <label for="equipement">Équipement</label>
            <select id="equipement" name="equipement">
              {equipements.map((e) => <option value={e}>{libelleEquipement(e)}</option>)}
            </select>
          </div>
        </div>
      </fieldset>

      {/* Ce qu'on CHIFFRE au clavier. L'unité est POSÉE DANS LE CHAMP, et y
          reste une fois la valeur saisie : en invite, elle disparaissait à la
          première frappe, au moment précis où elle devient utile. */}
      <fieldset class="groupe">
        <legend>Vos barres</legend>
        <div class="grille-champs">
          <div class="champ">
            <label for="poids">Poids de corps<span class="sr-only"> en kilogrammes</span></label>
            <div class="saisie">
              <input id="poids" name="poids" type="number" min="30" max="250" step="0.1" inputmode="decimal" />
              <span class="suffixe" aria-hidden="true">kg</span>
            </div>
          </div>

          <div class="champ">
            <label for="squat">Squat<span class="sr-only"> en kilogrammes</span></label>
            <div class="saisie">
              <input id="squat" name="squat" type="number" min="0" max="600" step="0.5" inputmode="decimal" />
              <span class="suffixe" aria-hidden="true">kg</span>
            </div>
          </div>

          <div class="champ">
            <label for="bench">Développé couché<span class="sr-only"> en kilogrammes</span></label>
            <div class="saisie">
              <input id="bench" name="bench" type="number" min="0" max="600" step="0.5" inputmode="decimal" />
              <span class="suffixe" aria-hidden="true">kg</span>
            </div>
          </div>

          <div class="champ">
            <label for="deadlift">Soulevé de terre<span class="sr-only"> en kilogrammes</span></label>
            <div class="saisie">
              <input id="deadlift" name="deadlift" type="number" min="0" max="600" step="0.5" inputmode="decimal" />
              <span class="suffixe" aria-hidden="true">kg</span>
            </div>
          </div>
        </div>
      </fieldset>

      {/* Masquée tant que rien n'est saisi : il n'y a alors rien à
          totaliser, ni rien à effacer. Sans `aria-live`, voir le script. */}
      <div class="rangee-etat" data-etat hidden>
        <p class="compteur" data-total></p>
        <button type="reset" class="bouton-outil bouton-reinitialiser">Réinitialiser</button>
      </div>
    </form>

    {/* `aria-live` : le résultat change sans rechargement, il doit donc
        s'annoncer à qui ne voit pas l'écran. */}
    <section class="resultat" id="resultat" aria-live="polite">
      <p class="invite">Renseignez au moins une barre pour voir votre place.</p>
    </section>

    <p class="note">
      La comparaison porte sur votre <Terme cle="categorie">catégorie</Terme> et
      votre équipement, <Terme cle="raw">raw</Terme> ou{' '}
      <Terme cle="equipped">équipé</Terme>. Chaque athlète y compte pour son
      meilleur total en <Terme cle="full-power">full power</Terme>, réalisé en
      compétition à La Réunion. Les textiles de l'équipé restituent une partie
      de l'effort, d'où deux classements séparés.
    </p>
  </div>

  <script
    type="application/json"
    id="donnees-classement"
    is:inline
    set:html={JSON.stringify({ athletes: donnees, classes: classesParSexe })}
  />
</BaseLayout>

<script>
  import { dots } from '../lib/dots';

  const form = document.getElementById('formulaire') as HTMLFormElement | null;
  const sortie = document.getElementById('resultat');
  const brut = document.getElementById('donnees-classement');

  if (form && sortie && brut) {
    interface Athlete {
      n: string;
      s: string;
      t: number;
      d: number;
      x: 'M' | 'F';
      c: string;
      e: string;
    }
    interface Classe {
      id: string;
      label: string;
      kg: number;
      o: boolean;
    }

    const { athletes, classes } = JSON.parse(brut.textContent ?? '{}') as {
      athletes: Athlete[];
      classes: Record<'M' | 'F', Classe[]>;
    };

    /** Catégorie choisie à la main dans le résultat, sinon celle du poids. */
    let categorieForcee: string | null = null;

    const nombre = (v: number, decimales = 1) =>
      Number(v.toFixed(decimales)).toLocaleString('fr-FR');

    const champ = (id: string) =>
      Number.parseFloat((document.getElementById(id) as HTMLInputElement).value) || 0;

    const select = (id: string) => (document.getElementById(id) as HTMLSelectElement).value;

    /*
     * LA RANGÉE D'ÉTAT, comme celle des listes : le total des trois barres à
     * gauche, « Réinitialiser » à droite, dès qu'une valeur est saisie. Le
     * total se lit ainsi sous les champs, au moment de la saisie, quand le
     * résultat est encore hors de l'écran d'un téléphone. Sans `aria-live` :
     * le résultat s'annonce déjà, une seconde annonce ferait doublon.
     */
    const etat = form.querySelector<HTMLElement>('[data-etat]');
    const totalSaisi = form.querySelector<HTMLElement>('[data-total]');
    const afficherEtat = (total: number, poids: number) => {
      if (etat) etat.hidden = total <= 0 && poids <= 0;
      if (totalSaisi) totalSaisi.textContent = `Total : ${nombre(total)} kg`;
    };

    /*
     * La catégorie d'un poids de corps : la plus légère dont la borne n'est
     * pas dépassée. Au-delà de la dernière borne, c'est la catégorie ouverte,
     * celle qui porte le « + ».
     */
    const categorieDuPoids = (poids: number, sexe: 'M' | 'F'): Classe | null => {
      const liste = classes[sexe];
      if (!liste?.length || poids <= 0) return null;
      return liste.find((c) => !c.o && poids <= c.kg) ?? liste[liste.length - 1];
    };

    const ligne = (a: Athlete, ecart: number) => `
      <li class="candidat">
        <span class="place-nom"><a href="/athlete/${a.s}/">${a.n}</a></span>
        <span class="place-total"><b class="num-tab">${nombre(a.t)}</b> <span class="unite">kg</span></span>
        <span class="place-ecart">${
          ecart > 0
            ? `<span class="manque">+${nombre(ecart)} kg pour passer devant</span>`
            : ecart === 0
              ? '<span class="egalite">à égalité</span>'
              : `<span class="avance">${nombre(-ecart)} kg d\'avance</span>`
        }</span>
      </li>`;

    const calculer = () => {
      const sexe = select('sexe') as 'M' | 'F';
      const equipement = select('equipement');
      const total = champ('squat') + champ('bench') + champ('deadlift');
      const poids = champ('poids');
      afficherEtat(total, poids);

      if (total <= 0) {
        sortie.innerHTML =
          '<p class="invite">Renseignez au moins une barre pour voir votre place.</p>';
        return;
      }

      const deduite = categorieDuPoids(poids, sexe);
      const active = categorieForcee ?? deduite?.id ?? null;
      const libelle = classes[sexe].find((c) => c.id === active)?.label ?? '';

      const pairs = athletes
        .filter((a) => a.x === sexe && a.e === equipement && (active === null || a.c === active))
        .sort((a, b) => b.t - a.t);

      const devant = pairs.filter((a) => a.t > total);
      const derriere = pairs.filter((a) => a.t <= total);
      const rang = devant.length + 1;

      const voisins = [
        ...devant.slice(-3).map((a) => ligne(a, a.t - total)),
        `<li class="candidat moi">
           <span class="place-nom"><b>Votre total</b></span>
           <span class="place-total"><b class="num-tab">${nombre(total)}</b> <span class="unite">kg</span></span>
           <span class="place-ecart"><span class="vous">${rang}<sup>e</sup> sur ${pairs.length + 1}</span></span>
         </li>`,
        ...derriere.slice(0, 3).map((a) => ligne(a, a.t - total)),
      ].join('');

      const general = athletes.filter((a) => a.t > total).length + 1;
      const score = poids > 0 ? dots(total, poids, sexe) : 0;
      const rangDots = score > 0 ? athletes.filter((a) => a.d > score).length + 1 : null;

      /* La catégorie est ANNONCÉE, et le bouton n'ouvre les autres qu'ensuite :
         le visiteur voit d'abord sa situation, puis compare s'il le souhaite. */
      const annonce = deduite
        ? categorieForcee && categorieForcee !== deduite.id
          ? `Comparaison en <b>${libelle}</b>, alors que ${nombre(poids)} kg vous placent en <b>${deduite.label}</b>.`
          : `Avec ${nombre(poids)} kg de poids de corps, vous concourez en <b>${deduite.label}</b>.`
        : 'Renseignez votre poids de corps pour connaître votre catégorie.';

      const choix = classes[sexe]
        .map(
          (c) =>
            `<button type="button" class="categorie${c.id === active ? ' active' : ''}" data-categorie="${c.id}" aria-pressed="${c.id === active}">${c.label}</button>`,
        )
        .join('');

      sortie.innerHTML = `
        <div class="bilan">
          <p class="titre">
            Avec <b>${nombre(total)} kg</b>${score > 0 ? ` et <b>${nombre(score)} Dots</b>` : ''},
            vous seriez <b>${rang}<sup>e</sup></b>${libelle ? ` en ${libelle}` : ''}.
          </p>
          <p class="sous-titre">${annonce}</p>
          <p class="sous-titre">
            ${general}<sup>e</sup> au total sur l'ensemble des ${athletes.length} athlètes classés${
              rangDots ? `, et ${rangDots}<sup>e</sup> aux points Dots` : ''
            }.
          </p>
        </div>

        <details class="autres">
          <summary>Comparer dans une autre catégorie</summary>
          <div class="categories">${choix}</div>
        </details>

        <ol class="voisins">${voisins}</ol>`;
    };

    /* Un seul écouteur sur la sortie, plutôt qu'un par bouton : les boutons
       sont recréés à chaque calcul, et des écouteurs posés sur eux seraient
       perdus à la première frappe. */
    sortie.addEventListener('click', (evenement) => {
      const bouton = (evenement.target as HTMLElement).closest<HTMLElement>('[data-categorie]');
      if (!bouton) return;
      const choisie = bouton.dataset.categorie ?? null;
      const sexe = select('sexe') as 'M' | 'F';
      const deduite = categorieDuPoids(champ('poids'), sexe);
      // Rechoisir sa propre catégorie revient à ne rien forcer du tout.
      categorieForcee = choisie === deduite?.id ? null : choisie;
      calculer();
      sortie.querySelector('details')?.setAttribute('open', '');
      // Le calcul a recréé les boutons : le focus, resté sur l'ancien, serait
      // tombé sur la page. Il revient au bouton choisi, pour qui navigue au
      // clavier. Mesuré avant correction : le focus finissait sur <body>.
      sortie.querySelector<HTMLElement>(`[data-categorie="${choisie}"]`)?.focus();
    });

    form.addEventListener('input', calculer);

    /*
     * Changer de sexe rend une catégorie forcée sans objet, et l'équipement
     * suit la même règle. Les MENUS seulement : un champ de saisie recalcule
     * déjà à chaque frappe, et son « change » n'arrive qu'à la sortie du
     * champ. Mesuré avant correction : un clic sur « Comparer dans une autre
     * catégorie » juste après une saisie recréait le résultat sous le
     * pointeur, et le volet ne s'ouvrait pas. Et retoucher une barre en
     * cours de comparaison ramenait à la catégorie du poids de corps.
     */
    form.addEventListener('change', (evenement) => {
      if (!(evenement.target instanceof HTMLSelectElement)) return;
      categorieForcee = null;
      calculer();
    });

    /*
     * « Réinitialiser » est un bouton `reset` natif : le navigateur rend à
     * chaque champ sa valeur d'origine, mais APRÈS l'événement, d'où le
     * calcul différé. Le bouton disparaît avec la rangée : le focus passe au
     * premier champ, un menu, qui n'ouvre pas le clavier d'un téléphone.
     */
    form.addEventListener('reset', () => {
      setTimeout(() => {
        categorieForcee = null;
        calculer();
        document.getElementById('sexe')?.focus();
      });
    });
  }
</script>

<style>


  .petit {
    font-size: var(--step--1);
  }

  /*
   * Le cadre, les champs, leur grille et la rangée d'état viennent de la
   * barre commune, src/styles/filtres.css. Ne restent ici que l'écart avant
   * le résultat, les deux groupes et l'unité posée dans le champ.
   */
  .formulaire {
    margin-bottom: var(--space-6);
  }

  /*
   * DEUX GROUPES SÉPARÉS PAR UN FILET : ce qu'on choisit, ce qu'on chiffre.
   * Un `fieldset` et non un `div` : la légende nomme le groupe pour les
   * lecteurs d'écran, qui annoncent alors « Vos barres, Squat » plutôt que
   * « Squat » seul au milieu de six champs. Le filet reprend celui de la
   * rangée d'état.
   */
  .groupe {
    min-width: 0;
    margin: 0;
    padding: 0;
    border: 0;
  }

  .groupe + .groupe {
    padding-top: var(--space-3);
    border-top: 1px solid var(--border);
  }

  /*
   * LA LÉGENDE FLOTTE, comme celles des bascules de /records/. Dessinée à
   * part, dans la bordure du groupe, elle échappait au rembourrage du cadre
   * et touchait presque son bord haut : 4 px mesurés à 375 px.
   */
  legend {
    float: left;
    width: 100%;
    padding: 0;
    margin-bottom: var(--space-2);
    font-size: var(--step--1);
    font-weight: 700;
    color: var(--muted);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .groupe > .grille-champs {
    clear: both;
  }

  /*
   * L'UNITÉ RESTE DANS LE CHAMP, une fois la valeur saisie.
   *
   * Elle était une invite, `placeholder` : elle disparaissait donc à la
   * première frappe, c'est-à-dire au moment précis où un nombre nu devient
   * ambigu. Elle est maintenant posée par-dessus le champ, à droite, et le
   * rembourrage lui réserve sa place pour que les chiffres ne passent jamais
   * dessous.
   *
   * `aria-hidden` sur le suffixe, et l'unité dite dans l'intitulé pour les
   * lecteurs d'écran : « Squat, en kilogrammes ». Un texte décoratif répété
   * quatre fois encombrerait l'écoute.
   */
  .saisie {
    position: relative;
    display: grid;
  }

  .saisie input {
    padding-right: 2.75rem;
  }

  .suffixe {
    position: absolute;
    top: 50%;
    right: var(--space-3);
    transform: translateY(-50%);
    font-size: var(--step--1);
    color: var(--muted);
    /* Sans quoi un clic sur l'unité ne donnerait pas le focus au champ. */
    pointer-events: none;
  }

  /*
   * Les flèches natives du champ nombre sont retirées : elles occupaient
   * exactement la place du suffixe, et se chevauchaient avec lui. Le champ
   * reste `type="number"`, donc les flèches du CLAVIER continuent
   * d'incrémenter, et le pavé numérique s'ouvre toujours sur téléphone.
   */
  input[type='number'] {
    appearance: textfield;
  }

  input[type='number']::-webkit-outer-spin-button,
  input[type='number']::-webkit-inner-spin-button {
    appearance: none;
    margin: 0;
  }

  .resultat {
    margin-bottom: var(--space-6);
  }

  /*
   * LE RÉSULTAT EST FABRIQUÉ PAR LE SCRIPT, et c'est ce qui impose `:global()`.
   *
   * Astro marque d'un attribut de portée les éléments écrits dans le gabarit,
   * et ses règles ne visent que ceux-là. Les lignes créées en JavaScript ne
   * portent pas cette marque : sans `:global()`, la liste s'affichait nue,
   * avec la numérotation par défaut du navigateur et aucune couleur.
   *
   * La portée reste tenue par `.resultat`, qui est dans le gabarit : ces
   * règles ne sortent donc pas de ce conteneur.
   */
  .resultat :global(.invite) {
    margin: 0;
    color: var(--muted);
  }

  .resultat :global(.bilan) {
    margin-bottom: var(--space-4);
  }

  .resultat :global(.titre) {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--step-2);
    line-height: 1.2;
  }

  .resultat :global(.sous-titre) {
    margin: var(--space-1) 0 0;
    color: var(--muted);
  }

  .resultat :global(.voisins) {
    list-style: none;
    margin: 0;
    padding: 0;
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: var(--surface);
    overflow: hidden;
  }

  /* Trois colonnes alignées d'une ligne à l'autre, comme le classement : le
     nom, le total, puis l'écart qui est la réponse à la question posée. */
  .resultat :global(.candidat) {
    display: grid;
    grid-template-columns: minmax(min(8rem, 100%), 1fr) auto;

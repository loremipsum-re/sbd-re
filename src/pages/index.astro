---
import InteractiveTable from '../components/InteractiveTable.astro';
import RankingTable from '../components/RankingTable.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import nextMeet from '../data/next-meet.json';
import { nombreAthletes, periode, results } from '../lib/data';
import { annee, dateLongue } from '../lib/format';
import { listeMeets } from '../lib/meets';
import { topDots } from '../lib/rankings';

const top = topDots(10);
const meets = listeMeets();
const { debut, fin } = periode();

/**
 * L'annonce disparaît d'elle-même une fois la date passée.
 *
 * « Aujourd'hui » est ici la date de BUILD, et non celle de la visite : sur un
 * site statique, la page est calculée une fois pour toutes. Le site étant
 * reconstruit chaque mois, une compétition passée peut donc rester affichée
 * quelques semaines. C'est le compromis assumé du statique, et la raison pour
 * laquelle on annonce une date plutôt qu'un « demain ».
 */
const aujourdhui = new Date().toISOString().slice(0, 10);
const annonce = nextMeet.annonce && nextMeet.date >= aujourdhui ? nextMeet : null;

const stats = [
  { valeur: nombreAthletes().toString(), libelle: 'athlètes' },
  { valeur: meets.length.toString(), libelle: 'compétitions' },
  { valeur: results.length.toLocaleString('fr-FR'), libelle: 'résultats' },
  { valeur: `${annee(debut)}–${annee(fin)}`, libelle: 'de données' },
];
---

<BaseLayout
  titre="Classement des powerlifters à La Réunion"
  titreOnglet="SBD.re - Classement des Powerlifters à La Réunion"
  description="Classements et records de force athlétique à La Réunion. Le classement officiel réunit les résultats homologués de compétition, destiné aux athlètes confirmés et aux clubs. Le classement communauté accueille les performances déclarées en salle, ouvert à tous les pratiquants."
>
  <section class="hero wrap">
    <p class="surtitre">Force athlétique à La Réunion</p>
    <h1>
      Les records de l'île,<br />
      <span class="accent">sur la barre.</span>
    </h1>
    <p class="chapeau">
      Chaque chiffre publié ici provient d'une compétition officielle, validé
      par trois juges sur le plateau et enregistré par la fédération.
    </p>

    <div class="actions">
      <a class="bouton primaire lien-nu" href="/classement/">Voir le classement</a>
      <a class="bouton lien-nu" href="/records/">Les records de La Réunion</a>
    </div>

    <dl class="stats">
      {
        stats.map((s) => (
          <div>
            <dt class="num">{s.valeur}</dt>
            <dd>{s.libelle}</dd>
          </div>
        ))
      }
    </dl>
  </section>

  {
    annonce && (
      <section class="wrap">
        <div class="annonce">
          <p class="etiquette">Prochaine compétition</p>
          <h2>{annonce.nom}</h2>
          <p class="detail">
            {dateLongue(annonce.date)}
            {annonce.ville && <> à {annonce.ville}</>}
            {annonce.lieu && <>, {annonce.lieu}</>}
          </p>
          {annonce.url && (
            <a href={annonce.url} rel="noopener">
              Informations et engagement
            </a>
          )}
        </div>
      </section>
    )
  }

  <section class="wrap bloc">
    <header class="titre-bloc">
      <div>
        <h2>Top 10 toutes catégories</h2>
        <p class="fin">
          Classé aux points Dots, qui rapportent le total soulevé au poids de
          corps. C'est ce calcul qui permet de placer un athlète de 59 kg et un
          athlète de 120 kg sur la même échelle. Full power uniquement.
        </p>
      </div>
      <a class="lien-plus lien-nu" href="/classement/">Classement complet →</a>
    </header>

    <InteractiveTable>
      <RankingTable entries={top} miseEnAvant="dots" />
    </InteractiveTable>
  </section>

  <section class="wrap bloc">
    <div class="communaute">
      <div>
        <h2>Et hors compétition ?</h2>
        <p class="fin">
          Le classement communauté accueille les performances réalisées en
          salle et les compétitions locales non homologuées. Il vit dans son
          propre espace, ce qui laisse au classement officiel toute sa valeur
          de référence.
        </p>
      </div>
      <a class="bouton lien-nu" href="/communaute/">Découvrir le classement communauté</a>
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    padding-block: var(--space-8) var(--space-12);
  }

  .surtitre {
    font-size: var(--step--1);
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: var(--space-3);
  }

  h1 {
    max-width: 16ch;
  }

  .accent {
    color: var(--accent);
  }

  .chapeau {
    max-width: 58ch;
    color: var(--muted);
    font-size: var(--step-1);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-bottom: var(--space-12);
  }

  .bouton {
    display: inline-block;
    padding: var(--space-3) var(--space-6);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
    color: var(--text);
    font-weight: 600;
  }
  .bouton:hover {
    border-color: var(--accent);
    color: var(--accent);
  }

  .bouton.primaire {
    background: var(--accent);
    border-color: var(--accent);
    color: var(--on-accent);
  }
  .bouton.primaire:hover {
    background: var(--accent-hover);
    border-color: var(--accent-hover);
    color: var(--on-accent);
  }

  .stats {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-6);
    margin: 0;
    padding-top: var(--space-8);
    border-top: 1px solid var(--border);
  }

  @media (min-width: 48rem) {
    .stats {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .stats dt {
    font-size: var(--step-3);
    line-height: 1;
    color: var(--text);
  }

  .stats dd {
    margin: var(--space-1) 0 0;
    color: var(--muted);
    font-size: var(--step--1);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .bloc {
    padding-block: var(--space-8);
  }

  .titre-bloc {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    justify-content: space-between;
    gap: var(--space-4);
    margin-bottom: var(--space-6);
  }

  .titre-bloc h2 {
    margin-bottom: var(--space-2);
  }

  .fin {
    color: var(--muted);
    max-width: 62ch;
    margin: 0;
    font-size: var(--step--1);
  }

  .lien-plus {
    font-weight: 600;
    white-space: nowrap;
    color: var(--accent);
  }
  .lien-plus:hover {
    text-decoration: underline;
  }

  .annonce {
    border: 1px solid var(--accent);
    border-radius: var(--radius-lg);
    background: color-mix(in srgb, var(--accent) 8%, transparent);
    padding: var(--space-6);
  }

  .annonce h2 {
    margin-bottom: var(--space-2);
  }

  .etiquette {
    font-size: var(--step--1);
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: var(--space-2);
  }

  .detail {
    color: var(--muted);
    margin-bottom: var(--space-2);
  }

  .communaute {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-6);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: var(--surface);
    padding: var(--space-8);
  }

  .communaute h2 {
    margin-bottom: var(--space-2);
  }
</style>

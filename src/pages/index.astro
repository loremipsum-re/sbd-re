---
import RankingTable from '../components/RankingTable.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import nextMeet from '../data/next-meet.json';
import { nombreAthletes, periode, results } from '../lib/data';
import { annee, dateLongue, dateCourte } from '../lib/format';
import { libelleEvent, listeMeets, meetsRecents } from '../lib/meets';
import { topDots } from '../lib/rankings';

const top = topDots(10);
const meets = listeMeets();
const recentes = meetsRecents(5);
const { debut, fin } = periode();

/**
 * L'annonce disparaît d'elle-même une fois la date passée.
 *
 * « Aujourd'hui » est ici la date de BUILD, et non celle de la visite : sur un
 * site statique, la page est calculée une fois pour toutes. Le site étant
 * reconstruit chaque mois, une compétition passée peut donc rester affichée
 * quelques semaines. C'est le compromis assumé du statique, et la raison pour
 * laquelle on annonce une date plutôt qu'un « demain ».
 */
const aujourdhui = new Date().toISOString().slice(0, 10);
const annonce = nextMeet.annonce && nextMeet.date >= aujourdhui ? nextMeet : null;

const stats = [
  { valeur: nombreAthletes().toString(), libelle: 'athlètes' },
  { valeur: meets.length.toString(), libelle: 'compétitions' },
  { valeur: results.length.toLocaleString('fr-FR'), libelle: 'résultats' },
  { valeur: `${annee(debut)}–${annee(fin)}`, libelle: 'de données' },
];
---

<BaseLayout
  titre="Classement des powerlifters à La Réunion"
  titreOnglet="SBD.re - Classement des Powerlifters à La Réunion"
  description="Site qui référence tous les athlètes officiels de force athlétique à La Réunion : records de squat, bench et deadlift, classements et résultats de compétition. Bientôt, le top des performances réunionnaises hors compétition."
>
  <section class="hero wrap">
    <h1>
      Les records de <span class="accent">Squat, Bench et Deadlift</span> à La
      Réunion
    </h1>
    <p class="chapeau">
      Site qui référence tous les athlètes officiels de force athlétique à La
      Réunion, et bientôt le top des performances réunionnaises hors
      compétition.
    </p>

    <div class="actions">
      <a class="bouton primaire lien-nu" href="/classement/">Voir le classement</a>
      <a class="bouton lien-nu" href="/records/">Les records de La Réunion</a>
    </div>

    <dl class="stats">
      {
        stats.map((s) => (
          <div>
            <dt class="num">{s.valeur}</dt>
            <dd>{s.libelle}</dd>
          </div>
        ))
      }
    </dl>
  </section>

  {
    annonce && (
      <section class="wrap">
        <div class="annonce">
          <p class="etiquette">Prochaine compétition</p>
          <h2>{annonce.nom}</h2>
          <p class="detail">
            {dateLongue(annonce.date)}
            {annonce.ville && <> à {annonce.ville}</>}
            {annonce.lieu && <>, {annonce.lieu}</>}
          </p>
          {annonce.url && (
            <a href={annonce.url} rel="noopener">
              Informations et engagement
            </a>
          )}
        </div>
      </section>
    )
  }

  <section class="wrap bloc">
    <header class="titre-bloc">
      <div>
        <h2>Top 10 toutes catégories</h2>
        <p class="fin">
          Classement aux points Dots : le total ramené au poids de corps. Full
          power uniquement.
        </p>
      </div>
      <a class="lien-plus lien-nu" href="/classement/">Classement complet →</a>
    </header>

    <RankingTable entries={top} />
  </section>

  <section class="wrap bloc">
    <header class="titre-bloc">
      <div>
        <h2>Compétitions récentes</h2>
        <p class="fin">Les dernières compétitions disputées à La Réunion.</p>
      </div>
      <a class="lien-plus lien-nu" href="/competitions/">Toutes les compétitions →</a>
    </header>

    <ul class="recentes">
      {
        recentes.map((m) => (
          <li>
            <a class="carte lien-nu" href={`/competitions/${m.chemin}/`}>
              <span class="carte-date">
                <span class="jour">{dateCourte(m.date).slice(0, 5)}</span>
                <span class="an">{annee(m.date)}</span>
              </span>
              <span class="carte-corps">
                <span class="carte-nom">{m.meetName}</span>
                <span class="carte-meta">
                  {m.meetTown}
                  {m.events.map((e) => (
                    <span class="carte-format">{libelleEvent(e)}</span>
                  ))}
                </span>
              </span>
              <span class="carte-effectif">
                <span class="num">{m.athletes}</span>
                <span class="carte-libelle">athlètes</span>
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="wrap bloc">
    <div class="communaute">
      <div>
        <h2>Performances hors compétition</h2>
        <p class="fin">
          Le top des performances réunionnaises réalisées en salle et en
          compétition non homologuée. Bientôt disponible.
        </p>
      </div>
      <a class="bouton lien-nu" href="/communaute/">Voir le classement communauté</a>
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    padding-block: var(--space-8) var(--space-12);
  }

  /*
   * Le surtitre « Force athlétique à La Réunion » a été retiré : le titre le
   * disait déjà mot pour mot, et le répéter juste au-dessus ne servait rien.
   */

  /* 24ch, contre 16 du temps où le titre tenait en trois mots et forçait sa
     coupure avec un <br>. Il se coupe désormais tout seul, où il faut. */
  h1 {
    max-width: 24ch;
  }

  .accent {
    color: var(--accent);
  }

  .chapeau {
    max-width: 58ch;
    color: var(--muted);
    font-size: var(--step-1);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-bottom: var(--space-12);
  }

  .bouton {
    display: inline-block;
    padding: var(--space-3) var(--space-6);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
    color: var(--text);
    font-weight: 600;
  }
  .bouton:hover {
    border-color: var(--accent);
    color: var(--accent);
  }

  /* L'APLAT, pas l'accent de texte. Voir la note de .evitement dans
     BaseLayout : --accent en fond sous --on-accent donne 2,78:1 en clair. */
  .bouton.primaire {
    background: var(--accent-fill);
    border-color: var(--accent-fill);
    color: var(--on-accent);
  }
  .bouton.primaire:hover {
    background: var(--accent-fill-hover);
    border-color: var(--accent-fill-hover);
    color: var(--on-accent);
  }

  .stats {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-6);
    margin: 0;
    padding-top: var(--space-8);
    border-top: 1px solid var(--border);
  }

  @media (min-width: 48rem) {
    .stats {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .stats dt {
    font-size: var(--step-3);
    line-height: 1;
    color: var(--text);
  }

  .stats dd {
    margin: var(--space-1) 0 0;
    color: var(--muted);
    font-size: var(--step--1);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .bloc {
    padding-block: var(--space-8);
  }

  .titre-bloc {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    justify-content: space-between;
    gap: var(--space-4);
    margin-bottom: var(--space-6);
  }

  .titre-bloc h2 {
    margin-bottom: var(--space-2);
  }

  .fin {
    color: var(--muted);
    max-width: 62ch;
    margin: 0;
    font-size: var(--step--1);
  }

  .lien-plus {
    font-weight: 600;
    white-space: nowrap;
    color: var(--accent);
  }
  .lien-plus:hover {
    text-decoration: underline;
  }

  .annonce {
    border: 1px solid var(--accent);
    border-radius: var(--radius-lg);
    background: color-mix(in srgb, var(--accent) 8%, transparent);
    padding: var(--space-6);
  }

  .annonce h2 {
    margin-bottom: var(--space-2);
  }

  .etiquette {
    font-size: var(--step--1);
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: var(--space-2);
  }

  .detail {
    color: var(--muted);
    margin-bottom: var(--space-2);
  }

  .recentes {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-2);
  }

  /*
   * Garde-fou structurel : un élément de grille vaut `min-width: auto` par
   * défaut, ce qui l'autorise à dépasser sa colonne pour loger son contenu.
   * C'est exactement ce qui faisait sortir l'effectif de l'écran. Le passer à
   * zéro rend la colonne souveraine, quoi qu'on mette dedans plus tard.
   */
  .recentes > li {
    min-width: 0;
  }

  .carte {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    padding: var(--space-3) var(--space-4);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: var(--surface);
    color: var(--text);
  }
  .carte:hover {
    border-color: var(--accent);
    color: var(--text);
  }

  .carte-date {
    display: grid;
    justify-items: center;
    min-width: 3.5rem;
    padding-right: var(--space-4);
    border-right: 1px solid var(--border);
  }

  .jour {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--step-0);
    color: var(--accent);
    font-variant-numeric: tabular-nums;
  }

  .an {
    font-size: var(--step--1);
    color: var(--muted);
  }

  .carte-corps {
    flex: 1;
    min-width: 0;
  }

  /*
   * Le nom PASSE À LA LIGNE, il n'est pas tronqué.
   *
   * Il portait `white-space: nowrap` avec des points de suspension. Sur
   * téléphone, « Championnat de La Réunion DC/BP » y perdait sa fin, et
   * surtout : en `nowrap`, sa largeur minimale devenait celle du texte entier.
   * Le `li` qui la contient est un élément de grille, donc en `min-width:
   * auto`, et refusait de descendre sous cette largeur. La carte mesurait
   * alors 433 px dans une colonne de 343, et l'effectif d'athlètes sortait de
   * l'écran sans que rien ne signale sa présence.
   *
   * Deux lignes de titre coûtent moins cher qu'une information invisible.
   */
  .carte-nom {
    display: block;
    font-weight: 600;
    /* Un nom d'un seul tenant plus large que la carte se coupe plutôt que de
       la faire déborder. Le cas ne se présente pas aujourd'hui ; il suffirait
       d'une compétition au nom mal saisi. */
    overflow-wrap: break-word;
  }

  .carte-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--step--1);
    color: var(--muted);
  }

  .carte-format {
    padding: 1px var(--space-2);
    border: 1px solid var(--border);
    border-radius: var(--radius);
  }

  .carte-effectif {
    display: grid;
    justify-items: end;
    text-align: right;
    white-space: nowrap;
  }

  .carte-libelle {
    font-size: var(--step--1);
    color: var(--muted);
  }

  .communaute {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-6);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: var(--surface);
    padding: var(--space-8);
  }

  .communaute h2 {
    margin-bottom: var(--space-2);
  }
</style>

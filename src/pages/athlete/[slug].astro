    margin-bottom: var(--space-12);
  }

  .barres dd {
    font-size: var(--step-3);
  }

  /* L'icône accompagne l'intitulé sans le pousser : `flex` plutôt qu'un SVG
     en ligne, dont la ligne de base ne tombe jamais où on l'attend. Le total
     n'en a pas, le composant ne rendant rien pour lui, et son intitulé
     s'aligne donc à gauche comme les autres. */
  .barres dt {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  /* Le total ferme la série, précédé d'un filet : il est la somme des trois

---
import BadgeOfficiel from '../../components/BadgeOfficiel.astro';
import Coupe from '../../components/Coupe.astro';
import IconeMouvement from '../../components/IconeMouvement.astro';
import SpriteMouvements from '../../components/SpriteMouvements.astro';
import InteractiveTable from '../../components/InteractiveTable.astro';
import ProgressChart from '../../components/ProgressChart.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { equipmentGroup, equipmentLabel, sexLabel } from '../../lib/categories';
import { results } from '../../lib/data';
import { exterieurDe, paysFr } from '../../lib/exterieur';
import { dateLongue, kg, nombre, place, points } from '../../lib/format';
import { liensAthlete } from '../../lib/liens';
import { presentationDe, surcoucheDe } from '../../lib/surcouche-athlete';
import { libelleEvent } from '../../lib/meets';
import { rangsDots } from '../../lib/rankings';
import { cleRecord, clesRecords } from '../../lib/records';
import { athleteSlug, meetPath, openpowerliftingUrl } from '../../lib/slug';
import type { LiftKey, Metal, Result } from '../../lib/types';

export async function getStaticPaths() {
  const parSlug = new Map<string, { name: string; lignes: Result[] }>();

  for (const r of results) {
    const slug = athleteSlug(r.name);
    const entree = parSlug.get(slug);
    if (entree) {
      /*
       * Deux noms différents qui produiraient le même slug fusionneraient deux
       * athlètes en une seule page, et pourraient attribuer un record à la
       * mauvaise personne. On préfère faire échouer le build bruyamment plutôt
       * que de publier une donnée fausse en silence.
       */
      if (entree.name !== r.name) {
        throw new Error(
          `Collision de slug « ${slug} » entre « ${entree.name} » et « ${r.name} ». ` +
            `Adapter athleteSlug() dans src/lib/slug.ts.`,
        );
      }
      entree.lignes.push(r);
    } else {
      parSlug.set(slug, { name: r.name, lignes: [r] });
    }
  }

  return [...parSlug.entries()].map(([slug, { name, lignes }]) => ({
    params: { slug },
    props: { name, lignes, slug },
  }));
}

const { name, lignes, slug } = Astro.props;
const records = clesRecords();
const liens = liensAthlete(slug);
// Ce que le CMS ajoute par-dessus les données : photo, présentation, liens.
// Absent pour la plupart des athlètes, et c'est le cas normal.
const surcouche = await surcoucheDe(name);
const Presentation = surcouche ? await presentationDe(surcouche) : null;

const historique = [...lignes].sort((a, b) => a.date.localeCompare(b.date));
const fullPower = historique.filter((r) => r.event === 'SBD' && (r.totalKg ?? 0) > 0);

const meilleurTotal = fullPower.reduce<Result | null>(
  (a, b) => (a === null || (b.totalKg ?? 0) > (a.totalKg ?? 0) ? b : a),
  null,
);
const meilleurDots = fullPower.reduce<Result | null>(
  (a, b) => (a === null || (b.dots ?? 0) > (a.dots ?? 0) ? b : a),
  null,
);

/*
 * ÉCART D'UNE COMPÉTITION À LA SUIVANTE, en points Dots.
 *
 * POURQUOI LES DOTS ET NON LE TOTAL. Un total se compare mal d'une
 * compétition à l'autre dès que le poids de corps bouge : en descendant de
 * catégorie, un athlète soulève moins et progresse quand même. C'est déjà
 * l'invariant qui sépare le meilleur total du meilleur Dots plus haut sur
 * cette page. Le Dots, lui, ramène toutes les barres à une même échelle, et
 * c'est bien un écart de PERFORMANCE que la flèche doit dire.
 *
 * SEUL LE FULL POWER ENTRE DANS LA SUITE. Sur une compétition d'un seul
 * mouvement, OpenPowerlifting renseigne quand même un total et donc un Dots,
 * mais ils valent la seule barre disputée : l'écart serait un artefact.
 * `fullPower` écarte déjà ces lignes, et la comparaison saute donc par-dessus.
 *
 * La carte est indexée par l'objet résultat lui-même, et non par une clé
 * reconstruite : deux compétitions peuvent partager une date et un nom.
 */
const ecartDots = new Map<Result, number>();
let dotsPrecedent: number | null = null;
for (const r of fullPower) {
  if (r.dots === null || r.dots === undefined) continue;
  if (dotsPrecedent !== null) {
    const ecart = Number((r.dots - dotsPrecedent).toFixed(1));
    // Un écart nul ne dit rien qu'une flèche puisse porter.
    if (ecart !== 0) ecartDots.set(r, ecart);
  }
  dotsPrecedent = r.dots;
}

const meilleures = {
  squat: Math.max(0, ...historique.map((r) => r.bestSquatKg ?? 0)),
  bench: Math.max(0, ...historique.map((r) => r.bestBenchKg ?? 0)),
  deadlift: Math.max(0, ...historique.map((r) => r.bestDeadliftKg ?? 0)),
};

const dernier = historique[historique.length - 1];
const meets = new Set(historique.map((r) => `${r.date}|${r.meetName}`)).size;

/** Une barre est-elle le record en cours de sa catégorie ? */
const estRecord = (r: Result, lift: LiftKey) =>
  records.has(cleRecord(lift, r.name, r.date, r.meetName));

/** Nombre de records détenus, toutes catégories de mouvement confondues. */
const nbRecords = (['squat', 'bench', 'deadlift', 'total'] as LiftKey[]).reduce(
  (total, lift) => total + historique.filter((r) => estRecord(r, lift)).length,
  0,
);

/**
 * Position au classement général aux points Dots.
 *
 * Le centile situe l'athlète bien mieux qu'un rang brut : « 18e sur 266 » parle
 * moins que « parmi les 7 % meilleurs ». Les deux sont affichés.
 */
const rangs = rangsDots(name);

/**
 * Compétitions disputées hors de l'île.
 *
 * Volontairement présentées à part, et après l'historique réunionnais : elles
 * n'entrent ni dans le classement ni dans les records, qui récompensent des
 * barres soulevées sur un plateau réunionnais. Elles font pourtant partie du
 * parcours de l'athlète, et les passer sous silence l'amputerait.
 */
const exterieur = exterieurDe(name);
const paysVisites = [...new Set(exterieur.map((r) => r.meetCountry).filter(Boolean))];

/*
 * Phrase construite ici plutôt que cousue dans le gabarit : intercaler des
 * conditions au milieu d'un texte produit des espaces parasites avant les
 * virgules et les points.
 */
const phraseExterieur =
  `${exterieur.length} compétition${exterieur.length > 1 ? 's' : ''} ` +
  `disputée${exterieur.length > 1 ? 's' : ''} ailleurs` +
  (paysVisites.length > 0 ? `, en ${paysVisites.map(paysFr).join(', ')}` : '') +
  '.';

/** « 1er » puis « 2e », « 3e »… La première place fait exception en français. */
const ordinal = (n: number) => (n === 1 ? '1er' : `${n}e`);

const metalDe = (n: number): Metal | undefined =>
  n === 1 ? 'or' : n === 2 ? 'argent' : n === 3 ? 'bronze' : undefined;

/**
 * Mise en avant déclenchée par le podium, ou à défaut par les dix pour cent de
 * tête. On retient le meilleur des deux rangs : un athlète 2e chez les femmes
 * mérite sa distinction même s'il est 40e au général.
 */
const seuil = (total: number) => Math.max(3, Math.ceil(total * 0.1));
const estDistingue =
  rangs !== null &&
  (rangs.global.rang <= seuil(rangs.global.total) || rangs.sexe.rang <= seuil(rangs.sexe.total));
const metalDuRang = rangs
  ? (metalDe(rangs.sexe.rang) ?? metalDe(rangs.global.rang))
  : undefined;

const libelleSexe = dernier?.sex === 'F' ? 'chez les femmes' : 'chez les hommes';

/**
 * Points de la courbe : les totaux full power, sur l'île et ailleurs.
 *
 * Les compétitions d'un seul mouvement en sont exclues : leur « total » n'est
 * que la barre disputée, et l'inclure ferait plonger la courbe sans qu'aucune
 * contre-performance n'ait eu lieu.
 */
const pointsGraphe = [
  ...fullPower.map((r) => ({
    date: r.date,
    value: r.totalKg as number,
    meetName: r.meetName,
    weightClassKg: r.weightClassKg,
    bodyweightKg: r.bodyweightKg,
    division: r.division,
    place: r.place,
    exterieur: false,
  })),
  ...exterieur
    .filter((r) => r.event === 'SBD' && (r.totalKg ?? 0) > 0)
    .map((r) => ({
      date: r.date,
      value: r.totalKg as number,
      meetName: r.meetName,
      weightClassKg: r.weightClassKg,
      bodyweightKg: r.bodyweightKg,
      division: r.division,
      place: r.place,
      exterieur: true,
    })),
];

const description =
  `${name}, powerlifter à La Réunion. ` +
  (meilleurTotal
    ? `Meilleur total ${kg(meilleurTotal.totalKg)} en catégorie ${meilleurTotal.weightClassKg} kg. `
    : '') +
  `${meets} compétition${meets > 1 ? 's' : ''} disputée${meets > 1 ? 's' : ''}.`;
---

<BaseLayout titre={name} description={description}>
  <SpriteMouvements />
    <div class="wrap">
    <p class="fil"><a href="/classement/">Retour au classement</a></p>

    <header class="entete-athlete">
      {
        surcouche?.data.photo && (
          <img
            class="portrait"
            src={surcouche.data.photo}
            alt={`Portrait de ${name}`}
            width="120"
            height="120"
            loading="lazy"
          />
        )
      }
      <div>
        <h1>
          {name}
          <BadgeOfficiel taille={22} />
        </h1>
        {/*
          Chaque badge mène au classement déjà filtré sur ce critère. Les
          filtres se lisant dans l'adresse, aucune page supplémentaire n'a
          besoin d'être générée : un simple paramètre suffit.
        */}
        <p class="badges">
          <a class="badge lien-nu" href={`/classement/?sexe=${dernier.sex}`}>
            {sexLabel(dernier.sex)}
          </a>
          {
            dernier.weightClassKg && (
              <a
                class="badge lien-nu"
                href={`/classement/?categorie=${encodeURIComponent(dernier.weightClassKg)}`}
              >
                {dernier.weightClassKg} kg
              </a>
            )
          }
          <a
            class="badge lien-nu"
            href={`/classement/?equipement=${equipmentGroup(dernier.equipment)}`}
          >
            {equipmentLabel(equipmentGroup(dernier.equipment))}
          </a>
          {
            dernier.division && (
              <a
                class="badge lien-nu"
                href={`/classement/?division=${encodeURIComponent(dernier.division)}`}
              >
                {dernier.division}
              </a>
            )
          }
          {
            dernier.ageClass && (
              <a
                class="badge lien-nu"
                href={`/classement/?age=${encodeURIComponent(dernier.ageClass)}`}
              >
                {dernier.ageClass} ans
              </a>
            )
          }
        </p>
      </div>

      <div class="liens-externes">
        <a href={openpowerliftingUrl(name)} rel="noopener">
          Fiche complète sur OpenPowerlifting
        </a>
        {
          liens.map((lien) => (
            <a href={lien.url} rel="noopener me">
              {lien.label}
            </a>
          ))
        }
        {
          surcouche?.data.liens.map((lien) => (
            <a href={lien.url} rel="noopener me">
              {lien.libelle}
            </a>
          ))
        }
      </div>
    </header>

    {
      Presentation && (
        <div class="presentation">
          <Presentation />
        </div>
      )
    }

    {
      estDistingue && rangs && (
        <div class="distinction" data-metal={metalDuRang ?? 'top'}>
          {/*
            LE RANG EN CHIFFRES, et non une coupe.

            Une coupe signale un record en cours partout ailleurs sur le site :
            sur /records/, dans les grilles de catégorie, dans les résultats de
            compétition. Ici elle marquait une position au classement, ce qui
            en faisait le même dessin pour deux notions. Le nombre dit la même
            chose sans ambiguïté, et il porte l'information au lieu de
            l'illustrer.
          */}
          <p class="rang-chiffre" aria-hidden="true">{rangs.global.rang}</p>
          <div>
            <p class="rang-titre">
              {ordinal(rangs.global.rang)} de La Réunion
              <span class="separateur">·</span>
              {ordinal(rangs.sexe.rang)} {libelleSexe}
            </p>
            <p class="rang-detail">
              Classement aux points Dots, avec {points(rangs.dots)} points. Parmi les
              {' '}{rangs.global.centile} % meilleurs des {rangs.global.total} athlètes
              classés, et les {rangs.sexe.centile} % meilleurs des {rangs.sexe.total}{' '}
              {dernier.sex === 'F' ? 'femmes' : 'hommes'}.
            </p>
          </div>
        </div>
      )
    }

    {/*
      DEUX GROUPES, et non une bande de sept mesures.

      Les barres et le total d'un côté, la place dans le classement de
      l'autre. La bande unique mettait sur la même ligne un poids soulevé et
      un rang, et écrasait les trois barres dans une seule case intitulée
      « Squat / DC / SDT », abréviations comprises.
    */}
    <dl class="chiffres-cles barres" data-distingue={estDistingue ? '' : undefined}>
      <div>
        <dt>
          <IconeMouvement mouvement="squat" taille={24} />
          Squat
        </dt>
        <dd class="num">
          {meilleures.squat ? nombre(meilleures.squat) : '—'}
          {meilleures.squat && <span class="unite">kg</span>}
        </dd>
      </div>
      <div>
        <dt>
          <IconeMouvement mouvement="bench" taille={24} />
          Développé couché
        </dt>
        <dd class="num">
          {meilleures.bench ? nombre(meilleures.bench) : '—'}
          {meilleures.bench && <span class="unite">kg</span>}
        </dd>
      </div>
      <div>
        <dt>
          <IconeMouvement mouvement="deadlift" taille={24} />
          Soulevé de terre
        </dt>
        <dd class="num">
          {meilleures.deadlift ? nombre(meilleures.deadlift) : '—'}
          {meilleures.deadlift && <span class="unite">kg</span>}
        </dd>
      </div>
      <div class="cumul">
        <dt>Meilleur total</dt>
        <dd class="num">
          {meilleurTotal ? nombre(meilleurTotal.totalKg) : '—'}
          {meilleurTotal && <span class="unite">kg</span>}
        </dd>
      </div>
    </dl>

    <dl class="chiffres-cles stats">
      <div>
        <dt>Meilleur Dots</dt>
        <dd class="num">{meilleurDots ? points(meilleurDots.dots) : '—'}</dd>
      </div>
      <div>
        <dt>Rang général</dt>
        <dd class="num">
          {rangs ? <>{rangs.global.rang}<span class="sur">/{rangs.global.total}</span></> : '—'}
        </dd>
      </div>
      <div>
        <dt>Rang {dernier.sex === 'F' ? 'femmes' : 'hommes'}</dt>
        <dd class="num">
          {rangs ? <>{rangs.sexe.rang}<span class="sur">/{rangs.sexe.total}</span></> : '—'}
        </dd>
      </div>
      <div>
        <dt>Records détenus</dt>
        <dd class="num">
          {nbRecords > 0 ? <>{nbRecords}<Coupe metal="or" taille={24} detail="Records en cours" /></> : '0'}
        </dd>
      </div>
      <div>
        <dt>Compétitions</dt>
        <dd class="num">{meets}</dd>
      </div>
    </dl>

    {
      pointsGraphe.length > 1 && (
        <section class="bloc">
          <h2>Progression</h2>
          <ProgressChart points={pointsGraphe} legende="Total en compétition" />
        </section>
      )
    }

    {
      /* Le graphique n'a de sens qu'à partir de deux points. Avec un seul, on
         affiche quand même le contexte plutôt que rien du tout. */
      pointsGraphe.length === 1 && (
        <p class="note unique">
          Un seul total en compétition à ce jour, {kg(pointsGraphe[0].value)}. La courbe de
          progression apparaîtra dès la deuxième compétition.
        </p>
      )
    }

    <section class="bloc">
      <h2>Historique</h2>

      <InteractiveTable
        recherche="Nom d'une compétition"
        singulier="compétition"
        pluriel="compétitions"
        total={historique.length}
      >
        <div class="liste liste-barres">
          <table data-tableau>
            <thead>
              <tr>
                <th scope="col" data-tri data-type="nombre">Date</th>
                <th scope="col" data-tri>Compétition</th>
                <th scope="col" data-tri>Format</th>
                <th scope="col" class="nombre" data-tri data-type="nombre">
                  <IconeMouvement mouvement="squat" taille={20} />
                  Squat
                </th>
                <th scope="col" class="nombre" data-tri data-type="nombre">
                  <IconeMouvement mouvement="bench" taille={20} />
                  DC
                </th>
                <th scope="col" class="nombre" data-tri data-type="nombre">
                  <IconeMouvement mouvement="deadlift" taille={20} />
                  SDT
                </th>
                <th scope="col" class="nombre" data-tri data-type="nombre">Total</th>
                <th scope="col" class="nombre" data-tri data-type="nombre">Dots</th>
                <th scope="col" class="nombre" data-tri data-type="nombre">Place</th>
              </tr>
            </thead>
            <tbody>
              {
                [...historique].reverse().map((r) => {
                  const ecart = ecartDots.get(r);
                  return (
                  <tr data-recherche={r.meetName}>
                    <th scope="row" class="date" data-valeur={r.date.replace(/-/g, '')}>
                      {dateLongue(r.date)}
                    </th>
                    <td data-libelle="Compétition" class="competition">
                      <a href={`/competitions/${meetPath(r.date, r.meetName)}/`}>
                        <span class="meet">{r.meetName}</span>
                        <span class="ou">{r.meetTown}</span>
                      </a>
                    </td>
                    <td data-libelle="Format" class="cellule-annexe">
                      <span class="etiquette">{libelleEvent(r.event)}</span>
                    </td>
                    <td class="nombre num-tab" data-libelle="Squat" data-valeur={r.bestSquatKg ?? ''}>
                      <span class="intitule"><IconeMouvement mouvement="squat" taille={20} />Squat</span>
                      <span class="v">
                        {nombre(r.bestSquatKg)}
                        {r.bestSquatKg && estRecord(r, 'squat') && <Coupe metal="or" detail="Record du squat dans sa catégorie" taille={20} />}
                      </span>
                    </td>
                    <td class="nombre num-tab" data-libelle="DC" data-valeur={r.bestBenchKg ?? ''}>
                      <span class="intitule"><IconeMouvement mouvement="bench" taille={20} />DC</span>
                      <span class="v">
                        {nombre(r.bestBenchKg)}
                        {r.bestBenchKg && estRecord(r, 'bench') && <Coupe metal="or" detail="Record du développé couché dans sa catégorie" taille={20} />}
                      </span>
                    </td>
                    <td class="nombre num-tab" data-libelle="SDT" data-valeur={r.bestDeadliftKg ?? ''}>
                      <span class="intitule"><IconeMouvement mouvement="deadlift" taille={20} />SDT</span>
                      <span class="v">
                        {nombre(r.bestDeadliftKg)}
                        {r.bestDeadliftKg && estRecord(r, 'deadlift') && <Coupe metal="or" detail="Record du soulevé de terre dans sa catégorie" taille={20} />}
                      </span>
                    </td>
                    <td class="nombre num-tab" data-libelle="Total" data-valeur={r.event === 'SBD' ? (r.totalKg ?? '') : ''}>
                      <span class="v">
                        {r.event === 'SBD' ? nombre(r.totalKg) : '—'}
                        {r.event === 'SBD' && estRecord(r, 'total') && <Coupe metal="or" detail="Record au total dans sa catégorie" taille={20} />}
                      </span>
                    </td>
                    <td class="nombre" data-libelle="Dots" data-valeur={r.event === 'SBD' ? (r.dots ?? '') : ''}>
                      {r.event === 'SBD' ? points(r.dots) : '—'}
                      {ecart !== undefined && (
                        <span class="evolution" data-sens={ecart > 0 ? 'hausse' : 'baisse'}>
                          <span aria-hidden="true">{ecart > 0 ? '▲' : '▼'}</span>
                          {points(Math.abs(ecart))}
                          <span class="sr-only">
                            points {ecart > 0 ? 'gagnés' : 'perdus'} depuis la compétition
                            précédente en full power
                          </span>
                        </span>
                      )}
                    </td>
                    <td class="nombre" data-libelle="Place" data-valeur={Number.parseInt(r.place, 10) || 999}>
                      {place(r.place)}
                    </td>
                  </tr>
                  );
                })
              }
            </tbody>
          </table>
        </div>
      </InteractiveTable>

      <p class="note">
        La coupe signale une barre qui constitue aujourd'hui le record de sa
        catégorie à La Réunion. Le total et les points Dots concernent le full
        power : sur une compétition à un seul mouvement, ils reprendraient
        simplement la barre disputée. La flèche sous les points Dots donne
        l'écart avec la compétition en full power précédente : les Dots ramènent
        toutes les barres à une même échelle, si bien qu'un changement de
        catégorie ne fausse pas la comparaison.
      </p>
    </section>

    {
      exterieur.length > 0 && (
        <section class="bloc">
          <h2>Hors de La Réunion</h2>
          <p class="intro-ext">
            {phraseExterieur} Ces résultats complètent le parcours de l'athlète.
            Le classement et les records restent réservés aux plateaux
            réunionnais.
          </p>

          <div class="liste liste-barres">
            <table>
              <thead>
                <tr>
                  <th scope="col">Date</th>
                  <th scope="col">Compétition</th>
                  <th scope="col">Pays</th>
                  <th scope="col" class="nombre">
                    <IconeMouvement mouvement="squat" taille={20} />
                    Squat
                  </th>
                  <th scope="col" class="nombre">
                    <IconeMouvement mouvement="bench" taille={20} />
                    DC
                  </th>
                  <th scope="col" class="nombre">
                    <IconeMouvement mouvement="deadlift" taille={20} />
                    SDT
                  </th>
                  <th scope="col" class="nombre">Total</th>
                  <th scope="col" class="nombre">Place</th>
                </tr>
              </thead>
              <tbody>
                {exterieur.map((r) => (
                  <tr>
                    <th scope="row" class="date">
                      {dateLongue(r.date)}
                    </th>
                    <td data-libelle="Compétition" class="competition">
                      {r.meetName}
                      <span class="ville">
                        {r.federation}
                        {r.meetTown && <> · {r.meetTown}</>}
                      </span>
                    </td>
                    <td data-libelle="Pays" class="cellule-annexe">
                      <span class="etiquette">{paysFr(r.meetCountry)}</span>
                    </td>
                    <td class="nombre num-tab" data-libelle="Squat">
                      <span class="intitule"><IconeMouvement mouvement="squat" taille={20} />Squat</span>
                      {nombre(r.bestSquatKg)}
                    </td>
                    <td class="nombre num-tab" data-libelle="DC">
                      <span class="intitule"><IconeMouvement mouvement="bench" taille={20} />DC</span>
                      {nombre(r.bestBenchKg)}
                    </td>
                    <td class="nombre num-tab" data-libelle="SDT">
                      <span class="intitule"><IconeMouvement mouvement="deadlift" taille={20} />SDT</span>
                      {nombre(r.bestDeadliftKg)}
                    </td>
                    <td class="nombre num-tab" data-libelle="Total">
                      {r.event === 'SBD' ? nombre(r.totalKg) : '—'}
                    </td>
                    <td class="nombre" data-libelle="Place">
                      {place(r.place)}
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>

          <p class="note">
            Voir <a href="/exterieur/">tous les résultats hors de La Réunion</a>.
          </p>
        </section>
      )
    }
  </div>
</BaseLayout>

<style>

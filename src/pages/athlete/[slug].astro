  .distinction[data-metal='argent'] .rang-chiffre {
    color: var(--argent);
  }
  .distinction[data-metal='bronze'] .rang-chiffre {
    color: var(--bronze);
  }

  .rang-titre {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--step-1);

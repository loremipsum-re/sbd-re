---
import InteractiveTable from '../components/InteractiveTable.astro';
import Glossaire from '../components/Glossaire.astro';
import Repli from '../components/Repli.astro';
import InfographieDots from '../components/infographies/InfographieDots.astro';
import InfographieTotal from '../components/infographies/InfographieTotal.astro';
import RankingTable from '../components/RankingTable.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import {
  EQUIPMENT_GROUPS,
  compareWeightClass,
  parseWeightClass,
  type EquipmentGroup,
} from '../lib/categories';
import { fullPowerResults } from '../lib/data';
import { equipementsPresents } from '../lib/records';
import { meilleurTotalParAthlete } from '../lib/rankings';
import type { Sex } from '../lib/types';
import Partenaire from '../components/Partenaire.astro';

const classement = meilleurTotalParAthlete();

/**
 * Catégories réellement présentes, avec les sexes concernés. Certaines valeurs
 * n'existent que chez les femmes, d'autres que chez les hommes : on marque
 * chaque option pour que le composant masque celles qui deviennent sans objet
 * quand le visiteur filtre par sexe.
 */
const sexesParClasse = new Map<string, Set<Sex>>();
for (const r of fullPowerResults) {
  if (!r.weightClassKg) continue;
  const set = sexesParClasse.get(r.weightClassKg) ?? new Set<Sex>();
  set.add(r.sex);
  sexesParClasse.set(r.weightClassKg, set);
}

const categories = [...sexesParClasse.entries()]
  .map(([id, sexes]) => ({ id, classe: parseWeightClass(id)!, sexes: [...sexes].sort().join('') }))
  .filter((c) => c.classe)
  .sort((a, b) => compareWeightClass(a.classe, b.classe));

const equipements = equipementsPresents(fullPowerResults);
const libelleEquipement = (id: EquipmentGroup) => EQUIPMENT_GROUPS.find((e) => e.id === id)!;

/**
 * Divisions et tranches d'âge, tirées du classement affiché.
 *
 * Les deux notions se recouvrent sans se confondre. La DIVISION est fédérale
 * et dépend de l'année de naissance : un athlète reste « Juniors » toute sa
 * saison. La TRANCHE D'ÂGE est l'âge réel au moment du plateau. Filtrer sur
 * l'une ou sur l'autre ne donne pas le même résultat, d'où deux filtres.
 */
const divisions = [...new Set(classement.map((e) => e.division).filter(Boolean))].sort(
  (a, b) => a.localeCompare(b, 'fr'),
);

const tranchesAge = [...new Set(classement.map((e) => e.ageClass).filter(Boolean))].sort(
  // Tri numérique sur la borne basse : sans lui, « 5-12 » passerait après « 45-49 ».
  (a, b) => Number.parseInt(a, 10) - Number.parseInt(b, 10),
);
---

<BaseLayout
  titre="Classement"
  description="Classement des powerlifters de La Réunion par meilleur total en compétition officielle. Triable et filtrable par sexe, catégorie de poids et équipement."
>
  <div class="wrap">
    {/*
      UNE PHRASE, PUIS LA LISTE. Les deux paragraphes d'avant tenaient
      onze lignes sur un téléphone, et la première carte tombait à 1 078 px,
      hors du premier écran de 812. Elle tient désormais entre 570 et
      707 px. Le mode d'emploi est parti, la barre se lit seule. « Sur les
      trois mouvements » dit le full power sans le jargon, et la précision
      qui explique une absence suit en petit.
    */}
    <header class="entete-page">
      <h1>Classement</h1>
      <p class="chapeau">
        Le meilleur total de chaque athlète en compétition à La Réunion, sur
        les trois mouvements.
      </p>
      <p class="precision">
        Les compétitions de développé couché seul comptent dans les{' '}
        <a href="/records/">records</a>.
      </p>
    </header>

    {/*
      DEUX PASTILLES SUR UNE LIGNE. Le vocabulaire, puis le calcul du
      classement en images. Repliées, elles coûtent une seule ligne avant la
      liste, et la première carte reste dans le premier écran. Le total et
      les Dots sont les deux nombres de chaque carte.
    */}
    <div class="rangee-replis">
      <Glossaire />
      <Repli titre="Calcul en images">
        <InfographieTotal lienArticle="total" />
        <InfographieDots lienArticle="dots" />
      </Repli>
    </div>

    {/*
      LES FILTRES REPLIÉS DERRIÈRE « FILTRES », À TOUTES LES LARGEURS, à la
      demande de l'auteur. Ouvert, le panneau mesure 392 px sur un téléphone
      de 375 px, soit 48 % de l'écran : cinq menus et six critères de tri. La
      recherche et le compteur restent visibles, le bouton dit combien de
      filtres sont actifs, et les étiquettes sous le compteur disent lesquels.
    */}
    <InteractiveTable
      recherche="Nom d'un athlète"
      singulier="athlète"
      pluriel="athlètes"
      total={classement.length}
      barreDeTri
      replier="toujours"
    >
      <Fragment slot="filtres">
        <div class="champ">
          <label for="f-sexe">Sexe</label>
          <select id="f-sexe" data-filtre="sexe">
            <option value="">Tous</option>
            <option value="M">Hommes</option>
            <option value="F">Femmes</option>
          </select>
        </div>

        <div class="champ">
          <label for="f-categorie">Catégorie</label>
          <select id="f-categorie" data-filtre="categorie" data-restreint-par="sexe">
            <option value="">Toutes</option>
            {
              categories.map((c) => (
                <option value={c.id} data-compatible={c.sexes}>
                  {c.classe.label}
                </option>
              ))
            }
          </select>
        </div>

        <div class="champ">
          <label for="f-equipement">Équipement</label>
          <select id="f-equipement" data-filtre="equipement">
            <option value="">Tous</option>
            {equipements.map((e) => <option value={e}>{libelleEquipement(e).label}</option>)}
          </select>
        </div>

        <div class="champ">
          <label for="f-division">Division</label>
          <select id="f-division" data-filtre="division">
            <option value="">Toutes</option>
            {divisions.map((d) => <option value={d}>{d}</option>)}
          </select>
        </div>

        <div class="champ">
          <label for="f-age">Âge</label>
          <select id="f-age" data-filtre="age">
            <option value="">Tous</option>
            {tranchesAge.map((a) => <option value={a}>{a} ans</option>)}
          </select>
        </div>
      </Fragment>

      <RankingTable entries={classement} id="classement" />
    </InteractiveTable>

    {/* Une information par phrase. Les deux-points de la dernière
        annonçaient une explication, et non une donnée ou une liste. */}
    <p class="note">
      La coche à côté d'un nom signale un compétiteur officiel. La compétition
      indiquée est celle du meilleur total. Un score Dots souligné en
      pointillé vient d'une autre compétition, et son lien y mène. Les
      athlètes invités figurent au classement. Leur performance a été réalisée
      en compétition, devant les mêmes juges.
    </p>

    <Partenaire emplacement="classement" />
  </div>
</BaseLayout>

<style>
  /* La précision du chapeau, en petit : elle explique une absence. L'écart
     au-dessus est la marge du chapeau, voir tokens.css. */
  .precision {
    max-width: 62ch;
    margin: 0;
    font-size: var(--step--1);
    color: var(--muted);
  }
</style>

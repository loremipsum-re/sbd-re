---
/**
 * Page d'accessibilité, adossée à un audit réellement mené.
 *
 * ELLE NE DÉCLARE PAS UNE CONFORMITÉ. Le RGAA impose une déclaration aux
 * organismes publics et aux grandes entreprises ; ce site n'entre dans aucune
 * de ces catégories, et aucun audit RGAA n'a été commandé. Annoncer une
 * conformité qui n'a pas été auditée serait exactement le genre de donnée
 * inventée que le projet s'interdit.
 *
 * Elle dit donc ce qui a été mesuré, comment, quand, ce qui passe, ce qui a été
 * corrigé et ce qui reste hors de portée. Les chiffres viennent des mesures
 * faites dans le navigateur le 14 octobre 2026, et sont à refaire après toute
 * refonte.
 */
import InfographieAccessibilite from '../components/infographies/InfographieAccessibilite.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import type {
  ControleAudit,
  LimiteAudit,
  PageAuditee,
  ResultatAudit,
} from '../lib/infographie-accessibilite';

const DATE_AUDIT = '14 octobre 2026';

/** Pages passées au crible, choisies pour couvrir chaque gabarit du site. */
const PAGES_AUDITEES: PageAuditee[] = [
  { url: '/', nom: "L'accueil" },
  { url: '/classement/', nom: 'Le classement, liste filtrable' },
  { url: '/categories/', nom: 'Les catégories de poids' },
  { url: '/records/', nom: 'Les records, grille à quatre tableaux' },
  { url: '/athlete/daisy-blondan/', nom: "Une fiche d'athlète, avec courbe" },
  { url: '/competitions/reunion-island-meet/2026-07-18/', nom: 'Une compétition' },
  { url: '/suggestions/', nom: 'Un formulaire' },
  { url: '/mises-a-jour/', nom: 'Une page de texte' },
];

/** Ce qui a été vérifié, et le résultat. */
const CONTROLES: ControleAudit[] = [
  {
    titre: 'Contraste des textes',
    critere: 'WCAG 2.2, critère 1.4.3, niveau AA',
    resultat: 'ok',
    detail:
      "Chaque texte visible a été comparé à la couleur réellement composée sous lui, transparences comprises, dans les deux thèmes. Aucun texte sous son seuil, 4,5 pour un corps courant et 3 pour un grand titre.",
  },
  {
    titre: 'Structure des titres',
    critere: 'WCAG 2.2, critère 1.3.1',
    resultat: 'ok',
    detail:
      "Un seul titre de premier niveau par page, et aucun niveau sauté dans la descente. Les tableaux ont leurs en-têtes de colonne et de ligne. Un lecteur d'écran annonce ainsi « Squat, 165 kg », intitulé compris.",
  },
  {
    titre: 'Nom des liens, des boutons et des images',
    critere: 'WCAG 2.2, critères 2.4.4 et 1.1.1',
    resultat: 'ok',
    detail:
      "Chaque lien et chaque bouton porte un intitulé lisible. Une icône qui accompagne un mot est masquée aux lecteurs d'écran, qui entendent ainsi le mot une seule fois. Une icône porteuse d'information a un texte de remplacement.",
  },
  {
    titre: 'Étiquettes de formulaire',
    critere: 'WCAG 2.2, critère 3.3.2',
    resultat: 'ok',
    detail:
      "Chaque champ des deux formulaires du site a son étiquette liée, qui reste visible pendant la saisie.",
  },
  {
    titre: 'Taille des cibles',
    critere: 'WCAG 2.2, critère 2.5.8, niveau AA',
    resultat: 'corrige',
    /*
     * REMESURÉ LE 28 OCTOBRE 2026, sur 26 pages, à 375 et 1 280 px, dans les
     * deux thèmes : 1 328 commandes. « Les autres commandes visent 44 px »
     * était faux, le logo mesurait 26 px. Corrigé depuis, il en mesure 44.
     * Restent les points de la courbe et les marqueurs de la carte, mesurés
     * de 320 à 375 px de large, et que la phrase nomme désormais.
     */
    detail:
      "Les en-têtes de colonne cliquables mesuraient 23 px de haut, un pixel sous le minimum de 24. Corrigé le jour de l'audit. Remesuré le 28 octobre 2026 : les autres boutons, les champs, les pastilles et les liens de l'en-tête mesurent 44 px au moins. Le niveau AA en demande 24. Sur téléphone, les points de la courbe de progression mesurent de 19 à 22 px. Les marqueurs de la carte des salles mesurent de 14 à 17 px. L'historique de chaque fiche et la liste des salles en donnent le contenu en texte.",
  },
  {
    titre: 'Affichage à 320 px de large',
    critere: 'WCAG 2.2, critère 1.4.10',
    resultat: 'ok',
    detail:
      "À la largeur d'un petit téléphone, ou d'un écran agrandi quatre fois, chaque page tient sans défilement horizontal. Les tableaux se replient en cartes.",
  },
  {
    titre: 'Navigation au clavier',
    critere: 'WCAG 2.2, critères 2.1.1 et 2.4.7',
    resultat: 'ok',
    detail:
      "Un lien d'évitement ouvre chaque page. Le focus reste visible partout, par un contour de 3 px. Les points de la courbe de progression se parcourent aux flèches. La touche Tab franchit ainsi la courbe en un seul arrêt, quel que soit le nombre de points.",
  },
  {
    titre: 'Rôles et états annoncés',
    critere: 'WCAG 2.2, critère 4.1.2',
    resultat: 'corrige',
    detail:
      "La courbe de progression se déclarait image tout en contenant des points cliquables, deux affirmations contradictoires qui rendaient ces points invisibles aux technologies d'assistance. Corrigé le 22 septembre 2026. Elle devient un groupe dès que le script rend ses points manipulables.",
  },
  {
    titre: 'Mouvement et animation',
    critere: 'WCAG 2.2, critère 2.3.3',
    resultat: 'ok',
    detail:
      "Aucune animation automatique. Les rares transitions s'effacent quand le système annonce une préférence pour le mouvement réduit.",
  },
];

const LIBELLES_RESULTAT: Record<ResultatAudit, string> = {
  ok: 'Conforme',
  corrige: 'Corrigé',
};

/*
 * Ce qui n'a pas été vérifié. Les limites vivent ici avec le reste de l'audit,
 * et non plus dans le gabarit, pour que la liste de la page et l'infographie
 * lisent la même source. Le texte publié est inchangé.
 */
const LIMITES: LimiteAudit[] = [
  {
    titre: 'Aucun test avec de vraies personnes.',
    suite:
      " Un audit à la mesure dit qu'une page respecte des règles. L'usage quotidien avec un lecteur d'écran demande d'autres tests. C'est la limite principale de cette page.",
    resume: 'Tests avec de vraies personnes',
  },
  {
    titre: 'Aucun audit certifié.',
    suite:
      " Les 106 critères du référentiel français n'ont pas été passés un à un par un auditeur tiers.",
    resume: 'Audit certifié par un tiers',
  },
  {
    titre: 'La carte des salles',
    suite:
      " montre des positions sur un fond dessiné. Une liste en texte, sous la carte, donne la même information. Elle reste à éprouver au lecteur d'écran.",
    resume: "Liste des salles au lecteur d'écran",
  },
  {
    titre: "Les contenus venant d'OpenPowerlifting",
    suite:
      ", noms et intitulés de compétitions, sont repris tels quels. Une faute de casse ou d'accent dans la source se retrouve ici.",
    resume: "Casse et accents des noms venant d'OpenPowerlifting",
  },
];
---

<BaseLayout
  titre="Accessibilité"
  description="Ce qui a été mesuré sur SBD.re en matière d'accessibilité : méthode, résultats, corrections apportées et limites connues."
>
  <div class="wrap">
    <header class="entete-page">
      <h1>Accessibilité</h1>
      <p class="chapeau">
        Un site de classements se consulte autant au clavier, à la loupe ou avec
        un lecteur d'écran qu'à la souris. Voici ce qui a été vérifié, comment,
        et ce qui reste à faire.
      </p>
    </header>

    {/*
      UN TITRE QUI DIT LE SUJET, ET UNE INFORMATION PAR PHRASE. L'ancien
      titre opposait ce que la page est à ce qu'elle n'est pas, et la phrase
      sur la conformité comptait 34 mots et trois négations. Le nombre de
      pages vient de la liste ci-dessus.
    */}
    <section class="bloc">
      <h2>Portée de cet audit</h2>
      <p class="texte">
        Cette page rend compte d'un <strong>audit interne, mené par la
        mesure</strong> le {DATE_AUDIT}, sur {PAGES_AUDITEES.length}&nbsp;pages
        couvrant chaque gabarit du site. Le référentiel français impose une
        déclaration de conformité aux organismes publics et aux grandes
        entreprises. Ce site est hors de ce champ. Aucun audit certifié n'a
        été commandé.
      </p>
      <p class="texte">
        L'objectif visé est le niveau AA des WCAG 2.2, référentiel international
        dont le référentiel français est la déclinaison.
      </p>
    </section>

    <section class="bloc">
      <h2>Comment la vérification a été faite</h2>
      <p class="texte">
        Tout a été mesuré dans un navigateur, sur les pages réelles. Les
        contrastes sont calculés sur la couleur réellement composée sous chaque
        texte, transparences comprises. Un aplat posé à 5 % sur un fond sombre
        donne ainsi une autre valeur que celle de la feuille de style.
      </p>
      <p class="texte">Les pages passées au crible :</p>
      <ul class="pages">
        {
          PAGES_AUDITEES.map((p) => (
            <li>
              <a href={p.url}>{p.nom}</a>
            </li>
          ))
        }
      </ul>
      <p class="note">
        Les scripts de mesure ont été exécutés depuis le navigateur, puis
        jetés. Aucun outil d'analyse tiers n'a été chargé sur le site.
      </p>
    </section>

    <section class="bloc">
      <h2>Résultats</h2>

      {/*
        LA SYNTHÈSE AVANT LE DÉTAIL, DÉPLIÉE. La page est un texte, sans liste
        de données à atteindre en premier : l'infographie ouvre la section
        qu'elle résume, et la liste des contrôles justifie ensuite chaque
        verdict. Repliée, elle cacherait la seule vue d'ensemble de l'audit.
      */}
      <InfographieAccessibilite
        dateAudit={DATE_AUDIT}
        pages={PAGES_AUDITEES}
        controles={CONTROLES}
        libelles={LIBELLES_RESULTAT}
        limites={LIMITES}
      />

      <ol class="controles">
        {
          CONTROLES.map((c) => (
            <li>
              <div class="entete-controle">
                <h3>{c.titre}</h3>
                <span class="verdict" data-resultat={c.resultat}>
                  {LIBELLES_RESULTAT[c.resultat]}
                </span>
              </div>
              <p class="critere">{c.critere}</p>
              <p class="detail">{c.detail}</p>
            </li>
          ))
        }
      </ol>
    </section>

    <section class="bloc">
      <h2>Ce qui n'a pas été vérifié</h2>
      <p class="texte">Voici les limites de cet audit.</p>
      <ul class="limites">
        {
          LIMITES.map((l) => (
            <li>
              {/* Sur une seule ligne : `suite` porte son propre séparateur. */}
              <strong>{l.titre}</strong>{l.suite}
            </li>
          ))
        }
      </ul>
    </section>

    <section class="bloc">
      <h2>Signaler un obstacle</h2>
      <p class="texte">
        Une page vous résiste ? Signalez-le depuis la page{' '}
        <a href="/suggestions/">Proposer une amélioration</a>. Le message
        suffit, l'adresse électronique reste facultative. Décrivez ce que vous
        tentiez de faire, et avec quel outil. Un signalement aussi précis se
        traite le plus vite.
      </p>
      <p class="note">
        Les corrections apportées figurent sur la page{' '}
        <a href="/mises-a-jour/">Mises à jour</a>, comme le reste des changements
        du site.
      </p>
    </section>
  </div>
</BaseLayout>

<style>
  .texte {
    max-width: 68ch;
    margin-bottom: var(--space-4);
  }

  .pages {
    margin: 0 0 var(--space-4) var(--space-6);
    max-width: 68ch;
  }

  .pages li {
    margin-bottom: var(--space-1);
  }

  /*
   * Les contrôles sont une liste ORDONNÉE : leur numéro ne s'affiche pas, mais
   * l'ordre reste porteur de sens pour qui parcourt la page au lecteur d'écran.
   */
  .controles {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-4);
  }

  .controles li {
    padding: var(--space-4) var(--space-6);
    border: 1px solid var(--border);
    border-left-width: 3px;
    border-radius: var(--radius-lg);
    background: var(--surface);
  }

  .entete-controle {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-2) var(--space-4);
  }

  .controles h3 {
    font-size: var(--step-0);
    margin: 0;
  }

  .critere {
    margin: var(--space-1) 0 var(--space-2);
    font-size: var(--step--1);
    color: var(--muted);
  }

  .detail {
    margin: 0;
    max-width: 68ch;
  }

  /*
   * LE MOT DIT LE VERDICT, la couleur ne fait que l'appuyer : « Conforme » et
   * « Corrigé » se lisent sans distinguer le vert de l'ambre.
   */
  .verdict {
    font-size: var(--step--1);
    font-weight: 700;
    white-space: nowrap;
  }

  .verdict[data-resultat='ok'] {
    color: var(--positif);
  }

  .verdict[data-resultat='corrige'] {
    color: var(--alerte);
  }

  .controles li:has([data-resultat='ok']) {
    border-left-color: var(--positif);
  }

  .controles li:has([data-resultat='corrige']) {
    border-left-color: var(--alerte);
  }

  .limites {
    margin: 0 0 0 var(--space-6);
    max-width: 68ch;
  }

  .limites li {
    margin-bottom: var(--space-3);
  }
</style>

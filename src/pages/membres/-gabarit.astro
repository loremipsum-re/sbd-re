---
/**
 * Le gabarit des profils de membres, que public/api/profil-page.php remplit.
 *
 * POURQUOI UN GABARIT. Les profils changent entre deux déploiements, et la
 * base n'est joignable que depuis OVH : PHP les rend à la demande. Astro
 * produit ici la page une fois, au dessin du site, avec des repères
 * « %%NOM%% » que PHP remplace par des valeurs échappées. En-tête, menu,
 * thème, pied de page et bannière restent ainsi ceux de toutes les pages.
 *
 * L'ADRESSE `/membres/-gabarit/` ne peut appartenir à aucun membre : le tiret
 * est refusé dans les pseudos. Le .htaccess la renvoie en 404, et PHP lit le
 * fichier sur le disque. Elle sort du plan de site, voir astro.config.mjs.
 *
 * LES STYLES SONT GLOBAUX, sous `.page-membre` : les blocs écrits par PHP ne
 * portent pas l'attribut qu'Astro pose pour isoler les styles d'un fichier.
 *
 * Les repères : PSEUDO, TITRE, DESCRIPTION, ROBOTS (index ou noindex, selon
 * que le profil a des performances), PRESENTATION, FICHE, RECORDS, SUJETS
 * (ses sujets au forum, ou rien), AVATAR, MEMBRE, DONNEES
 * (le JSON-LD ProfilePage). Toute adresse `/membres/-gabarit/` devient celle
 * du profil, l'adresse canonique comprise.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout titre="%%PSEUDO%%" titreOnglet="%%TITRE%%" description="%%DESCRIPTION%%">
  <meta slot="tete" name="robots" content="%%ROBOTS%%" />

  <div class="wrap page-membre">
    <header class="entete-page">
      %%AVATAR%%
      <p class="surtitre">Membre de la communauté</p>
      <h1>%%PSEUDO%%</h1>
      %%PRESENTATION%%
    </header>

    %%FICHE%%

    <section class="records-membre" aria-labelledby="titre-records">
      <h2 id="titre-records">Records</h2>
      %%RECORDS%%
    </section>

    %%SUJETS%%

    {/* Signaler ce profil, avatar compris : pour un membre connecté seulement,
        d'après le cookie lisible de la connexion (lib/cloche.ts). */}
    <p class="signaler-profil" data-signaler-profil data-membre="%%MEMBRE%%" hidden>
      <button type="button" class="bouton-signaler">Signaler ce profil</button>
      <span class="etat-signalement" role="status" aria-live="polite"></span>
    </p>
  </div>

  <script type="application/ld+json" is:inline>%%DONNEES%%</script>
</BaseLayout>

<script>
  import { api } from '../../lib/api-compte';

  const zone = document.querySelector<HTMLElement>('[data-signaler-profil]');
  if (zone && document.cookie.split('; ').includes('sbdre-connecte=1')) {
    zone.hidden = false;
    const bouton = zone.querySelector('button')!;
    bouton.addEventListener('click', async () => {
      if (!confirm('Signaler ce profil à l\'admin ?')) return;
      bouton.disabled = true;
      const r = await api('/api/signalements.php', 'POST', { type: 'membre', cible_id: Number(zone.dataset.membre) });
      zone.querySelector('[role="status"]')!.textContent = r.message;
    });
  }
</script>

<style is:global>
  .page-membre {
    padding-block: var(--space-8) var(--space-16);
  }

  .page-membre .surtitre {
    margin: 0 0 var(--space-2);
    font-size: var(--step--1);
    font-weight: 600;
    color: var(--muted);
  }

  /* Le pseudo ne se tronque jamais : il passe à la ligne s'il est long. */
  .page-membre h1 {
    overflow-wrap: anywhere;
  }

  .page-membre .fiche-membre {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(14rem, 100%), 1fr));
    gap: var(--space-4);
    margin: 0 0 var(--space-12);
    max-width: 48rem;
  }

  .page-membre .fiche-membre div {
    min-width: 0;
    padding: var(--space-3) var(--space-4);
    border: 2px solid var(--border);
    border-radius: var(--radius);
  }

  .page-membre .fiche-membre dt {
    font-size: var(--step--1);
    color: var(--muted);
  }

  .page-membre .fiche-membre dd {
    margin: var(--space-1) 0 0;
    font-weight: 600;
    overflow-wrap: anywhere;
  }

  /* Un lien seul dans sa case est un contrôle : 44 px, comme le reste. */
  .page-membre .fiche-membre a {
    display: inline-flex;
    align-items: center;
    min-height: var(--cible-min);
  }

  /* La fiche d'athlète reliée par l'admin : le mot en vert, au filet de sa
     couleur, comme les barres vérifiées. */
  .page-membre .fiche-membre .verifie {
    display: inline-block;
    margin-left: var(--space-1);
    padding: 0 var(--space-2);
    border: 1px solid currentColor;
    border-radius: 999px;
    color: var(--succes);
    font-size: var(--step--1);
    font-weight: 600;
  }

  .page-membre .records-membre,
  .page-membre .sujets-membre {
    max-width: 48rem;
  }

  /* Ses sujets au forum : le titre en lien, le forum dessous. */
  .page-membre .sujets-membre ul {
    margin: var(--space-3) 0 0;
    padding: 0;
    list-style: none;
  }

  .page-membre .sujets-membre li {
    display: flex;
    flex-direction: column;
    padding: var(--space-2) 0;
    border-bottom: 1px solid var(--border);
  }

  .page-membre .sujets-membre a {
    display: inline-flex;
    align-items: center;
    min-height: var(--cible-min);
  }

  .page-membre .sujets-membre .meta {
    color: var(--muted);
    font-size: var(--step--1);
  }

  .page-membre .records-membre h2 {
    margin-bottom: var(--space-3);
  }

  .page-membre .records-membre h3 {
    margin: var(--space-6) 0 var(--space-3);
    font-size: var(--step-0);
  }

  /* Les records d'un équipement : une case par mouvement, puis le total. */
  .page-membre .records {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(12rem, 100%), 1fr));
    gap: var(--space-3);
    margin: 0;
  }

  .page-membre .records div {
    min-width: 0;
    padding: var(--space-3) var(--space-4);
    border: 2px solid var(--border);
    border-radius: var(--radius);
  }

  /* Le total, état dans la donnée : l'aplat sous le filet, jamais seul. */
  .page-membre .records .total {
    border-color: var(--accent);
    background: var(--accent-fill);
    color: var(--on-accent);
  }

  .page-membre .records .total dt {
    color: inherit;
  }

  .page-membre .records dt {
    font-size: var(--step--1);
    color: var(--muted);
  }

  .page-membre .records dd {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-1) var(--space-3);
    margin: var(--space-1) 0 0;
  }

  .page-membre .charge {
    font-size: var(--step-2);
    font-weight: 700;
    font-variant-numeric: tabular-nums;
  }

  /* Vérifiée en vert, non vérifiée en ambre : une pastille au filet de sa
     couleur, le mot toujours écrit. Mêmes règles dans styles/compte.css. */
  .page-membre .verif {
    display: inline-block;
    padding: 0 var(--space-2);
    border: 1px solid currentColor;
    border-radius: 999px;
    font-size: var(--step--1);
    font-weight: 600;
    white-space: nowrap;
  }

  .page-membre .verif-oui {
    color: var(--succes);
  }

  .page-membre .verif-non {
    color: var(--alerte);
  }

  .page-membre .liste-perfs {
    display: grid;
    gap: var(--space-2);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .page-membre .liste-perfs li {
    padding: var(--space-2) 0;
    border-bottom: 1px solid var(--border);
  }

  /* Le lien de la vidéo, dans une case ou une ligne, reste une cible de 44 px. */
  .page-membre .records-membre a {
    display: inline-flex;
    align-items: center;
    min-height: var(--cible-min);
  }

  .page-membre .avatar-profil {
    display: block;
    width: 6rem;
    height: 6rem;
    margin-bottom: var(--space-4);
    border: 2px solid var(--border);
    border-radius: var(--radius);
  }

  .page-membre .signaler-profil {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3);
    margin-top: var(--space-12);
    font-size: var(--step--1);
    color: var(--muted);
  }

  .page-membre .signaler-profil[hidden] {
    display: none;
  }

  .page-membre .bouton-signaler {
    padding: var(--space-2) var(--space-4);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: transparent;
    color: var(--muted);
    font: inherit;
    cursor: pointer;
  }
</style>
